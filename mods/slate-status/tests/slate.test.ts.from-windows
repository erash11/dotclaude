import { expect, mock, test } from 'claude-code/testing'

const HOME = 'C:/Users/eric'
const CONFIG = `${HOME}/.claude/skills/_shared/config.windows.json`
const SLATE = {
  status: 'DUE', enabled: true, active: 1, cap: 5,
  problems: [{ level: 'DUE', project: 'Weekly_Matchups_2026', message: 'charter incomplete: no charter' }],
}

const norm = (p: string) => p.replace(/\\/g, '/')

function machine(on: any, slate: unknown, exitCode = 0) {
  const ran: string[][] = []
  const status: (string | undefined)[] = []
  mock.env(on, { USERPROFILE: HOME })
  mock.clock(on)
  on('fs.read', ($: any, e: any) => {
    if (norm(e.path) === CONFIG) return { value: JSON.stringify({ portfolio_json: 'C:\\DEV\\project-triage\\portfolio.json' }) }
    throw new Error('missing ' + e.path)
  })
  on('fs.exists', ($: any, e: any) => ({ value: norm(e.path) === 'C:/DEV/project-triage/portfolio.py' }))
  on('process.run', ($: any, e: any) => {
    ran.push([...e.argv])
    return { value: { exitCode, stdout: JSON.stringify(slate), stderr: exitCode ? 'boom' : '' } }
  })
  on('ui.status', ($: any, e: any) => { status.push(e.text); return { value: undefined } })
  on('ui.toast', () => ({ value: undefined }))
  return { ran, status }
}

test('/slate runs slate-check with the configured path and lists what is due', async ($, on) => {
  const { ran, status } = machine(on, SLATE)
  const { text } = await $.command.run({ command: 'slate' })
  expect(ran.at(-1)).toEqual(['python', 'C:/DEV/project-triage/portfolio.py', 'slate-check', '--json'])
  expect(status.at(-1)).toBe('slate: DUE · 1/5 active · 1 to do')
  expect(text).toContain('Weekly_Matchups_2026: charter incomplete: no charter')
})

test('a check that cannot run reads as DUE, never OK', async ($, on) => {
  const { status } = machine(on, {}, 2)
  const { text } = await $.command.run({ command: 'slate' })
  expect(status.at(-1)).toContain('slate: DUE')
  expect(text).toContain('slate check could not run')
})
