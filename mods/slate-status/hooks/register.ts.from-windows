import type { EngineInterface, Register } from 'claude-code'

// Reads the job-lane slate from project-triage (`portfolio.py slate-check --json`) and shows it.
// The registry's path lives in ~/.claude/skills/_shared/config.<platform>.json as `portfolio_json`,
// so the same mod works on the Windows laptop and the Mac.

type Problem = { level: string; project?: string; message: string }
export type Slate = { status: string; enabled: boolean; active: number; cap: number | null; problems: Problem[] }

const REFRESH_MS = 30 * 60 * 1000
const CONFIGS = [
  { file: 'config.windows.json', python: 'python' },
  { file: 'config.macos.json', python: 'python3' },
]

/** Finds this machine's portfolio.py and the python to run it with, or explains why not. */
export async function locate($: EngineInterface): Promise<{ script: string; dir: string; python: string } | string> {
  const home = (await $.env.get('USERPROFILE')) ?? (await $.env.get('HOME'))
  if (!home) return 'no home directory'
  for (const c of CONFIGS) {
    const path = `${home}/.claude/skills/_shared/${c.file}`
    let cfg: { portfolio_json?: string }
    try {
      cfg = JSON.parse(await $.fs.read(path))
    } catch {
      continue
    }
    const registry = cfg.portfolio_json?.replace(/\\/g, '/')
    if (!registry) continue
    const dir = registry.slice(0, registry.lastIndexOf('/'))
    if (!(await $.fs.exists(`${dir}/portfolio.py`))) continue // the other machine's config
    return { script: `${dir}/portfolio.py`, dir, python: c.python }
  }
  return 'no portfolio_json in skills/_shared/config.*.json that exists on this machine'
}

/** Runs slate-check. A check that cannot run is reported as DUE, never OK (slate.py's own rule). */
export async function check($: EngineInterface): Promise<Slate> {
  const where = await locate($)
  const fail = (message: string): Slate => ({
    status: 'DUE', enabled: true, active: 0, cap: null, problems: [{ level: 'DUE', message: `slate check could not run: ${message}` }],
  })
  if (typeof where === 'string') return fail(where)
  try {
    const { exitCode, stdout, stderr } = await $.process.run(
      [where.python, where.script, 'slate-check', '--json'], { cwd: where.dir, timeoutMs: 30_000 })
    if (exitCode !== 0) return fail((stderr || `exit ${exitCode}`).trim().slice(0, 200))
    return JSON.parse(stdout) as Slate
  } catch (err) {
    return fail(String(err).slice(0, 200))
  }
}

export function line(s: Slate): string {
  if (!s.enabled) return 'slate: off'
  const n = s.problems.length
  return `slate: ${s.status} · ${s.active}/${s.cap ?? '?'} active${n ? ` · ${n} to do` : ''}`
}

export function report(s: Slate): string {
  const rows = s.problems.map(p => `- **${p.level}** ${p.project ? `${p.project}: ` : ''}${p.message}`)
  return [`**${line(s)}**`, '', ...(rows.length ? rows : ['Nothing due.'])].join('\n')
}

// Last status line shown; a module variable, so a reload starts it over (and may toast once).
let last = ''

async function refresh($: EngineInterface, announce: boolean): Promise<Slate> {
  const s = await check($)
  const text = line(s)
  $.ui.status(text)
  // Toast only when the state changes, so a 30-minute refresh is not a 30-minute nag.
  if (announce && s.status !== 'OK' && text !== last) $.ui.toast(`${text} — /slate for details`)
  last = text
  return s
}

export const register: Register = on => {
  on('session.start', async ($, e, next) => {
    await $.command.register({ name: 'slate', description: 'Show the job-lane slate and what is due' })
    void refresh($, true)
    $.clock.every(REFRESH_MS, () => refresh($, true))
    return next(e)
  })

  on('command.run', { command: 'slate' }, async $ => {
    return { text: report(await refresh($, false)) }
  })
}
