{"parentUuid":"5bc8aee3-4288-483b-996c-444d6bdcb575","isSidechain":false,"attachment":{"type":"hook_non_blocking_error","hookName":"PreToolUse:Bash","toolUseID":"toolu_01DmqBDYvNt1TmnWL448AqxG","hookEvent":"PreToolUse","stderr":"Failed with non-blocking status code: /usr/bin/bash: line 1: /Users/kristinarash/.local/bin/dcg: No such file or directory","stdout":"","exitCode":127,"command":"/Users/kristinarash/.local/bin/dcg","durationMs":112},"type":"attachment","uuid":"76d9fdf0-7918-42d9-9f03-ae699f3ec481","timestamp":"2026-10-06T20:42:30.355Z","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
{"parentUuid":"eb8570f2-be81-4e5a-a4d2-34e455bbc07d","isSidechain":false,"promptId":"b9492239-3e1e-4c1a-81f1-01c3172a67db","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DmqBDYvNt1TmnWL448AqxG","type":"tool_result","content":"   93 test_load.py\n  314 make_self_service.py\n  284 check_workbook.py\n  691 total\n\"\"\"Test a self-service (014-016 layout) workbook against a set of leaderboard\nexport folders, the way Anthony will: stage the CSVs into one flat folder, point\nUPDATE DATA at it, Data > Refresh All, then report LOAD STATUS and the board.\n\nWorks on a copy (--out, never overwritten); the numbered workbook is untouched.\nExcel COM only.\n\nUsage:\n  uv run --with pywin32 python scripts/test_load.py --workbook \"<016>.xlsx\" ^\n      --exports \"<Drive>/_exports/2026_asof_2026-09-29/fbs\" \"<Drive>/_exports/2026_asof_2026-09-29/fcs_g6\" ^\n      --stage \"<scratch>/load_2026\" --out \"<scratch>/016_2026_test_load.xlsx\"\n\"\"\"\n\nimport argparse\nimport shutil\nimport time\nfrom pathlib import Path\n\nFIRST_ROW = 5  # data starts on row 5 of PORTAL INPUT and REVIEW BOARD\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    ap.add_argument(\"--workbook\", required=True)\n    ap.add_argument(\"--exports\", nargs=\"+\", required=True, help=\"folders of leaderboard CSVs\")\n    ap.add_argument(\"--stage\", required=True, help=\"new local folder the CSVs are copied into\")\n    ap.add_argument(\"--out\", required=True, help=\"test copy of the workbook (must not exist)\")\n    ap.add_argument(\"--min-elig\", type=int, default=1)\n    args = ap.parse_args()\n\n    stage, out = Path(args.stage), Path(args.out)\n    if out.exists():\n        raise SystemExit(f\"Refusing to overwrite {out}\")\n    stage.mkdir(parents=True, exist_ok=False)\n    n = 0\n    for folder in args.exports:\n        for f in sorted(Path(folder).glob(\"*.csv\")):\n            shutil.copy2(f, stage / f.name)\n            n += 1\n    print(f\"staged {n} CSVs in {stage}\")\n    shutil.copy2(args.workbook, out)\n\n    import win32com.client\n    xl = win32com.client.DispatchEx(\"Excel.Application\")\n    xl.Visible = False\n    xl.DisplayAlerts = False\n    try:\n        wb = xl.Workbooks.Open(str(out))\n        ud = wb.Worksheets(\"UPDATE DATA\")\n        wb.Names(\"LoadFolder\").RefersToRange.Value = str(stage)\n        wb.Names(\"LoadMinElig\").RefersToRange.Value = args.min_elig\n        t0 = time.time()\n        wb.RefreshAll()\n        xl.CalculateUntilAsyncQueriesDone()\n        xl.Calculate()\n        print(f\"Refresh All: {time.time() - t0:.0f} s\")\n\n        for i in range(1, ud.ListObjects.Count + 1):  # the LOAD STATUS table (its Excel name varies)\n            st = ud.ListObjects(i)\n            print(f\"LOAD STATUS ({st.Name}):\")\n            hdr = [c.Value for c in st.HeaderRowRange.Cells]\n            for row in st.DataBodyRange.Value:\n                print(\"  \" + \" | \".join(f\"{h}: {v}\" for h, v in zip(hdr, row) if v not in (None, \"\")))\n\n        board = wb.Worksheets(\"REVIEW BOARD\")\n        heads = {board.Cells(4, c).Value: c for c in range(1, 60) if board.Cells(4, c).Value}\n        last = board.Cells(board.Rows.Count, 1).End(-4162).Row  # xlUp\n        rows = max(0, last - FIRST_ROW + 1)\n\n        def col(name):\n            c = heads[name]\n            v = board.Range(board.Cells(FIRST_ROW, c), board.Cells(last, c)).Value\n            return [x[0] for x in v]\n\n        review, sample = col(\"REVIEW?\"), col(\"Sample\")\n        errors = sum(1 for x in review if isinstance(x, int) and x < 0)  # COM returns error codes as ints\n        players = sum(1 for x in col(board.Cells(4, 1).Value) if x not in (None, \"\"))\n        rv = sum(1 for x in review if x == \"Y\")\n        rv_ok = sum(1 for x, s in zip(review, sample) if x == \"Y\" and s == \"OK\")\n        print(f\"REVIEW BOARD: {players} players (rows to {last}), REVIEW {rv}, REVIEW with Sample OK {rv_ok}, \"\n              f\"formula errors {errors}\")\n        inp = wb.Worksheets(\"PORTAL INPUT\")\n        pl = inp.Cells(inp.Rows.Count, 1).End(-4162).Row\n        print(f\"PORTAL INPUT: last row {pl} ({pl - FIRST_ROW + 1} rows)\")\n        wb.Save()\n        wb.Close(False)\n    finally:\n        xl.Quit()\n    print(f\"saved {out}\")\n\n\nif __name__ == \"__main__\":\n    main()\nShell cwd was reset to G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","is_error":false}]},"uuid":"e7224bdf-2a9b-477c-9a71-07c6e6342a95","timestamp":"2026-10-06T20:42:32.126Z","toolUseResult":{"stdout":"   93 test_load.py\n  314 make_self_service.py\n  284 check_workbook.py\n  691 total\n\"\"\"Test a self-service (014-016 layout) workbook against a set of leaderboard\nexport folders, the way Anthony will: stage the CSVs into one flat folder, point\nUPDATE DATA at it, Data > Refresh All, then report LOAD STATUS and the board.\n\nWorks on a copy (--out, never overwritten); the numbered workbook is untouched.\nExcel COM only.\n\nUsage:\n  uv run --with pywin32 python scripts/test_load.py --workbook \"<016>.xlsx\" ^\n      --exports \"<Drive>/_exports/2026_asof_2026-09-29/fbs\" \"<Drive>/_exports/2026_asof_2026-09-29/fcs_g6\" ^\n      --stage \"<scratch>/load_2026\" --out \"<scratch>/016_2026_test_load.xlsx\"\n\"\"\"\n\nimport argparse\nimport shutil\nimport time\nfrom pathlib import Path\n\nFIRST_ROW = 5  # data starts on row 5 of PORTAL INPUT and REVIEW BOARD\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    ap.add_argument(\"--workbook\", required=True)\n    ap.add_argument(\"--exports\", nargs=\"+\", required=True, help=\"folders of leaderboard CSVs\")\n    ap.add_argument(\"--stage\", required=True, help=\"new local folder the CSVs are copied into\")\n    ap.add_argument(\"--out\", required=True, help=\"test copy of the workbook (must not exist)\")\n    ap.add_argument(\"--min-elig\", type=int, default=1)\n    args = ap.parse_args()\n\n    stage, out = Path(args.stage), Path(args.out)\n    if out.exists():\n        raise SystemExit(f\"Refusing to overwrite {out}\")\n    stage.mkdir(parents=True, exist_ok=False)\n    n = 0\n    for folder in args.exports:\n        for f in sorted(Path(folder).glob(\"*.csv\")):\n            shutil.copy2(f, stage / f.name)\n            n += 1\n    print(f\"staged {n} CSVs in {stage}\")\n    shutil.copy2(args.workbook, out)\n\n    import win32com.client\n    xl = win32com.client.DispatchEx(\"Excel.Application\")\n    xl.Visible = False\n    xl.DisplayAlerts = False\n    try:\n        wb = xl.Workbooks.Open(str(out))\n        ud = wb.Worksheets(\"UPDATE DATA\")\n        wb.Names(\"LoadFolder\").RefersToRange.Value = str(stage)\n        wb.Names(\"LoadMinElig\").RefersToRange.Value = args.min_elig\n        t0 = time.time()\n        wb.RefreshAll()\n        xl.CalculateUntilAsyncQueriesDone()\n        xl.Calculate()\n        print(f\"Refresh All: {time.time() - t0:.0f} s\")\n\n        for i in range(1, ud.ListObjects.Count + 1):  # the LOAD STATUS table (its Excel name varies)\n            st = ud.ListObjects(i)\n            print(f\"LOAD STATUS ({st.Name}):\")\n            hdr = [c.Value for c in st.HeaderRowRange.Cells]\n            for row in st.DataBodyRange.Value:\n                print(\"  \" + \" | \".join(f\"{h}: {v}\" for h, v in zip(hdr, row) if v not in (None, \"\")))\n\n        board = wb.Worksheets(\"REVIEW BOARD\")\n        heads = {board.Cells(4, c).Value: c for c in range(1, 60) if board.Cells(4, c).Value}\n        last = board.Cells(board.Rows.Count, 1).End(-4162).Row  # xlUp\n        rows = max(0, last - FIRST_ROW + 1)\n\n        def col(name):\n            c = heads[name]\n            v = board.Range(board.Cells(FIRST_ROW, c), board.Cells(last, c)).Value\n            return [x[0] for x in v]\n\n        review, sample = col(\"REVIEW?\"), col(\"Sample\")\n        errors = sum(1 for x in review if isinstance(x, int) and x < 0)  # COM returns error codes as ints\n        players = sum(1 for x in col(board.Cells(4, 1).Value) if x not in (None, \"\"))\n        rv = sum(1 for x in review if x == \"Y\")\n        rv_ok = sum(1 for x, s in zip(review, sample) if x == \"Y\" and s == \"OK\")\n        print(f\"REVIEW BOARD: {players} players (rows to {last}), REVIEW {rv}, REVIEW with Sample OK {rv_ok}, \"\n              f\"formula errors {errors}\")\n        inp = wb.Worksheets(\"PORTAL INPUT\")\n        pl = inp.Cells(inp.Rows.Count, 1).End(-4162).Row\n        print(f\"PORTAL INPUT: last row {pl} ({pl - FIRST_ROW + 1} rows)\")\n        wb.Save()\n        wb.Close(False)\n    finally:\n        xl.Quit()\n    print(f\"saved {out}\")\n\n\nif __name__ == \"__main__\":\n    main()","stderr":"\nShell cwd was reset to G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"eb8570f2-be81-4e5a-a4d2-34e455bbc07d","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
{"parentUuid":"e7224bdf-2a9b-477c-9a71-07c6e6342a95","isSidechain":false,"attachment":{"type":"hook_non_blocking_error","hookName":"PreToolUse:Bash","toolUseID":"toolu_01PjjuQSXq7qbtSgWJGjzmNe","hookEvent":"PreToolUse","stderr":"Failed with non-blocking status code: /usr/bin/bash: line 1: /Users/kristinarash/.local/bin/dcg: No such file or directory","stdout":"","exitCode":127,"command":"/Users/kristinarash/.local/bin/dcg","durationMs":166},"type":"attachment","uuid":"7f2a3294-fbe2-4a43-9f8b-82c21ae3b666","timestamp":"2026-10-06T20:42:31.192Z","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
{"parentUuid":"5bc8aee3-4288-483b-996c-444d6bdcb575","isSidechain":false,"promptId":"b9492239-3e1e-4c1a-81f1-01c3172a67db","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PjjuQSXq7qbtSgWJGjzmNe","type":"tool_result","content":"  if (more.length) { more[more.length - 1].setAttribute('data-tp', 'more'); out.more = true; }\n  return out;\n}\n\"\"\"\n\nPROBE_JS = r\"\"\"\n() => ({\n  inputs: [...document.querySelectorAll('input')].filter(i => i.offsetParent !== null)\n            .map(i => ({value: i.value, placeholder: i.placeholder, cls: i.className.slice(0, 80)})),\n  buttons: [...document.querySelectorAll('button')].filter(b => b.offsetParent !== null)\n            .map(b => ({text: b.textContent.trim().slice(0, 40), aria: b.getAttribute('aria-label'), title: b.title}))\n            .filter(b => b.text || b.aria || b.title).slice(0, 60),\n  tabs: [...document.querySelectorAll('[role=tab], a')].map(t => t.textContent.trim()).filter(t => /Traits|Advanced|Boxscore/.test(t)),\n  hidden: document.hidden, url: location.href,\n})\n\"\"\"\n\n\nclass PullError(RuntimeError):\n    pass\n\n\ndef settle(page, seconds=2.5):\n    # Telemetry keeps connections open, so \"networkidle\" rarely fires; cap it short.\n    try:\n        page.wait_for_load_state(\"networkidle\", timeout=5000)\n    except Exception:\n        pass\n    time.sleep(seconds)\n\n\ndef logged_in(page):\n    \"\"\"Leaderboard controls present and no password field on the page.\"\"\"\n    for _ in range(20):\n        if page.locator(\"input[type=password]\").count():\n            return False\n        if tag(page).get(\"group\"):\n            return True\n        time.sleep(1)\n    return False\n\n\ndef tag(page):\n    return page.evaluate(TAG_JS)\n\n\ndef pick_option(page, name):\n    \"\"\"Click the dropdown option whose text is exactly `name`.\"\"\"\n    opt = page.get_by_role(\"option\", name=name, exact=True)\n    if opt.count() == 0:\n        opt = page.locator(\"[role=option]\", has_text=re.compile(rf\"^\\s*{re.escape(name)}\\s*$\"))\n    if opt.count() == 0:\n        raise PullError(f\"option not found: {name!r}\")\n    opt.first.scroll_into_view_if_needed()\n    opt.first.click()\n\n\ndef set_select(page, which, value):\n    state = tag(page)\n    if state.get(which) == value:\n        return\n    box = page.locator(f\"[data-tp={which}]\")\n    if box.count() == 0:\n        raise PullError(f\"{which} box not found (run --probe)\")\n    box.first.click()\n    box.first.fill(\"\")\n    box.first.type(value, delay=30)\n    time.sleep(0.8)\n    pick_option(page, value)\n    settle(page)\n    got = tag(page).get(which)\n    if got != value:\n        raise PullError(f\"{which} reads {got!r} after selecting {value!r}\")\n\n\ndef set_scope(page, scopes):\n    \"\"\"Leave exactly the chips in `scopes` (a list, e.g. [\"FCS\", \"Group of Six\"]).\"\"\"\n    want = set(scopes)\n    if set(tag(page).get(\"scopes\", [])) == want:\n        return\n    box = page.locator(\"[data-tp=scope]\")\n    if box.count() == 0:\n        raise PullError(\"scope box not found (run --probe)\")\n    # One wanted scope at a time: add it, then remove the unwanted chips. The page\n    # will not remove its last chip, and with three or more chips it collapses them\n    # into one \"3 selected\" label that has no per-chip x button.\n    for scope in scopes:\n        if scope not in tag(page).get(\"scopes\", []):\n            box.first.click()\n            time.sleep(0.8)\n            box.first.type(scope, delay=30)\n            time.sleep(0.8)\n            pick_option(page, scope)\n            page.keyboard.press(\"Escape\")\n            settle(page)\n        # Remove every other chip with its own x button (\"Clear\" does not remove\n        # Power Four, and the options carry no selected attribute to untick by).\n        for _ in range(8):\n            extra = [n for n in tag(page).get(\"scopes\", []) if n not in want]\n            if not extra:\n                break\n            chip = page.locator('[class*=\"Pill-root\"]', has=page.locator('[class*=\"Pill-label\"]', has_text=re.compile(rf\"^\\s*{re.escape(extra[0])}\\s*$\")))\n            remove = chip.first.locator(\"button\")\n            if remove.count() == 0:\n                raise PullError(f\"no remove button on scope chip {extra[0]!r}\")\n            remove.first.click()\n            time.sleep(0.6)\n    settle(page)\n    got = tag(page).get(\"scopes\", [])\n    if set(got) != want or len(got) != len(want):\n        raise PullError(f\"scope reads {got} after selecting {scopes}\")\n\n\n# Keeps the CSV the page builds for \"Download CSV\" and stops it reaching Chrome's\n# download manager, which crashed the browser a few seconds after each download on\n# this machine (Crashpad dumps 2026-09-29). Only the page's own export blob is read.\nCAPTURE_JS = r\"\"\"\n() => {\n  if (window.__tpHook) { window.__tpBlobs = []; return; }\n  window.__tpHook = true; window.__tpBlobs = [];\n  const make = URL.createObjectURL.bind(URL);\n  URL.createObjectURL = (obj) => { if (obj instanceof Blob) window.__tpBlobs.push(obj); return make(obj); };\n  const isExport = (a) => a && a.hasAttribute && a.hasAttribute('download') && (a.href || '').startsWith('blob:');\n  const click = HTMLAnchorElement.prototype.click;\n  HTMLAnchorElement.prototype.click = function () { if (isExport(this)) return; return click.apply(this, arguments); };\n  document.addEventListener('click', (e) => { const a = e.target.closest && e.target.closest('a'); if (isExport(a)) e.preventDefault(); }, true);\n}\n\"\"\"\n\n\ndef download_csv(page, dest):\n    tag(page)\n    page.evaluate(CAPTURE_JS)\n    more = page.locator(\"[data-tp=more]\")\n    if more.count() == 0:\n        more = page.get_by_role(\"button\", name=re.compile(\"more options\", re.I))\n    if more.count() == 0:\n        raise PullError(\"More options button not found (run --probe)\")\n    more.last.click()\n    time.sleep(0.8)\n    item = page.get_by_role(\"menuitem\", name=re.compile(\"download csv\", re.I))\n    if item.count() == 0:\n        item = page.get_by_text(re.compile(r\"^\\s*Download CSV\\s*$\", re.I))\n    item.first.click()\n    deadline = time.time() + 60\n    while time.time() < deadline:\n        # Raw bytes (base64), not blob.text(), which would drop the UTF-8 BOM the export carries.\n        b64 = page.evaluate(\"\"\"async () => {\n            if (!window.__tpBlobs.length) return null;\n            const bytes = new Uint8Array(await window.__tpBlobs[window.__tpBlobs.length - 1].arrayBuffer());\n            let s = ''; for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode(...bytes.subarray(i, i + 0x8000));\n            return btoa(s);\n        }\"\"\")\n        if b64 is not None:\n            Path(dest).write_bytes(base64.b64decode(b64))\n            page.keyboard.press(\"Escape\")  # the menu stays open when the download is held back\n            time.sleep(0.5)\n            return\n        time.sleep(0.5)\n    raise PullError(\"Download CSV produced no file within 60 s\")\n\n\ndef check_file(path, tab_key, group, previous_bytes):\n    raw = Path(path).read_bytes()\n    if previous_bytes is not None and raw == previous_bytes:\n        raise PullError(\"file is identical to the previous download (table did not refresh)\")\n    rows = list(csv.DictReader(io.StringIO(raw.decode(\"utf-8-sig\"))))\n    if not rows:\n        raise PullError(\"CSV has no rows (table empty when downloaded)\")\n    is_adv = \"Player Impact\" in rows[0]\n    if is_adv != (tab_key == \"advanced\"):\n        raise PullError(f\"expected {tab_key} but header says {'advanced' if is_adv else 'traits'}\")\n    codes = Counter(r.get(\"Pos.\", \"\") for r in rows)\n    expected = GROUPS[group][1]\n    share = sum(n for c, n in codes.items() if c in expected) / len(rows)\n    if share < 0.9:\n        raise PullError(f\"only {share:.0%} of rows carry {group} codes: {codes.most_common(4)}\")\n    snaps = [int(r[\"Snaps\"]) for r in rows if (r.get(\"Snaps\") or \"\").isdigit()]\n    return {\"rows\": len(rows), \"teams\": len({r.get('Team') for r in rows}),\n            \"max_snaps\": max(snaps) if snaps else None, \"pos_codes\": dict(codes.most_common(5))}, raw\n\n\ndef launch(profile):\n    from playwright.sync_api import sync_playwright\n    pw = sync_playwright().start()\n    # Own download folder: with the default (the user's Downloads) Chrome crashed\n    # mid-download on this machine (Crashpad dumps name Downloads\\desktop.ini).\n    downloads = Path(profile).parent / \"downloads\"\n    downloads.mkdir(parents=True, exist_ok=True)\n    ctx = pw.chromium.launch_persistent_context(\n        str(profile), channel=\"chrome\", headless=False, accept_downloads=True,\n        downloads_path=str(downloads), viewport={\"width\": 1400, \"height\": 950})\n    page = ctx.pages[0] if ctx.pages else ctx.new_page()\n    return pw, ctx, page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    ap.add_argument(\"--season\", type=int)\n    ap.add_argument(\"--scope\", default=\"FBS\", help='scope option(s) as named in Telemetry, comma-separated: \"FBS\", \"FCS,Group of Six\"')\n    ap.add_argument(\"--tag\", help=\"scope tag in file names (default from --scope; 2025 used fcs-g6)\")\n    ap.add_argument(\"--out\", help=\"folder for the CSVs (created; existing files are never overwritten)\")\n    ap.add_argument(\"--groups\", nargs=\"*\", default=list(GROUPS), choices=list(GROUPS))\n    ap.add_argument(\"--tabs\", nargs=\"*\", default=[\"traits\", \"advanced\"], choices=list(TABS))\n    ap.add_argument(\"--profile\", default=str(DEFAULT_PROFILE))\n    ap.add_argument(\"--login\", action=\"store_true\", help=\"open Telemetry to log in once, then exit\")\n    ap.add_argument(\"--probe\", action=\"store_true\", help=\"print the page's controls and exit\")\n    args = ap.parse_args()\n\n    profile = Path(args.profile)\n    profile.mkdir(parents=True, exist_ok=True)\n    pw, ctx, page = launch(profile)\n    try:\n        page.goto(URL.format(tab=\"player-traits\"), wait_until=\"domcontentloaded\", timeout=60000)\n        settle(page, 4)\n        if args.login:\n            print(\"Log in to Telemetry in the Chrome window that just opened (you type the password).\",\n                  \"Waiting up to 10 minutes for the leaderboard to appear...\", flush=True)\n            deadline = time.time() + 600\n            while time.time() < deadline:\n                try:\n                    if \"leaderboard\" not in page.url:\n                        time.sleep(3)\n                        continue\n                    if tag(page).get(\"group\") and not page.locator(\"input[type=password]\").count():\n                        time.sleep(3)  # let the session cookies settle before closing\n                        print(\"Logged in. Saved to the tool profile; later runs reuse it.\")\n                        return\n                except Exception:\n                    pass  # page navigating during login\n                time.sleep(3)\n            sys.exit(\"Timed out waiting for login.\")\n        print(\"Telemetry opened; checking login...\", flush=True)\n        ok = logged_in(page)\n        if args.probe:\n            print(\"logged in:\", ok)\n            print(json.dumps(page.evaluate(PROBE_JS), indent=2))\n            print(json.dumps(tag(page), indent=2))\n            return\n        if not ok:\n            sys.exit(\"Not logged in (or the leaderboard did not load). Run with --login first.\")\n        if not (args.season and args.out):\n            sys.exit(\"--season and --out are required\")\n\n        out = Path(args.out)\n        out.mkdir(parents=True, exist_ok=True)\n        scopes = [x.strip() for x in args.scope.split(\",\") if x.strip()]\n        scope_tag = args.tag or \"-\".join(re.sub(r\"[^a-z0-9]+\", \"-\", x.lower()).strip(\"-\") for x in scopes)\n        manifest = {\"season\": args.season, \"scope\": args.scope, \"started\": time.strftime(\"%Y-%m-%d %H:%M\"),\n                    \"files\": {}, \"failed\": {}}\n        for tab_key in args.tabs:\n            slug, label = TABS[tab_key]\n            page.goto(URL.format(tab=slug), wait_until=\"domcontentloaded\", timeout=60000)  # resets filters\n            settle(page, 4)\n            set_scope(page, scopes)\n            set_select(page, \"season\", str(args.season))\n            previous = None\n            for group in args.groups:\n                name = f\"{args.season}_{scope_tag}_{GROUPS[group][0]}_{slug}.csv\"\n                dest = out / name\n                if dest.exists():\n                    print(f\"skip  {name} (exists)\")\n                    continue\n                for attempt in (1, 2):\n                    try:\n                        set_select(page, \"group\", f\"{group} {label}\")\n                        state = tag(page)\n                        if state.get(\"season\") != str(args.season) or set(state.get(\"scopes\", [])) != set(scopes):\n                            raise PullError(f\"filters drifted: {state}\")\n                        tmp = out / (name + \".part\")\n                        download_csv(page, tmp)\n                        info, previous = check_file(tmp, tab_key, group, previous)\n                        tmp.rename(dest)\n                        manifest[\"files\"][name] = info\n                        print(f\"ok    {name}: {info['rows']} rows, {info['teams']} teams, top snaps {info['max_snaps']}\")\n                        break\n                    except Exception as e:\n                        for p in out.glob(name + \".part\"):\n                            p.unlink()\n                        if attempt == 2:\n                            manifest[\"failed\"][name] = str(e)\n                            print(f\"FAIL  {name}: {e}\")\n                        else:\n                            print(f\"retry {name}: {e}\")\n                            page.keyboard.press(\"Escape\")\n                            settle(page)\n        manifest[\"finished\"] = time.strftime(\"%Y-%m-%d %H:%M\")\n        mpath = out / f\"manifest_{args.season}_{scope_tag}.json\"\n        if mpath.exists():  # a rerun that skipped existing files keeps their entries\n            earlier = json.loads(mpath.read_text(encoding=\"utf-8\"))\n            manifest[\"files\"] = {**earlier.get(\"files\", {}), **manifest[\"files\"]}\n            manifest[\"started\"] = earlier.get(\"started\", manifest[\"started\"])\n            for name in manifest[\"files\"]:\n                manifest[\"failed\"].pop(name, None)\n        mpath.write_text(json.dumps(manifest, indent=2), encoding=\"utf-8\")\n        teams = {i[\"teams\"] for i in manifest[\"files\"].values()}\n        print(f\"\\n{len(manifest['files'])} files, {len(manifest['failed'])} failed. Teams per file: {sorted(teams)}. \"\n              f\"Manifest: {mpath}\")\n        if manifest[\"failed\"]:\n            sys.exit(1)\n    finally:\n        ctx.close()\n        pw.stop()\n\n\nif __name__ == \"__main__\":\n    main()\nShell cwd was reset to G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","is_error":false}]},"uuid":"cdd28205-c66d-4b42-9d22-8e01e7e4b447","timestamp":"2026-10-06T20:42:32.399Z","toolUseResult":{"stdout":"  if (more.length) { more[more.length - 1].setAttribute('data-tp', 'more'); out.more = true; }\n  return out;\n}\n\"\"\"\n\nPROBE_JS = r\"\"\"\n() => ({\n  inputs: [...document.querySelectorAll('input')].filter(i => i.offsetParent !== null)\n            .map(i => ({value: i.value, placeholder: i.placeholder, cls: i.className.slice(0, 80)})),\n  buttons: [...document.querySelectorAll('button')].filter(b => b.offsetParent !== null)\n            .map(b => ({text: b.textContent.trim().slice(0, 40), aria: b.getAttribute('aria-label'), title: b.title}))\n            .filter(b => b.text || b.aria || b.title).slice(0, 60),\n  tabs: [...document.querySelectorAll('[role=tab], a')].map(t => t.textContent.trim()).filter(t => /Traits|Advanced|Boxscore/.test(t)),\n  hidden: document.hidden, url: location.href,\n})\n\"\"\"\n\n\nclass PullError(RuntimeError):\n    pass\n\n\ndef settle(page, seconds=2.5):\n    # Telemetry keeps connections open, so \"networkidle\" rarely fires; cap it short.\n    try:\n        page.wait_for_load_state(\"networkidle\", timeout=5000)\n    except Exception:\n        pass\n    time.sleep(seconds)\n\n\ndef logged_in(page):\n    \"\"\"Leaderboard controls present and no password field on the page.\"\"\"\n    for _ in range(20):\n        if page.locator(\"input[type=password]\").count():\n            return False\n        if tag(page).get(\"group\"):\n            return True\n        time.sleep(1)\n    return False\n\n\ndef tag(page):\n    return page.evaluate(TAG_JS)\n\n\ndef pick_option(page, name):\n    \"\"\"Click the dropdown option whose text is exactly `name`.\"\"\"\n    opt = page.get_by_role(\"option\", name=name, exact=True)\n    if opt.count() == 0:\n        opt = page.locator(\"[role=option]\", has_text=re.compile(rf\"^\\s*{re.escape(name)}\\s*$\"))\n    if opt.count() == 0:\n        raise PullError(f\"option not found: {name!r}\")\n    opt.first.scroll_into_view_if_needed()\n    opt.first.click()\n\n\ndef set_select(page, which, value):\n    state = tag(page)\n    if state.get(which) == value:\n        return\n    box = page.locator(f\"[data-tp={which}]\")\n    if box.count() == 0:\n        raise PullError(f\"{which} box not found (run --probe)\")\n    box.first.click()\n    box.first.fill(\"\")\n    box.first.type(value, delay=30)\n    time.sleep(0.8)\n    pick_option(page, value)\n    settle(page)\n    got = tag(page).get(which)\n    if got != value:\n        raise PullError(f\"{which} reads {got!r} after selecting {value!r}\")\n\n\ndef set_scope(page, scopes):\n    \"\"\"Leave exactly the chips in `scopes` (a list, e.g. [\"FCS\", \"Group of Six\"]).\"\"\"\n    want = set(scopes)\n    if set(tag(page).get(\"scopes\", [])) == want:\n        return\n    box = page.locator(\"[data-tp=scope]\")\n    if box.count() == 0:\n        raise PullError(\"scope box not found (run --probe)\")\n    # One wanted scope at a time: add it, then remove the unwanted chips. The page\n    # will not remove its last chip, and with three or more chips it collapses them\n    # into one \"3 selected\" label that has no per-chip x button.\n    for scope in scopes:\n        if scope not in tag(page).get(\"scopes\", []):\n            box.first.click()\n            time.sleep(0.8)\n            box.first.type(scope, delay=30)\n            time.sleep(0.8)\n            pick_option(page, scope)\n            page.keyboard.press(\"Escape\")\n            settle(page)\n        # Remove every other chip with its own x button (\"Clear\" does not remove\n        # Power Four, and the options carry no selected attribute to untick by).\n        for _ in range(8):\n            extra = [n for n in tag(page).get(\"scopes\", []) if n not in want]\n            if not extra:\n                break\n            chip = page.locator('[class*=\"Pill-root\"]', has=page.locator('[class*=\"Pill-label\"]', has_text=re.compile(rf\"^\\s*{re.escape(extra[0])}\\s*$\")))\n            remove = chip.first.locator(\"button\")\n            if remove.count() == 0:\n                raise PullError(f\"no remove button on scope chip {extra[0]!r}\")\n            remove.first.click()\n            time.sleep(0.6)\n    settle(page)\n    got = tag(page).get(\"scopes\", [])\n    if set(got) != want or len(got) != len(want):\n        raise PullError(f\"scope reads {got} after selecting {scopes}\")\n\n\n# Keeps the CSV the page builds for \"Download CSV\" and stops it reaching Chrome's\n# download manager, which crashed the browser a few seconds after each download on\n# this machine (Crashpad dumps 2026-09-29). Only the page's own export blob is read.\nCAPTURE_JS = r\"\"\"\n() => {\n  if (window.__tpHook) { window.__tpBlobs = []; return; }\n  window.__tpHook = true; window.__tpBlobs = [];\n  const make = URL.createObjectURL.bind(URL);\n  URL.createObjectURL = (obj) => { if (obj instanceof Blob) window.__tpBlobs.push(obj); return make(obj); };\n  const isExport = (a) => a && a.hasAttribute && a.hasAttribute('download') && (a.href || '').startsWith('blob:');\n  const click = HTMLAnchorElement.prototype.click;\n  HTMLAnchorElement.prototype.click = function () { if (isExport(this)) return; return click.apply(this, arguments); };\n  document.addEventListener('click', (e) => { const a = e.target.closest && e.target.closest('a'); if (isExport(a)) e.preventDefault(); }, true);\n}\n\"\"\"\n\n\ndef download_csv(page, dest):\n    tag(page)\n    page.evaluate(CAPTURE_JS)\n    more = page.locator(\"[data-tp=more]\")\n    if more.count() == 0:\n        more = page.get_by_role(\"button\", name=re.compile(\"more options\", re.I))\n    if more.count() == 0:\n        raise PullError(\"More options button not found (run --probe)\")\n    more.last.click()\n    time.sleep(0.8)\n    item = page.get_by_role(\"menuitem\", name=re.compile(\"download csv\", re.I))\n    if item.count() == 0:\n        item = page.get_by_text(re.compile(r\"^\\s*Download CSV\\s*$\", re.I))\n    item.first.click()\n    deadline = time.time() + 60\n    while time.time() < deadline:\n        # Raw bytes (base64), not blob.text(), which would drop the UTF-8 BOM the export carries.\n        b64 = page.evaluate(\"\"\"async () => {\n            if (!window.__tpBlobs.length) return null;\n            const bytes = new Uint8Array(await window.__tpBlobs[window.__tpBlobs.length - 1].arrayBuffer());\n            let s = ''; for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode(...bytes.subarray(i, i + 0x8000));\n            return btoa(s);\n        }\"\"\")\n        if b64 is not None:\n            Path(dest).write_bytes(base64.b64decode(b64))\n            page.keyboard.press(\"Escape\")  # the menu stays open when the download is held back\n            time.sleep(0.5)\n            return\n        time.sleep(0.5)\n    raise PullError(\"Download CSV produced no file within 60 s\")\n\n\ndef check_file(path, tab_key, group, previous_bytes):\n    raw = Path(path).read_bytes()\n    if previous_bytes is not None and raw == previous_bytes:\n        raise PullError(\"file is identical to the previous download (table did not refresh)\")\n    rows = list(csv.DictReader(io.StringIO(raw.decode(\"utf-8-sig\"))))\n    if not rows:\n        raise PullError(\"CSV has no rows (table empty when downloaded)\")\n    is_adv = \"Player Impact\" in rows[0]\n    if is_adv != (tab_key == \"advanced\"):\n        raise PullError(f\"expected {tab_key} but header says {'advanced' if is_adv else 'traits'}\")\n    codes = Counter(r.get(\"Pos.\", \"\") for r in rows)\n    expected = GROUPS[group][1]\n    share = sum(n for c, n in codes.items() if c in expected) / len(rows)\n    if share < 0.9:\n        raise PullError(f\"only {share:.0%} of rows carry {group} codes: {codes.most_common(4)}\")\n    snaps = [int(r[\"Snaps\"]) for r in rows if (r.get(\"Snaps\") or \"\").isdigit()]\n    return {\"rows\": len(rows), \"teams\": len({r.get('Team') for r in rows}),\n            \"max_snaps\": max(snaps) if snaps else None, \"pos_codes\": dict(codes.most_common(5))}, raw\n\n\ndef launch(profile):\n    from playwright.sync_api import sync_playwright\n    pw = sync_playwright().start()\n    # Own download folder: with the default (the user's Downloads) Chrome crashed\n    # mid-download on this machine (Crashpad dumps name Downloads\\desktop.ini).\n    downloads = Path(profile).parent / \"downloads\"\n    downloads.mkdir(parents=True, exist_ok=True)\n    ctx = pw.chromium.launch_persistent_context(\n        str(profile), channel=\"chrome\", headless=False, accept_downloads=True,\n        downloads_path=str(downloads), viewport={\"width\": 1400, \"height\": 950})\n    page = ctx.pages[0] if ctx.pages else ctx.new_page()\n    return pw, ctx, page\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    ap.add_argument(\"--season\", type=int)\n    ap.add_argument(\"--scope\", default=\"FBS\", help='scope option(s) as named in Telemetry, comma-separated: \"FBS\", \"FCS,Group of Six\"')\n    ap.add_argument(\"--tag\", help=\"scope tag in file names (default from --scope; 2025 used fcs-g6)\")\n    ap.add_argument(\"--out\", help=\"folder for the CSVs (created; existing files are never overwritten)\")\n    ap.add_argument(\"--groups\", nargs=\"*\", default=list(GROUPS), choices=list(GROUPS))\n    ap.add_argument(\"--tabs\", nargs=\"*\", default=[\"traits\", \"advanced\"], choices=list(TABS))\n    ap.add_argument(\"--profile\", default=str(DEFAULT_PROFILE))\n    ap.add_argument(\"--login\", action=\"store_true\", help=\"open Telemetry to log in once, then exit\")\n    ap.add_argument(\"--probe\", action=\"store_true\", help=\"print the page's controls and exit\")\n    args = ap.parse_args()\n\n    profile = Path(args.profile)\n    profile.mkdir(parents=True, exist_ok=True)\n    pw, ctx, page = launch(profile)\n    try:\n        page.goto(URL.format(tab=\"player-traits\"), wait_until=\"domcontentloaded\", timeout=60000)\n        settle(page, 4)\n        if args.login:\n            print(\"Log in to Telemetry in the Chrome window that just opened (you type the password).\",\n                  \"Waiting up to 10 minutes for the leaderboard to appear...\", flush=True)\n            deadline = time.time() + 600\n            while time.time() < deadline:\n                try:\n                    if \"leaderboard\" not in page.url:\n                        time.sleep(3)\n                        continue\n                    if tag(page).get(\"group\") and not page.locator(\"input[type=password]\").count():\n                        time.sleep(3)  # let the session cookies settle before closing\n                        print(\"Logged in. Saved to the tool profile; later runs reuse it.\")\n                        return\n                except Exception:\n                    pass  # page navigating during login\n                time.sleep(3)\n            sys.exit(\"Timed out waiting for login.\")\n        print(\"Telemetry opened; checking login...\", flush=True)\n        ok = logged_in(page)\n        if args.probe:\n            print(\"logged in:\", ok)\n            print(json.dumps(page.evaluate(PROBE_JS), indent=2))\n            print(json.dumps(tag(page), indent=2))\n            return\n        if not ok:\n            sys.exit(\"Not logged in (or the leaderboard did not load). Run with --login first.\")\n        if not (args.season and args.out):\n            sys.exit(\"--season and --out are required\")\n\n        out = Path(args.out)\n        out.mkdir(parents=True, exist_ok=True)\n        scopes = [x.strip() for x in args.scope.split(\",\") if x.strip()]\n        scope_tag = args.tag or \"-\".join(re.sub(r\"[^a-z0-9]+\", \"-\", x.lower()).strip(\"-\") for x in scopes)\n        manifest = {\"season\": args.season, \"scope\": args.scope, \"started\": time.strftime(\"%Y-%m-%d %H:%M\"),\n                    \"files\": {}, \"failed\": {}}\n        for tab_key in args.tabs:\n            slug, label = TABS[tab_key]\n            page.goto(URL.format(tab=slug), wait_until=\"domcontentloaded\", timeout=60000)  # resets filters\n            settle(page, 4)\n            set_scope(page, scopes)\n            set_select(page, \"season\", str(args.season))\n            previous = None\n            for group in args.groups:\n                name = f\"{args.season}_{scope_tag}_{GROUPS[group][0]}_{slug}.csv\"\n                dest = out / name\n                if dest.exists():\n                    print(f\"skip  {name} (exists)\")\n                    continue\n                for attempt in (1, 2):\n                    try:\n                        set_select(page, \"group\", f\"{group} {label}\")\n                        state = tag(page)\n                        if state.get(\"season\") != str(args.season) or set(state.get(\"scopes\", [])) != set(scopes):\n                            raise PullError(f\"filters drifted: {state}\")\n                        tmp = out / (name + \".part\")\n                        download_csv(page, tmp)\n                        info, previous = check_file(tmp, tab_key, group, previous)\n                        tmp.rename(dest)\n                        manifest[\"files\"][name] = info\n                        print(f\"ok    {name}: {info['rows']} rows, {info['teams']} teams, top snaps {info['max_snaps']}\")\n                        break\n                    except Exception as e:\n                        for p in out.glob(name + \".part\"):\n                            p.unlink()\n                        if attempt == 2:\n                            manifest[\"failed\"][name] = str(e)\n                            print(f\"FAIL  {name}: {e}\")\n                        else:\n                            print(f\"retry {name}: {e}\")\n                            page.keyboard.press(\"Escape\")\n                            settle(page)\n        manifest[\"finished\"] = time.strftime(\"%Y-%m-%d %H:%M\")\n        mpath = out / f\"manifest_{args.season}_{scope_tag}.json\"\n        if mpath.exists():  # a rerun that skipped existing files keeps their entries\n            earlier = json.loads(mpath.read_text(encoding=\"utf-8\"))\n            manifest[\"files\"] = {**earlier.get(\"files\", {}), **manifest[\"files\"]}\n            manifest[\"started\"] = earlier.get(\"started\", manifest[\"started\"])\n            for name in manifest[\"files\"]:\n                manifest[\"failed\"].pop(name, None)\n        mpath.write_text(json.dumps(manifest, indent=2), encoding=\"utf-8\")\n        teams = {i[\"teams\"] for i in manifest[\"files\"].values()}\n        print(f\"\\n{len(manifest['files'])} files, {len(manifest['failed'])} failed. Teams per file: {sorted(teams)}. \"\n              f\"Manifest: {mpath}\")\n        if manifest[\"failed\"]:\n            sys.exit(1)\n    finally:\n        ctx.close()\n        pw.stop()\n\n\nif __name__ == \"__main__\":\n    main()","stderr":"\nShell cwd was reset to G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"5bc8aee3-4288-483b-996c-444d6bdcb575","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
