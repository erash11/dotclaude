xit $?\"; for d in 2026_asof_2026-09-29/fbs 2026_asof_2026-09-29/fcs_g6 2025_baseline/fbs 2025_baseline/fcs_g6 2024_baseline/fbs 2023_baseline/fbs; do $U run --no-project python scripts/check_exports.py \"$D/_exports/$d\" | tail -3; echo \"exit $? $d\"; done","description":"Run the new check on the bad dump and all good export sets"}},"apiBlockIndex":3,"requestId":"req_011Cfmdh4auJZY5vJ3kgoU6X","type":"assistant","uuid":"7b0e303e-1a05-4363-ba5c-09a6371848b6","timestamp":"2026-10-06T20:43:33.996Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
{"parentUuid":"c3dbf816-f8d9-426e-baae-d124fcc4efa2","isSidechain":false,"promptId":"b9492239-3e1e-4c1a-81f1-01c3172a67db","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017tquE9PSSKBL9MCbJg4hcG","type":"tool_result","content":"File created successfully at: C:\\Users\\eric_rash\\Desktop\\DEV\\PP_Recruiting\\scripts\\check_exports.py (file state is current in your context — no need to Read it back)"}]},"uuid":"d4078dc1-ea9f-48f1-a612-6f22405dc750","timestamp":"2026-10-06T20:43:36.300Z","toolUseResult":{"type":"create","filePath":"C:\\Users\\eric_rash\\Desktop\\DEV\\PP_Recruiting\\scripts\\check_exports.py","content":"\"\"\"check-exports: check Telemetry leaderboard CSVs before they are loaded.\n\nCatches the two ways a hand-made export goes wrong (both seen 2026-10-06):\n- Columns missing because they were switched off in the leaderboard view.\n  Download CSV writes only the columns on screen, so a hidden Elig. or Tackle\n  Breaking simply is not in the file, and the load cannot notice.\n- The file was opened and saved in Excel, which turns Height \"6-0\" into a date\n  (\"Jun-00\"). The loader cannot read those heights.\n\nEach file's position group comes from its Pos. codes (not the file name, which a\nperson may get wrong), its tab (Player Traits or Advanced Stats) from its\nheader. Every required column is listed in EXPECTED; the headers were identical\nin every 2023-2026 FBS and FCS / G6 export (checked 2026-10-06).\n\nThe same check runs inside telemetry_pull.py on every download and, in the\nworkbook (019 on), on LOAD STATUS (scripts/powerquery/Stage.m). Keep the three\nin step.\n\nUsage (from the repo root):\n  uv run python scripts/check_exports.py \"<folder of CSVs>\" [more folders or files]\nExit code 1 if any file has a problem.\n\"\"\"\n\nimport csv\nimport io\nimport re\nimport sys\nfrom collections import Counter\nfrom pathlib import Path\n\nROSTER = [\"PlayerId\", \"Rank\", \"Player\", \"#\", \"Pos.\", \"Class\", \"Elig.\", \"Height\", \"Weight\", \"Team\",\n          \"Hometown\", \"State\", \"Snaps\"]\n\n# Leaderboard position group -> the Pos. codes its rows carry.\nGROUP_CODES = {\n    \"QB\": {\"QB\"},\n    \"RB\": {\"HB\", \"FB\", \"RB\"},\n    \"WR\": {\"OWR\", \"SWR\", \"WR\"},\n    \"TE\": {\"H\", \"Y\", \"F\", \"TE\"},\n    \"OT\": {\"LT\", \"RT\", \"OT\", \"T\"},\n    \"IOL\": {\"LG\", \"RG\", \"C\", \"OG\", \"G\"},\n    \"IDL\": {\"DT\", \"NT\", \"DL\"},\n    \"EDGE\": {\"UP\", \"DOWN\", \"DE\", \"EDGE\"},\n    \"OB-LB\": {\"ILB\", \"OLB\", \"LB\", \"UP\"},\n    \"CB\": {\"OCB\", \"SCB\", \"CB\"},\n    \"SAF\": {\"FS\", \"SS\", \"SAF\", \"SCB\"},\n}\n\n# Metric columns after the roster columns, per (group, tab), in export order.\nEXPECTED = {\n    (\"QB\", \"player-traits\"): [\"Accuracy\", \"Pocket Awareness\", \"Target Selection\", \"INT Avoidance\",\n                              \"Adj. Throw Velocity\", \"Max Throw Velocity\", \"Risk Level\", \"Tackle Breaking\",\n                              \"Play Speed\", \"Burst\", \"CoD\"],\n    (\"RB\", \"player-traits\"): [\"Run Ability\", \"Tackle Breaking\", \"Elusiveness\", \"Play Speed\", \"Deep Speed\",\n                              \"Burst\", \"CoD\", \"Pass Blocking\", \"Ball Skills\"],\n    (\"WR\", \"player-traits\"): [\"Ball Skills\", \"Tackle Breaking\", \"Elusiveness\", \"Play Speed\", \"Deep Speed\",\n                              \"Burst\", \"CoD\", \"Decel\", \"Run Blocking\"],\n    (\"TE\", \"player-traits\"): [\"Ball Skills\", \"Elusiveness\", \"Run Blocking\", \"Play Speed\", \"Deep Speed\",\n                              \"Burst\", \"CoD\"],\n    (\"OT\", \"player-traits\"): [\"Pass Blocking\", \"Run Blocking\"],\n    (\"IOL\", \"player-traits\"): [\"Run Blocking\", \"Pass Blocking\"],\n    (\"IDL\", \"player-traits\"): [\"Run Defense\", \"Pass Rush\", \"Get Off\", \"Tackling\"],\n    (\"EDGE\", \"player-traits\"): [\"Pass Rush\", \"Get Off\", \"Run Defense\", \"Tackling\", \"Play Speed\", \"CoD\"],\n    (\"OB-LB\", \"player-traits\"): [\"Tackling\", \"Run Defense\", \"Pass Rush\", \"Play Speed\", \"Deep Speed\",\n                                 \"Burst\", \"CoD\"],\n    (\"CB\", \"player-traits\"): [\"Play Speed\", \"Deep Speed\", \"Burst\", \"CoD\", \"Decel\", \"Tackling\",\n                              \"Run Defense\"],\n    (\"SAF\", \"player-traits\"): [\"Play Speed\", \"Deep Speed\", \"Burst\", \"CoD\", \"Decel\", \"Tackling\",\n                               \"Run Defense\"],\n    (\"QB\", \"advanced-stats\"): [\"Player Impact\", \"Passing Production\", \"Passing Effectiveness\",\n                               \"Evasion Rate\", \"Batdowns\", \"Rushing Production\", \"Rushing Effectiveness\",\n                               \"Tackles Avoided\", \"Yards After Contact\", \"Top End Speed\", \"Adjusted Speed\",\n                               \"Power Speed\"],\n    (\"RB\", \"advanced-stats\"): [\"Player Impact\", \"Rushing Production\", \"Rushing Effectiveness\",\n                               \"Explosive Run Rate\", \"Tackles Avoided\", \"Yards After Contact\",\n                               \"Receiving Production\", \"Receiving Effectiveness\", \"YAC Over Expected\",\n                               \"Separation\", \"Top End Speed\", \"Adjusted Speed\", \"Power Speed\"],\n    (\"WR\", \"advanced-stats\"): [\"Player Impact\", \"Receiving Production\", \"Receiving Effectiveness\",\n                               \"Separation\", \"YAC Over Expected\", \"Tackles Avoided\", \"Yards After Contact\",\n                               \"Penalty Drawn\", \"Penalty\", \"Top End Speed\", \"Adjusted Speed\", \"Power Speed\"],\n    (\"TE\", \"advanced-stats\"): [\"Player Impact\", \"Receiving Production\", \"Receiving Effectiveness\",\n                               \"Stops Allowed Over Expected\", \"Disruption Prevention\", \"YAC Over Expected\",\n                               \"Tackles Avoided\", \"Yards After Contact\", \"Penalty Drawn\", \"Penalty\",\n                               \"Top End Speed\", \"Adjusted Speed\", \"Power Speed\"],\n    (\"OT\", \"advanced-stats\"): [\"Player Impact\", \"Push\", \"Stops Allowed Over Expected\",\n                               \"Disruption Prevention\", \"Penalty\", \"Movement\"],\n    (\"IOL\", \"advanced-stats\"): [\"Player Impact\", \"Push\", \"Stops Allowed Over Expected\",\n                                \"Disruption Prevention\", \"Penalty\", \"Movement\"],\n    (\"IDL\", \"advanced-stats\"): [\"Player Impact\", \"Run Stops Over Expected\", \"Push\", \"Disruption\",\n                                \"Double Team Rate\", \"Penalty Drawn\", \"Penalty\", \"Batdowns\",\n                                \"Screen Awareness\", \"Top End Speed\"],\n    (\"EDGE\", \"advanced-stats\"): [\"Player Impact\", \"Disruption\", \"Push\", \"Run Stops Over Expected\",\n                                 \"Double Team Rate\", \"Penalty Drawn\", \"Penalty\", \"Batdowns\",\n                                 \"Screen Awareness\", \"Top End Speed\", \"Adjusted Speed\"],\n    (\"OB-LB\", \"advanced-stats\"): [\"Player Impact\", \"Screen Awareness\", \"EPA/Target\",\n                                  \"Comp Rate Over Expected\", \"Ball Hawk\", \"Target Rate\", \"Penalty\", \"Push\",\n                                  \"Double Team Rate\", \"Play Action Susceptibility\", \"Top End Speed\",\n                                  \"Adjusted Speed\", \"Power Speed\"],\n    (\"CB\", \"advanced-stats\"): [\"Player Impact\", \"EPA/Target\", \"Comp Rate Over Expected\", \"Ball Hawk\",\n                               \"Target Rate\", \"Penalty\", \"Top End Speed\", \"Adjusted Speed\", \"Power Speed\"],\n    (\"SAF\", \"advanced-stats\"): [\"Player Impact\", \"EPA/Target\", \"Comp Rate Over Expected\", \"Ball Hawk\",\n                                \"Target Rate\", \"Penalty\", \"Top End Speed\", \"Adjusted Speed\", \"Power Speed\"],\n}\n\nHEIGHT = re.compile(r\"^\\d-\\d{1,2}$\")\n\n\ndef group_of(codes):\n    \"\"\"Position group whose codes cover the most rows; None if under 90%.\"\"\"\n    total = sum(codes.values())\n    if not total:\n        return None\n    best = max(GROUP_CODES, key=lambda g: sum(n for c, n in codes.items() if c in GROUP_CODES[g]))\n    share = sum(n for c, n in codes.items() if c in GROUP_CODES[best]) / total\n    return best if share >= 0.9 else None\n\n\ndef tab_of(group, header):\n    \"\"\"The tab whose expected columns overlap the header most.\"\"\"\n    cols = set(header)\n    return max((\"player-traits\", \"advanced-stats\"),\n               key=lambda t: len(cols & set(EXPECTED[(group, t)])))\n\n\ndef check_rows(header, rows, group=None, tab=None):\n    \"\"\"Problems with one export as a list of strings ([] = fine), plus (group, tab).\"\"\"\n    problems = []\n    if not rows:\n        return [\"no rows\"], (group, tab)\n    group = group or group_of(Counter(r.get(\"Pos.\") or \"\" for r in rows))\n    if group is None:\n        missing = [c for c in ROSTER if c not in header]\n        return ([f\"missing columns: {', '.join(missing)}\"] if missing else []) + \\\n            [\"position group not recognised from Pos. codes\"], (None, tab)\n    tab = tab or tab_of(group, header)\n    missing = [c for c in ROSTER + EXPECTED[(group, tab)] if c not in header]\n    if missing:\n        problems.append(f\"missing columns: {', '.join(missing)}\")\n    bad = [h for h in (r.get(\"Height\") or \"\" for r in rows) if h.strip() and not HEIGHT.match(h.strip())]\n    if bad:\n        problems.append(f\"{len(bad)} unreadable heights (e.g. {bad[0]!r}; was the file saved in Excel?)\")\n    return problems, (group, tab)\n\n\ndef read(path):\n    text = Path(path).read_bytes().decode(\"utf-8-sig\")\n    reader = csv.DictReader(io.StringIO(text))\n    rows = list(reader)\n    return reader.fieldnames or [], rows\n\n\ndef main(argv):\n    if not argv:\n        sys.exit(__doc__)\n    files = []\n    for a in argv:\n        p = Path(a)\n        files += sorted(p.glob(\"*.csv\")) if p.is_dir() else [p]\n    if not files:\n        sys.exit(\"No .csv files found.\")\n    bad = 0\n    seen = Counter()\n    for f in files:\n        header, rows = read(f)\n        problems, (group, tab) = check_rows(header, rows)\n        seen[(group, tab)] += 1\n        label = f\"{group or '?'} {tab or '?'}\"\n        if problems:\n            bad += 1\n            print(f\"PROBLEM  {f.name}  [{label}, {len(rows)} rows]\")\n            for p in problems:\n                print(f\"         - {p}\")\n        else:\n            print(f\"ok       {f.name}  [{label}, {len(rows)} rows]\")\n    gaps = [f\"{g} {t}\" for (g, t) in EXPECTED if not seen[(g, t)]]\n    print(f\"\\n{len(files)} files, {bad} with problems.\")\n    if gaps:\n        print(f\"Not in this set (fine if you meant to skip them): {', '.join(gaps)}\")\n    if bad:\n        print(\"Fix: in the Telemetry leaderboard turn every column on, Download CSV again, \"\n              \"and do not open the file in Excel before loading.\")\n    return 1 if bad else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"c3dbf816-f8d9-426e-baae-d124fcc4efa2","session_id":"d1673601-88f7-4fb0-b59a-00f5414c1656","userType":"external","entrypoint":"cli","cwd":"G:\\My Drive\\00_Primary_Storage_Drive\\02_SPORTS\\Football\\PP_Recruiting","sessionId":"d1673601-88f7-4fb0-b59a-00f5414c1656","version":"2.1.291","gitBranch":"HEAD"}
