de_ai_Fireflies__fireflies_update_meeting_privacy","mcp__claude_ai_Fireflies__fireflies_update_meeting_title","mcp__claude_ai_HyperFrames_by_HeyGen__compose","mcp__claude_ai_HyperFrames_by_HeyGen__get-design-import-job-status","mcp__claude_ai_HyperFrames_by_HeyGen__get-send-to-hyperframes-guide","mcp__claude_ai_HyperFrames_by_HeyGen__get_project","mcp__claude_ai_HyperFrames_by_HeyGen__get_project_status","mcp__claude_ai_HyperFrames_by_HeyGen__get_render_status","mcp__claude_ai_HyperFrames_by_HeyGen__import-claude-design-from-url","mcp__claude_ai_HyperFrames_by_HeyGen__internal_get_project_status","mcp__claude_ai_HyperFrames_by_HeyGen__internal_get_render_status","mcp__claude_ai_HyperFrames_by_HeyGen__list_projects","mcp__claude_ai_HyperFrames_by_HeyGen__render_video","mcp__plugin_context-mode_context-mode__ctx_batch_execute","mcp__plugin_context-mode_context-mode__ctx_doctor","mcp__plugin_context-mode_context-mode__ctx_execute","mcp__plugin_context-mode_context-mode__ctx_execute_file","mcp__plugin_context-mode_context-mode__ctx_fetch_and_index","mcp__plugin_context-mode_context-mode__ctx_index","mcp__plugin_context-mode_context-mode__ctx_insight","mcp__plugin_context-mode_context-mode__ctx_purge","mcp__plugin_context-mode_context-mode__ctx_search","mcp__plugin_context-mode_context-mode__ctx_stats","mcp__plugin_context-mode_context-mode__ctx_upgrade"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":[],"failedMcpServers":[]},"type":"attachment","uuid":"20bf5d57-8483-44dd-bab6-62ad74cac268","timestamp":"2026-09-10T22:32:09.646Z","rendered":[{"content":"<system-reminder>\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nListMcpResourcesTool\nReadMcpResourceDirTool\nReadMcpResourceTool\nmcp__claude_ai_Excalidraw__create_view\nmcp__claude_ai_Excalidraw__export_to_excalidraw\nmcp__claude_ai_Excalidraw__read_checkpoint\nmcp__claude_ai_Excalidraw__read_me\nmcp__claude_ai_Excalidraw__save_checkpoint\nmcp__claude_ai_Fireflies__fireflies_create_soundbite\nmcp__claude_ai_Fireflies__fireflies_fetch\nmcp__claude_ai_Fireflies__fireflies_get_active_meetings\nmcp__claude_ai_Fireflies__fireflies_get_analytics\nmcp__claude_ai_Fireflies__fireflies_get_channel\nmcp__claude_ai_Fireflies__fireflies_get_rule_executions\nmcp__claude_ai_Fireflies__fireflies_get_soundbites\nmcp__claude_ai_Fireflies__fireflies_get_summary\nmcp__claude_ai_Fireflies__fireflies_get_transcript\nmcp__claude_ai_Fireflies__fireflies_get_transcripts\nmcp__claude_ai_Fireflies__fireflies_get_user\nmcp__claude_ai_Fireflies__fireflies_get_user_contacts\nmcp__claude_ai_Fireflies__fireflies_get_usergroups\nmcp__claude_ai_Fireflies__fireflies_list_channels\nmcp__claude_ai_Fireflies__fireflies_move_meeting\nmcp__claude_ai_Fireflies__fireflies_revoke_meeting_access\nmcp__claude_ai_Fireflies__fireflies_search\nmcp__claude_ai_Fireflies__fireflies_share_meeting\nmcp__claude_ai_Fireflies__fireflies_update_meeting_privacy\nmcp__claude_ai_Fireflies__fireflies_update_meeting_title\nmcp__claude_ai_HyperFrames_by_HeyGen__compose\nmcp__claude_ai_HyperFrames_by_HeyGen__get-design-import-job-status\nmcp__claude_ai_HyperFrames_by_HeyGen__get-send-to-hyperframes-guide\nmcp__claude_ai_HyperFrames_by_HeyGen__get_project\nmcp__claude_ai_HyperFrames_by_HeyGen__get_project_status\nmcp__claude_ai_HyperFrames_by_HeyGen__get_render_status\nmcp__claude_ai_HyperFrames_by_HeyGen__import-claude-design-from-url\nmcp__claude_ai_HyperFrames_by_HeyGen__internal_get_project_status\nmcp__claude_ai_HyperFrames_by_HeyGen__internal_get_render_status\nmcp__claude_ai_HyperFrames_by_HeyGen__list_projects\nmcp__claude_ai_HyperFrames_by_HeyGen__render_video\nmcp__plugin_context-mode_context-mode__ctx_batch_execute\nmcp__plugin_context-mode_context-mode__ctx_doctor\nmcp__plugin_context-mode_context-mode__ctx_execute\nmcp__plugin_context-mode_context-mode__ctx_execute_file\nmcp__plugin_context-mode_context-mode__ctx_fetch_and_index\nmcp__plugin_context-mode_context-mode__ctx_index\nmcp__plugin_context-mode_context-mode__ctx_insight\nmcp__plugin_context-mode_context-mode__ctx_purge\nmcp__plugin_context-mode_context-mode__ctx_search\nmcp__plugin_context-mode_context-mode__ctx_stats\nmcp__plugin_context-mode_context-mode__ctx_upgrade\n</system-reminder>"}],"session_id":"5f2ac916-6e52-43f6-bc78-4e7231c4afa0","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA","sessionId":"5f2ac916-6e52-43f6-bc78-4e7231c4afa0","version":"2.1.268","gitBranch":"main"}
{"parentUuid":"20bf5d57-8483-44dd-bab6-62ad74cac268","isSidechain":false,"attachment":{"type":"mcp_instructions_delta","addedNames":["claude.ai HyperFrames by HeyGen"],"addedBlocks":["## claude.ai HyperFrames by HeyGen\n\n[HeyGen HyperFrames MCP] — Programmable HTML video projects.\n\n## When to use this MCP\n\nThis MCP is the primary HyperFrames surface for hosted chat clients (Claude.ai\nweb/desktop, ChatGPT, Grok, and similar), where the user has no local filesystem\nand the agent cannot author HyperFrames code directly.\n\nFrom a CLI/IDE agent on the user's machine (Claude Code, Cursor, Codex, the\nlocalhost MCP Inspector, etc.), **`compose` and `render_video` are disabled** — these clients have a local\nfilesystem, so author HyperFrames with the local HyperFrames skills instead, which\nproduce standalone HTML compositions the user can edit, diff, and commit. Calls to\nthose two tools from such clients are rejected with a pointer to install them:\n\n    npx skills add heygen-com/hyperframes\n\nThe read tools (list_projects, get_project, get_project_status, get_render_status)\nstay available to every client.\n\nAfter installation they expose slash commands like `/hyperframes` (compose),\n`/hyperframes-cli` (init, lint, preview, render), and `/hyperframes-media`\n(TTS, transcribe, remove-background). See\nhttps://github.com/heygen-com/hyperframes for the full skill list and docs.\n\nBut the skills and this MCP are *not* drop-in equivalents:\n\n- Local skills → standalone HTML/GSAP files on disk. No `project_id`, no hosted\n  artifact, no integrated cloud render pipeline.\n- This MCP → hosted HeyGen project with a `project_id`, a live canvas at\n  `app.heygen.com/projects/{id}`, and the cloud render queue.\n\nRoute by what the user actually wants:\n- \"Make a local HTML composition / something I can edit\" → use a local skill.\n- \"Make a HeyGen project I can share / render in the cloud / open in the app\"\n  → use this MCP, even from a CLI agent.\n\n## What it does\n\nHyperFrames is HeyGen's framework for creating, editing, and rendering programmable\nHTML-based video projects. Projects are authored interactively (Magic Edit\nchat-driven flow) and rendered to MP4, WebM, or MOV at any framerate. Tools exposed\nhere cover composing, listing, fetching, and rendering projects… [truncated]"],"removedNames":[]},"type":"attachment","uuid":"0fa134ea-ab35-46b9-9d62-ea798c8394de","timestamp":"2026-09-10T22:32:09.646Z","rendered":[{"content":"<system-reminder>\n# MCP Server Instructions\n\nThe following MCP servers have provided instructions for how to use their tools and resources:\n\n## claude.ai HyperFrames by HeyGen\n\n[HeyGen HyperFrames MCP] — Programmable HTML video projects.\n\n## When to use this MCP\n\nThis MCP is the primary HyperFrames surface for hosted chat clients (Claude.ai\nweb/desktop, ChatGPT, Grok, and similar), where the user has no local filesystem\nand the agent cannot author HyperFrames code directly.\n\nFrom a CLI/IDE agent on the user's machine (Claude Code, Cursor, Codex, the\nlocalhost MCP Inspector, etc.), **`compose` and `render_video` are disabled** — these clients have a local\nfilesystem, so author HyperFrames with the local HyperFrames skills instead, which\nproduce standalone HTML compositions the user can edit, diff, and commit. Calls to\nthose two tools from such clients are rejected with a pointer to install them:\n\n    npx skills add heygen-com/hyperframes\n\nThe read tools (list_projects, get_project, get_project_status, get_render_status)\nstay available to every client.\n\nAfter installation they expose slash commands like `/hyperframes` (compose),\n`/hyperframes-cli` (init, lint, preview, render), and `/hyperframes-media`\n(TTS, transcribe, remove-background). See\nhttps://github.com/heygen-com/hyperframes for the full skill list and docs.\n\nBut the skills and this MCP are *not* drop-in equivalents:\n\n- Local skills → standalone HTML/GSAP files on disk. No `project_id`, no hosted\n  artifact, no integrated cloud render pipeline.\n- This MCP → hosted HeyGen project with a `project_id`, a live canvas at\n  `app.heygen.com/projects/{id}`, and the cloud render queue.\n\nRoute by what the user actually wants:\n- \"Make a local HTML composition / something I can edit\" → use a local skill.\n- \"Make a HeyGen project I can share / render in the cloud / open in the app\"\n  → use this MCP, even from a CLI agent.\n\n## What it does\n\nHyperFrames is HeyGen's framework for creating, editing, and rendering programmable\nHTML-based video projects. Projects are authored interactively (Magic Edit\nchat-driven flow) and rendered to MP4, WebM, or MOV at any framerate. Tools exposed\nhere cover composing, listing, fetching, and rendering projects… [truncated]\n</system-reminder>"}],"session_id":"5f2ac916-6e52-43f6-bc78-4e7231c4afa0","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA","sessionId":"5f2ac916-6e52-43f6-bc78-4e7231c4afa0","version":"2.1.268","gitBranch":"main"}
