__learnings_stats","mcp__zotero__playbook","mcp__zotero__playbook_amend","mcp__zotero__playbook_list","mcp__zotero__recall","mcp__zotero__search","mcp__zotero__searches_get","mcp__zotero__searches_list","mcp__zotero__sql","mcp__zotero__sync","mcp__zotero__tags_list","mcp__zotero__tail","mcp__zotero__teach","mcp__zotero__teach_lookup","mcp__zotero__teach_pattern","mcp__zotero__teach_playbook","mcp__zotero__workflow","mcp__zotero__workflow_archive","mcp__zotero__workflow_status"],"addedLines":["CronCreate","CronDelete","CronList","DesignSync","EnterWorktree","ExitWorktree","ListMcpResourcesTool","Monitor","NotebookEdit","PushNotification","ReadMcpResourceDirTool","ReadMcpResourceTool","RemoteTrigger","SendMessage","TaskCreate","TaskGet","TaskList","TaskOutput","TaskStop","TaskUpdate","WebFetch","WebSearch","mcp__claude_ai_Excalidraw__create_view","mcp__claude_ai_Excalidraw__export_to_excalidraw","mcp__claude_ai_Excalidraw__read_checkpoint","mcp__claude_ai_Excalidraw__read_me","mcp__claude_ai_Excalidraw__save_checkpoint","mcp__claude_ai_Fireflies__fireflies_create_soundbite","mcp__claude_ai_Fireflies__fireflies_fetch","mcp__claude_ai_Fireflies__fireflies_get_active_meetings","mcp__claude_ai_Fireflies__fireflies_get_analytics","mcp__claude_ai_Fireflies__fireflies_get_channel","mcp__claude_ai_Fireflies__fireflies_get_rule_executions","mcp__claude_ai_Fireflies__fireflies_get_soundbites","mcp__claude_ai_Fireflies__fireflies_get_summary","mcp__claude_ai_Fireflies__fireflies_get_transcript","mcp__claude_ai_Fireflies__fireflies_get_transcripts","mcp__claude_ai_Fireflies__fireflies_get_user","mcp__claude_ai_Fireflies__fireflies_get_user_contacts","mcp__claude_ai_Fireflies__fireflies_get_usergroups","mcp__claude_ai_Fireflies__fireflies_list_channels","mcp__claude_ai_Fireflies__fireflies_move_meeting","mcp__claude_ai_Fireflies__fireflies_revoke_meeting_access","mcp__claude_ai_Fireflies__fireflies_search","mcp__claude_ai_Fireflies__fireflies_share_meeting","mcp__claude_ai_Fireflies__fireflies_update_meeting_privacy","mcp__claude_ai_Fireflies__fireflies_update_meeting_title","mcp__claude_ai_Gmail__apply_sensitive_message_label","mcp__claude_ai_Gmail__apply_sensitive_thread_label","mcp__claude_ai_Gmail__create_draft","mcp__claude_ai_Gmail__create_label","mcp__claude_ai_Gmail__delete_label","mcp__claude_ai_Gmail__forward","mcp__claude_ai_Gmail__get_draft","mcp__claude_ai_Gmail__get_message","mcp__claude_ai_Gmail__get_thread","mcp__claude_ai_Gmail__label_message","mcp__claude_ai_Gmail__label_thread","mcp__claude_ai_Gmail__list_drafts","mcp__claude_ai_Gmail__list_labels","mcp__claude_ai_Gmail__mark_message_spam","mcp__claude_ai_Gmail__mark_thread_spam","mcp__claude_ai_Gmail__reply","mcp__claude_ai_Gmail__search_threads","mcp__claude_ai_Gmail__send_message","mcp__claude_ai_Gmail__trash_message","mcp__claude_ai_Gmail__trash_thread","mcp__claude_ai_Gmail__unlabel_message","mcp__claude_ai_Gmail__unlabel_thread","mcp__claude_ai_Gmail__unmark_message_spam","mcp__claude_ai_Gmail__unmark_thread_spam","mcp__claude_ai_Gmail__untrash_message","mcp__claude_ai_Gmail__untrash_thread","mcp__claude_ai_Gmail__update_draft","mcp__claude_ai_Gmail__update_label","mcp__claude_ai_Gmail__update_message_labels","mcp__claude_ai_Google_Calendar__create_event","mcp__claude_ai_Google_Calendar__delete_event","mcp__claude_ai_Google_Calendar__get_event","mcp__claude_ai_Google_Calendar__list_calendars","mcp__claude_ai_Google_Calendar__list_events","mcp__claude_ai_Google_Calendar__respond_to_event","mcp__claude_ai_Google_Calendar__search_events","mcp__claude_ai_Google_Calendar__suggest_time","mcp__claude_ai_Google_Calendar__update_event","mcp__claude_ai_Google_Drive__copy_file","mcp__claude_ai_Google_Drive__create_file","mcp__claude_ai_Google_Drive__download_file_content","mcp__claude_ai_Google_Drive__get_file_metadata","mcp__claude_ai_Google_Drive__get_file_permissions","mcp__claude_ai_Google_Drive__list_recent_files","mcp__claude_ai_Google_Drive__read_file_content","mcp__claude_ai_Google_Drive__search_files","mcp__claude_ai_Google_Drive__share_file","mcp__claude_ai_Google_Drive__trash_file","mcp__claude_ai_Google_Drive__update_file","mcp__claude_ai_HyperFrames_by_HeyGen__compose","mcp__claude_ai_HyperFrames_by_HeyGen__get-design-import-job-status","mcp__claude_ai_HyperFrames_by_HeyGen__get-send-to-hyperframes-guide","mcp__claude_ai_HyperFrames_by_HeyGen__get_project","mcp__claude_ai_HyperFrames_by_HeyGen__get_project_status","mcp__claude_ai_HyperFrames_by_HeyGen__get_render_status","mcp__claude_ai_HyperFrames_by_HeyGen__import-claude-design-from-url","mcp__claude_ai_HyperFrames_by_HeyGen__internal_get_project_status","mcp__claude_ai_HyperFrames_by_HeyGen__internal_get_render_status","mcp__claude_ai_HyperFrames_by_HeyGen__list_projects","mcp__claude_ai_HyperFrames_by_HeyGen__render_video","mcp__plugin_context-mode_context-mode__ctx_batch_execute","mcp__plugin_context-mode_context-mode__ctx_doctor","mcp__plugin_context-mode_context-mode__ctx_execute","mcp__plugin_context-mode_context-mode__ctx_execute_file","mcp__plugin_context-mode_context-mode__ctx_fetch_and_index","mcp__plugin_context-mode_context-mode__ctx_index","mcp__plugin_context-mode_context-mode__ctx_insight","mcp__plugin_context-mode_context-mode__ctx_purge","mcp__plugin_context-mode_context-mode__ctx_search","mcp__plugin_context-mode_context-mode__ctx_stats","mcp__plugin_context-mode_context-mode__ctx_upgrade","mcp__zotero__analytics","mcp__zotero__cache","mcp__zotero__cache_index_fulltext","mcp__zotero__cache_reindex","mcp__zotero__cache_status","mcp__zotero__cite","mcp__zotero__collections_get","mcp__zotero__collections_items","mcp__zotero__collections_list","mcp__zotero__collections_subcollections","mcp__zotero__collections_top","mcp__zotero__collections_tree","mcp__zotero__context","mcp__zotero__deleted_list","mcp__zotero__export","mcp__zotero__full_text_deep_search","mcp__zotero__fulltext_changed","mcp__zotero__ground","mcp__zotero__items_children","mcp__zotero__items_fulltext","mcp__zotero__items_get","mcp__zotero__items_list","mcp__zotero__items_recent","mcp__zotero__items_top","mcp__zotero__items_trash","mcp__zotero__keys_current","mcp__zotero__learnings","mcp__zotero__learnings_candidates","mcp__zotero__learnings_confirm","mcp__zotero__learnings_forget","mcp__zotero__learnings_list","mcp__zotero__learnings_reject","mcp__zotero__learnings_stats","mcp__zotero__playbook","mcp__zotero__playbook_amend","mcp__zotero__playbook_list","mcp__zotero__recall","mcp__zotero__search","mcp__zotero__searches_get","mcp__zotero__searches_list","mcp__zotero__sql","mcp__zotero__sync","mcp__zotero__tags_list","mcp__zotero__tail","mcp__zotero__teach","mcp__zotero__teach_lookup","mcp__zotero__teach_pattern","mcp__zotero__teach_playbook","mcp__zotero__workflow","mcp__zotero__workflow_archive","mcp__zotero__workflow_status"],"removedNames":[],"readdedNames":[],"pendingMcpServers":[],"needsAuthMcpServers":[]},"type":"attachment","uuid":"88763910-01e6-4733-bce8-dd05c8ba6dec","timestamp":"2026-09-12T22:31:11.840Z","userType":"external","entrypoint":"sdk-py","cwd":"/Users/kristinarash/.claude/claude-memory-compiler","sessionId":"d7af60b9-a2bd-450d-8d80-e0f0cd6e200b","version":"2.1.228","gitBranch":"session-start-progressive-disclosure"}
{"parentUuid":"88763910-01e6-4733-bce8-dd05c8ba6dec","isSidechain":false,"attachment":{"type":"agent_listing_delta","addedTypes":["claude","codex:codex-rescue","Explore","general-purpose","Plan","statusline-setup"],"addedLines":["- claude: Catch-all for any task that doesn't fit a more specific agent. FleetView's default when no agent name is typed. (Tools: *)","- codex:codex-rescue: Proactively use when Claude Code is stuck, wants a second implementation or diagnosis pass, needs a deeper root-cause investigation, or should hand a substantial coding task to Codex through the shared runtime (Tools: Bash)","- Explore: Read-only search agent for broad fan-out searches — when answering means sweeping many files, directories, or naming conventions and you only need the conclusion, not the file dumps. It reads excerpts rather than whole files, so it locates code; it doesn't review or audit it. Specify search breadth: \"medium\" for moderate exploration, \"very thorough\" for multiple locations and naming conventions. (Tools: All tools except Agent, Artifact, ExitPlanMode, Edit, Write, NotebookEdit)","- general-purpose: General-purpose agent for researching complex questions, searching for code, and executing multi-step tasks. When you are searching for a keyword or file and are not confident that you will find the right match in the first few tries use this agent to perform the search for you. (Tools: *)","- Plan: Software architect agent for designing implementation plans. Use this when you need to plan the implementation strategy for a task. Returns step-by-step plans, identifies critical files, and considers architectural trade-offs. (Tools: All tools except Agent, Artifact, ExitPlanMode, Edit, Write, NotebookEdit)","- statusline-setup: Use this agent to configure the user's Claude Code status line setting. (Tools: Read, Edit)"],"removedTypes":[],"isInitial":true,"showConcurrencyNote":true},"type":"attachment","uuid":"b74c7aa7-a70b-4ed4-b615-2f56c51afaa2","timestamp":"2026-09-12T22:31:11.840Z","userType":"external","entrypoint":"sdk-py","cwd":"/Users/kristinarash/.claude/claude-memory-compiler","sessionId":"d7af60b9-a2bd-450d-8d80-e0f0cd6e200b","version":"2.1.228","gitBranch":"session-start-progressive-disclosure"}
{"parentUuid":"b74c7aa7-a70b-4ed4-b615-2f56c51afaa2","isSidechain":false,"attachment":{"type":"mcp_instructions_delta","addedNames":["claude.ai HyperFrames by HeyGen"],"addedBlocks":["## claude.ai HyperFrames by HeyGen\n\n[HeyGen HyperFrames MCP] — Programmable HTML video projects.\n\n## When to use this MCP\n\nThis MCP is the primary HyperFrames surface for hosted chat clients (Claude.ai\nweb/desktop, ChatGPT, Grok, and similar), where the user has no local filesystem\nand the agent cannot author HyperFrames code directly.\n\nFrom a CLI/IDE agent on the user's machine (Claude Code, Cursor, Codex, the\nlocalhost MCP Inspector, etc.), **`compose` and `render_video` are disabled** — these clients have a local\nfilesystem, so author HyperFrames with the local HyperFrames skills instead, which\nproduce standalone HTML compositions the user can edit, diff, and commit. Calls to\nthose two tools from such clients are rejected with a pointer to install them:\n\n    npx skills add heygen-com/hyperframes\n\nThe read tools (list_projects, get_project, get_project_status, get_render_status)\nstay available to every client.\n\nAfter installation they expose slash commands like `/hyperframes` (compose),\n`/hyperframes-cli` (init, lint, preview, render), and `/hyperframes-media`\n(TTS, transcribe, remove-background). See\nhttps://github.com/heygen-com/hyperframes for the full skill list and docs.\n\nBut the skills and this MCP are *not* drop-in equivalents:\n\n- Local skills → standalone HTML/GSAP files on disk. No `project_id`, no hosted\n  artifact, no integrated cloud render pipeline.\n- This MCP → hosted HeyGen project with a `project_id`, a live canvas at\n  `app.heygen.com/projects/{id}`, and the cloud render queue.\n\nRoute by what the user actually wants:\n- \"Make a local HTML composition / something I can edit\" → use a local skill.\n- \"Make a HeyGen project I can share / render in the cloud / open in the app\"\n  → use this MCP, even from a CLI agent.\n\n## What it does\n\nHyperFrames is HeyGen's framework for creating, editing, and rendering programmable\nHTML-based video projects. Projects are authored interactively (Magic Edit\nchat-driven flow) and rendered to MP4, WebM, or MOV at any framerate. Tools exposed\nhere cover composing, listing, fetching, and rendering projects… [truncated]"],"removedNames":[]},"type":"attachment","uuid":"6f3c6995-d186-483e-a427-fe1e227cff52","timestamp":"2026-09-12T22:31:11.840Z","userType":"external","entrypoint":"sdk-py","cwd":"/Users/kristinarash/.claude/claude-memory-compiler","sessionId":"d7af60b9-a2bd-450d-8d80-e0f0cd6e200b","version":"2.1.228","gitBranch":"session-start-progressive-disclosure"}
{"parentUuid":"6f3c6995-d186-483e-a427-fe1e227cff52","isSidechain":false,"attachment":{"type":"skill_listing","content":"- anti-sleep: Keep the user's MacBook awake reliably with macOS caffeinate for a set duration or while a process runs. Use for \"don't let my Mac sleep\", \"keep the screen on\", \"anti-sleep\", \"caffeinate\", overnight work, or long builds. Unlike a normal background job, it survives temporary agent-shell cleanup.\n- backup: Run the KeystoneOS daily backup on demand (git-push the memory repos, rsync state to Google Drive and the CRASHBOX SSD, reindex memsearch), then report what was saved and what was skipped. Use when the user says \"/backup\", \"run the backup\", \"back up now\", \"back my stuff up\", \"did the backup run\", \"the backup failed\", \"I left the laptop off — catch up the backup\", or when a session-start HOOK FAILURE names daily-backup. The scheduled launchd job only fires if the Mac is awake at 09:00, so this is the manual catch-up path. NOT FOR whole-stack health checks (use claude-stack-doctor).\n- brain-audit: Score the second brain as a system — the four C's (context, connections, capabilities, cadence) — write a dated report to ~/SecondBrain/audits/, append the score to a trend table, and end by proposing exactly two next builds. Use when the user says \"/brain-audit\", \"audit my second brain\", \"score my brain\", \"is my second brain working\", \"how healthy is my system\", \"level up my brain\", \"what should I build next for my brain\", or when a monthly ritual is due. NOT FOR automation plumbing — launchd jobs, venvs, backup freshness (use claude-stack-doctor). NOT FOR note-level rot — stale seeds, duplicates, conflicting claims (use improve-system).\n- claude-stack-doctor: Health-check Eric's automation/memory stack in one pass, and verify the Mac-to-Windows handoff actually works — launchd agents (com.keystone.morning, agysync, dailybackup, rituals, reconcile, adjudicate), Python venvs, memsearch, memory-compiler flush pipeline, backup freshness, and context budget — and diagnose what's silently broken. Use when the user says \"/claude-stack-doctor\", \"stack doctor\", \"is my stack healthy\", \"did my scheduled jobs run\", \"check the memory pipeline\", \"why didn't the backup run\", or when closeout/morning sessions should verify automation health.\n- claudex-loop: Harden a plan with independent Claude/Codex review, then optionally build and cross-inspect it. Start in either Claude Code or Codex: the host plans and the other provider reviews. Use for claudex this plan, claudex-loop, or the legacy crucible trigger; not for trivial edits.\n- claudex-route: Recommend a model and a scoped handoff for a task in Claude Code or Codex. Use when choosing who should handle a task, seeking a second opinion, getting unstuck, or delegating focused work; execute one handoff when requested.\n- cli-hub-meta-skill: Discover agent-native CLIs for professional software. Access the live catalog to find tools for creative workflows, productivity, AI, and more.\n- closeout: End-of-session sign-off ritual. Sweeps loose ends, commits and pushes what needs it, verifies memory capture, writes a cross-harness handoff, and reports \"clear to sign off\" or what's still open. Use when the user says \"/closeout\", \"any loose ends?\", \"am I good to sign off?\", \"close out for the night\", \"closing out\", \"goodnight\", \"wrap up for the day\", or asks for a system health check before leaving.\n- code-review: Review the changes since a fixed point (commit, branch, tag, or merge-base) along two axes — Standards (does the code follow this repo's documented coding standards?) and Spec (does the code match what the originating issue/PRD asked for?). Runs both reviews in parallel sub-agents and reports them side by side. Use when the user wants to review a branch, a PR, work-in-progress changes, or asks to \"review since X\".\n- codex-build: Have Codex implement a concrete work order and have Claude independently inspect the final changes. Preserves the explicit Codex builder choice; use claudex-loop for host-based planning and automatic reviewer selection.\n- codex-review: Have Codex independently review an existing implementation plan while Claude coordinates a bounded revision loop. For automatic reviewer selection from either host, use claudex-loop with mode=review.\n- CreateSkill: Invoke BEFORE any skill work — creating, modifying, adding a workflow/tool to, renaming, validating, or canonicalizing any skill. Required by skills/CLAUDE.md; the single home for skill authoring in this workspace. Owns the skill lifecycle: scaffold (public TitleCase vs private _ALLCAPS, flat 2-level, Gotchas + Examples, BPE check), validate, canonicalize, test, improve, optimize descriptions. USE WHEN create skill, new skill, make a skill, build a skill, set up a skill, private skill, make a X skill, add a workflow, add a tool, edit/change/update/rename a skill, skill frontmatter, validate skill, check skill, canonicalize, scaffold skill, test skill, improve skill, optimize description, skill not triggering, overtriggering. NOT FOR TypeScript CLI generation (use CreateCLI).\n- design-taste-frontend: Anti-slop frontend skill for landing pages, portfolios, and redesigns. The agent reads the brief, infers the right design direction, and ships interfaces that do not look templated. Real design systems when applicable, audit-first on redesigns, strict pre-flight check.\n- dev-sync: Bring this machine into line with GitHub and load back the context that came with it: locate DEV automatically, pull config and skills, inventory every project, commit and push local work, pull the other machine's work, clone what is missing, report conflicts, then read the repo's STATUS and latest handoff and report where the last session left off. Use when Eric switches machines, sits down to start work, says 'sync DEV', asks whether everything is pushed, or asks where he left off.\n- doctor-plus: Runs Claude Code's built-in /doctor health check, then audits the workspace against the 6 then-and-now context-engineering shifts Anthropic shipped with the Claude 5 models (rules to judgement, examples to interfaces, upfront to progressive disclosure, repeats to tool descriptions, CLAUDE.md memory to auto-memory, simple specs to rich references). Reports findings first, fixes only on approval. Triggers on \"/doctor-plus\", \"doctor plus\", \"doctor-plus\", \"extended doctor\", \"then and now audit\", \"context checkup\".\n- fireflies-intake: One-command Fireflies pipeline — sync new meeting transcripts into the SecondBrain vault, rename generically-titled meetings, then report exactly what was ingested. Use when the user says \"/fireflies-intake\", \"ingest my recent fireflies meetings\", \"sync meetings that aren't in the second brain yet\", \"pull in the new meetings\", \"meeting ingestion\", or asks whether all recent meetings have been ingested.\n- five-slides-generator: Generate a '5 Slides in 5 Minutes' PowerPoint deck for Baylor Athletics Applied Performance — research, narrative, pptxgenjs, .pptx build, QA. Use whenever the user mentions '5 slides,' '5 slides in 5 minutes,' or gives a topic they want a Performance School deck on. Also trigger for a cross-functional staff presentation, a quick sport science deck, or any short educational deck in the established series format (CMJ, GPS, VBT are prior examples).\n- forecast-capture: Capture and freeze the CFB Victory Model's pre-game forecasts before kickoff, then report what moved since last week. Run every Wednesday during the season. Use when the user says \"/forecast-capture\", \"capture the forecast\", \"freeze this week's predictions\", \"run the CFB capture\", \"did we capture this week\", or asks whether the weekly model snapshot has been taken.\n- game-film-timestamps: Fix wrong startTime/endTime values in football game film JSON exported from Hudl, DVSport, or similar. Fetches correct wall-clock timestamps from the ESPN API and writes corrected copies. Use whenever the user mentions fixing or correcting play-by-play timestamps in game film JSON, or has files with \"OFF\", \"DEF\", or \"KICKS\" in the filename and mentions timestamps or time issues.\n- graphify: Use for any question about a codebase, its architecture, file relationships, or project content — especially when graphify-out/ exists, where the question should be treated as a graphify query first. Turns any input (code, docs, papers, images, videos) into a persistent knowledge graph with god nodes, community detection, and query/path/explain tools.\n- Harvest: Distill a finished project into evergreen Knowledge/ articles in the SecondBrain vault and log the shipped artifact in the output ledger. Use when the user says \"/harvest <project>\", \"harvest this project\", \"distill what we learned from X\", declares a project finished/shipped/done, or when a session ends with a clearly shipped deliverable worth recording.\n- html-to-pdf: Render any local HTML report, deck, or dashboard to a print-ready PDF via headless Chrome — replaces the manual Ctrl+P → Save as PDF ritual. Use when the user says \"export this to PDF\", \"print version\", \"PDF for the coaches\", \"make this printable\", or a coach-facing HTML deliverable needs a shareable/printable copy.\n- impeccable: Use when the user wants to design, redesign, shape, critique, audit, polish, clarify, distill, harden, optimize, adapt, animate, colorize, extract, or otherwise improve a frontend interface. Covers websites, landing pages, dashboards, product UI, app shells, components, forms, settings, onboarding, and empty states. Handles UX review, visual hierarchy, information architecture, cognitive load, accessibility, performance, responsive behavior, theming, anti-patterns, typography, fonts, spacing, layout, alignment, color, motion, micro-interactions, UX copy, error states, edge cases, i18n, and reusable design systems or tokens. Also use for bland designs that need to become bolder or more delightful, loud designs that should become quieter, live browser iteration on UI elements, or ambitious visual effects that should feel technically extraordinary. Not for backend-only or non-UI tasks.\n- improve-system: Audit the SecondBrain vault for rot — stale seed notes, conflicting claims, and duplicate notes — and propose merge/archive/update actions. Use when the user says \"/improve-system\", \"audit my notes\", \"audit the vault\", \"find stale/duplicate notes\", or \"clean up my second brain\". For mining sessions for missed learnings use session-miner; for capturing a win/lesson use capture-insight; for improving a skill use write-a-skill.\n- ingest-book: Ingest a book (PDF/EPUB full-text, Kindle highlights, or framework-only from a physical book) into the SecondBrain library as atomized, citable advisor entries. Use when the user wants to \"ingest a book\", \"add a book to my library/advisors\", \"/ingest-book\", or points at a book file for the advisor system. For articles/transcripts/general resources use ingest-resource instead.\n- ingest-resource: Ingest any article, YouTube link, transcript, PDF, or note into the SecondBrain vault — routes it to Knowledge/ (stable info) or Projects/ (active work), adds a summary block, and cross-links related notes with [[wikilinks]]. Use when the user shares a URL, file, or pasted content and says \"ingest\", \"save this\", \"add to my vault/second brain\", \"/ingest-resource\", or drops a resource with intent to keep it.\n- interview-me: End-of-workday structured interview in two parts — a 90-second supervisor log of operational facts (equipment, people, blockers) that feeds the biweekly status report, then four reflection questions that distill the day into atomic permanent notes for the SecondBrain Obsidian vault. NOT a journaling app — produces a fact log and curated synthesis notes, not stream-of-consciousness. Use when the user types `/interview-me`, says \"interview me\", \"let's debrief\", \"end of day interview\", \"process my day\", \"wrap up today\", \"log my day\", or otherwise asks to capture their workday for their second brain or for their supervisor update. NOT FOR building the biweekly report itself (use status-report).\n- library-advisor: Consult a grounded domain advisor built from your curated book library. Answers ONLY from ingested library entries, cites every claim, and explicitly separates grounded knowledge from general knowledge. Use when the user says \"ask my <domain> advisor\", \"/library-advisor <domain> <question>\", \"what would my library say about…\", \"consult my library advisor\", or consults a standing advisor. Domains live in SecondBrain/Knowledge/library/advisors/. NOT FOR the built-in /advisor reviewer command, which is a different tool.\n- meeting-prep: Pre-meeting readiness brief for a project — what changed, what's open, every deliverable path. Use when the user says \"/meeting-prep <project>\", \"I have a meeting with <person> — are we in a good spot on <project>?\", \"verify we're up to speed before the meeting\", \"get me ready for this afternoon's meeting\", or names an upcoming coach/staff meeting.\n- meeting-sync: Sync new Fireflies transcripts into the SecondBrain vault; audit vault filenames for drift against Fireflies titles. Idempotent. Use when the user says \"sync meetings\", \"pull latest meetings\", \"/meeting-sync\", \"update meeting notes\", \"any new meetings?\", or when invoked by weekly-review. Also for filename drift — \"are any meeting files misnamed?\", \"did a meeting get renamed after export?\", \"why is this meeting titled differently in Fireflies than in the vault?\", \"audit the meeting filenames\".\n- memory-write: Writes, updates, removes, and recalls facts in the two-tier memory system at ~/.claude/global-memory/ and ~/.claude/projects/<slug>/memory/. Use for write requests such as \"remember this\", \"note that\", \"update memory\", \"save this\", and \"forget about\", and for recall requests such as \"did we already…?\", \"what did we decide about X?\", and \"do you remember…?\". For writes, selects the correct tier and enforces deduplication and character caps. For recall, checks the injected snapshot first, then follows the memsearch retrieval ladder.\n- name-meetings: Detects Fireflies meetings with generic titles (empty, \"Zoom Meeting\", \"Recording\", date-only, etc.), proposes structured names based on AI summary + participants, and applies approved renames via the Fireflies API. Use when user says \"/name-meetings\", \"name my meetings\", \"rename untitled meetings\", \"fix meeting titles\", \"my meetings have no names\", or when invoked by meeting-sync.\n- new-project: Scaffold a new project in DEV the standard way: git repo, AGENTS.md with the session routine, CLAUDE.md pointer, docs/STATUS.md, .gitignore, private GitHub repo under erash11. Use when Eric starts a new project or says 'set this up as a repo'.\n- next-decision: Drill open decisions one at a time — present the most important decision not yet clarified, give the top four choices, state a preference, ask the user. Use when the user says \"next decision\", \"one decision at a time\", or a plan has several unresolved choices. Differentiator: forward-looking; the decisions skill is retrospective (choices already made). Can be invoked with /next-decision.\n- pbir-report-builder: Generates Power BI report pages, visuals, and IBCS-compliant variance charts by writing PBIR JSON into PBIP project folders. Use whenever the user wants to create a Power BI page, add visuals, generate KPI cards, build charts, tables or dashboard layouts, or mentions 'PBIR', 'IBCS', 'variance chart', 'variance table', 'actual vs plan'.\n- persistent-localhost: Start, stop, restart, and inspect durable localhost dev servers on macOS as user LaunchAgents, so they outlive the agent's shell and auto-restart on crash. Use whenever an agent must run a dev server, API, or any long-lived local process on a port: \"start the dev server\", \"run it on localhost\", \"keep the server running\", \"the server keeps dying\", \"restart the app on port 5111\". Never start servers with nohup, &, disown, setsid, or run_in_background; those die with the shell or become unfindable orphans.\n- pp-catapult-openfield-connect: Every Catapult GPS metric — ACWR, velocity benchmarks, load reports — from one command, with a local SQLite mirror for offline analysis. Trigger phrases: `check ACWR for the squad`, `what is the player load from today's session`, `compare the last two matches`, `who is at injury risk`, `generate a weekly load report`, `sync Catapult data`, `use catapult-openfield-connect`, `run catapult CLI`.\n- pp-fireflies: Query Fireflies via fireflies-pp-cli — offline transcript search, cross-meeting intelligence, speaker analytics, local SQLite. For writing vault summaries use meeting-sync instead. Trigger phrases: `find stale action items from meetings`, `search my meeting transcripts for`, `who talked most in recent meetings`, `sync fireflies meetings`, `use fireflies-pp-cli`, `run fireflies`, `what did we discuss with`.\n- pp-zotero-research-library: Your entire Zotero research library, searchable offline — version-based incremental sync into SQLite with full-text search no other Zotero tool has. Trigger phrases: `search my Zotero library`, `what does my library say about`, `find papers about`, `sync my Zotero library`, `what did I add to Zotero this week`, `get the citation for`, `use zotero-research-library`, `run zotero cli`.\n- project: Manage the portfolio project registry (ideas, updates, ranking, promotion, dev stages) and render/publish the dashboard. Triggers on \"/project\", \"new idea:\", \"log progress on\", \"project update\", \"add to my project inbox\", \"show my projects\", \"re-rank my projects\", \"set the stage on\", \"mark <project> as spec'd/planned/shipped\".\n- project-triage: Generate the DEV/ project triage HTML dashboard for today or a backfill date, surfacing drift between curated and current state. Use when the user says \"project triage\", \"/project-triage\", \"run my project review\", \"dev dashboard\", \"what's open in DEV\", \"morning review\", or asks to see the open-projects HTML.\n- scroll-craft: Build a premium, scroll-driven interactive landing page for any business: a service company, a physical product, a food brand, a drink brand. Scroll becomes the timeline. Video scrubs frame by frame under the wheel, sections pin and advance, rails pan sideways, headlines assemble line by line, the page ground shifts colour as you travel, and the pointer moves things that are not scrolling. Interviews the human first (their vibe, their journey, one unbroken world or distinct scenes, and what assets they already own), then picks a page grammar and a signature move so no two builds share a skeleton, generates photoreal assets through kie.ai or builds from the user's own footage and photos, writes real semantic HTML on a design-system floor, and verifies the result by screenshotting its own scroll. Use for \"scrollytelling\", \"scroll animation site\", \"a site where scrolling plays a video\", \"Apple-style landing page\", \"3D scroll world\", \"interactive landing page\", \"make my brand a scroll experience\", \"make it feel different\", \"this looks like a template\", \"a unique scroll site\", or any request for a site that should feel like an experience rather than a document.\n- sports-science-research-grounding: Use automatically for substantive questions about sport science, return to play or sport, rehabilitation, strength and conditioning, workload, recovery, testing, athlete health, injury, performance, research-backed answers, and Zotero full-library batch processing. Searches the user's Zotero library first, clearly labels external peer-reviewed fallback sources, and applies tier-aware model routing during bounded batch work.\n- startup: Start of day, or sitting down at either machine: sync this machine against GitHub, then report where the last session left off and wait. Use when Eric says '/startup', 'good morning', 'starting up', 'where did I leave off', 'what was I working on', 'picking this back up', or opens a session without naming a task.\n- status-report: Build the every-two-weeks Applied Performance status report for Kenny Boyd and Chris Ruf — paste-ready email, one-page PDF, internal record. Use when the user says \"/status-report\", \"build my status report\", \"time for the Chris report\", \"biweekly update\", \"status update for Chris and Kenny\", \"what do I send Chris this week\", or when a scheduled report date arrives.\n- weekly-review: Friday close-of-week synthesis ritual. Pulls the last 7 days of meetings, interview notes, and permanent notes from the SecondBrain vault and produces a single weekly review note covering themes, project status, decisions, stale action items, essay angles, and next-week priorities. Use when user says \"/weekly-review\", \"weekly review\", \"Friday review\", \"let's do this week's review\", \"weekly synthesis\", or \"what should I work on next week?\".\n- codex:rescue: Delegate investigation, an explicit fix request, or follow-up rescue work to the Codex rescue subagent\n- codex:setup: Check whether the local Codex CLI is ready and optionally toggle the stop-time review gate\n- superpowers:brainstorming: You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.\n- superpowers:dispatching-parallel-agents: Use when facing 2+ independent tasks that can be worked on without shared state or sequential dependencies\n- superpowers:executing-plans: Use when you have a written implementation plan to execute in a separate session with review checkpoints\n- superpowers:finishing-a-development-branch: Use when implementation is complete, all tests pass, and you need to decide how to integrate the work\n- superpowers:receiving-code-review: Use when receiving code review feedback, before implementing suggestions, especially if feedback seems unclear or technically questionable - requires technical rigor and verification, not performative agreement or blind implementation\n- superpowers:requesting-code-review: Use when completing tasks, implementing major features, or before merging to verify work meets requirements\n- superpowers:subagent-driven-development: Use when executing implementation plans with independent tasks in the current session\n- superpowers:systematic-debugging: Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes\n- superpowers:test-driven-development: Use when implementing any feature or bugfix, before writing implementation code\n- superpowers:using-git-worktrees: Use when starting feature work that needs isolation from current workspace or before executing implementation plans - ensures an isolated workspace exists via native tools or git worktree fallback\n- superpowers:using-superpowers: Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions\n- superpowers:verification-before-completion: Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always\n- superpowers:writing-plans: Use when you have a spec or requirements for a multi-step task, before touching code\n- superpowers:writing-skills: Use when creating new skills, editing existing skills, or verifying skills work before deployment\n- last30days:last30days: Research what people actually say about any topic in the last 30 days. Pulls posts and engagement from Reddit, X, YouTube, TikTok, Hacker News, Polymarket, GitHub, and the web. Includes a doctor health check to diagnose broken or missing sources.\n- context-mode:context-mode\n- context-mode:ctx-doctor: Run context-mode diagnostics. Checks runtimes, hooks, FTS5,\nplugin registration, npm and marketplace versions.\nTrigger: /context-mode:ctx-doctor\n- context-mode:ctx-index: Index a local file or directory into context-mode's persistent FTS5 knowledge base\nso future ctx_search calls can retrieve focused snippets without rereading raw files.\nTrigger: /context-mode:ctx-index\n- context-mode:ctx-insight\n- context-mode:ctx-purge\n- context-mode:ctx-search\n- context-mode:ctx-stats\n- context-mode:ctx-upgrade\n- codex:codex-cli-runtime: Internal helper contract for calling the codex-companion runtime from Claude Code\n- codex:codex-result-handling\n- codex:gpt-5-4-prompting\n- mattpocock-skills:diagnosing-bugs\n- mattpocock-skills:tdd\n- mattpocock-skills:prototype: Build a throwaway prototype to answer a design question. Use when the user wants to sanity-check whether a state model or logic feels right, or explore what a UI should look like.\n- mattpocock-skills:research\n- mattpocock-skills:domain-modeling\n- mattpocock-skills:codebase-design\n- mattpocock-skills:code-review\n- mattpocock-skills:resolving-merge-conflicts\n- mattpocock-skills:wizard\n- mattpocock-skills:grilling: Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any 'grill' trigger phrases.\n- mattpocock-skills:writing-for-agents\n- watch:watch: Watch a video (URL or local path). Downloads with yt-dlp, extracts auto-scaled frames with ffmpeg, pulls the transcript from captions (or Whisper API fallback), and hands the result to Claude so it can answer questions about what's in the video.\n- dataviz: Use this skill whenever you are about to create ANY chart, graph, plot, dashboard, or data visualization, in ANY output medium — an HTML or React artifact, inline SVG, plotting code in any library (matplotlib, plotly, d3, Recharts, …), an image/PNG you will render and upload, or a chart shared into Slack. Read it BEFORE writing the first line of chart code, choosing chart colors, building a stat tile / meter / KPI row, or laying out a dashboard. Produces visualizations that read as one system — elegant, accessible, consistent in light and dark — using a brand-neutral placeholder palette you swap for your own. Teaches a design-system-agnostic method: a form heuristic, a color formula with a runnable validator, mark specs, and interaction rules. A validated default palette is documented in `references/palette.md` — swap that file's values for your brand's. Triggers on: \"chart\", \"graph\", \"plot\", \"data viz\", \"visualization\", \"dashboard\", \"analytics\", \"visualize data\", \"categorical colors\", \"sequential / diverging palette\", \"stat tile\", \"sparkline\", \"heatmap\", \"legend\", \"axis\", \"tooltip\", \"chart colors\", \"color by series\".\n- update-config: Use this skill to configure the Claude Code harness via settings.json. Automated behaviors (\"from now on when X\", \"each time X\", \"whenever X\", \"before/after X\") require hooks configured in settings.json - the harness executes these, not Claude, so memory/preferences cannot fulfill them. Also use for: permissions (\"allow X\", \"add permission\", \"move permission to\"), env vars (\"set X=Y\"), hook troubleshooting, or any changes to settings.json/settings.local.json files. Examples: \"allow npm commands\", \"add bq permission to global settings\", \"move permission to user settings\", \"set DEBUG=true\", \"when claude stops show X\". For simple settings like theme/model, suggest the /config command.\n- keybindings-help: Use when the user wants to customize keyboard shortcuts, rebind keys, add chord bindings, or modify ~/.claude/keybindings.json. Examples: \"rebind ctrl+s\", \"add a chord shortcut\", \"change the submit key\", \"customize keybindings\".\n- simplify: Review the changed code for reuse, simplification, efficiency, and altitude cleanups, then apply the fixes. Quality only — it does not hunt for bugs; use /code-review for that.\n- fewer-permission-prompts: Scan your transcripts for common read-only Bash and MCP tool calls, then add a prioritized allowlist to project .claude/settings.json to reduce permission prompts.\n- loop: Run a prompt or slash command on a recurring interval (e.g. /loop 5m /foo). Omit the interval to let the model self-pace. - When the user wants to set up a recurring task, poll for status, or run something repeatedly on an interval (e.g. \"check the deploy every 5 minutes\", \"keep running /babysit-prs\"). Do NOT invoke for one-off tasks.\n- schedule: Create, update, list, or run scheduled cloud agents (routines) that execute on a cron schedule. - When the user wants to schedule a recurring cloud agent, set up automated tasks, create a cron job for Claude Code, or manage their scheduled agents/routines. Also use when the user wants a one-time scheduled run (\"run this once at 3pm\", \"remind me to check X tomorrow\").\n- claude-api: Reference for the Claude API / Anthropic SDK — model ids, pricing, params, streaming, tool use, MCP, agents, caching, token counting, model migration.\nTRIGGER — read BEFORE opening the target file; don't skip because it \"looks like a one-liner\" — whenever: the prompt names Claude/Anthropic in any form (Claude, Anthropic, Fable, Opus, Sonnet, Haiku, `anthropic`, `@anthropic-ai`, `claude-*`, `us.anthropic.*`, `[1m]`); the user asks about an LLM (pricing/model choice/limits/caching) — never answer from memory; OR the task is LLM-shaped with provider unstated (agent/MCP/tool-definition/multi-agent/RAG/LLM-judge/computer-use; generate/summarize/extract/classify/rewrite/converse over NL; debugging refusals/cutoffs/streaming/tool-calls/tokens).\nSKIP only when another provider is being worked on (overrides all triggers): OpenAI/GPT/Gemini/Llama/Mistral/Cohere/Ollama named in the query; OR `grep -rE 'openai|langchain_openai|google.generativeai|genai|mistralai|cohere|ollama'` over the project hits (run this grep FIRST if no provider named — don't Read the file).\n- run: Launch and drive this project's app to see a change working. Use when asked to run, start, or screenshot the app, or to confirm a change works in the real app (not just tests). First looks for a project skill that already covers launching the app; otherwise falls back to built-in patterns per project type (CLI, server, TUI, Electron, browser-driven, library).\n- init: Initialize a new CLAUDE.md file with codebase documentation\n- security-review","skillCount":97,"isInitial":true,"names":["anti-sleep","backup","brain-audit","claude-stack-doctor","claudex-loop","claudex-route","cli-hub-meta-skill","closeout","code-review","codex-build","codex-review","CreateSkill","design-taste-frontend","dev-sync","doctor-plus","fireflies-intake","five-slides-generator","forecast-capture","game-film-timestamps","graphify","Harvest","html-to-pdf","impeccable","improve-system","ingest-book","ingest-resource","interview-me","library-advisor","meeting-prep","meeting-sync","memory-write","name-meetings","new-project","next-decision","pbir-report-builder","persistent-localhost","pp-catapult-openfield-connect","pp-fireflies","pp-zotero-research-library","project","project-triage","scroll-craft","sports-science-research-grounding","startup","status-report","weekly-review","codex:rescue","codex:setup","superpowers:brainstorming","superpowers:dispatching-parallel-agents","superpowers:executing-plans","superpowers:finishing-a-development-branch","superpowers:receiving-code-review","superpowers:requesting-code-review","superpowers:subagent-driven-development","superpowers:systematic-debugging","superpowers:test-driven-development","superpowers:using-git-worktrees","superpowers:using-superpowers","superpowers:verification-before-completion","superpowers:writing-plans","superpowers:writing-skills","last30days:last30days","context-mode:context-mode","context-mode:ctx-doctor","context-mode:ctx-index","context-mode:ctx-insight","context-mode:ctx-purge","context-mode:ctx-search","context-mode:ctx-stats","context-mode:ctx-upgrade","codex:codex-cli-runtime","codex:codex-result-handling","codex:gpt-5-4-prompting","mattpocock-skills:diagnosing-bugs","mattpocock-skills:tdd","mattpocock-skills:prototype","mattpocock-skills:research","mattpocock-skills:domain-modeling","mattpocock-skills:codebase-design","mattpocock-skills:code-review","mattpocock-skills:resolving-merge-conflicts","mattpocock-skills:wizard","mattpocock-skills:grilling","mattpocock-skills:writing-for-agents","watch:watch","dataviz","update-config","keybindings-help","simplify","fewer-permission-prompts","loop","schedule","claude-api","run","init","security-review"]},"type":"attachment","uuid":"15a9ac2a-3d39-4b5f-845d-c54f9ded8a78","timestamp":"2026-09-12T22:31:11.840Z","userType":"external","entrypoint":"sdk-py","cwd":"/Users/kristinarash/.claude/claude-memory-compiler","sessionId":"d7af60b9-a2bd-450d-8d80-e0f0cd6e200b","version":"2.1.228","gitBranch":"session-start-progressive-disclosure"}
