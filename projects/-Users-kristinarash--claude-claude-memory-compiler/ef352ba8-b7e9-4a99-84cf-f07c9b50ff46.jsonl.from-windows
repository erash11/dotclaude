ase__get_project_url","mcp__claude_ai_Supabase__get_publishable_keys","mcp__claude_ai_Supabase__list_branches","mcp__claude_ai_Supabase__list_edge_functions","mcp__claude_ai_Supabase__list_extensions","mcp__claude_ai_Supabase__list_migrations","mcp__claude_ai_Supabase__list_organizations","mcp__claude_ai_Supabase__list_projects","mcp__claude_ai_Supabase__list_tables","mcp__claude_ai_Supabase__merge_branch","mcp__claude_ai_Supabase__pause_project","mcp__claude_ai_Supabase__query_logs","mcp__claude_ai_Supabase__rebase_branch","mcp__claude_ai_Supabase__reset_branch","mcp__claude_ai_Supabase__restore_project","mcp__claude_ai_Supabase__search_docs"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":[],"needsAuthMcpServers":[],"failedMcpServers":[],"surfacedNames":["mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update","mcp__claude_ai_Firecrawl__firecrawl_scrape","mcp__claude_ai_Firecrawl__firecrawl_search"]},"type":"attachment","uuid":"0984e8f6-0a95-477e-89ac-ce25e4660362","timestamp":"2026-09-25T00:50:15.601Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\nmcp__claude_ai_Firecrawl__firecrawl_scrape\nmcp__claude_ai_Firecrawl__firecrawl_search\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nCronCreate\nCronDelete\nCronList\nDesignSync\nEnterWorktree\nExitWorktree\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nTaskOutput\nTaskStop\nWebFetch\nWebSearch\nmcp__claude_ai_Claude_Docs__create\nmcp__claude_ai_Claude_Docs__delete\nmcp__claude_ai_