{"parentUuid":"5fecfb0c-c051-49f9-90de-b5ec33a8dade","isSidechain":false,"attachment":{"type":"deferred_tools_delta","addedNames":["CronCreate","CronDelete","CronList","DesignSync","EnterWorktree","ExitWorktree","ListMcpResourcesTool","Monitor","NotebookEdit","PushNotification","ReadMcpResourceDirTool","ReadMcpResourceTool","RemoteTrigger","SendMessage","TaskOutput","TaskStop","WebFetch","WebSearch","mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__create","mcp__claude_ai_Claude_Docs__delete","mcp__claude_ai_Claude_Docs__export","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__query","mcp__claude_ai_Claude_Docs__read","mcp__claude_ai_Claude_Docs__update","mcp__claude_ai_Excalidraw__create_view","mcp__claude_ai_Excalidraw__export_to_excalidraw","mcp__claude_ai_Excalidraw__read_checkpoint","mcp__claude_ai_Excalidraw__read_me","mcp__claude_ai_Excalidraw__save_checkpoint","mcp__claude_ai_Fireflies__fireflies_create_soundbite","mcp__claude_ai_Fireflies__fireflies_fetch","mcp__claude_ai_Fireflies__fireflies_get_active_meetings","mcp__claude_ai_Fireflies__fireflies_get_analytics","mcp__claude_ai_Fireflies__fireflies_get_channel","mcp__claude_ai_Fireflies__fireflies_get_rule_executions","mcp__claude_ai_Fireflies__fireflies_get_soundbites","mcp__claude_ai_Fireflies__fireflies_get_summary","mcp__claude_ai_Fireflies__fireflies_get_transcript","mcp__claude_ai_Fireflies__fireflies_get_transcripts","mcp__claude_ai_Fireflies__fireflies_get_user","mcp__claude_ai_Fireflies__fireflies_get_user_contacts","mcp__claude_ai_Fireflies__fireflies_get_usergroups","mcp__claude_ai_Fireflies__fireflies_list_channels","mcp__claude_ai_Fireflies__fireflies_move_meeting","mcp__claude_ai_Fireflies__fireflies_revoke_meeting_access","mcp__claude_ai_Fireflies__fireflies_search","mcp__claude_ai_Fireflies__fireflies_share_meeting","mcp__claude_ai_Fireflies__fireflies_update_meeting_privacy","mcp__claude_ai_Fireflies__fireflies_update_meeting_title","mcp__claude_ai_Gmail__ap