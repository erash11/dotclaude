T\" >> \"$ALERT_LOG\"\n}\n\nif ! cd \"$HERE\"; then\n  alert \"error exit=1 cannot cd to $HERE\"\n  exit 1\nfi\n\necho \"[$(stamp)] gps pull start\"\n\n# 1. Warn when the last successful pull is older than STALE_HOURS (covers days the Mac was off).\nstale_msg=\"$(\"$PY\" -c '\nimport json, sys\nfrom datetime import datetime, timezone\npath, hours = sys.argv[1], float(sys.argv[2])\ntry:\n    with open(path, encoding=\"utf-8\") as f:\n        data = json.load(f)\nexcept (OSError, ValueError):\n    sys.exit(0)  # first run: nothing to compare\nlast = data.get(\"last_success_at\")\nif not last:\n    print(\"no successful pull on record\")\n    sys.exit(0)\nt = datetime.fromisoformat(last)\nif t.tzinfo is None:\n    t = t.astimezone()\nage = (datetime.now(timezone.utc) - t).total_seconds() / 3600\nif age > hours:\n    print(f\"last success {last} ({age:.0f} h ago)\")\n' \"$RECEIPT\" \"$STALE_HOURS\" 2>/dev/null)\"\nif [ -n \"$stale_msg\" ]; then\n  alert \"stale $stale_msg\"\nfi\n\n# 2. Import. Absolute paths so the working directory never matters.\nRUN_ID=\"$(date '+%Y%m%dT%H%M%S')-$$\"\ncd \"$HERE\" || exit 1\n\"$PY\" \"$HERE/bulk_import.py\" --since-db --config \"$CONFIG\" --db \"$DB\" --receipt \"$RECEIPT\" --run-id \"$RUN_ID\"\nrc=$?\necho \"[$(stamp)] bulk_import exit=$rc run_id=$RUN_ID\"\n\n# The receipt is trusted only if this run wrote it (a stale one would replay old dates).\ncd \"$HERE\" || exit \"$rc\"\nreceipt_check=\"$(\"$PY\" -c '\nimport json, sys\ntry:\n    with open(sys.argv[1], encoding=\"utf-8\") as f:\n        d = json.load(f)\nexcept (OSError, ValueError):\n    print(\"unreadable\")\n    sys.exit(0)\nprint(\"ok\" if d.get(\"run_id\") == sys.argv[2] else \"from another run\")\n' \"$RECEIPT\" \"$RUN_ID\" 2>/dev/null)\"\nif [ \"$receipt_check\" != \"ok\" ]; then\n  alert \"error exit=$rc receipt not written by this run (${receipt_check:-unreadable})\"\n  if [ \"$rc\" -eq 0 ] || [ \"$rc\" -eq 3 ]; then\n    rc=5\n  fi\n  echo \"[$(stamp)] gps pull end exit=$rc (no receipt from this run)\"\n  exit \"$rc\"\nfi\n\nif [ \"$rc\" -ne 0 ]; then\n  reason=\"$(\"$PY\" -c '\nimport json, sys\nwith open(sys.argv[1], encoding=\"utf-8\") as f:\n    d = json.load(f)\nmsg = (d.get(\"error\") or \"\").replace(\"\\n\", \" \")[:200]\nstatus = d.get(\"status\") or \"error\"\nprint(f\"{status} exit={sys.argv[2]} {msg}\".rstrip())\n' \"$RECEIPT\" \"$rc\" 2>/dev/null)\"\n  alert \"${reason:-error exit=$rc}\"\nfi\n\n# 3. Coach reports for newly imported dates (ok or partial runs only). Failures are logged only.\nif [ \"$rc\" -eq 0 ] || [ \"$rc\" -eq 3 ]; then\n  cd \"$HERE\" || exit \"$rc\"\n  dates=\"$(\"$PY\" -c '\nimport json, sys\nwith open(sys.argv[1], encoding=\"utf-8\") as f:\n    print(\"\\n\".join(json.load(f).get(\"imported_dates\") or []))\n' \"$RECEIPT\" 2>/dev/null)\"\n  for d in $dates; do\n    cd \"$HERE\" || break\n    out_dir=\"$COACH_OUT/$d\"\n    mark=\"$(mktemp \"${TMPDIR:-/tmp}/gpspull-mark.XXXXXX\")\"\n    sleep 1  # mtime granularity: files written by this run must be newer than the marker\n    \"$PY\" \"$COACH\" --date \"$d\" --db \"$DB\"\n    crc=$?\n    echo \"[$(stamp)] coach_report $d exit=$crc\"\n    if [ \"$crc\" -ne 0 ]; then\n      alert \"coach-report $d exit=$crc\"\n    else\n      for f in coach_report.html coach_report.pdf; do\n        if [ ! -f \"$out_dir/$f\" ] || [ ! \"$out_dir/$f\" -nt \"$mark\" ]; then\n          alert \"coach-report $d missing $f (not written by this run)\"\n        fi\n      done\n    fi\n    rm -f \"$mark\"\n  done\nfi\n\necho \"[$(stamp)] gps pull end exit=$rc\"\nexit \"$rc\"\nINSTALLED_SAME\nBattery Power:\n Sleep On Power Button 1\n lowpowermode         1\n standby              1\n ttyskeepawake        1\n hibernatemode        3\n powernap             1\n hibernatefile        /var/vm/sleepimage\n displaysleep         2\n womp                 0\n networkoversleep     0\n sleep                1\n lessbright           1\n tcpkeepalive         1\n disksleep            10\nAC Power:\n Sleep On Power Button 1\n lowpowermode         1\n standby              1\n ttyskeepawake        1\n hibernatemode        3\n powernap             1\n hibernatefile        /var/vm/sleepimage\n displaysleep         10\n womp                 1\n networkoversleep     0\n sleep                1\n tcpkeepalive         1\n disksleep            10","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"f162dc11-8a6a-4ef5-a5ae-c4e786e7c1da","session_id":"b4e73986-d9fe-48ee-8449-471485f44b0e","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/DataBase_GPS_Reporting","sessionId":"b4e73986-d9fe-48ee-8449-471485f44b0e","version":"2.1.273","gitBranch":"main"}
