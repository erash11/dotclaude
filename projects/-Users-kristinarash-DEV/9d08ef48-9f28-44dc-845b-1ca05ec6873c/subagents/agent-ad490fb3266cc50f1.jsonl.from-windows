{"parentUuid":"08833667-4df4-4291-a2af-550ee929d0e1","isSidechain":true,"agentId":"ad490fb3266cc50f1","attachment":{"type":"deferred_tools_record","entries":[],"toolInputCopies":[{"id":"toolu_01DFQ8VRnFzekHZw3MywWRpq","copy":"wire"}]},"type":"attachment","uuid":"96df3aa9-766d-4393-9e5a-884102b6f3c3","timestamp":"2026-10-03T16:16:36.790Z","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"96df3aa9-766d-4393-9e5a-884102b6f3c3","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011CffbyDaLD32h3vm7pqyQ6","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1955,"cache_read_input_tokens":137113,"cache_creation":{"ephemeral_5m_input_tokens":1955,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":1071,"apiBlockIndex":0,"requestId":"req_011Cffby6NF8RphxwogxxinH","attributionAgent":"general-purpose","type":"assistant","uuid":"6dbf6d65-90db-495c-b150-0c9765a5fefb","timestamp":"2026-10-03T16:16:36.789Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"6dbf6d65-90db-495c-b150-0c9765a5fefb","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011CffbyDaLD32h3vm7pqyQ6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019Enprmcgwrrkpvz9BQiarw","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--berger-sets-reps-and-frequency-studies-in-novices.md","old_string":"with lighter weights \"about 10% of the entire load\" (PDF p. 270-271 / printed p. 259-260).","new_string":"with lighter weights \"about 10% of the entire load,\" and \"Other studies\" show that \"most weightlifting training is done with 1-3 repetitions for advanced weightlifters, thereby emphasizing the importance of 1RM, 2RM and 3RM loads for enhancing competitive strength, especially where strength-skill is involved\" (PDF p. 270 / printed p. 259, verified against the page image; Vorobyev 1978 at PDF p. 271 / printed p. 260)."},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1955,"cache_read_input_tokens":137113,"cache_creation":{"ephemeral_5m_input_tokens":1955,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_019Enprmcgwrrkpvz9BQiarw":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--berger-sets-reps-and-frequency-studies-in-novices.md","old_string":"with lighter weights \"about 10% of the entire load\" (PDF p. 270-271 / printed p. 259-260).","new_string":"with lighter weights \"about 10% of the entire load,\" and \"Other studies\" show that \"most weightlifting training is done with 1-3 repetitions for advanced weightlifters, thereby emphasizing the importance of 1RM, 2RM and 3RM loads for enhancing competitive strength, especially where strength-skill is involved\" (PDF p. 270 / printed p. 259, verified against the page image; Vorobyev 1978 at PDF p. 271 / printed p. 260)."}},"apiBlockIndex":1,"requestId":"req_011Cffby6NF8RphxwogxxinH","attributionAgent":"general-purpose","type":"assistant","uuid":"2fd6ff8d-0f0b-489f-bddc-d235bd9a055f","timestamp":"2026-10-03T16:16:38.898Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"2fd6ff8d-0f0b-489f-bddc-d235bd9a055f","isSidechain":true,"promptId":"03e4fd49-e0c7-4b5d-bb77-f25bc8e8f726","agentId":"ad490fb3266cc50f1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Enprmcgwrrkpvz9BQiarw","type":"tool_result","content":"The file /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--berger-sets-reps-and-frequency-studies-in-novices.md has been updated successfully."}]},"uuid":"e5a256ff-645d-4ddf-b66e-a10e2104a8e4","timestamp":"2026-10-03T16:16:39.001Z","toolUseResult":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--berger-sets-reps-and-frequency-studies-in-novices.md","oldString":"with lighter weights \"about 10% of the entire load\" (PDF p. 270-271 / printed p. 259-260).","newString":"with lighter weights \"about 10% of the entire load,\" and \"Other studies\" show that \"most weightlifting training is done with 1-3 repetitions for advanced weightlifters, thereby emphasizing the importance of 1RM, 2RM and 3RM loads for enhancing competitive strength, especially where strength-skill is involved\" (PDF p. 270 / printed p. 259, verified against the page image; Vorobyev 1978 at PDF p. 271 / printed p. 260).","originalFile":"---\ntype: library-entry\nkind: claim\ndomain: strength-and-conditioning\nbook: supertraining--verkhoshansky\nchapter: \"5.2.1\"\ntopic: sets reps and frequency for strength\ncategory: [maximal-strength, programming, training-frequency]\nconfidence: supported\ningest-tier: full-text\ncreated: 2026-10-03\n---\n\n# Berger's Sets, Reps and Frequency Studies: About 3 x 6RM, One Heavy Day a Week Carries the Gain, but the Subjects Were Novices\n\n**What it is** — The authors summarise early Western studies on sets, reps and frequency (PDF p. 270-271 / printed p. 259-260, verified against the page images). Of nine bench-press programmes, \"3 sets of 6 repetitions (with the 6RM weight) was the most effective (Berger, 1962),\" corroborating Keipen (1956) on three sets of the 5RM. Berger (1963) concluded that a heavy weight \"does not permit the optimal number of repetitions,\" and light weights with many reps offer \"too weak a stimulus,\" yet \"A significant difference in strength increase was not found between training regimes using 2RM, 5RM or 10RM,\" and there was \"no major difference between the effectiveness of 2 or 3 training sessions per week.\" \"Training with a rest interval of two days between sessions is significantly more effective than with a rest interval of one day (Vasiliev, 1954).\" Berger (1965) compared five programmes: (1) 2/3 of 1RM twice a week plus the 1RM in the third workout; (2) the same with 80% of 1RM; (3) with 90%; (4) 1RM once a week; (5) 2/3 of 1RM three times a week. \"The only programme which did not produce an increase in strength was the fifth one\"; the others gave \"approximately the same\" gains. The six conclusions include: submaximal twice plus maximal once a week equals maximal three times a week; the gain from programme 1 \"is due mainly to training with the 1RM\"; with three workouts a week the load per set \"should be between the 3RM and the 10RM\"; \"Training once a week with the 1RM for 1 set increases strength significantly for up to 6 weeks\"; twice a week with 3 x 10RM equals three times a week; and after one set of the 10RM, \"subsequent lifts with lighter loads have no training value.\" The authors then stress, in italics, that \"these conclusions were based on research with untrained subjects or subjects with very little training experience\" and that \"no single programme can be ideal for everyone (Berger, 1962, 1963).\" For qualified lifters they set against this Vorobyev (1978): \"between 1-6 repetitions is the optimum number for training highly qualified weightlifters and an increase in this number hinders strength development,\" and Vorobyev (1971): most of the load is at \"70% of 1RM and higher,\" with lighter weights \"about 10% of the entire load\" (PDF p. 270-271 / printed p. 259-260).\n\n**Why it works** — Berger's explanation, as reported, is a trade-off: too heavy a load allows too few reps, too light a load is too weak a stimulus (PDF p. 270 / printed p. 259). For frequency the authors give recovery: \"the recuperative powers of the body deteriorate under the influence of a large number of workouts per week\" (PDF p. 271 / printed p. 260).\n\n**When to apply** — Eric's baseline: \"No sport performs true 1RM testing\" (`docs/method-baseline.md` line 61, Explicit, Q10). Inference: the Berger results are about novices, which is the setting where they are most usable: freshmen and athletes new to barbell training gain on modest frequency, and one heavy exposure a week can carry most of the strength gain, which helps when practice load limits lifting days. For advanced lifters the Vorobyev figures (1-6 reps, most volume at 70% or more) are the authors' own guide.\n\n**When NOT to apply** — Do not carry the novice conclusions to trained athletes; the authors say so themselves. Several of the six conclusions are not traceable on the page: conclusion 1 speaks of \"maximal weights three times per week,\" which is none of the five listed programmes, and conclusions 3, 5 and 6 refer to data the page does not describe. Treat those as reported without their data. Berger (1962) favouring 3 x 6RM and Berger (1963) finding no difference between 2RM, 5RM and 10RM regimes are both printed on PDF p. 270 / printed p. 259 without reconciliation. The muscle tested in Berger 1965 and the study lengths are not given.\n\n**Example** — The authors' own example is Berger (1965) programme 4, the 1RM once a week, which raised strength about as much as the other programmes except programme 5, and conclusion 4, that one set of the 1RM once a week \"increases strength significantly for up to 6 weeks\" (PDF p. 270-271 / printed p. 259-260).\n\n**Related** — [[framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric]]; [[claim--delorme-oxford-mccloy-progressive-resistance-variants-compared]]; [[claim--strength-and-speed-training-response-shifts-with-training-age]] (training age changes the effective load); [[heuristic--program-variable-complexity-scales-with-training-age]]\n","structuredPatch":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # Berger's Sets, Reps and Frequency Studies: About 3 x 6RM, One Heavy Day a Week Carries the Gain, but the Subjects Were Novices"," ","-**What it is** — The authors summarise early Western studies on sets, reps and frequency (PDF p. 270-271 / printed p. 259-260, verified against the page images). Of nine bench-press programmes, \"3 sets of 6 repetitions (with the 6RM weight) was the most effective (Berger, 1962),\" corroborating Keipen (1956) on three sets of the 5RM. Berger (1963) concluded that a heavy weight \"does not permit the optimal number of repetitions,\" and light weights with many reps offer \"too weak a stimulus,\" yet \"A significant difference in strength increase was not found between training regimes using 2RM, 5RM or 10RM,\" and there was \"no major difference between the effectiveness of 2 or 3 training sessions per week.\" \"Training with a rest interval of two days between sessions is significantly more effective than with a rest interval of one day (Vasiliev, 1954).\" Berger (1965) compared five programmes: (1) 2/3 of 1RM twice a week plus the 1RM in the third workout; (2) the same with 80% of 1RM; (3) with 90%; (4) 1RM once a week; (5) 2/3 of 1RM three times a week. \"The only programme which did not produce an increase in strength was the fifth one\"; the others gave \"approximately the same\" gains. The six conclusions include: submaximal twice plus maximal once a week equals maximal three times a week; the gain from programme 1 \"is due mainly to training with the 1RM\"; with three workouts a week the load per set \"should be between the 3RM and the 10RM\"; \"Training once a week with the 1RM for 1 set increases strength significantly for up to 6 weeks\"; twice a week with 3 x 10RM equals three times a week; and after one set of the 10RM, \"subsequent lifts with lighter loads have no training value.\" The authors then stress, in italics, that \"these conclusions were based on research with untrained subjects or subjects with very little training experience\" and that \"no single programme can be ideal for everyone (Berger, 1962, 1963).\" For qualified lifters they set against this Vorobyev (1978): \"between 1-6 repetitions is the optimum number for training highly qualified weightlifters and an increase in this number hinders strength development,\" and Vorobyev (1971): most of the load is at \"70% of 1RM and higher,\" with lighter weights \"about 10% of the entire load\" (PDF p. 270-271 / printed p. 259-260).","+**What it is** — The authors summarise early Western studies on sets, reps and frequency (PDF p. 270-271 / printed p. 259-260, verified against the page images). Of nine bench-press programmes, \"3 sets of 6 repetitions (with the 6RM weight) was the most effective (Berger, 1962),\" corroborating Keipen (1956) on three sets of the 5RM. Berger (1963) concluded that a heavy weight \"does not permit the optimal number of repetitions,\" and light weights with many reps offer \"too weak a stimulus,\" yet \"A significant difference in strength increase was not found between training regimes using 2RM, 5RM or 10RM,\" and there was \"no major difference between the effectiveness of 2 or 3 training sessions per week.\" \"Training with a rest interval of two days between sessions is significantly more effective than with a rest interval of one day (Vasiliev, 1954).\" Berger (1965) compared five programmes: (1) 2/3 of 1RM twice a week plus the 1RM in the third workout; (2) the same with 80% of 1RM; (3) with 90%; (4) 1RM once a week; (5) 2/3 of 1RM three times a week. \"The only programme which did not produce an increase in strength was the fifth one\"; the others gave \"approximately the same\" gains. The six conclusions include: submaximal twice plus maximal once a week equals maximal three times a week; the gain from programme 1 \"is due mainly to training with the 1RM\"; with three workouts a week the load per set \"should be between the 3RM and the 10RM\"; \"Training once a week with the 1RM for 1 set increases strength significantly for up to 6 weeks\"; twice a week with 3 x 10RM equals three times a week; and after one set of the 10RM, \"subsequent lifts with lighter loads have no training value.\" The authors then stress, in italics, that \"these conclusions were based on research with untrained subjects or subjects with very little training experience\" and that \"no single programme can be ideal for everyone (Berger, 1962, 1963).\" For qualified lifters they set against this Vorobyev (1978): \"between 1-6 repetitions is the optimum number for training highly qualified weightlifters and an increase in this number hinders strength development,\" and Vorobyev (1971): most of the load is at \"70% of 1RM and higher,\" with lighter weights \"about 10% of the entire load,\" and \"Other studies\" show that \"most weightlifting training is done with 1-3 repetitions for advanced weightlifters, thereby emphasizing the importance of 1RM, 2RM and 3RM loads for enhancing competitive strength, especially where strength-skill is involved\" (PDF p. 270 / printed p. 259, verified against the page image; Vorobyev 1978 at PDF p. 271 / printed p. 260)."," "," **Why it works** — Berger's explanation, as reported, is a trade-off: too heavy a load allows too few reps, too light a load is too weak a stimulus (PDF p. 270 / printed p. 259). For frequency the authors give recovery: \"the recuperative powers of the body deteriorate under the influence of a large number of workouts per week\" (PDF p. 271 / printed p. 260)."," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"2fd6ff8d-0f0b-489f-bddc-d235bd9a055f","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"e5a256ff-645d-4ddf-b66e-a10e2104a8e4","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011CffbyDaLD32h3vm7pqyQ6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016yJNC19QEpEyFLeCrTnu47","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--berger-sets-reps-and-frequency-studies-in-novices.md","old_string":"Several of the six conclusions are not traceable on the page: conclusion 1 speaks of \"maximal weights three times per week,\" which is none of the five listed programmes, and conclusions 3, 5 and 6 refer to data the page does not describe. Treat those as reported without their data.","new_string":"The six conclusions are drawn partly from data outside the five-programme list: conclusion 1's \"maximal weights three times per week\" and conclusion 5 trace to the Berger (1963) sentences (\"10RM for one set three times per week\"; \"no major difference between the effectiveness of 2 or 3 training sessions per week,\" PDF p. 270 / printed p. 259), though conclusion 5 speaks of \"3 sets of the 10RM\" where that sentence describes one set; conclusion 3 traces loosely to the 2RM/5RM/10RM and 3 x 6RM results; and conclusion 6 traces to no data on the page. Treat conclusion 6 as reported without its data."},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1955,"cache_read_input_tokens":137113,"cache_creation":{"ephemeral_5m_input_tokens":1955,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_016yJNC19QEpEyFLeCrTnu47":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertra