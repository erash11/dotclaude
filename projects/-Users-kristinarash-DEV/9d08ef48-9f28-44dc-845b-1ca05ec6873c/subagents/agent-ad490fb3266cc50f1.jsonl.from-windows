ed]]; [[claim--berger-sets-reps-and-frequency-studies-in-novices]]; [[claim--ivanov-1966-training-mode-decides-which-strength-test-improves]]; [[claim--strength-detraining-and-retention-timelines]]; [[framework--types-of-maximal-strength]]; [[framework--sarcomere-vs-sarcoplasmic-hypertrophy]]; [[heuristic--isometric-training-execution-protocol-and-advantages-drawbacks]]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[],"moreFiles":0,"shared":true}},"sourceToolAssistantUUID":"469074a8-7f07-4d7e-b4c6-991f752a6dc4","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
