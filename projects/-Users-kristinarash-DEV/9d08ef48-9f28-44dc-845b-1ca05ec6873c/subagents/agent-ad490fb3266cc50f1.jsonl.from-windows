{"parentUuid":"08198173-3c57-426d-9002-e0fdaee5d44e","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011Cffbx5WNN3YBDxpyr27Kt","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2233,"cache_read_input_tokens":133478,"cache_creation":{"ephemeral_5m_input_tokens":2233,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":649,"apiBlockIndex":0,"requestId":"req_011CffbwomLaSzGu5Ns8cZjr","attributionAgent":"general-purpose","type":"assistant","uuid":"f91d4af6-0436-4544-b0d9-9f0a1cf8527c","timestamp":"2026-10-03T16:16:20.853Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"f91d4af6-0436-4544-b0d9-9f0a1cf8527c","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011Cffbx5WNN3YBDxpyr27Kt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QeqWtrAgVFpQww2WqNPy6v","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","old_string":"These three are not consistent; do not use any one as a rep-to-load conversion.","new_string":"Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion."},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2233,"cache_read_input_tokens":133478,"cache_creation":{"ephemeral_5m_input_tokens":2233,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01QeqWtrAgVFpQww2WqNPy6v":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","old_string":"These three are not consistent; do not use any one as a rep-to-load conversion.","new_string":"Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion."}},"apiBlockIndex":1,"requestId":"req_011CffbwomLaSzGu5Ns8cZjr","attributionAgent":"general-purpose","type":"assistant","uuid":"601070ed-d90c-4500-93bc-14a61743423d","timestamp":"2026-10-03T16:16:22.547Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"601070ed-d90c-4500-93bc-14a61743423d","isSidechain":true,"promptId":"03e4fd49-e0c7-4b5d-bb77-f25bc8e8f726","agentId":"ad490fb3266cc50f1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QeqWtrAgVFpQww2WqNPy6v","type":"tool_result","content":"The file /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md has been updated successfully."}]},"uuid":"cddcfa89-f320-4ade-bd81-0be3ccba9278","timestamp":"2026-10-03T16:16:22.652Z","toolUseResult":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","oldString":"These three are not consistent; do not use any one as a rep-to-load conversion.","newString":"Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion.","originalFile":"---\ntype: library-entry\nkind: framework\ndomain: strength-and-conditioning\nbook: supertraining--verkhoshansky\nchapter: \"5.2.1\"\ntopic: maximum strength methods\ncategory: [maximal-strength, programming, hypertrophy]\nconfidence: contested\ningest-tier: full-text\ncreated: 2026-10-03\n---\n\n# Three Methods for Maximum Strength (Repetitive Effort, Brief Maximal Tension, Isometric) and When Each Is Used\n\n**What it is** — Maximum strength in this chapter is \"the maximal force that a person can develop voluntarily,\" shown \"under isometric conditions or in a very slow movement against a maximal load.\" There are \"two basic methods\": \"the method of repetitive effort and the method of brief maximal tension\" (PDF p. 269 / printed p. 258), with isometrics discussed as a third option (PDF p. 271-272 / printed p. 260-261). The authors' summary (PDF p. 272 / printed p. 261, verified against the page image):\n- **Repetitive effort**: lifting a weight that is raised as strength grows; \"appropriate in the initial stages of strength development and when strength and its speed of production are not important.\" Moderate weights \"(50-60% of 1RM)\" for \"8-12\" reps increase muscle mass; heavy weights \"(90-95% of 1RM)\" for \"3-6\" reps raise strength faster with a smaller mass gain. The effect grows with \"the magnitude of the load and the volume of work.\" The authors attribute its effect to proprioceptive feedback from slow lifting, strong cortex-to-muscle excitation and more motor units recruited (Kabat 1947; Hellebrant & Houtz 1956; PDF p. 269 / printed p. 258).\n- **Brief maximal tension**: \"heavy weights (85-95% of 1RM, i.e. 3-5RM)\" combined with lighter weights in the session and maximal singles \"once or twice a week\"; weightlifters \"execute 5-6 exercises for 6-10 sets of 1-3 repetitions in one training session (Medvedev, 1967; Vorobyev, 1971)\" (PDF p. 271 / printed p. 260). It raises maximum strength \"without appreciably increasing muscle mass,\" improves \"the ability to display strength quickly,\" suits athletes needing relative strength, and is used \"when the repetitive effort method has become ineffective,\" when strength must rise \"quickly in a relatively short period with a small volume of work,\" and to maintain strength and \"sporting form\" (PDF p. 272 / printed p. 261).\n- **Isometric tension (with gradual increase in effort)**: maximum strength without mass gain; to maintain strength \"where speed of movement is not important,\" in preparatory training, and \"during the early stages of musculoskeletal rehabilitation, when movement might be restricted.\" Isometric tension \"may be applied slowly or explosively (see 4.2.4)\" (PDF p. 272 / printed p. 261).\n\n**Why it works** — The authors' explanation is neuromuscular specificity: \"Similar significant increases in maximum strength can be obtained\" by all three, \"However, the strength acquired from each of these methods has its own neuromuscular specificity\" (PDF p. 272 / printed p. 261). For brief maximal tension they say it \"develops the ability to concentrate neuromuscular effort\" and that lifting near-maximal weights \"enhances the ability to accelerate heavy loads\" (PDF p. 271 / printed p. 260). They also note that strength \"is retained for longer if it is founded first upon a base of increased muscle hypertrophy\" and declines faster if built mainly on neuromuscular efficiency (PDF p. 269 / printed p. 258); that retention point is atomized in [[claim--strength-detraining-and-retention-timelines]].\n\n**When to apply** — Eric's baseline: \"No sport performs true 1RM testing. Maxes are projected from observation plus the athlete's history\" (`docs/method-baseline.md` line 61, Explicit, Q10), and %1RM prescription is kept \"stated explicitly as built on projected maxes\" (line 260, Tension 16). Inference: the percentage bands here are therefore percentages of a projected max, so the RM descriptions (3-5RM, 8-12 reps) are the safer way to apply them. The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule lines up with the authors' sequence, repetitive effort first and brief maximal tension once it stops working. Inference: the in-season rule \"maintain intensity, reduce volume\" (line 105) matches the authors' use of brief maximal tension \"for maintaining the existing level of strength.\"\n\n**When NOT to apply** — The book contradicts itself on several details; keep both sides. (1) Sets: brief maximal tension needs sets \"increased to more than three (Berger, 1962)\" (PDF p. 271 / printed p. 260), but its effect \"is enhanced by increasing the maximal weight, increasing the average weight lifted per session and reducing the number of sets and repetitions\" (PDF p. 272 / printed p. 261). (2) Size of effect: brief maximal tension \"yields a larger training effect than the progressive resistance method for developing maximum strength\" (Diachkov 1961; Chudinov 1961; PDF p. 271 / printed p. 260), against \"Similar significant increases in maximum strength can be obtained by the repetitive effort and brief maximal tension methods, as well as with isometric tension\" (PDF p. 272 / printed p. 261). (3) Isometrics: isometric training \"does not increase strength significantly more\" than dynamic lifting (Salter 1955; PDF p. 271 / printed p. 260) and dynamic 3 x 5-6 \"is more effective than the corresponding amount of isometric work\" (Rasch & Morehouse 1957; Berger 1962; PDF p. 272 / printed p. 261), against the \"similar significant increases ... with isometric tension\" sentence on the same page. (4) Load-rep pairings: the 5RM is \"about 89%\" of 1RM (PDF p. 269 / printed p. 258), yet \"90-95% of 1RM\" is paired with \"3-6\" reps (PDF p. 272 / printed p. 261), and \"85-95% of 1RM\" with \"3-5RM\" (PDF p. 271 / printed p. 260). These three are not consistent; do not use any one as a rep-to-load conversion. Inference: for sports decided by fast force production, these three methods are not the whole answer; the authors put speed-strength and explosive work in separate method groups (5.2.3-5.2.4).\n\n**Example** — The authors' own prescription for weightlifters under brief maximal tension: \"5-6 exercises for 6-10 sets of 1-3 repetitions in one training session (Medvedev, 1967; Vorobyev, 1971)\" (PDF p. 271 / printed p. 260).\n\n**Related** — [[claim--delorme-oxford-mccloy-progressive-resistance-variants-compared]]; [[claim--berger-sets-reps-and-frequency-studies-in-novices]]; [[claim--ivanov-1966-training-mode-decides-which-strength-test-improves]]; [[claim--strength-detraining-and-retention-timelines]]; [[framework--types-of-maximal-strength]]; [[framework--sarcomere-vs-sarcoplasmic-hypertrophy]]; [[heuristic--isometric-training-execution-protocol-and-advantages-drawbacks]]\n","structuredPatch":[{"oldStart":22,"oldLines":7,"newStart":22,"newLines":7,"lines":[" "," **When to apply** — Eric's baseline: \"No sport performs true 1RM testing. Maxes are projected from observation plus the athlete's history\" (`docs/method-baseline.md` line 61, Explicit, Q10), and %1RM prescription is kept \"stated explicitly as built on projected maxes\" (line 260, Tension 16). Inference: the percentage bands here are therefore percentages of a projected max, so the RM descriptions (3-5RM, 8-12 reps) are the safer way to apply them. The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule lines up with the authors' sequence, repetitive effort first and brief maximal tension once it stops working. Inference: the in-season rule \"maintain intensity, reduce volume\" (line 105) matches the authors' use of brief maximal tension \"for maintaining the existing level of strength.\""," ","-**When NOT to apply** — The book contradicts itself on several details; keep both sides. (1) Sets: brief maximal tension needs sets \"increased to more than three (Berger, 1962)\" (PDF p. 271 / printed p. 260), but its effect \"is enhanced by increasing the maximal weight, increasing the average weight lifted per session and reducing the number of sets and repetitions\" (PDF p. 272 / printed p. 261). (2) Size of effect: brief maximal tension \"yields a larger training effect than the progressive resistance method for developing maximum strength\" (Diachkov 1961; Chudinov 1961; PDF p. 271 / printed p. 260), against \"Similar significant increases in maximum strength can be obtained by the repetitive effort and brief maximal tension methods, as well as with isometric tension\" (PDF p. 272 / printed p. 261). (3) Isometrics: isometric training \"does not increase strength significantly more\" than dynamic lifting (Salter 1955; PDF p. 271 / printed p. 260) and dynamic 3 x 5-6 \"is more effective than the corresponding amount of isometric work\" (Rasch & Morehouse 1957; Berger 1962; PDF p. 272 / printed p. 261), against the \"similar significant increases ... with isometric tension\" sentence on the same page. (4) Load-rep pairings: the 5RM is \"about 89%\" of 1RM (PDF p. 269 / printed p. 258), yet \"90-95% of 1RM\" is paired with \"3-6\" reps (PDF p. 272 / printed p. 261), and \"85-95% of 1RM\" with \"3-5RM\" (PDF p. 271 / printed p. 260). These three are not consistent; do not use any one as a rep-to-load conversion. Inference: for sports decided by fast force production, these three methods are not the whole answer; the authors put speed-strength and explosive work in separate method groups (5.2.3-5.2.4).","+**When NOT to apply** — The book contradicts itself on several details; keep both sides. (1) Sets: brief maximal tension needs sets \"increased to more than three (Berger, 1962)\" (PDF p. 271 / printed p. 260), but its effect \"is enhanced by increasing the maximal weight, increasing the average weight lifted per session and reducing the number of sets and repetitions\" (PDF p. 272 / printed p. 261). (2) Size of effect: brief maximal tension \"yields a larger training effect than the progressive resistance method for developing maximum strength\" (Diachkov 1961; Chudinov 1961; PDF p. 271 / printed p. 260), against \"Similar significant increases in maximum strength can be obtained by the repetitive effort and brief maximal tension methods, as well as with isometric tension\" (PDF p. 272 / printed p. 261). (3) Isometrics: isometric training \"does not increase strength significantly more\" than dynamic lifting (Salter 1955; PDF p. 271 / printed p. 260) and dynamic 3 x 5-6 \"is more effective than the corresponding amount of isometric work\" (Rasch & Morehouse 1957; Berger 1962; PDF p. 272 / printed p. 261), against the \"similar significant increases ... with isometric tension\" sentence on the same page. (4) Load-rep pairings: the 5RM is \"about 89%\" of 1RM (PDF p. 269 / printed p. 258), yet \"90-95% of 1RM\" is paired with \"3-6\" reps (PDF p. 272 / printed p. 261), and \"85-95% of 1RM\" with \"3-5RM\" (PDF p. 271 / printed p. 260). Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion. Inference: for sports decided by fast force production, these three methods are not the whole answer; the authors put speed-strength and explosive work in separate method groups (5.2.3-5.2.4)."," "," **Example** — The authors' own prescription for weightlifters under brief maximal tension: \"5-6 exercises for 6-10 sets of 1-3 repetitions in one training session (Medvedev, 1967; Vorobyev, 1971)\" (PDF p. 271 / printed p. 260)."," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"601070ed-d90c-4500-93bc-14a61743423d","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"cddcfa89-f320-4ade-bd81-0be3ccba9278","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011Cffbx5WNN3YBDxpyr27Kt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C4VpmwTPDZv99TFKCQSpHv","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","old_string":"The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule","new_string":"Eric's baseline: off-season strength work prioritizes \"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work\" (line 105, Inferred, transcript and shared slides). Inference: that rule"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2233,"cache_read_input_tokens":133478,"cache_creation":{"ephemeral_5m_input_tokens":2233,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01C4VpmwTPDZv99TFKCQSpHv":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","old_string":"The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule","new_string":"Eric's baseline: off-season strength work prioritizes \"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work\" (line 105, Inferred, transcript and shared slides). Inference: that rule"}},"apiBlockIndex":2,"requestId":"req_011CffbwomLaSzGu5Ns8cZjr","attributionAgent":"general-purpose","type":"assistant","uuid":"aa57bf0f-8c20-40b5-9fe2-eedbd0ee59ed","timestamp":"2026-10-03T16:16:24.596Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"aa57bf0f-8c20-40b5-9fe2-eedbd0ee59ed","isSidechain":true,"promptId":"03e4fd49-e0c7-4b5d-bb77-f25bc8e8f726","agentId":"ad490fb3266cc50f1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C4VpmwTPDZv99TFKCQSpHv","type":"tool_result","content":"The file /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md has been updated successfully."}]},"uuid":"c6a67203-8517-452b-8ebb-3d6427c0703e","timestamp":"2026-10-03T16:16:24.670Z","toolUseResult":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--three-methods-for-maximum-strength-repetitive-brief-maximal-isometric.md","oldString":"The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule","newString":"Eric's baseline: off-season strength work prioritizes \"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work\" (line 105, Inferred, transcript and shared slides). Inference: that rule","originalFile":"---\ntype: library-entry\nkind: framework\ndomain: strength-and-conditioning\nbook: supertraining--verkhoshansky\nchapter: \"5.2.1\"\ntopic: maximum strength methods\ncategory: [maximal-strength, programming, hypertrophy]\nconfidence: contested\ningest-tier: full-text\ncreated: 2026-10-03\n---\n\n# Three Methods for Maximum Strength (Repetitive Effort, Brief Maximal Tension, Isometric) and When Each Is Used\n\n**What it is** — Maximum strength in this chapter is \"the maximal force that a person can develop voluntarily,\" shown \"under isometric conditions or in a very slow movement against a maximal load.\" There are \"two basic methods\": \"the method of repetitive effort and the method of brief maximal tension\" (PDF p. 269 / printed p. 258), with isometrics discussed as a third option (PDF p. 271-272 / printed p. 260-261). The authors' summary (PDF p. 272 / printed p. 261, verified against the page image):\n- **Repetitive effort**: lifting a weight that is raised as strength grows; \"appropriate in the initial stages of strength development and when strength and its speed of production are not important.\" Moderate weights \"(50-60% of 1RM)\" for \"8-12\" reps increase muscle mass; heavy weights \"(90-95% of 1RM)\" for \"3-6\" reps raise strength faster with a smaller mass gain. The effect grows with \"the magnitude of the load and the volume of work.\" The authors attribute its effect to proprioceptive feedback from slow lifting, strong cortex-to-muscle excitation and more motor units recruited (Kabat 1947; Hellebrant & Houtz 1956; PDF p. 269 / printed p. 258).\n- **Brief maximal tension**: \"heavy weights (85-95% of 1RM, i.e. 3-5RM)\" combined with lighter weights in the session and maximal singles \"once or twice a week\"; weightlifters \"execute 5-6 exercises for 6-10 sets of 1-3 repetitions in one training session (Medvedev, 1967; Vorobyev, 1971)\" (PDF p. 271 / printed p. 260). It raises maximum strength \"without appreciably increasing muscle mass,\" improves \"the ability to display strength quickly,\" suits athletes needing relative strength, and is used \"when the repetitive effort method has become ineffective,\" when strength must rise \"quickly in a relatively short period with a small volume of work,\" and to maintain strength and \"sporting form\" (PDF p. 272 / printed p. 261).\n- **Isometric tension (with gradual increase in effort)**: maximum strength without mass gain; to maintain strength \"where speed of movement is not important,\" in preparatory training, and \"during the early stages of musculoskeletal rehabilitation, when movement might be restricted.\" Isometric tension \"may be applied slowly or explosively (see 4.2.4)\" (PDF p. 272 / printed p. 261).\n\n**Why it works** — The authors' explanation is neuromuscular specificity: \"Similar significant increases in maximum strength can be obtained\" by all three, \"However, the strength acquired from each of these methods has its own neuromuscular specificity\" (PDF p. 272 / printed p. 261). For brief maximal tension they say it \"develops the ability to concentrate neuromuscular effort\" and that lifting near-maximal weights \"enhances the ability to accelerate heavy loads\" (PDF p. 271 / printed p. 260). They also note that strength \"is retained for longer if it is founded first upon a base of increased muscle hypertrophy\" and declines faster if built mainly on neuromuscular efficiency (PDF p. 269 / printed p. 258); that retention point is atomized in [[claim--strength-detraining-and-retention-timelines]].\n\n**When to apply** — Eric's baseline: \"No sport performs true 1RM testing. Maxes are projected from observation plus the athlete's history\" (`docs/method-baseline.md` line 61, Explicit, Q10), and %1RM prescription is kept \"stated explicitly as built on projected maxes\" (line 260, Tension 16). Inference: the percentage bands here are therefore percentages of a projected max, so the RM descriptions (3-5RM, 8-12 reps) are the safer way to apply them. The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule lines up with the authors' sequence, repetitive effort first and brief maximal tension once it stops working. Inference: the in-season rule \"maintain intensity, reduce volume\" (line 105) matches the authors' use of brief maximal tension \"for maintaining the existing level of strength.\"\n\n**When NOT to apply** — The book contradicts itself on several details; keep both sides. (1) Sets: brief maximal tension needs sets \"increased to more than three (Berger, 1962)\" (PDF p. 271 / printed p. 260), but its effect \"is enhanced by increasing the maximal weight, increasing the average weight lifted per session and reducing the number of sets and repetitions\" (PDF p. 272 / printed p. 261). (2) Size of effect: brief maximal tension \"yields a larger training effect than the progressive resistance method for developing maximum strength\" (Diachkov 1961; Chudinov 1961; PDF p. 271 / printed p. 260), against \"Similar significant increases in maximum strength can be obtained by the repetitive effort and brief maximal tension methods, as well as with isometric tension\" (PDF p. 272 / printed p. 261). (3) Isometrics: isometric training \"does not increase strength significantly more\" than dynamic lifting (Salter 1955; PDF p. 271 / printed p. 260) and dynamic 3 x 5-6 \"is more effective than the corresponding amount of isometric work\" (Rasch & Morehouse 1957; Berger 1962; PDF p. 272 / printed p. 261), against the \"similar significant increases ... with isometric tension\" sentence on the same page. (4) Load-rep pairings: the 5RM is \"about 89%\" of 1RM (PDF p. 269 / printed p. 258), yet \"90-95% of 1RM\" is paired with \"3-6\" reps (PDF p. 272 / printed p. 261), and \"85-95% of 1RM\" with \"3-5RM\" (PDF p. 271 / printed p. 260). Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion. Inference: for sports decided by fast force production, these three methods are not the whole answer; the authors put speed-strength and explosive work in separate method groups (5.2.3-5.2.4).\n\n**Example** — The authors' own prescription for weightlifters under brief maximal tension: \"5-6 exercises for 6-10 sets of 1-3 repetitions in one training session (Medvedev, 1967; Vorobyev, 1971)\" (PDF p. 271 / printed p. 260).\n\n**Related** — [[claim--delorme-oxford-mccloy-progressive-resistance-variants-compared]]; [[claim--berger-sets-reps-and-frequency-studies-in-novices]]; [[claim--ivanov-1966-training-mode-decides-which-strength-test-improves]]; [[claim--strength-detraining-and-retention-timelines]]; [[framework--types-of-maximal-strength]]; [[framework--sarcomere-vs-sarcoplasmic-hypertrophy]]; [[heuristic--isometric-training-execution-protocol-and-advantages-drawbacks]]\n","structuredPatch":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":7,"lines":[" "," **Why it works** — The authors' explanation is neuromuscular specificity: \"Similar significant increases in maximum strength can be obtained\" by all three, \"However, the strength acquired from each of these methods has its own neuromuscular specificity\" (PDF p. 272 / printed p. 261). For brief maximal tension they say it \"develops the ability to concentrate neuromuscular effort\" and that lifting near-maximal weights \"enhances the ability to accelerate heavy loads\" (PDF p. 271 / printed p. 260). They also note that strength \"is retained for longer if it is founded first upon a base of increased muscle hypertrophy\" and declines faster if built mainly on neuromuscular efficiency (PDF p. 269 / printed p. 258); that retention point is atomized in [[claim--strength-detraining-and-retention-timelines]]."," ","-**When to apply** — Eric's baseline: \"No sport performs true 1RM testing. Maxes are projected from observation plus the athlete's history\" (`docs/method-baseline.md` line 61, Explicit, Q10), and %1RM prescription is kept \"stated explicitly as built on projected maxes\" (line 260, Tension 16). Inference: the percentage bands here are therefore percentages of a projected max, so the RM descriptions (3-5RM, 8-12 reps) are the safer way to apply them. The baseline's off-season rule (\"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work,\" line 105, course material, Inferred). Inference: that rule lines up with the authors' sequence, repetitive effort first and brief maximal tension once it stops working. Inference: the in-season rule \"maintain intensity, reduce volume\" (line 105) matches the authors' use of brief maximal tension \"for maintaining the existing level of strength.\"","+**When to apply** — Eric's baseline: \"No sport performs true 1RM testing. Maxes are projected from observation plus the athlete's history\" (`docs/method-baseline.md` line 61, Explicit, Q10), and %1RM prescription is kept \"stated explicitly as built on projected maxes\" (line 260, Tension 16). Inference: the percentage bands here are therefore percentages of a projected max, so the RM descriptions (3-5RM, 8-12 reps) are the safer way to apply them. Eric's baseline: off-season strength work prioritizes \"relative strength and technique first; already-strong athletes shift more time toward strength-speed/speed-strength work\" (line 105, Inferred, transcript and shared slides). Inference: that rule lines up with the authors' sequence, repetitive effort first and brief maximal tension once it stops working. Inference: the in-season rule \"maintain intensity, reduce volume\" (line 105) matches the authors' use of brief maximal tension \"for maintaining the existing level of strength.\""," "," **When NOT to apply** — The book contradicts itself on several details; keep both sides. (1) Sets: brief maximal tension needs sets \"increased to more than three (Berger, 1962)\" (PDF p. 271 / printed p. 260), but its effect \"is enhanced by increasing the maximal weight, increasing the average weight lifted per session and reducing the number of sets and repetitions\" (PDF p. 272 / printed p. 261). (2) Size of effect: brief maximal tension \"yields a larger training effect than the progressive resistance method for developing maximum strength\" (Diachkov 1961; Chudinov 1961; PDF p. 271 / printed p. 260), against \"Similar significant increases in maximum strength can be obtained by the repetitive effort and brief maximal tension methods, as well as with isometric tension\" (PDF p. 272 / printed p. 261). (3) Isometrics: isometric training \"does not increase strength significantly more\" than dynamic lifting (Salter 1955; PDF p. 271 / printed p. 260) and dynamic 3 x 5-6 \"is more effective than the corresponding amount of isometric work\" (Rasch & Morehouse 1957; Berger 1962; PDF p. 272 / printed p. 261), against the \"similar significant increases ... with isometric tension\" sentence on the same page. (4) Load-rep pairings: the 5RM is \"about 89%\" of 1RM (PDF p. 269 / printed p. 258), yet \"90-95% of 1RM\" is paired with \"3-6\" reps (PDF p. 272 / printed p. 261), and \"85-95% of 1RM\" with \"3-5RM\" (PDF p. 271 / printed p. 260). Inference: the 90-95% with 3-6 reps pairing clearly clashes with 5RM = 89% (six reps cannot be done at 90% or more if five reps is 89%); the 85-95% = 3-5RM pairing is only loosely off (it implies a 5RM near 85%). Do not use any of them as a rep-to-load conversion. Inference: for sports decided by fast force production, these three methods are not the whole answer; the authors put speed-strength and explosive work in separate method groups (5.2.3-5.2.4)."," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"aa57bf0f-8c20-40b5-9fe2-eedbd0ee59ed","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"c6a67203-8517-452b-8ebb-3d6427c0703e","isSidechain":true,"agentId":"ad490fb3266cc50f1","message":{"model":"claude-opus-5-5","id":"msg_011Cffbx5WNN3YBDxpyr27Kt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YXouZG7PJ1Gat7GgtsnKWW","name":"Read","input":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--delorme-oxford-mccloy-progressive-resistance-variants-compared.md","offset":22,"limit":1},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2233,"cache_read_input_tokens":133478,"output_tokens":887,"output_tokens_details":{"thinking_tokens":93},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2233},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":887,"cache_read_input_tokens":133478,"cache_creation_input_tokens":2233,"cache_creation":{"ephemeral_5m_input_tokens":2233,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01YXouZG7PJ1Gat7GgtsnKWW":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--delorme-oxford-mccloy-progressive-resistance-variants-compared.md","offset":22,"limit":1}},"apiBlockIndex":3,"requestId":"req_011CffbwomLaSzGu5Ns8cZjr","attributionAgent":"general-purpose","type":"assistant","uuid":"677a4d5d-0f34-4ef2-aaa2-0c9786c1ea24","timestamp":"2026-10-03T16:16:25.588Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"677a4d5d-0f34-4ef2-aaa2-0c9786c1ea24","isSidechain":true,"promptId":"03e4fd49-e0c7-4b5d-bb77-f25bc8e8f726","agentId":"ad490fb3266cc50f1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YXouZG7PJ1Gat7GgtsnKWW","type":"tool_result","content":"22\t**When NOT to apply** — Faulkner's percentages do not state their baseline or measure (154% of what), so read them only as a ranking, not as effect sizes. The authors themselves say the size difference is uncorroborated, especially in advanced athletes. The Krusen comparison as printed has sets at \"125%\" and \"150% of the 5RM\" for 5 reps, which no lifter can do; treat that line as unclear and do not cite it (Inference: a misprint or a different reference load would explain it, but the book gives no correction). The frog-muscle finding is a fatigue observation, not a strength-training trial. All the studies are 1945-1960 work, mostly in rehabilitation or untrained subjects."}]},"uuid":"4771af84-8149-45c9-8974-797c65b2f80c","timestamp":"2026-10-03T16:16:25.755Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--delorme-oxford-mccloy-progressive-resistance-variants-compared.md","content":"**When NOT to apply** — Faulkner's percentages do not state their baseline or measure (154% of what), so read them only as a ranking, not as effect sizes. The authors themselves say the size difference is uncorroborated, especially in advanced athletes. The Krusen comparison as printed has sets at \"125%\" and \"150% of the 5RM\" for 5 reps, which no lifter can do; treat that line as unclear and do not cite it (Inference: a misprint or a different reference load would explain it, but the book gives no correction). The frog-muscle finding is a fatigue observation, not a strength-training trial. All the studies are 1945-1960 work, mostly in rehabilitation or untrained subjects.","numLines":1,"startLine":22,"totalLines":27}},"sourceToolAssistantUUID":"677a4d5d-0f34-4ef2-aaa2-0c9786c1ea24","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
