^\\]|#]+)\", text):\n            link = link.strip().removesuffix(\".md\")\n            if link not in known and link.split(\"/\")[-1] not in known:\n                issues.append(f\"unresolved [[{link}]]\")\n        if not f.name.startswith(\"_\"):\n            m = re.search(r\"^confidence:\\s*(\\S+)\", text, re.M)\n            if not m or m.group(1).strip(\"\\\"'\") not in CONF:","is_error":false}]},"uuid":"5347f00d-a22b-4618-b0f2-ea3306052cf6","timestamp":"2026-10-03T18:15:26.072Z","toolUseResult":{"stdout":"**Related** — [[framework--conditions-for-concentrated-unidirectional-loading]], [[heuristic--allow-restoration-after-a-concentrated-block-before-the-next]], [[principle--sequentially-introduce-means-of-greater-training-effect]], [[heuristic--replace-means-as-their-training-effect-fades]], [[framework--sequential-and-concurrent-variants-of-systematic-means]], [[framework--four-principles-of-special-strength-training-organisation]], [[block-periodization--issurin/principle--concentration-of-training-workloads]], [[block-periodization--issurin/framework--accumulation-transmutation-realization-mesocycles]] (Issurin's multi-targeted alternative), [[periodization--bompa/principle--concentrated-loading-overreaching]], [[research-papers/issurin-2016-benefits-and-limitations-of-block-periodized-training-approaches-to-athletes-preparation-a]]\nContested by Issurin.** The library's summary of Issurin 2016 (*Sports Medicine*, pp.\nCONF = {\"proven\", \"supported\", \"untested\", \"contested\"}\nSECTIONS = [\"**What it is**\", \"**When NOT to apply**\"]\n\nknown = set()\nfor root in (STAGING, VAULT):\n    for p in root.rglob(\"*.md\"):\n        known.add(p.stem)\n        known.add(p.relative_to(root).with_suffix(\"\").as_posix())\n        known.add(p.parent.name + \"/\" + p.stem)\n\nproblems = 0\nfor folder in sys.argv[1:]:\n    for f in sorted(Path(folder).glob(\"*.md\")):\n        text = f.read_text(encoding=\"utf-8\")\n        issues = []\n        body_dash = [i + 1 for i, line in enumerate(text.splitlines())\n                     if \"—\" in HEADER.sub(\"\", line)]\n        if body_dash:\n            issues.append(f\"body em dash lines {body_dash[:8]}\")\n        for link in re.findall(r\"\\[\\[([^\\]|#]+)\", text):\n            link = link.strip().removesuffix(\".md\")\n            if link not in known and link.split(\"/\")[-1] not in known:\n                issues.append(f\"unresolved [[{link}]]\")\n        if not f.name.startswith(\"_\"):\n            m = re.search(r\"^confidence:\\s*(\\S+)\", text, re.M)\n            if not m or m.group(1).strip(\"\\\"'\") not in CONF:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"6c19a1c4-ec60-4239-9d09-8b64281fd3cb","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
