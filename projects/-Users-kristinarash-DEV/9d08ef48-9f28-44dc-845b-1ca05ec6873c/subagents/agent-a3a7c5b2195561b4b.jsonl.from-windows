/strength-and-conditioning/supertraining--verkhoshansky/claim--bondarchuk-50-percent-more-volume-did-not-prolong-training-effect.md"]}},"sourceToolAssistantUUID":"3adb2249-f207-4046-9c81-815c5b05ad88","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
