xt_management":null},"wireToolInputs":{"toolu_01LmZTQMkEJB6rAGqp4Efzj3":{"command":"cd /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky && for f in framework--pnf-activation-and-relaxation-techniques.md claim--novices-progress-from-mobility-to-stability-pnf-sequence.md heuristic--use-pulleys-and-dumbbells-for-spiral-diagonal-pnf-patterns.md principle--train-for-a-safety-factor-above-competition-forces.md claim--functional-training-means-sport-specific-and-no-exercise-is-non-functional.md; do perl -0pi -e 's/\\Q(7.2 rests on his 1989 NSCA workshop, PDF p. 430 \\/ printed p. 419)\\E/(in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 \\/ printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 \\/ printed p. 419)/' \"$f\"; echo \"$f $(grep -c 'PDF p. 429 / printed p. 418, and that' \"$f\")\"; done"}},"apiBlockIndex":1,"requestId":"req_011CffrALFcDTBeGqr12Fo4d","attributionAgent":"general-purpose","type":"assistant","uuid":"8a18a6be-22c5-46a8-bb74-5129e031f98c","timestamp":"2026-10-03T19:22:49.005Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"8a18a6be-22c5-46a8-bb74-5129e031f98c","isSidechain":true,"promptId":"189515d2-55e8-482a-8b52-f518760b72bc","agentId":"afcd6d73916c3b3e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LmZTQMkEJB6rAGqp4Efzj3","type":"tool_result","content":"framework--pnf-activation-and-relaxation-techniques.md 1\nclaim--novices-progress-from-mobility-to-stability-pnf-sequence.md 1\nheuristic--use-pulleys-and-dumbbells-for-spiral-diagonal-pnf-patterns.md 1\nprinciple--train-for-a-safety-factor-above-competition-forces.md 1\nclaim--functional-training-means-sport-specific-and-no-exercise-is-non-functional.md 1","is_error":false}]},"uuid":"432f3571-5f28-435a-9847-ba9ae768bc34","timestamp":"2026-10-03T19:22:49.295Z","toolUseResult":{"stdout":"framework--pnf-activation-and-relaxation-techniques.md 1\nclaim--novices-progress-from-mobility-to-stability-pnf-sequence.md 1\nheuristic--use-pulleys-and-dumbbells-for-spiral-diagonal-pnf-patterns.md 1\nprinciple--train-for-a-safety-factor-above-competition-forces.md 1\nclaim--functional-training-means-sport-specific-and-no-exercise-is-non-functional.md 1","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--functional-training-means-sport-specific-and-no-exercise-is-non-functional.md","hunks":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # \"Functional Training\" Is Only a Synonym for Sport-Specific Training, and No Single Exercise Is \"Non-Functional\""," ","-**What it is** — Siff (7.2 rests on his 1989 NSCA workshop, PDF p. 430 / printed p. 419) proposes replacing \"modified PNF\" with Functional Neuromuscular Conditioning (FNC), for five reasons: it is \"sometimes desirable to deviate from strict PNF principles\"; other disciplines (\"Feldenkrais, Alexander, yoga, Tai Chi and Laban\") add methods; contraction \"may be facilitated by local after-discharge of the same muscle,\" so not all is neuromuscular; some PNF methods \"may not be classified accurately as proprioceptive, such as cognitive, perceptual and other sensory mechanisms\"; and the full name \"is too technically daunting for the average coach or athlete.\" FNC \"should be regarded as an entire conditioning system capable of developing any desired type of musculoskeletal fitness.\" He then turns to the fashion term: \"Lately, the term 'functional training' has been promoted as a unique and modern method of training. In fact, it is nothing much more than a synonym for 'action specific', 'activity specific' or 'sport specific' training.\" To be accurate it \"should address not only the motor qualities, but also the metabolic requirements of a given activity.\" And: \"it is misleading to classify a single exercise as being \"non-functional\", since functional conditioning can comprise a combination of general and specific, 'functional' and 'non-functional' exercises. Indeed, this type of combined GPP and SPP methods forms the basis of all periodisation.\" (All PDF p. 422 / printed p. 411, checked against the page image.)","+**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) proposes replacing \"modified PNF\" with Functional Neuromuscular Conditioning (FNC), for five reasons: it is \"sometimes desirable to deviate from strict PNF principles\"; other disciplines (\"Feldenkrais, Alexander, yoga, Tai Chi and Laban\") add methods; contraction \"may be facilitated by local after-discharge of the same muscle,\" so not all is neuromuscular; some PNF methods \"may not be classified accurately as proprioceptive, such as cognitive, perceptual and other sensory mechanisms\"; and the full name \"is too technically daunting for the average coach or athlete.\" FNC \"should be regarded as an entire conditioning system capable of developing any desired type of musculoskeletal fitness.\" He then turns to the fashion term: \"Lately, the term 'functional training' has been promoted as a unique and modern method of training. In fact, it is nothing much more than a synonym for 'action specific', 'activity specific' or 'sport specific' training.\" To be accurate it \"should address not only the motor qualities, but also the metabolic requirements of a given activity.\" And: \"it is misleading to classify a single exercise as being \"non-functional\", since functional conditioning can comprise a combination of general and specific, 'functional' and 'non-functional' exercises. Indeed, this type of combined GPP and SPP methods forms the basis of all periodisation.\" (All PDF p. 422 / printed p. 411, checked against the page image.)"," "," **Why it works** — The argument is from programme level, not exercise level: function is a property of the whole combination of general (GPP) and specific (SPP) means over time, so labelling one exercise cannot settle it (PDF p. 422 / printed p. 411). Siff adds that \"Because Wolff's Law states that function precedes structure, FNC may be seen to embrace all-round development of function and structure\" (same page). Inference: Wolff's law is usually stated for bone remodelling under load; the book extends it here without further explanation."," "]}]},{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--novices-progress-from-mobility-to-stability-pnf-sequence.md","hunks":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # Novices Should Progress From Mobility to Stability, Following the Developmental Sequences PNF Is Built On"," ","-**What it is** — Siff (7.2 rests on his 1989 NSCA workshop, PDF p. 430 / printed p. 419) writes that PNF methods \"were formulated from findings on neuromuscular development, such as the functional evolution of all movement from motor immaturity to motor maturity in the growing child or novice athlete,\" progressing \"total to individuated; proximal to distal, distal to proximal; mobile to stabile; gross to selective; reflexive to deliberate; overlapping to integrative; incoordinate to coordinate\" (PDF p. 416 / printed p. 405, text layer). In 7.2.3.3 he restates the emphasis for \"the patient, the novice or the child\": \"progression from primitive to complex, gross to individuated, mobile to stabile, reflexive to deliberative, proximal to distal, and incoordinate to coordinate.\" Then: \"Contrary to common belief, the novice must be taught from a base of mobility to progress to stability, just as an infant learns to stand by first moving, staggering and exploring the environment\" (PDF p. 418 / printed p. 407, text layer).","+**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) writes that PNF methods \"were formulated from findings on neuromuscular development, such as the functional evolution of all movement from motor immaturity to motor maturity in the growing child or novice athlete,\" progressing \"total to individuated; proximal to distal, distal to proximal; mobile to stabile; gross to selective; reflexive to deliberate; overlapping to integrative; incoordinate to coordinate\" (PDF p. 416 / printed p. 405, text layer). In 7.2.3.3 he restates the emphasis for \"the patient, the novice or the child\": \"progression from primitive to complex, gross to individuated, mobile to stabile, reflexive to deliberative, proximal to distal, and incoordinate to coordinate.\" Then: \"Contrary to common belief, the novice must be taught from a base of mobility to progress to stability, just as an infant learns to stand by first moving, staggering and exploring the environment\" (PDF p. 418 / printed p. 407, text layer)."," "," **Why it works** — Siff's argument is the developmental analogy itself: the infant moves and staggers before standing stably (PDF p. 418 / printed p. 407). He also states that \"all physical conditioning requires a constant interplay of mobility and stability, all patterns implicate some parts of the body in stabilising and other parts in mobilising\" (PDF p. 418 / printed p. 407). He gives no training study for the novice-athlete claim."," "]}]},{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","hunks":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # PNF Procedures: Three Activation Techniques, Three Antagonist Reversals and Three Relaxation (Stretching) Techniques"," ","-**What it is** — Siff (7.2 rests on his 1989 NSCA workshop, PDF p. 430 / printed p. 419) lists nine PNF procedures: manual contacts to guide movement; \"maximal tolerated resistance\"; oral commands and non-verbal cues; maximal stretch reflex in the lengthened range; timing and sequencing; \"traction or approximation (compression) to stimulate joint receptors\"; \"recuperative motion to reduce or avoid fatigue produced by resisted activity\"; Specific Activation Techniques; and Specific Relaxation Techniques (PDF p. 417 / printed p. 406, text layer). He expands the last two (PDF pp. 417-418 / printed pp. 406-407, text layer):","+**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) lists nine PNF procedures: manual contacts to guide movement; \"maximal tolerated resistance\"; oral commands and non-verbal cues; maximal stretch reflex in the lengthened range; timing and sequencing; \"traction or approximation (compression) to stimulate joint receptors\"; \"recuperative motion to reduce or avoid fatigue produced by resisted activity\"; Specific Activation Techniques; and Specific Relaxation Techniques (PDF p. 417 / printed p. 406, text layer). He expands the last two (PDF pp. 417-418 / printed pp. 406-407, text layer):"," "," - Activation. Repeated Contractions (RC): \"precise sequences or patterns of isometric, concentric and eccentric contraction, sometimes augmented by eliciting various neuromuscular reflexes (i.e. methods which may be similar to some types of plyometrics).\" Rhythmic Initiation (RI): voluntary relaxation, passive movement and repeated dynamic contractions, \"valuable with subjects who struggle to initiate activity because of rigidity or spasticity.\" Reversal of Antagonists (RA), in three forms: slow reversal (dynamic antagonist contraction, then dynamic agonist contraction); slow reversal-hold (dynamic then isometric contraction of the antagonist, then the same for the agonist); rhythmic stabilisation (isometric antagonist then isometric agonist, \"thereby producing co-contraction\")."," - Relaxation (the techniques coaches call PNF stretching). Contract-Relax (CR): \"a dynamic contraction of the antagonist against maximal resistance, followed by a phase of relaxation,\" repeated from the limit of pain-free range; the practitioner resists \"as strongly as possible,\" tells the client to relax, waits for relaxation, then moves the limb passively \"to its new limit of extension\" for \"a few repetitions.\" Hold-Relax (HR): the same \"except that isometric rather than dynamic contraction against maximal resistance is applied.\" Slow-Reversal-Hold-Relax (SRHR): \"dynamic contraction of the antagonists involved, isometric contraction of the antagonists, brief voluntary relaxation, and finally, dynamic contraction of the agonists,\" over several repetitions \"to enhance functional flexibility.\""]}]},{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/heuristic--use-pulleys-and-dumbbells-for-spiral-diagonal-pnf-patterns.md","hunks":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # Rank Equipment by How Well It Allows Spiral-Diagonal Patterns: Pulleys and Dumbbells First, Barbells Next, Machines Last"," ","-**What it is** — Siff (7.2 rests on his 1989 NSCA workshop, PDF p. 430 / printed p. 419) ranks equipment for modified PNF: \"Pulleys and dumbbells are especially suitable for application of the spiral and diagonal, midline-crossing PNF techniques. ... Barbell training provides fewer opportunities for the use of PNF training, while machines offer the fewest possibilities of all\" (PDF p. 421 / printed p. 410, checked against the page image). Patterns are \"Probably the most neglected aspect of PNF by coaches\" (PDF p. 418 / printed p. 407, text layer). \"No machines other than the traditional high-low pulley machines allow the user to produce PNF patterns,\" and \"pec-decks, back hyperextension machines, seated pressing machines, hack-squat machines and leg extension machines ... cause such large deviations from recommended PNF patterns that they can impose excessive loading on certain joints and are suitable only for a small proportion of the training of highly conditioned athletes\" (PDF p. 418 / printed p. 407, text layer). Machine training \"requires a disproportionate number of machines to approximate the training offered by free weight and pulley training in three-dimensional space\" (same page).","+**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) ranks equipment for modified PNF: \"Pulleys and dumbbells are especially suitable for application of the spiral and diagonal, midline-crossing PNF techniques. ... Barbell training provides fewer opportunities for the use of PNF training, while machines offer the fewest possibilities of all\" (PDF p. 421 / printed p. 410, checked against the page image). Patterns are \"Probably the most neglected aspect of PNF by coaches\" (PDF p. 418 / printed p. 407, text layer). \"No machines other than the traditional high-low pulley machines allow the user to produce PNF patterns,\" and \"pec-decks, back hyperextension machines, seated pressing machines, hack-squat machines and leg extension machines ... cause such large deviations from recommended PNF patterns that they can impose excessive loading on certain joints and are suitable only for a small proportion of the training of highly conditioned athletes\" (PDF p. 418 / printed p. 407, text layer). Machine training \"requires a disproportionate number of machines to approximate the training offered by free weight and pulley training in three-dimensional space\" (same page)."," "," **Why it works** — Siff's reason is pattern fidelity: PNF patterns \"stimulate more thorough involvement and motor development than the less-than-optimal patterns imposed by the abundance of linear or cam machines\" (PDF p. 418 / printed p. 407). Machine design \"imposes body positions, postures and activation of pivots which usually differ considerably from those recommended by PNF and compromise the effectiveness and safety of the exercise\" (PDF p. 421 / printed p. 410). He calls the belief that machines offer \"greater stability and safety for beginners than free weights\" \"A major error,\" and concludes \"instructors must always 'spot' for the users of machines as well as free weights\" (PDF p. 421 / printed p. 410)."," "]}]},{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/principle--train-for-a-safety-factor-above-competition-forces.md","hunks":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":[" "," # Train for a Safety Factor Above Competition Forces, but Strength and Bulk Alone Do Not Protect an Inefficient Athlete"," ","-**What it is** — Under \"Pattern Deviations and Safety Factors,\" Siff (7.2 rests on his 1989 NSCA workshop, PDF p. 430 / printed p. 419) writes that PNF patterns \"were devised for rehabilitation, not elite sporting training, so that it is not incorrect to employ patterns of movement which may deviate significantly from those stipulated in PNF\" (italics in the original). PNF keeps patterns \"close to the body, a situation which occurs seldom in sport,\" where \"forceful or rapid movements have to be executed with the distal extremities far from the relevant joints, thereby imposing large torque on these joints. If training always ensures that this degree of torque or force is avoided, then it will not prepare the athlete for the rigors of the sport and will increase susceptibility to overtraining and injury.\" Hence: \"As in engineering, one must plan for a certain safety factor which allows the athlete to manage even larger forces than those which may be encountered in competition. For example, a safety factor of 1.2 means that a system can cope with a maximal loading of 0.2 or 20% greater than normally expected.\" Heavy supplementary resistance training (\"cross training\") serves this, \"provided that it does not alter the neuromuscular patterns needed in the given sport.\" The limit: \"Far too many athletes (e.g. in football and rugby) believe that increase in strength and bodymass will automatically protect them from injury. If one executes a movement in an inefficient manner or reacts too slowly to produce adequate force, then even gigantic strength or structural bulk can be inadequate to prevent injury.\" (All PDF p. 421 / printed p. 410, checked against the page image.)","+**What it is** — Under \"Pattern Deviations and Safety Factors,\" Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) writes that PNF patterns \"were devised for rehabilitation, not elite sporting training, so that it is not incorrect to employ patterns of movement which may deviate significantly from those stipulated in PNF\" (italics in the original). PNF keeps patterns \"close to the body, a situation which occurs seldom in sport,\" where \"forceful or rapid movements have to be executed with the distal extremities far from the relevant joints, thereby imposing large torque on these joints. If training always ensures that this degree of torque or force is avoided, then it will not prepare the athlete for the rigors of the sport and will increase susceptibility to overtraining and injury.\" Hence: \"As in engineering, one must plan for a certain safety factor which allows the athlete to manage even larger forces than those which may be encountered in competition. For example, a safety factor of 1.2 means that a system can cope with a maximal loading of 0.2 or 20% greater than normally expected.\" Heavy supplementary resistance training (\"cross training\") serves this, \"provided that it does not alter the neuromuscular patterns needed in the given sport.\" The limit: \"Far too many athletes (e.g. in football and rugby) believe that increase in strength and bodymass will automatically protect them from injury. If one executes a movement in an inefficient manner or reacts too slowly to produce adequate force, then even gigantic strength or structural bulk can be inadequate to prevent injury.\" (All PDF p. 421 / printed p. 410, checked against the page image.)"," "," **Why it works** — Siff gives the engineering analogy and one sentence of reasoning: \"high levels of skill and reactive ability in sport are vital in ensuring that sporting action is efficient and safe\" (PDF p. 421 / printed p. 410). No physiological mechanism or data are given. Inference: the claim has two parts, tissue capacity above expected load (the safety factor) and timing and skill to apply it (reactive ability), and the book makes both necessary and neither sufficient."," "]}]}],"moreFiles":0,"changedFiles":["/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--functional-training-means-sport-specific-and-no-exercise-is-non-functional.md","/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/claim--novices-progress-from-mobility-to-stability-pnf-sequence.md","/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/heuristic--use-pulleys-and-dumbbells-for-spiral-diagonal-pnf-patterns.md","/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/principle--train-for-a-safety-factor-above-competition-forces.md"]}},"sourceToolAssistantUUID":"8a18a6be-22c5-46a8-bb74-5129e031f98c","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
