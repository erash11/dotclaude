{"parentUuid":"809e2b6b-5ec4-4654-a501-3428f64763ff","isSidechain":true,"agentId":"afcd6d73916c3b3e0","message":{"model":"claude-opus-5-5","id":"msg_011CffrBxGpH7HuTK97MENua","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1492,"cache_read_input_tokens":167646,"cache_creation":{"ephemeral_5m_input_tokens":1492,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":1259,"apiBlockIndex":0,"requestId":"req_011CffrBo8ARG7LaxsnE6iB9","attributionAgent":"general-purpose","type":"assistant","uuid":"e7a1bc98-3105-4e2e-90bb-225bf174fe91","timestamp":"2026-10-03T19:23:05.236Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"e7a1bc98-3105-4e2e-90bb-225bf174fe91","isSidechain":true,"agentId":"afcd6d73916c3b3e0","message":{"model":"claude-opus-5-5","id":"msg_011CffrBxGpH7HuTK97MENua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018WtvCzUjx9t3TV9Z8ZjueQ","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","old_string":"Siff's 7.5 extension: stretching would gain \"markedly\" if done \"statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" instead of \"in a static manner separately from the main exercises\" (PDF p. 430 / printed p. 419, checked against the page image).","new_string":"Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image)."},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1492,"cache_read_input_tokens":167646,"cache_creation":{"ephemeral_5m_input_tokens":1492,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018WtvCzUjx9t3TV9Z8ZjueQ":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","old_string":"Siff's 7.5 extension: stretching would gain \"markedly\" if done \"statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" instead of \"in a static manner separately from the main exercises\" (PDF p. 430 / printed p. 419, checked against the page image).","new_string":"Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image)."}},"apiBlockIndex":1,"requestId":"req_011CffrBo8ARG7LaxsnE6iB9","attributionAgent":"general-purpose","type":"assistant","uuid":"a348c28b-27d5-4d5e-8096-146e8c115dee","timestamp":"2026-10-03T19:23:07.754Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"a348c28b-27d5-4d5e-8096-146e8c115dee","isSidechain":true,"promptId":"189515d2-55e8-482a-8b52-f518760b72bc","agentId":"afcd6d73916c3b3e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WtvCzUjx9t3TV9Z8ZjueQ","type":"tool_result","content":"The file /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)"}]},"uuid":"76a4eb81-148f-4e6d-bd36-d1c6df928fa4","timestamp":"2026-10-03T19:23:07.841Z","toolUseResult":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","oldString":"Siff's 7.5 extension: stretching would gain \"markedly\" if done \"statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" instead of \"in a static manner separately from the main exercises\" (PDF p. 430 / printed p. 419, checked against the page image).","newString":"Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image).","originalFile":"---\ntype: library-entry\nkind: framework\ndomain: strength-and-conditioning\nbook: supertraining--verkhoshansky\nchapter: \"7.2.3.2\"\ntopic: PNF procedures and techniques\ncategory: [pnf, flexibility, neuromuscular, rehabilitation]\nconfidence: supported\ningest-tier: full-text\ncreated: 2026-10-03\n---\n\n# PNF Procedures: Three Activation Techniques, Three Antagonist Reversals and Three Relaxation (Stretching) Techniques\n\n**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) lists nine PNF procedures: manual contacts to guide movement; \"maximal tolerated resistance\"; oral commands and non-verbal cues; maximal stretch reflex in the lengthened range; timing and sequencing; \"traction or approximation (compression) to stimulate joint receptors\"; \"recuperative motion to reduce or avoid fatigue produced by resisted activity\"; Specific Activation Techniques; and Specific Relaxation Techniques (PDF p. 417 / printed p. 406, text layer). He expands the last two (PDF pp. 417-418 / printed pp. 406-407, text layer):\n\n- Activation. Repeated Contractions (RC): \"precise sequences or patterns of isometric, concentric and eccentric contraction, sometimes augmented by eliciting various neuromuscular reflexes (i.e. methods which may be similar to some types of plyometrics).\" Rhythmic Initiation (RI): voluntary relaxation, passive movement and repeated dynamic contractions, \"valuable with subjects who struggle to initiate activity because of rigidity or spasticity.\" Reversal of Antagonists (RA), in three forms: slow reversal (dynamic antagonist contraction, then dynamic agonist contraction); slow reversal-hold (dynamic then isometric contraction of the antagonist, then the same for the agonist); rhythmic stabilisation (isometric antagonist then isometric agonist, \"thereby producing co-contraction\").\n- Relaxation (the techniques coaches call PNF stretching). Contract-Relax (CR): \"a dynamic contraction of the antagonist against maximal resistance, followed by a phase of relaxation,\" repeated from the limit of pain-free range; the practitioner resists \"as strongly as possible,\" tells the client to relax, waits for relaxation, then moves the limb passively \"to its new limit of extension\" for \"a few repetitions.\" Hold-Relax (HR): the same \"except that isometric rather than dynamic contraction against maximal resistance is applied.\" Slow-Reversal-Hold-Relax (SRHR): \"dynamic contraction of the antagonists involved, isometric contraction of the antagonists, brief voluntary relaxation, and finally, dynamic contraction of the agonists,\" over several repetitions \"to enhance functional flexibility.\"\n\n**Why it works** — For reversals, Siff's reason is functional: antagonist reversal \"occurs naturally in numerous activities such as walking, running and sawing wood,\" and \"If the antagonists do not reverse competently in terms of strength, speed and coordination, motor efficiency is impaired\" (PDF p. 417 / printed p. 406). For RC: \"Repetition of muscle contraction is necessary for motor learning and the development of strength, muscle endurance and flexibility\" (PDF p. 417 / printed p. 406). For the relaxation techniques the book's reflex rationale is in 7.2.1: prolonged resistance enhances \"activation of the Golgi tendon reflex, thereby tending to reduce the tension in a muscle and promote local relaxation,\" and strong agonist contraction causes reciprocal \"reflex relaxation of the antagonist muscles\" (PDF p. 415 / printed p. 404, text layer). Siff does not tie each named technique to a specific reflex. Inference: CR and HR read as uses of the Golgi tendon mechanism and SRHR adds reciprocal inhibition through the final agonist contraction, but that pairing is this entry's reading.\n\n**When to apply** — Use reversals (slow reversal, rhythmic stabilisation) when the target is coordination between opposing groups, and CR, HR or SRHR when the target is range under control rather than passive range. Siff's 7.5 extension: stretching would gain \"markedly\" if done \"statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" instead of \"in a static manner separately from the main exercises\" (PDF p. 430 / printed p. 419, checked against the page image). Eric's baseline: \"Assessment is continuous, not a single test day: start with movement quality, injury history, and training background, then observe daily via warm-ups and practice.\" (`docs/method-baseline.md`, line 56, Inferred (transcript)). Inference: warm-ups are where these partner techniques can be observed and dosed daily.\n\n**When NOT to apply** — These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none. CR and HR need a partner who can resist \"as strongly as possible\" and judge relaxation, so they do not scale to large groups without trained staff. Work stays inside \"the limit of pain-free action\" (PDF p. 417 / printed p. 406), which matches principle 6, \"Movement free of pain, but not free of effort\" (PDF p. 416 / printed p. 405). Rhythmic Initiation is aimed at rigidity or spasticity, a patient problem, not a typical athlete one.\n\n**Example** — Siff's procedure for CR, as he gives it: move the limb to its pain-free limit, have the client contract the antagonist dynamically while the practitioner resists maximally, command relaxation, wait for it, move the limb passively to its new limit, and repeat \"gently for a few repetitions\" (PDF p. 417 / printed p. 406). Inference: for a hamstring, the athlete lies supine with the leg raised to its limit and pushes the heel down against the partner's shoulder, relaxes, and the partner raises the leg further; the book does not name a muscle for this example.\n\n**Related** — [[framework--pnf-five-p-factors-and-principles-as-a-conditioning-system]], [[framework--stretch-reflex-types-and-neuromuscular-control-of-flexibility]], [[framework--methods-for-improving-voluntary-muscle-relaxation]] (CR and HR as relaxation methods, 3.5.9), [[framework--stretching-techniques-taxonomy-static-vs-dynamic]] (where PNF stretching sits among stretching types), [[framework--four-methods-of-enhancing-rom-ranked-by-effectiveness]]\n","structuredPatch":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":7,"lines":[" "," **Why it works** — For reversals, Siff's reason is functional: antagonist reversal \"occurs naturally in numerous activities such as walking, running and sawing wood,\" and \"If the antagonists do not reverse competently in terms of strength, speed and coordination, motor efficiency is impaired\" (PDF p. 417 / printed p. 406). For RC: \"Repetition of muscle contraction is necessary for motor learning and the development of strength, muscle endurance and flexibility\" (PDF p. 417 / printed p. 406). For the relaxation techniques the book's reflex rationale is in 7.2.1: prolonged resistance enhances \"activation of the Golgi tendon reflex, thereby tending to reduce the tension in a muscle and promote local relaxation,\" and strong agonist contraction causes reciprocal \"reflex relaxation of the antagonist muscles\" (PDF p. 415 / printed p. 404, text layer). Siff does not tie each named technique to a specific reflex. Inference: CR and HR read as uses of the Golgi tendon mechanism and SRHR adds reciprocal inhibition through the final agonist contraction, but that pairing is this entry's reading."," ","-**When to apply** — Use reversals (slow reversal, rhythmic stabilisation) when the target is coordination between opposing groups, and CR, HR or SRHR when the target is range under control rather than passive range. Siff's 7.5 extension: stretching would gain \"markedly\" if done \"statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" instead of \"in a static manner separately from the main exercises\" (PDF p. 430 / printed p. 419, checked against the page image). Eric's baseline: \"Assessment is continuous, not a single test day: start with movement quality, injury history, and training background, then observe daily via warm-ups and practice.\" (`docs/method-baseline.md`, line 56, Inferred (transcript)). Inference: warm-ups are where these partner techniques can be observed and dosed daily.","+**When to apply** — Use reversals (slow reversal, rhythmic stabilisation) when the target is coordination between opposing groups, and CR, HR or SRHR when the target is range under control rather than passive range. Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image). Eric's baseline: \"Assessment is continuous, not a single test day: start with movement quality, injury history, and training background, then observe daily via warm-ups and practice.\" (`docs/method-baseline.md`, line 56, Inferred (transcript)). Inference: warm-ups are where these partner techniques can be observed and dosed daily."," "," **When NOT to apply** — These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none. CR and HR need a partner who can resist \"as strongly as possible\" and judge relaxation, so they do not scale to large groups without trained staff. Work stays inside \"the limit of pain-free action\" (PDF p. 417 / printed p. 406), which matches principle 6, \"Movement free of pain, but not free of effort\" (PDF p. 416 / printed p. 405). Rhythmic Initiation is aimed at rigidity or spasticity, a patient problem, not a typical athlete one."," "]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"sourceToolAssistantUUID":"a348c28b-27d5-4d5e-8096-146e8c115dee","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"76a4eb81-148f-4e6d-bd36-d1c6df928fa4","isSidechain":true,"agentId":"afcd6d73916c3b3e0","message":{"model":"claude-opus-5-5","id":"msg_011CffrBxGpH7HuTK97MENua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013fEVGXbyLWWhrSDPE5V5ux","name":"Edit","input":{"replace_all":false,"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","old_string":"These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none.","new_string":"These are clinical techniques of classical PNF (the Knott and Voss approach, PDF p. 415 / printed p. 404), described here with repetition counts only (CR \"is repeated several times\" and \"continued gently for a few repetitions\", PDF p. 417 / printed p. 406; SRHR uses \"several repetitions\", PDF p. 418 / printed p. 407), and without loads, hold durations, rest periods or outcome data; Siff gives none."},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1492,"cache_read_input_tokens":167646,"output_tokens":893,"output_tokens_details":{"thinking_tokens":160},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1492},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":893,"cache_read_input_tokens":167646,"cache_creation_input_tokens":1492,"cache_creation":{"ephemeral_5m_input_tokens":1492,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_013fEVGXbyLWWhrSDPE5V5ux":{"file_path":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","old_string":"These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none.","new_string":"These are clinical techniques of classical PNF (the Knott and Voss approach, PDF p. 415 / printed p. 404), described here with repetition counts only (CR \"is repeated several times\" and \"continued gently for a few repetitions\", PDF p. 417 / printed p. 406; SRHR uses \"several repetitions\", PDF p. 418 / printed p. 407), and without loads, hold durations, rest periods or outcome data; Siff gives none."}},"apiBlockIndex":2,"requestId":"req_011CffrBo8ARG7LaxsnE6iB9","attributionAgent":"general-purpose","type":"assistant","uuid":"177176ae-d005-400e-a728-5ac180af4b18","timestamp":"2026-10-03T19:23:10.076Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"177176ae-d005-400e-a728-5ac180af4b18","isSidechain":true,"promptId":"189515d2-55e8-482a-8b52-f518760b72bc","agentId":"afcd6d73916c3b3e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013fEVGXbyLWWhrSDPE5V5ux","type":"tool_result","content":"The file /Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md has been updated successfully."}]},"uuid":"6062109a-9557-40b9-b573-b2f6761629d2","timestamp":"2026-10-03T19:23:10.187Z","toolUseResult":{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--pnf-activation-and-relaxation-techniques.md","oldString":"These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none.","newString":"These are clinical techniques of classical PNF (the Knott and Voss approach, PDF p. 415 / printed p. 404), described here with repetition counts only (CR \"is repeated several times\" and \"continued gently for a few repetitions\", PDF p. 417 / printed p. 406; SRHR uses \"several repetitions\", PDF p. 418 / printed p. 407), and without loads, hold durations, rest periods or outcome data; Siff gives none.","originalFile":"---\ntype: library-entry\nkind: framework\ndomain: strength-and-conditioning\nbook: supertraining--verkhoshansky\nchapter: \"7.2.3.2\"\ntopic: PNF procedures and techniques\ncategory: [pnf, flexibility, neuromuscular, rehabilitation]\nconfidence: supported\ningest-tier: full-text\ncreated: 2026-10-03\n---\n\n# PNF Procedures: Three Activation Techniques, Three Antagonist Reversals and Three Relaxation (Stretching) Techniques\n\n**What it is** — Siff (in 7.5 the book says \"the author\" gave the 1989 NSCA presentation (Siff, 1989), PDF p. 429 / printed p. 418, and that \"An overview of this presentation and workshop acted as the basis for Chapter 7.2 above\", PDF p. 430 / printed p. 419) lists nine PNF procedures: manual contacts to guide movement; \"maximal tolerated resistance\"; oral commands and non-verbal cues; maximal stretch reflex in the lengthened range; timing and sequencing; \"traction or approximation (compression) to stimulate joint receptors\"; \"recuperative motion to reduce or avoid fatigue produced by resisted activity\"; Specific Activation Techniques; and Specific Relaxation Techniques (PDF p. 417 / printed p. 406, text layer). He expands the last two (PDF pp. 417-418 / printed pp. 406-407, text layer):\n\n- Activation. Repeated Contractions (RC): \"precise sequences or patterns of isometric, concentric and eccentric contraction, sometimes augmented by eliciting various neuromuscular reflexes (i.e. methods which may be similar to some types of plyometrics).\" Rhythmic Initiation (RI): voluntary relaxation, passive movement and repeated dynamic contractions, \"valuable with subjects who struggle to initiate activity because of rigidity or spasticity.\" Reversal of Antagonists (RA), in three forms: slow reversal (dynamic antagonist contraction, then dynamic agonist contraction); slow reversal-hold (dynamic then isometric contraction of the antagonist, then the same for the agonist); rhythmic stabilisation (isometric antagonist then isometric agonist, \"thereby producing co-contraction\").\n- Relaxation (the techniques coaches call PNF stretching). Contract-Relax (CR): \"a dynamic contraction of the antagonist against maximal resistance, followed by a phase of relaxation,\" repeated from the limit of pain-free range; the practitioner resists \"as strongly as possible,\" tells the client to relax, waits for relaxation, then moves the limb passively \"to its new limit of extension\" for \"a few repetitions.\" Hold-Relax (HR): the same \"except that isometric rather than dynamic contraction against maximal resistance is applied.\" Slow-Reversal-Hold-Relax (SRHR): \"dynamic contraction of the antagonists involved, isometric contraction of the antagonists, brief voluntary relaxation, and finally, dynamic contraction of the agonists,\" over several repetitions \"to enhance functional flexibility.\"\n\n**Why it works** — For reversals, Siff's reason is functional: antagonist reversal \"occurs naturally in numerous activities such as walking, running and sawing wood,\" and \"If the antagonists do not reverse competently in terms of strength, speed and coordination, motor efficiency is impaired\" (PDF p. 417 / printed p. 406). For RC: \"Repetition of muscle contraction is necessary for motor learning and the development of strength, muscle endurance and flexibility\" (PDF p. 417 / printed p. 406). For the relaxation techniques the book's reflex rationale is in 7.2.1: prolonged resistance enhances \"activation of the Golgi tendon reflex, thereby tending to reduce the tension in a muscle and promote local relaxation,\" and strong agonist contraction causes reciprocal \"reflex relaxation of the antagonist muscles\" (PDF p. 415 / printed p. 404, text layer). Siff does not tie each named technique to a specific reflex. Inference: CR and HR read as uses of the Golgi tendon mechanism and SRHR adds reciprocal inhibition through the final agonist contraction, but that pairing is this entry's reading.\n\n**When to apply** — Use reversals (slow reversal, rhythmic stabilisation) when the target is coordination between opposing groups, and CR, HR or SRHR when the target is range under control rather than passive range. Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image). Eric's baseline: \"Assessment is continuous, not a single test day: start with movement quality, injury history, and training background, then observe daily via warm-ups and practice.\" (`docs/method-baseline.md`, line 56, Inferred (transcript)). Inference: warm-ups are where these partner techniques can be observed and dosed daily.\n\n**When NOT to apply** — These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none. CR and HR need a partner who can resist \"as strongly as possible\" and judge relaxation, so they do not scale to large groups without trained staff. Work stays inside \"the limit of pain-free action\" (PDF p. 417 / printed p. 406), which matches principle 6, \"Movement free of pain, but not free of effort\" (PDF p. 416 / printed p. 405). Rhythmic Initiation is aimed at rigidity or spasticity, a patient problem, not a typical athlete one.\n\n**Example** — Siff's procedure for CR, as he gives it: move the limb to its pain-free limit, have the client contract the antagonist dynamically while the practitioner resists maximally, command relaxation, wait for it, move the limb passively to its new limit, and repeat \"gently for a few repetitions\" (PDF p. 417 / printed p. 406). Inference: for a hamstring, the athlete lies supine with the leg raised to its limit and pushes the heel down against the partner's shoulder, relaxes, and the partner raises the leg further; the book does not name a muscle for this example.\n\n**Related** — [[framework--pnf-five-p-factors-and-principles-as-a-conditioning-system]], [[framework--stretch-reflex-types-and-neuromuscular-control-of-flexibility]], [[framework--methods-for-improving-voluntary-muscle-relaxation]] (CR and HR as relaxation methods, 3.5.9), [[framework--stretching-techniques-taxonomy-static-vs-dynamic]] (where PNF stretching sits among stretching types), [[framework--four-methods-of-enhancing-rom-ranked-by-effectiveness]]\n","structuredPatch":[{"oldStart":22,"oldLines":7,"newStart":22,"newLines":7,"lines":[" "," **When to apply** — Use reversals (slow reversal, rhythmic stabilisation) when the target is coordination between opposing groups, and CR, HR or SRHR when the target is range under control rather than passive range. Siff's 7.5 extension: stretching is usually done \"in a static manner separately from the main exercises\", when its effectiveness \"would increase markedly if the latter [the main exercises] were also to be used statically and dynamically over a full range with progressively increasing resistance incorporating relevant PNF procedures\" (PDF p. 430 / printed p. 419, checked against the page image). Eric's baseline: \"Assessment is continuous, not a single test day: start with movement quality, injury history, and training background, then observe daily via warm-ups and practice.\" (`docs/method-baseline.md`, line 56, Inferred (transcript)). Inference: warm-ups are where these partner techniques can be observed and dosed daily."," ","-**When NOT to apply** — These are clinical techniques from Knott and Voss, described here without dosages, rest periods or outcome data; Siff gives none. CR and HR need a partner who can resist \"as strongly as possible\" and judge relaxation, so they do not scale to large groups without trained staff. Work stays inside \"the limit of pain-free action\" (PDF p. 417 / printed p. 406), which matches principle 6, \"Movement free of pain, but not free of effort\" (PDF p. 416 / printed p. 405). Rhythmic Initiation is aimed at rigidity or spasticity, a patient problem, not a typical athlete one.","+**When NOT to apply** — These are clinical techniques of classical PNF (the Knott and Voss approach, PDF p. 415 / printed p. 404), described here with repetition counts only (CR \"is repeated several times\" and \"continued gently for a few repetitions\", PDF p. 417 / printed p. 406; SRHR uses \"several repetitions\", PDF p. 418 / printed p. 407), and without loads, hold durations, rest periods or outcome data; Siff gives none. CR and HR need a partner who can resist \"as strongly as possible\" and judge relaxation, so they do not scale to large groups without trained staff. Work stays inside \"the limit of pain-free action\" (PDF p. 417 / printed p. 406), which matches principle 6, \"Movement free of pain, but not free of effort\" (PDF p. 416 / printed p. 405). Rhythmic Initiation is aimed at rigidity or spasticity, a patient problem, not a typical athlete one."," "," **Example** — Siff's procedure for CR, as he gives it: move the limb to its pain-free limit, have the client contract the antagonist dynamically while the practitioner resists maximally, command relaxation, wait for it, move the limb passively to its new limit, and repeat \"gently for a few repetitions\" (PDF p. 417 / printed p. 406). Inference: for a hamstring, the athlete lies supine with the leg raised to its limit and pushes the heel down against the partner's shoulder, relaxes, and the partner raises the leg further; the book does not name a muscle for this example."," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"177176ae-d005-400e-a728-5ac180af4b18","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
