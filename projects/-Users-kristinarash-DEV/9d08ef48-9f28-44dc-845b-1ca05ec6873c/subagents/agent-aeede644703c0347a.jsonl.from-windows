{"parentUuid":"74ef0d47-6f9b-4669-b7f6-1a22d9cac08f","isSidechain":true,"agentId":"aeede644703c0347a","message":{"model":"claude-opus-5-5","id":"msg_011CffmvWRBd3r3UJRNtYLzZ","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14045,"cache_read_input_tokens":76096,"cache_creation":{"ephemeral_5m_input_tokens":14045,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":862,"apiBlockIndex":0,"requestId":"req_011CffmvW8pAdyjBiLS2wouQ","attributionAgent":"general-purpose","type":"assistant","uuid":"e90944e4-3643-4142-9ceb-9c08e16e5c9c","timestamp":"2026-10-03T18:27:07.684Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"e90944e4-3643-4142-9ceb-9c08e16e5c9c","isSidechain":true,"agentId":"aeede644703c0347a","message":{"model":"claude-opus-5-5","id":"msg_011CffmvWRBd3r3UJRNtYLzZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0142QDuDLfo6rsM8Tqt6yjXo","name":"Bash","input":{"command":"cd /Users/kristinarash/DEV/Flint/staging && mkdir -p _renders && ~/.local/bin/uv run --with pymupdf python3 -c \"\nimport pymupdf\nd=pymupdf.open('books/supertraining-6th-expanded.pdf')\nout=open('/tmp/r6b_src.txt','w')\nfor n in list(range(347,363))+[305,381]:\n    out.write(f'\\n=========== PDF {n} ===========\\n'+d[n].get_text())\nfor n in [348,349,351,352,354,358,359,360,361,362]:\n    d[n].get_pixmap(dpi=200).save(f'_renders/r6b_p{n}.png')\n\" && wc -c /tmp/r6b_src.txt","description":"Extract source text and render figure pages"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14045,"cache_read_input_tokens":76096,"cache_creation":{"ephemeral_5m_input_tokens":14045,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_0142QDuDLfo6rsM8Tqt6yjXo":{"command":"cd /Users/kristinarash/DEV/Flint/staging && mkdir -p _renders && ~/.local/bin/uv run --with pymupdf python3 -c \"\nimport pymupdf\nd=pymupdf.open('books/supertraining-6th-expanded.pdf')\nout=open('/tmp/r6b_src.txt','w')\nfor n in list(range(347,363))+[305,381]:\n    out.write(f'\\n=========== PDF {n} ===========\\n'+d[n].get_text())\nfor n in [348,349,351,352,354,358,359,360,361,362]:\n    d[n].get_pixmap(dpi=200).save(f'_renders/r6b_p{n}.png')\n\" && wc -c /tmp/r6b_src.txt","description":"Extract source text and render figure pages"}},"apiBlockIndex":1,"requestId":"req_011CffmvW8pAdyjBiLS2wouQ","attributionAgent":"general-purpose","type":"assistant","uuid":"e105448d-332a-401b-90ae-422cfd1a2d5e","timestamp":"2026-10-03T18:27:10.021Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"e105448d-332a-401b-90ae-422cfd1a2d5e","isSidechain":true,"agentId":"aeede644703c0347a","message":{"model":"claude-opus-5-5","id":"msg_011CffmvWRBd3r3UJRNtYLzZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QNNZ8SHiUiFZQys6ggACY7","name":"Read","input":{"file_path":"/tmp/r6b_src.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14045,"cache_read_input_tokens":76096,"output_tokens":486,"output_tokens_details":{"thinking_tokens":99},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":14045},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":486,"cache_read_input_tokens":76096,"cache_creation_input_tokens":14045,"cache_creation":{"ephemeral_5m_input_tokens":14045,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01QNNZ8SHiUiFZQys6ggACY7":{"file_path":"/tmp/r6b_src.txt"}},"apiBlockIndex":2,"requestId":"req_011CffmvW8pAdyjBiLS2wouQ","attributionAgent":"general-purpose","type":"assistant","uuid":"1ae49b2c-c489-49d3-9d07-0fb3feed3157","timestamp":"2026-10-03T18:27:10.290Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"e105448d-332a-401b-90ae-422cfd1a2d5e","isSidechain":true,"promptId":"18f95e19-3d7d-4312-a698-c0ed8ed1d357","agentId":"aeede644703c0347a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0142QDuDLfo6rsM8Tqt6yjXo","type":"tool_result","content":"   70148 /tmp/r6b_src.txt","is_error":false}]},"uuid":"f1ebecae-f37d-4957-88ab-cfc20702ab87","timestamp":"2026-10-03T18:27:15.827Z","toolUseResult":{"stdout":"   70148 /tmp/r6b_src.txt","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--tricyclic-annual-model-for-individual-and-one-on-one-sports.md","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":30,"lines":["+---","+type: library-entry","+kind: framework","+domain: strength-and-conditioning","+book: supertraining--verkhoshansky","+chapter: \"6.14.4\"","+topic: tricyclic annual model","+category: [periodization, annual-plan, tri-cyclic, combat-sports, concentrated-loading]","+confidence: supported","+ingest-tier: full-text","+created: 2026-10-03","+---","+","+# Tri-Cyclic Model for Individual and One-on-One Sports: Three Mesocycles for SPP, Technical Mastery and Competition Readiness, Each With Its Own Strength Block","+","+**What it is** — 6.14.4 (PDF p. 397 / printed p. 386, checked against the page image; Fig 6.42 on PDF p. 398 / printed p. 387, checked against the image): \"The tri-cyclic model is intended primarily for individual and one-on-one sports (Fig 6.42). It comprises three mesocycles, with preparatory and competitive micro-stages. The first stage is oriented chiefly towards special physical preparation; the second, to perfecting technical mastery, and the third, to readiness for the major competitions.\" The third stage \"can be increased by shortening the duration of the second stage,\" and \"In certain cases a bi-cyclic model of training can be employed with this group of sports.\"","+- **Athlete-state model:** maximum aerobic productivity in the second stage, then some decrease; \"Maximum strength rises uniformly, while strength-endurance accelerates more during the third stage. Explosive strength reaches a maximum at the beginning of the second and at the end of the third stages.\"","+- **Three strength blocks:** the first \"to develop maximum and explosive strength; the second, to develop strength-endurance; the third, chiefly to increase explosive strength and create conditions for exploiting the LDTE of the strength loading during the fundamental competition phase.\"","+- **Energy-system pairing:** \"The first and third blocks of strength work are executed in combination with special work in the mixed (aerobic-anaerobic) zone of energy production, while the second is combined with work in the anaerobic (ATP-CP and anaerobic-glycolytic) zone. The fundamental volume of speed and technical-tactical preparation is executed against a background of the LDTE elicited by the blocks of strength work.\"","+- **Fig 6.42, read by eye:** phases I about months 1-4, II about months 5-8, III about months 9-11. Block 1 about months 1-3 (tallest), block 2 about months 5-6, block 3 about months 9-10 (shortest). At the right edge the upper-panel curves end in the order Explosive strength, Anaerobic capacity, Aerobic capacity, Strength-endurance, with Maximum strength lowest and rising nearly linearly. Shorter mesocycles of this kind \"should not shift achieving the objective of optimal enhancement of the current adaptation reserves (CAR) to the next stage\" (PDF p. 400 / printed p. 389).","+","+**Why it works** — The authors give the structure, not a mechanism beyond the LDTE of each strength block. No data are shown; the figure is credited to Siff & Verkhoshansky (1999).","+","+**When to apply** — Individual and combat sports with three main competition periods, such as the boxing and swimming examples the authors cite for tri-cyclic forms (PDF p. 387 / printed p. 376), and team sports where \"tri-cyclic periodisation may have to be used, as dictated by the competition calendar\" (PDF p. 387). Eric's baseline: \"The head coach's system of play and roster identity (e.g., a \\\"home run hitters\\\" lineup vs. a \\\"steal bases\\\" lineup) is treated as a direct input into whether a team's programming leans toward maximal strength or toward speed/power emphasis\" (`docs/method-baseline.md`, line 188, Inferred (transcript)). Inference: the model's block contents (maximum, endurance, explosive) are the kind of lever that input would set.","+","+**When NOT to apply** — **Contested by Issurin for combat sports**: the library's brief of Issurin 2016 records that concentrated-unidirectional programs in combat and team sports improved some fitness measures without reported effects on practice or competitive performance, and that Issurin judged the evidence insufficient for broad use in \"high-performance combat, team-sport, and swimming preparation\" (brief, p. 6; [[research-papers/issurin-2016-benefits-and-limitations-of-block-periodized-training-approaches-to-athletes-preparation-a]]). This entry keeps `supported` because the tri-cyclic layout itself is not what Issurin challenges; the challenge is to the concentrated blocks inside it, recorded on [[claim--concentrated-strength-loading-limited-period-qualified-athletes-and-volume-saving]]. The model assumes three distinct competition peaks; it is not a template for a weekly-competition season.","+","+**Example** — The authors give the schematic only. Inference: a wrestler with a winter national championship, a spring continental event and a late-summer world championship runs a maximum-strength block in autumn, a strength-endurance block in late winter with anaerobic work, and a short explosive block before the summer peak.","+","+**Related** — [[claim--two-large-mesocycles-a-year-bi-cyclic-organisation]], [[framework--bi-cyclic-annual-model-for-explosive-strength-sports]], [[heuristic--set-mesocycle-boundaries-by-main-competition-dates]], [[elite-sports-performance--evans/framework--bompa-annual-plan-cycle-types]], [[research-papers/issurin-2016-benefits-and-limitations-of-block-periodized-training-approaches-to-athletes-preparation-a]]"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/kristinarash/DEV/Flint/staging/library/strength-and-conditioning/supertraining--verkhoshansky/framework--tricyclic-annual-model-for-individual-and-one-on-one-sports.md"]}},"sourceToolAssistantUUID":"e105448d-332a-401b-90ae-422cfd1a2d5e","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"f1ebecae-f37d-4957-88ab-cfc20702ab87","isSidechain":true,"agentId":"aeede644703c0347a","attachment":{"type":"hook_success","hookName":"PreToolUse:Read","toolUseID":"toolu_01QNNZ8SHiUiFZQys6ggACY7","hookEvent":"PreToolUse","content":"","stdout":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"<context_guidance>\\n  <tip>\\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\\n  </tip>\\n</context_guidance>\"}}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.mjs\"","durationMs":64},"type":"attachment","uuid":"99d43d51-8d04-4a3f-a7fb-dbcc51cb676a","timestamp":"2026-10-03T18:27:15.894Z","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"99d43d51-8d04-4a3f-a7fb-dbcc51cb676a","isSidechain":true,"agentId":"aeede644703c0347a","attachment":{"type":"hook_additional_context","content":["<context_guidance>\n  <tip>\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\n  </tip>\n</context_guidance>"],"hookName":"PreToolUse:Read","toolUseID":"toolu_01QNNZ8SHiUiFZQys6ggACY7","hookEvent":"PreToolUse"},"type":"attachment","uuid":"0119c44e-43cd-4981-8747-6eeda0b58846","timestamp":"2026-10-03T18:27:15.895Z","rendered":[{"content":"<system-reminder>\nPreToolUse:Read hook additional context: <context_guidance>\n  <tip>\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\n  </tip>\n</context_guidance>\n</system-reminder>"}],"renderedRole":"system","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"1ae49b2c-c489-49d3-9d07-0fb3feed3157","isSidechain":true,"promptId":"18f95e19-3d7d-4312-a698-c0ed8ed1d357","agentId":"aeede644703c0347a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QNNZ8SHiUiFZQys6ggACY7","type":"tool_result","content":"1\t\n2\t=========== PDF 347 ===========\n3\tSUPERTRAINING\n4\tfort those who may be interested in investigating this field more thoroughly (e.g., Klein ct al, 1991; Moore-Edeet \n5\tal, 1992; Nagai, 1992; Chadwick & Ackrill, 1996; Redfem & Lcmmer, 1997).\n6\t6.4 Training as a Problem in M anagement\n7\tProgramming and organisation of training require in-depth and comprehensive knowledge of the principles of \n8\ttraining. It is appropriate, therefore, to examine programming as a problem in management.\n9\tThe essence of management may be expressed in terms of the changcs of state of the relevant systems \n10\tproduced by given tasks, while the criterion of effectiveness lies in its functioning or development. Consequently, \n11\tfor practical implementation of management, it is necessary firstly to establish concepts about the structure of the \n12\tmanaged system and the characteristics of raising it from one state to another.\n13\tLet us examine a logical scheme of training organisation for describing the components of management in \n14\tsports training (Fig 6.12). Training is organised in accordance with specific tasks which result in a definite \n15\timprovement in sports results, so that the degree of improvement in sporting performance is the criterion of the \n16\teffectiveness of training. Sports results arc the observable product of the organisation of the athlete's external \n17\tinteractions. In other words, this is the result of the organisation of the athlete's movements which make effective \n18\tuse of strength and motor potential for executing specific motor tasks.\n19\tThe patterning of the external influences and an increase in the relative contribution of those forces which \n20\tdirectly contribute to the execution of the motor tasks are important conditions for improving sporting \n21\tproficiency. Therefore, one has to identify the major components of management in sports training, as follows:\n22\t1. The complex of the athlete's external influences encountered in competition. The greater the athlete's motor \n23\tpotential, the more effectively the complex of external interactions can be organised. Therefore, in multi-year \n24\ttraining, athletes train to increase their motor potential and specific work-capacity.\n25\t2. In this regard, the athlete's fitness state, as a characteristic of motor potential, should be classified as the \n26\tsecond component of management in the system of sports training. In this context, fitness state refers to the \n27\tathlete's structural-functional qualities which determine the athlete's potential to produce sporting prowess \n28\t(Zatsiorsky, 1979). \n29\tThe complcx of external interactions and the athlete's fitness state are established \n30\teffectively as a result of the systematic specialisation of the motor activities. The latter provides a number of \n31\tspecific training influences organised to produce the required changes in the complex comprising the external \n32\tinfluences and the athlete's fitness state.\n33\t3. Consequently, specialised motor activities, i.e. the training load is the third component of management in the \n34\tsystem of sport training (see 6.12).\n35\tThus, the preceding components together represent an hierarchically organised complex which undergoes goal- \n36\tdirected changes during sports training. In training, the ordered influences address all three components of the \n37\tmanagement process simultaneously. However, the basis for changes of fitness state during training lies in a \n38\tspecific, cyclic sequence of events. The dosage of the training load is prescribed to promote changes in the \n39\tathlete’s fitness state which, in turn, entails changcs in the complcx of external interactions of the athlete and a \n40\tcorresponding improvement in sporting results.\n41\tWhen the planned results are achieved, the programme and the organisation of the loading are determined \n42\tfor the next stage of training, and the sequence of the preceding conditions is repeated at higher levels. The \n43\tcyclicity of this process in accordance with sport specific periodisation determines the contents of the athlete's \n44\ttraining programme.\n45\tCompletion of the tasks, executed as separate components of the complex system of management process, \n46\tgives rise to an intricate dynamic complex of cause-effect relations between them, which may be considered as \n47\tthe structure of the managed system. Thus, the aggregate of the components of this complcx system, with its \n48\tcharacteristic cause-cffcct connections, represents the overall managed system.\n49\tThus, management involves all the tasks of training, motivation, the athlete's personality and social factors \n50\twhich express and integrate the interests of the athlete, coach and team, as well as the practical experience and \n51\ttheory of training construction. In orienting the course of training in a specific direction, model characteristics are \n52\tquantitatively assigned which relate to the training load, the athlete’s fitness state and his external interactions \n53\t(see Fig 6.12).\n54\t336\n55\t\n56\t=========== PDF 348 ===========\n57\tSUPERTRAINING\n58\tFigure 6.12 A logical scheme for organising sports training (Siff & Vcrkhoshansky, 1999).\n59\tThe main idea of managing training consists of raising the fitness state of the body to a higher functional level. \n60\tControl of this process is accomplished by assessing the effect at primarily two levels of management, namely at \n61\tthe level of the athlete's fitness state (control of the effect of the loading on fitness) and at the level of external \n62\tinteractions of the athlete (control of the change in their characteristics as a result of changes in fitness). Based on \n63\ta comparison of different effects achieved at the levels indicated by the given model characteristics* suitable \n64\tsolutions are implemented in order to manage the later course of training. \n65\tAnalysis of the contents and \n66\torganisation of training may now be summarised as follows:\n67\t1. Firstly, the interaction between the components of the managed system is determined by the training \n68\tpotential and the training effect of the loading (Fig 6.12). Here, the training potential o f the loading is \n69\tunderstood to mean its potential for promoting adaptation of the body and corresponding changes in its \n70\tfitness state and, consequently, in its external interactions. The training potential of the loading is a relative \n71\tconcept which should be examined and assessed in accordance with the athlete's current fitness state. \n72\tAssessment o f the training effect of the loading means measuring the performance change that the loading \n73\tproduces in each case under competitive and laboratory conditions.\n74\tThe training effect is achieved with relatively stable adaptation within the body, by use of any logical \n75\ttraining programme. The basis for the training effect is the accumulation of adaptive traces within the body \n76\tproduced by the entire complex of training influences. The substantive meaning of training, encompassing \n77\tthe concepts of training potential and training effect of the loading has central significance for programming \n78\ttraining and will be examined later in more detail.\n79\t2. The connection between the beginning and end points of training management is highly complex. The \n80\textent of this connection is determined primarily by the effectiveness of the operations of two \n81\tinterdependent subsystems of regulation (see Fig 6.12): {Training Load - Training Potential o f Loading - \n82\tAthlete's Fitness State} (subsystem A) and {Training Effect o f Loading - Athlete's Fitness State • Athlete's \n83\tExternal Interactions} (subsystem B). Assessment of the predictive reliability and the probability of success \n84\tof regulation at the level of each subsystem shows one can be certain that the lower the measures for the first \n85\tone (A), the weaker the link in the entire management system.\n86\t3. The necessity for effective management arises when there is a problem in selecting a training regime. In such \n87\tsituations success depends on the degree of accuracy in choosing the optimal from the multitude of possible \n88\tsolutions.\n89\t337\n90\t\n91\t=========== PDF 349 ===========\n92\tSUPERTRAINING\n93\t6.5 Prerequisites for Organising Training\n94\tA successful solution to the problem of programming and organising training cannot be obtained only by \n95\tassembling the results of individual fragments of research. Intensive research is required to formulate usable \n96\tconcepts concerning the training process and identifying those conditions which determine its efficieni \n97\tdevelopment. A preliminary examination of this problem already enables one to determine the goal of the task, \n98\tthe fundamental direction of research, and the specific information required (Fig 6.13).\n99\tThe scheme need not be described in much detail, because its meaning and contents are sufficiently clear and \n100\ttheir analysis is a matter for later discussion. Formulating a generalised theory of training requires a complcx \n101\tapproach to the organisation of research, without repeating those experimental errors which were proliferated \n102\tduring the preceding few decades.\n103\tFigure 6.13 A general theory of structuring sports training (Siff & Verkhoshansky, 1999).\n104\tIn sport physiology especially, a divergence of the professional interests of specialists leads to the human body \n105\tbeing regarded as two fairly distinct systems. Some specialists limit their study primarily to the neuromuscular \n106\tsystem and its regulation by the CNS, applying their work largely to specd-strength and complex-technical types \n107\tof sport. Others focus their interest on the cardiovascular-respiratory systems and metabolic processes which \n108\tdetermine success in primarily cyclic types of sport.\n109\tSuch specialisation is quite convenient for science, but is effective and applicable only on the basis of close \n110\tintegration between theory and practice. All too often, studies are based on the effect of a single factor on \n111\tperformance; very rarely does research focus on the interactive effects of concurrent or sequential complexes of \n112\ttraining methods.\n113\t338\n114\t\n115\t=========== PDF 350 ===========\n116\tSUPERTRAINING\n117\tIn particular, understanding of the scientific and practical fundamentals of the development of general \n118\tendurance suffers. Attention is centred on the mechanism of energy production, which ignores the specialisation \n119\tof the muscular apparatus as the direct executor of work, and general endurance is considered exclusively to be a \n120\t(unction of respiratory potential. Therefore, physiologists were perplexed when information was revealed about \n121\tthe decrease in V02max during the competition period and the unexpectedly low V02max levels among many \n122\tathletes in cyclic sports. However, this should not have been unexpected if they had concurrently examined the \n123\tcontractile and metabolic characteristics of the muscles of athletes who specialise in general endurance sports.\n124\tSport training theory also abounds with misdirected efforts. Here there is a similar division in the interests of \n125\tspecialists who give preference primarily to speed-strength or cyclic sports and tend to minimise the role of \n126\tgeneral endurance training. This professional specialisation cannot be condemned if they limit their theoretical \n127\tand practical generalisations to 'their' types of sport. It is when they attempt to apply the same principles and \n128\tmethods to other types of sport that this single-minded approach becomes misleading.\n129\tA definite weakness in modem sports training theory is the result of underestimating the importance of \n130\tinformation obtained from physiological and biochemical research in sport, as well as from the limited amount of \n131\tdefinitive scientific information which forms the basis for establishing training principles. \n132\tUntil recently, \n133\tgeneralised practical experience was usually regarded as the only valid way of establishing effective training \n134\tprinciples and methods, thereby neglecting the important contributions of scientific research. At the same time, \n135\tscientists disdained this attitude and coaches regarded scientists as impractical theoreticians, with the result that \n136\ttheir individual bodies of information were not shared and training methodology suffered. The advancement of \n137\tsport now depends strongly on close cooperation between scientists, coaches and athletes.\n138\t6.6 Basic M anagem ent Theory\n139\tIn most interactions in the work, social or recreational setting, leaders or managers emerge or are appointed to \n140\tcontrol, coordinate and guide their fellow humans to carry out certain tasks or achieve specific goals or fulfill a \n141\tprescribed purpose.\n142\tThe terms leadership and management are often used interchangeably, but there are distinct differences \n143\tbetween the two, depending on the situation. Small, ephemeral groups may have leaders or elected chairpersons, \n144\tbut usually not managers. The chairman of the board of a company does not play the managerial role of the \n145\texecutive director, who in turn does not function like the sales manager, who also may act as the highly motivating \n146\tleader of a sales team. Sports teams have captains, who are special types of leader, but they also have managers \n147\twho have no leadership function whatsoever on the field of play. Similarly, captains usually have no prescribed \n148\tleadership role off the field. Military officers often have to fill roles of leadership and management. What is \n149\tcommon to both leadership and management is the task of marshalling together the abilities and efforts of groups of \n150\tindividuals to reach specific goals, whether social, economic, military, sporting or otherwise. What is also common \n151\tto both is that communication is essential to the entire process.\n152\tTellier states that management roles are determined by position in an organisation and are characterised by \n153\tthree basic elements: responsibility, authority and accountability. Leadership, on the other hand, implies power to \n154\tinfluence others, which relies on factors such as expertise, personality and charisma.\n155\tManagement and leadership both require an understanding of human behaviour in terms of needs, wants and \n156\tdrives, hence the next section introduces you to theories of human behaviour and motivation.\n157\t6.6.1 Human Needs and Motivation\n158\tAlthough many models have been formulated to explain human needs, only a few have been selected here to enable \n159\tyou to appreciate the strengths and weaknesses of each and be able to select a suitable model for a given situation \n160\t(Siff, 1990). The motivation process involved in human drive may be summarized in the following way (Fig 6.14):\n161\t339\n162\t\n163\t=========== PDF 351 ===========\n164\tSUPERTRAINING\n165\tAt this point it is relevant to discuss the relationship between performance and motivation or. arousal. Higher levdr \n166\tof arousal do not necessarily lead to increased performance, on the contrary, excessive arousal may lead to a drop a \n167\tperformance, lowered productivity and an increase in the incidencc of mistakes and accidents. There appears to be \n168\tan optimum level of arousal for any person performing a specific task at a specific time, as was revealed by the \n169\twork of Yerkes and Dodson (see Fig 6.15).\n170\tThe exact shape of the curve depends on individual characteristics such as level of introversion/extroversion, \n171\tlevel of exhaustion, standard of health, and task complexity. There is no easy formula to determine the \n172\tcharacteristic curve for any individual; instead it depends on the effort of a manager, leader or coach to become \n173\tadequately informed of the personal attributes, performance and characteristics of each worker or athlete. What is \n174\trelevant is that the manager or coach appreciates that all motivational techniques are not universally applicable to \n175\teveryone. Instead, they are to be applied with a thorough understanding of the individual and the situation.\n176\tCaution must be exercised when applying the Yerkes-Dodson (Y-D) model, since it implies that there is just \n177\tone discrete peak for a specific optimal level of arousal or stress. The existence of the 'second wind' phenomenon \n178\t(curve B) and the effect of task complexity on curve shape are two of several reasons why the original curve must \n179\tbe applied to restoration and stress management with circumspection.\n180\tIt also implies that very low and very high levels of arousal invariably lead to diminished performance. While \n181\tthis may be generally true, it is well known that both sensory underload and overload may lead to phases of \n182\tenhanced performance (curves A, C). The consequences of low arousal levels is not necessarily sleep or coma. On \n183\tthe contrary, meditation and similar altered states of consciousness may enhance performance in certain situations \n184\t(curve A).\n185\tMoreover, sleep, reverie, day-dreaming and relaxed visualisation should not be viewed always as unproductive \n186\tand disconnected, since research and experience reveal that problem-solving, creativity and physiological repair \n187\tmay occur strongly in these altered, though perfectly normal, states. The occurrence of nightmares and vigorous \n188\tmuscular activity also suggests that high stress levels may persist even in sleep.\n189\tNotions of optimising one's stress level thus may be seen to be based on a limited mechanistic model of human \n190\tbehaviour. Altered states of consciousness are a normal part of life and are not adequately described by the Y-D or \n191\tSelye curves. In fact, the most efficient use and channeling of 'stress energy' may be mediated during periodic \n192\taltered states which the Y-D model describes as inadequately stressful to produce meaningful performance (cunt \n193\tA). Therefore, both optimisation and transcendental stress management strategies are necessary if effective use is to \n194\tbe made of stress.\n195\tFurthermore, regular exposure to a stressor may produce either habituation or oversensitisation, so that the \n196\tsame level of stress may not produce the same response at a later stage. In either event, timely use of restoration \n197\tmeasures is of central importance.\n198\tPersonality can have a significant effect on the shape of the Y-D curve. For instance, the introvert appears to \n199\thave a lower optimal arousal zone, unlike the extrovert who requires greater stimulation and can cope better with \n200\thigh levels of stress. This difference in the effect of high levels of training and competitive stress has important \n201\timplications for the prescription of restorative procedures, with the introvert probably requiring early restoration \n202\tand the extrovert requiring careful monitoring to prevent overtraining caused by a desire for greater stimulation.\n203\tTask structure also modifies the shape of the Y-D curve. Complex tasks require low levels of arousal to reach \n204\toptimal performance over very limited periods (e.g. in golf, gymnastics and pole vaulting), whereas simple sports \n205\ttasks may be executed over a longer period at higher levels of arousal. \n206\tExcessive exposure of an athlete to\n207\t340\n208\t\n209\t=========== PDF 352 ===========\n210\tSUPERTRAINING\n211\tOther Theories of Needs\n212\tAldcrfer identified the following categories of needs:\n213\t• Existence needs, which concern our physiological and material desires, such as those for hunger and shelter\n214\t• Relatedness needs, which concern relationships between people\n215\t• Growth needs, which concern personal development, change, evolution and creativity.\n216\tMcClelland, like the neurophysiologist, James Olds, however, maintained that there arc only two human needs ~ \n217\tthe need for pleasure and the need to avoid pain. All other needs or motives are learned. On this basis, McClelland \n218\tthen categorized these acquired needs as follows:\n219\t• Achievement. There is a strong need among some people to excel. They have a high achievement need and \n220\twant to do a task well for its own sake, rather than for its material rewards.\n221\t• Power. This refers to the desire to influence, regulate and control the actions and behaviour of other people.\n222\t• Affiliation This refers to the need for positive relationships with other people and probably is described best \n223\tby the word 'friendship’. A major aspect of the affiliation need is the need for communication.\n224\tAlderfer’s model differs significantly from Maslow's in that it recognizes that satisfied needs may still continue to \n225\tbe influential, particularly if they can substitute for an unsatisfied need. Research by Alderfer also reveals that \n226\thigher order (growth) needs can arise or exist simultaneously with the lower order needs. It also emerges that \n227\tcertain needs become even more intensified if they are more satisfied than others. It is obvious then that Maslow's \n228\thierarchy, like all theory, has to be applied with circumspection.\n229\t341\n230\tcomplex training tasks can lead rapidly to ‘overstrcss*, while simple tasks may be insufficiently challenging to \n231\tproduce continued supercompensation. A balance between complexity, simplicity, intensity and volume of load is \n232\tnecessary to ensure growth and to minimise overtraining.\n233\tMaslow's Hierarchy of Needs\n234\tOne of the best known, though simplistic, models of human needs is that of psychologist, Abraham Maslow. He \n235\tdevised an hierarchy of needs ranging from the most basic, which have to be satisfied first before subsequent \n236\tneeds will begin to exert a significant influence on a person. This hierarchy may be arranged in the form of a \n237\ttriangle with the most basic physiological, concrete needs at its base and the highest level, abstract need for \n238\tself-actualization (the need to achieve one's highest potential in a specific situation) at its apex. It may also be \n239\tarranged to explain the needs of the individual in both a private or a professional capacity (see Fig 6.16).\n240\tOccasionally, this model may include a state beyond self-actualisation, called transcendence which is \n241\tassociated with states of profoundly altered consciousness such as religious reverie or trance meditation. \n242\tHowever, this state is not simply the preserve of the ascetic or mystic, because many athletes have reported \n243\tachieving world class performances in similar altered states (Murphy & White, 1978)\n244\t\n245\t=========== PDF 353 ===========\n246\tSUPERTRAINING\n247\tAll the above theories overlap in some respects or have strong similarities. They are usefully augmented or \n248\treplaced in the analysis of management interactions by Vroom's Expectancy Theory o f Motivation, which can b: \n249\tparticularly valuable to apply in the workplace or advertising realm. This theory posits that it is not merely i \n250\tspecific goal, but the individual perception of that goal which motivates people. Vroom stated that Motivate \n251\tForce depends on two factors (Tellier, 1978):\n252\t• the perceived attractiveness (valence V) of the goal or outcome\n253\t• the perceived probability o f achieving that goal or outcome (one's personal belief, B, that success is likely)\n254\tHe then combined these two factors so that the Motivational Force F depends on their arithmetic product F = V X\n255\tB. \n256\tIn other words, if a goal is highly attractive and you believe strongly that it is within your reach, tht \n257\tMotivational Force driving you will be very strong. However, if a goal is extremely attractive, but you believe it to \n258\tbe far outside your reach, you will experience a small Motivational Force and put in minimal effort to attain that \n259\tgoal. Under such circumstances, it is desirable to break down a large or distant goal into smaller goals to be \n260\tachieved over a period or at a rate which you perceive to be more matched to your capabilities or experience.\n261\tVroom's detailed theory involves allocating numerical values to the contributing factors. Perceived \n262\tattractiveness is rated from -5 (extremely undesirable) to +5 (extremely desirable), while belief in success is rated \n263\ton a scale from 0 (total disbelief) to 1 (total belief)- The overall Motivational Force is the sum of the motivational \n264\tforces calculated from the products of perceived attractiveness and perceived belief for all the important goals or \n265\toutcomes associated with carrying out the task.\n266\tDetailed examples of this theory are outside the scope of this book, so it is sufficient to note that a manager or \n267\tleader can motivate athletes strongly if he appreciates that motivation depends on perceptions of goal attractiveness \n268\tand attainability. He can improve performance either by modifying the task accordingly or by altering the athlete’s \n269\tperceptions of the task and its outcomes.\n270\t6.6.2 Management Models\n271\tManagement implies the existence of authority. Oncken identifies four types of authority: authority of position or \n272\tpower, authority of personality, authority of competence, and authority of integrity.\n273\tThe Traditional Model\n274\tTradition decreed that workers were of secondary importance to productivity, that they were possessions, slaves or \n275\thired slaves. This linear approach to management may be summarized in the form of the following diagram (Fig \n276\t6.17). All too often this model continues to be applied by managers, leaders and coaches steeped in the traditional\n277\tways.\n278\tE xpectancy Theory of M otivation\n279\tFigure 6.17 The linear, single continuum model of traditional management\n280\tThe Managerial Grid\n281\tExperience and subsequent research have revealed that productivity is enhanced if an appropriate balance is \n282\testablished between concern for people and production. This led Blake and Mouton to devise the Ohio State \n283\tUniversity model, which emphasizes the relationship between productivity and people concern (Fig 6.18).\n284\tAll management styles may be identified by selecting suitable coordinates from the grid. For instance, the \n285\tautocrat would have a rating of (9,1), whereas the laissez faire leader would have a rating of (1,9). Coordinates \n286\t(1,1) characterize impoverished leadership, while (9,9) refers to ideal management. The middle-of-the-road \n287\tmanager is located at (5,5).\n288\t342\n289\t\n290\t=========== PDF 354 ===========\n291\tSUPERTRAINING\n292\tFigure 6.18 The Blake-Mouton managerial grid\n293\tSituational Leadership\n294\tHcrscy and Blanchard stated that leadership style ought to be implemented according to each situation which arises. \n295\tTheir model illustrates how leadership style may be adapted to a given situation according to the ’maturity' \n296\t(education, experience, responsibility, self-motivation, degree of self-actualization) of the worker or follower (Fig \n297\t6.19).\n298\tFigure 6.19 The Situational Leadership Model (Hersey and Blanchard)\n299\tTo use this system, the coach in playing a role as leader rates the maturity of the follower as low, moderate or high \n300\t(Ml, M2, M3 or M4), then reads off the appropriate leadership style (SI, S2, S3 or S4) in the relevant box above. \n301\tRelationship behaviour includes the amount of time and effort put into interaction with followers. One spends more \n302\ttime in Selling or Participatory situations than in Telling or Delegating situations, hence the shape of the curve.\n303\tThe Leadership Continuum\n304\tTannenbaum and Schmidt devised a leadership continuum extending between the extremes of Leader-ccntredness \n305\tand Worker-centredness. It relates well to the leadership characteristics of Likert’s four management styles, as \n306\tfollows (Fig 6.20).\n307\t343\n308\t\n309\t=========== PDF 355 ===========\n310\tSUPERTRAINING\n311\tFigure 6.20 The Tanncnbaum-Schmidt leadership continuum and its relation to Likert's management style\n312\tDecision Making and Problem Solving\n313\tDecision-making is a vital part of all management situations, so it is essential that some of the formal theory of this \n314\tprocess be covered. Often, managers or committees are called upon to handle problems in order of importance. The \n315\tword 'Importance' is far too unspecific to be of any real value in every situation; it is relative to the individual \n316\tperceptions of all concerned in the problem solving or decision-making process. It is preferable to rate every \n317\tproblem in terms of:\n318\t• Seriousness or size\n319\t• Urgency\n320\t• Growth potential or growth rate\n321\tIn using such a system, one allocates H (high), M (medium) or L (low) to each of these factors relating to all the \n322\tproblems to be considered in a particular situation. Problems identified by triple or double H’s are then handled \n323\tbefore those with fewer or no H's, with triple L's rated problems receiving lowest priority. In attempting to solve \n324\tany problem, it is useful to recognize the main six steps in problem-solving:\n325\t1. Identification and definition of problem\n326\t2. Generation of alternative solutions\n327\t3. Evaluation of the alternative solutions\n328\t4. Decision -making: selection of solution\n329\t5. Implementation of decision\n330\t6. Testing of solution.\n331\tShould the final step verify the value of the chosen solution, the process will terminate. If not, one may return to \n332\tsteps 1, 2 or 3 and repeat the process until a suitable solution emerges. Limitations involving factors such as time, \n333\tinformation, expertise, money and materials may hinder or halt this process. Consequently, one might make \n334\tinappropriate or ill-considered decisions. A better understanding of the nature of problem-solving and \n335\tdecision-making then becomes advisable.\n336\tMaier (1963) identified two fundamental factors in the decision-making process: the objective quality of the \n337\tdecision, and the acceptance of that decision by those concerned, which involves their subjective feelings. \n338\tDepending on one’s individual decision-making style, he will tend to focus separately on quality or acceptance, \n339\tregardless of the problem situation. Roskin, therefore, developed a decision-making inventory to make one more \n340\taware that personal decision-making style should be more flexible and guided by the situation concerned (Maier.\n341\t344\n342\t\n343\t=========== PDF 356 ===========\n344\tSUPERTRAINING\n345\tI%3). In this system, you have to identify the problem type in terms of its relative quality and acceptance, than \n346\tdecide on one of four decision-making styles (Fig 6.21). It is essential to remember that implementation of all \n347\tstyles depends on the time available for managing the different phases of the problem.\n348\tConcluding Remarks\n349\tThis section was included to enable you to apply some of the vast field of management and leadership theory in the \n350\tmajor communication situations you will encounter as a professional. It does not pretend to offer any completeness. \n351\tNot only is thorough coverage of the topic outside the scope of this book, but management is a dynamic and rapidly \n352\texpanding discipline, with nuances and expertise being added regularly by innovative managers and scientists.\n353\tFor instance, the close interaction of manager and worker, logic and emotion, science and intuition are being \n354\tclosely examined. Researchers have produced the 7-S Framework to define the scope of management more clearly. \n355\tIt stresses that management must take account of the following factors in any organization: structure, staff, systems, \n356\tstrategy, skills, style and shared values (Peters & Waterman, 1983). It is up to interested readers to expand their \n357\tknowledge by reading some of the standard management texts and professional journals.\n358\t6.7 Classification of Sports\n359\tEstablishing the principles and rules of programming training necessitates determining clearly the limits of \n360\tgenerality and specificity in individual sports or groups of related sports. To do this it is necessary to classify \n361\tsports scientifically to establish programming criteria.\n362\tSport is associated first of all, with the spatio-temporal organisation of the athlete's movements, which is \n363\tdetermined by the rules and conditions of competition and by the effective use of motor potential for executing \n364\tthe required motor tasks. \n365\tIn all cases, this requires perfecting the central nervous processes which control \n366\tmovement, as well as raising the functional potential of the muscles and metabolic systems. Classification of \n367\tsports into individual, team, ball or water sports, for example, is not scientifically useful; it is more appropriate to \n368\tclassify sports on the basis of the particular organisation of the sporting movements and characteristics of the \n369\tphysical systems used to produce their working effect.\n370\tThe more prolonged and the lower the intensity of muscular work, the greater the role of aerobic processes \n371\tand the greater the functional specialisation of the muscles to utilise oxygen more fully. \n372\tThe role o f the \n373\tglycolytic mechanisms of energy production grows as the duration of work decreases and the power of muscular \n374\twork increases. The muscles adapt to working conditions of an inadequate supply of oxygen and the rapid \n375\tremoval of lactate during the exercise.\n376\tThe loading of the motor apparatus and the power of explosive effort increase significantly during brief \n377\tacyclic work. Under conditions of heavy dynamic overload, athletes must overcome significant external \n378\tresistance which they must accomplish in a very short time (tenths and even hundredths of a second). This \n379\tcomplicates movement coordination significantly and requires the development of an effective and reliable \n380\tbiodynamic structure (see 2.1.3). Under these conditions, the neuromuscular apparatus improves intramuscular \n381\tregulation and increases the power of anaerobic energy production. This preamble shows that sports may be \n382\tdivided into two broad groups, namely acyclic and cyclic sports:\n383\t345\n384\t\n385\t=========== PDF 357 ===========\n386\tSUPERTRAINING\n387\t• Acyclic sports characterised by the complex organisation of motor actions and an intense concentration of \n388\tworking effort, displayed briefly under competition conditions. Such sports have an inherently stable \n389\tbiodynamic movement structure and defmite structural-functional specialisation of the neuromuscular \n390\tapparatus which recruits its abilities to display powerful explosive effort and anaerobic power; primarily \n391\tthrough ATP-CP energy processes.\n392\t• Cyclic sports characterised by prolonged repetition of stereotyped work cycles of relatively simple \n393\torganisation which do not require maximal muscular tension. The energy acquired for such work comes \n394\tprimarily from stored glycogen or free fatty acids metabolised in the presence of oxygen during the exercise. \n395\tOne of the most important conditions for improving performance in this group of sports is the structural and \n396\tfunctional specialisation of the muscles to improve their ability to oxidise metabolites, as well as to increase \n397\tthe capacity of the metabolic processes and the economy of using the energy substrates during exercise.\n398\tOne should further subdivide the sports in each of these broad groups in terms of specific characteristics of \n399\tmovement organisation and energy production. Thus, the acyclic group embraces sports that require powerful, \n400\tbrief, explosive efforts and others which involve fine motor control and spatially precise movement. In the \n401\tcyclical group there are some sports where the work is executed under conditions of extensive oxygen utilisation \n402\tand others where the muscles have an inadequate oxygen supply.\n403\tFinally, one should identify a third group of sports, characterised by varying competition demands and the \n404\tneed to maintain a high work output under conditions of fatigue. These types of sports combine characteristics of \n405\tthe preceding two groups. They involve constant changes in intensity of the competition activities, as well as \n406\tbursts of high power movements with periodic rest pauses, so that energy production is of a mixed aerobic- \n407\tanaerobic character, with the greater part being derived from glycolytic reactions. Thus we may classify sports \n408\tinto three groups, as already outlined by Farfel (1969):\n409\t• Acyclic sports, in which perfecting of the neuromuscular system for precise regulation of movements and the \n410\tability to produce great power play the dominant roles\n411\t• Cyclic sports (usually of submaximal and of moderate power), associated primarily with the production of \n412\tmuscular work through aerobic processes\n413\t• Complex (combined) sports, where characteristically there is a high variability of motor actions under \n414\tconditions of advancing fatigue and varying intensity of work, typified by team sports and one-on-one events \n415\t(e.g. boxing and fencing).\n416\tIn classifying sports, it is necessary to consider competitive, as well as training activities. This is important, \n417\tbecause in some cases the training exercises are very different from competitive actions, often due to the \n418\tnecessity for repeated reproduction of the competitive movements in training. In practice, we refer to special \n419\tendurance (e.g. speed-jumping-, and strength-endurance) in such cases. For example, the shortest sprint distance \n420\tin track-and-field (100 metres) is covered in approximately 10 seconds. The effort expended to achieve this does \n421\tnot depend on oxidative efficiency. However, in order for a sprinter to prepare himself to effectively display such \n422\teffort, he should execute training loads that develop his aerobic and anaerobic potential, in particular the latter. \n423\tThe general principles of programming training for each of the above groups of sport will be examined later.\n424\t6.8 C haracteristics of the Training Process\n425\tFormulation of theories and practical methods of programming training, as stated before, is possible only through \n426\tunderstanding the training process. Therefore, it is relevant to return to the scheme presented in Figure 6.8 to \n427\texamine the characteristics of the long-term adaptation to intense muscular work. We will then examine the \n428\tcharacteristics of the structural and functional specialisation of the body as a specific external expression of long­\n429\tterm adaptation to intense muscular work. Finally, we will investigate some of the characteristics of developing \n430\ttechnical proficiency in different sports to understand how the athlete masters the skill to use motor potential \n431\tefficiently in competition.\n432\t6.8.1 Adaptation to Intense Muscular Work\n433\tExtensive experimental data has been collected concerning the restorative processes and the body's reaction after \n434\tbrief training stimuli in sport (the immediate training effect). It has been shown that the after-effect of large \n435\tloading docs not simply restore the expended energy but leads to super-restoration which exceeds the initial level\n436\t346\n437\t\n438\t=========== PDF 358 ===========\n439\tSUPERTRAINING\n440\t(see 1.14). This phenomenon (Weigert’s law of supercompensation) was first formally described by Folbrot \n441\t(1941, 1952, 1958), while its relation to exhaustion-restoration processes under different types of loading has \n442\tbeen studied by several other specialists (Yakovlev, 1955, 1975; Gorkin et al, 1973; Volkov, 1975; Monogarov \n443\t& Platonov, 1975; Sergeyev, 1981). \n444\tApplication of the these findings on the nature of adaptation and \n445\tsupercompensation led to rapid acceptance of the following practical recommendations:\n446\t• It is necessary for the athlete to maintain a state of adaptation during training, so that it is possible to \n447\texecute the fundamental sporting actions effectively over an extended period\n448\t• Repetition of training loads when the body is in a state of insufficient restoration is generally undesirable, \n449\talthough this is permissible in certain instances\n450\t• Special work capacity should rise steadily during the course of training; any decrease at given stages of \n451\ttraining would indicate that the training is incorrectly organised.\n452\tUndoubtedly, all of these premises were progressive in their time and to a certain extent are still valid today. \n453\tHowever, modem sporting requirements reveal the necessity to alter the main approach to structuring training and \n454\tobey common sense, which indicates that the fundamental unit of training should be the mesocycle and not the \n455\tmicrocycle. An extensive study of the characteristics of long-term adaptation is required for this. The practical \n456\tvalue of this study will be appreciated only if one can observe the specific effect of given training loads on the \n457\tdynamics of the athlete's state and determine the quantitative characteristics of the adaptation process.\n458\tThe initial results of this research already have convincingly demonstrated its scientific and practical value, \n459\tespecially in the case of sports which require explosive effort. General concepts about the development o f long­\n460\tterm adaptation are the result of observing the dynamics of an athlete's special physical preparedness indicators \n461\tover many years of training. Extensive research allows us to reach the following conclusions:\n462\t1. The absolute and mean level of special strength preparedness increases annually.\n463\t2. The initial level of speed-strength in each annual cycle is lower than the level at the end of the preceding \n464\tyear's, but higher than at its beginning.\n465\t3. The rise in speed-strength from year to year is larger for athletes of medium qualification than for highly \n466\tqualified athletes.\n467\t4. There is a definite trend in the dynamics of special strength preparedness in the annual cycle, which is \n468\tdetermined by the traditional periodisation of training for the given sport and competition calendar. One can \n469\tclearly trace a twin peak in the dynamics of speed-strength with two competition stages, because the level \n470\tof special strength preparedness is higher in the second competition stage than in the first. In types of sports \n471\twith one competition season, speed-strength rises regularly and uniformly.\n472\tDrawing such conclusions about some of the characteristics of long-term adaptation to intense muscular work in \n473\tsport has important practical significance for programming training.\n474\tThe performance results of the adaptation process, expressed by the dynamics of special work capacity, may \n475\tbe presented schematically in the form of several concurrent graphs (Fig 6.22). Graphs B and C reflect the \n476\tdynamics of the athlete's special work capacity in annual cycles (for bi-cyclic and mono-cyclic periodisation, \n477\trespectively). Graph A depicts the dynamics of relatively stable, long-term adaptation over many years.\n478\tFigure 6.22 The dynamics o f adaptation in sports training over several years (Siff & Verkhoshansky, 1999).\n479\t347\n480\t\n481\t=========== PDF 359 ===========\n482\tSUPERTRAINING\n483\tThe changcs in the functional indicators (graphs B and C) during the annual cycle are temporary, unstable and to \n484\ta certain extent, reversible. \n485\tThe basis for these changes arc the so-called compensatory mechanisms, i.e. \n486\treactions designed to maintain the necessary level of functioning for brief periods under demanding conditions \n487\twhich ultimately lead to stable adaptation. The compensatory mechanisms are dynamic physiological means of \n488\trepairing the body during extreme conditions and gradually fade as adaptation takes place. \n489\tInsofar as these \n490\tmechanisms precede adaptation, they should be designated pre-adaptation phenomena (Kuznyetsov, 1979).\n491\tThus, compensatory adaptation is a prerequisite condition for the development of long-term, stable \n492\tadaptation (graph A). The latter can progressively increase if the functional reconstruction during the course of \n493\tcompensatory adaptation is sufficient to produce a noticeable cffcct on the external interactions of the body and \n494\tincrease its special work capacity. It should be stressed that adaptation in sport consists not only of increased \n495\tmotor potential, but also the improvement of the athlete's skills to more effectively utilise this potential for coping \n496\twith specific motor tasks (graph D).\n497\tIn the light of scientific research, adaptation cannot be considered an equilibrium process. Adaptation is the \n498\tdynamic maintenance o f a definite level o f imbalance between the body and the environment at a given time, \n499\twhich is the fundamental reason for the origin and development of accommodative reconstruction (Bauer, 1935; \n500\tBernstein, 1966).\n501\tFigure 6.22 illustrates the gross changes in special preparedness with time and, therefore, reflects only the \n502\tgeneral aspects of long-term adaptation. In reality, changes in special work capacity are produced by an extensive \n503\tcomplex of adaptive processes which involve all of the body's survival systems. The rate of improving the \n504\tperformance of these systems and the stages of acceleratcd physical development can be different. This \n505\theterochronicity is determined by:\n506\t• the action of particular physiological systems in establishing long-term adaptation of a specific emphasis\n507\t• differences in their reactiveness (or adaptive inertia)\n508\t• changes in the role of these systems at different stages of long-term adaptation.\n509\tA clear picture of the development of long-term adaptation in endurance sports has not been observed as it has \n510\tbeen in explosivc-strcngth sports. In this case, it is not a matter of some specific differences in the adaptation \n511\tprocess, but in the ability to observe it in the factors used for analysis. The measures of aerobic and anaerobic \n512\toutput reflect the general level of special work capacity (i.e. endurance), but they do not express the internal \n513\tchanges associated with adaptation to intense cyclic or acyclic work. A great deal of work still has to be done in \n514\tunderstanding adaptation as the result of the summation of physiological responses to different training stresses, \n515\tin particular regarding the endocrine system, neurohormonal processes, the neuromuscular system and the entire \n516\tnervous system. The research done by Folbrot (1941), Selyc (see 1.16) and others has to be taken much further \n517\tin its application to the development of sporting mastery, especially in endurance sports. Until then one can \n518\tassume that long-term adaptation to endurance work is developed by the same, above-mentioned chief \n519\tmechanisms, although at another level of the physiological systems.\n520\tLong-term compensatory adaptation cannot continue indefinitely. The cffcct of compensatory adaptation on \n521\tspecial work capacity diminishes with each repetition; with the adaptation being described by a parabola whose \n522\tpeak is eventually reached with time (Fig 6.22, graph A). This indicates that an athlete's general adaptation \n523\treserves have a limit that is genetically predetermined. One can judge the limits of compensatory adaptation by \n524\tthe presence of waves in the dynamics of special work capacity (graphs B and C). One of the reasons for the \n525\tappearancc of these waves is the use of traditional periodisation of training (mono- or bi-cyclic periodisation), but \n526\ta more important reason is the exhaustion of the so-called current adaptation reserves (CAR) of the body (see \n527\t1.16).\n528\tAt any instant, the body has a definite reserve potential, i.e. a capability of responding to adapt to external \n529\tinfluences and raise itself to a new functional level. The capacity of these adaptive reserves is limited by definite \n530\tphysiological mechanisms which determine the absolute level of the body's adaptive capability. Hence, the \n531\tintensity, volume and duration of the training influences determine the optimal development of the body's CAR. \n532\tIf the magnitude of these are below certain thresholds, the body will not fully utilise its CAR, whereas, if they \n533\texceed it, exhaustion of reserve potential will occur and the training effect will be low or negative.\n534\tThe adaptation proccss has been divided by different researchers into three phases, based on observations of \n535\tphysiological changes and the corresponding dynamics of sporting achievements, namely: (a) the growth of \n536\ttrainability, (b) sporting form, (c) loss of trainability (Letunov, 1952), or as the similar scheme: (a) adaptation, (b) \n537\tthe highest sport work-capacity, (c) re-adaptation (Prokor, 1959). In the latter case, re-adaptation refers to the\n538\t348\n539\t\n540\t=========== PDF 360 ===========\n541\tS UPER'fRA IN INC\n542\tdecrease in work capacity as the limits of adaptability are exceeded, i.e. the adaptation energy is lowered. \n543\tSubsequent workers have designated these phases simply as acquisition, preservation and brief loss of sporting \n544\tform (Matveyev, 1964).\n545\tThus, one can consider training organisation to be effective when it produces the maximum growth of the \n546\tbody’s CAR by means of the appropriate volume of loading. Hence, useful ways of programming and organising \n547\ttraining emerge if we devise means of assessing the body’s CAR in each case, together with criteria for \n548\tdetermining the contents and volume of the training loads that are necessary for building up the CAR. The \n549\tpossibility of devising a quantitative approach to determine the body's reserve capacity has already been \n550\tdiscussed in the literature for several decades. It is based, in particular, on assessments of a number of bio­\n551\tchemical indicators of energy exchange processes (Beckman et al, 1961; Yakovlev, 1977).\n552\tTwo forms of compensatory adaptation, associated with enhancing the CAR by systematic training, which \n553\tdiffer in volume and organisation of the training loads, have been identified and studied in explosive sports (Fig \n554\t623). The first form o f adaptation, produced by distributed loading (A), is characterised by a gradual increase in \n555\tthe functional indicators and is associated with a moderate volume of continuous loading. In this case, periodic \n556\tbrief disturbances of the body's homeostasis occur and the current expenditure of energy resources is \n557\tcompensated during training. This form of compensatory adaptation follows traditional concepts for developing \n558\ttrainability and is typical for athletes of medium classification under contemporary training conditions.\n559\tThe second form of compensatory adaptation, produced by concentrated loading (B), is associated with the \n560\tuse of a large, concentrated volume of special physical preparation means, concentrated in the first half of the \n561\ttraining phase. These large volumes provoke a profound and prolonged disturbance of the body's homeostasis, \n562\twhich is reflected by decrease of the functional indicators. Then, after the volume of loading is decreased, their \n563\tincrease accelerates and exceeds the level achieved with the first form of adaptation. This way of organising \n564\tloading in the preparatory mesocycles was devised for highly qualified athletes and has been shown by research \n565\tto be effective for all types of sport (Verkhoshansky, 1977).\n566\tThe practical aspects of utilising this form of compensatory adaptation in actual training conditions will be \n567\tdealt with later. It is relevant here to dwell on the results of research which studied compensatory adaptation and \n568\tmethods of maximally enhancing the body’s CAR during the training mesocycle.\n569\tFirstly, the optimal duration of the training influences was determined, since this is vital \n570\tfor maximal \n571\tenhancement of the body's CAR. It was learned that the appropriate duration of continuous training is 5-6 weeks, \n572\tand with concentrated loading, the duration is 3-4 weeks, after which a recuperation period is necessary for \n573\tactivating the compensatory processes.\n574\tIt was also revealed that the trained athlete is able to tolerate three such sequential blocks of loading, \n575\tseparated by short recuperation pauses (7-10 days). After this, a longer recuperation period is necessary to \n576\tfacilitate stabilisation at the new level of adaptation. Thus, the time interval necessary for exhausting the body's \n577\tCAR is between 18-22 weeks (see Fig 6.23). This period coincides with observations of highly qualified athletes \n578\ttraining in different sports, including cyclic types (Zhikharevich, 1976; Sirenko, 1980).\n579\tIn order to apply this information, it is necessary to appreciate that the body cannot indefinitely continue to \n580\tadapt successively to training loads. There are definite time limits during which the body is able to react \n581\tpositively to continuous training loads of large volume, and these must be taken into account when programming \n582\ttraining. Whatever training regime is devised, it must always be remembered that it is inappropriate to subject \n583\tthe body to extreme exhaustion of its energy reserves. This requires a longer recuperation period and has a \n584\tnegative effect on the subsequent stages of adaptation.\n585\tThe preceding cautionary remarks apparently have not been fully appreciated by the critics (such as \n586\tKomarova, 1984) of the concentrated loading system. \n587\tKomarova correctly recognises that premature or \n588\tprolonged application of concentrated loading can lead to overtraining, stagnation or injury, as has been \n589\temphasized regularly in this textbook. However, he errs in extrapolating this analysis to completely dismiss the \n590\tperiodic use of concentrated loading by qualified athletes. This underlines how important it is for the coach to be \n591\table to select the appropriate form of periodisation to suit the athlete during every stage of the training process.\n592\tResearch aimed at revealing effective ways of maximally developing the body's CAR, has revealed one of \n593\tthe most important features of adaptation associated with the extensive disturbance of the body's homeostasis \n594\tI Verkhoshansky, 1977). It was found that the more extensive and longer the exhaustion of the body's energy \n595\tresources by concentrated loading during specific mesocycles of training (obviously within reasonable limits), the \n596\thigher their subsequent super-restoration and the longer the new functional level is maintained. The key issue, of\n597\t349\n598\t\n599\t=========== PDF 361 ===========\n600\tSUPERTRAINING\n601\tcourse, is determining the optimal duration of concentrated loading, so as to avoid exhaustion and diminished \n602\tperformance.\n603\tFigure 6.23 Two forms of compensatory adaptation during the large preparation phase (Siff & Verkhoshansky. 1999).\n604\tIt is interesting to note the results of a study done by Bondarchuk (1982) which analysed the effect of different \n605\tvolumes of an identical training programme on a group of hammcr-throwers. He found that a 50% increase in \n606\tvolume of loading had no significant effect on the duration of maintenance of the training effect and sporting \n607\tperformance. Although Bondarchuk stresses that this finding applies strictly to a particular group of athletes, it \n608\ttends to confirm that major changes in intensity have a more profound effect on athletic state than comparable \n609\tchanges in volume. It also implies that calculations of volume are not as critical as those of intensity, thus \n610\tcorroborating the importance o f paying careful attention to zones o f loading intensity, as emphasized earlier in\n611\t6.2.2 (see also Table 6.1).\n612\tTraining organisation which elicits extensive and relatively prolonged disturbance of homeostasis \n613\tnecessitates the inclusion of suitable restorative stages for triggering a compensatory reaction, thereby eliminating \n614\tinappropriately phased peaking of the various functional indicators and stabilising the body at the new functional \n615\tlevel. The general volume of the load should be decreased at this time and General Physical Preparation means \n616\tshould be introduced into training so as to intensify the compensatory reaction. \n617\tThe more extensive and \n618\tprolonged the disturbance of homeostasis, the longer the restorative stage should be. The concept of CAR and \n619\tthe characteristics of compensatory adaptation have great significance for programming training and especially \n620\tfor effective annual periodisation.\n621\t6.8.2 Structural-Functional Specialisation in Training\n622\tStructural-functional specialisation refers to those stable, adaptive changes that are produced by the specific form \n623\tof conditioning imposed by a given sport. \n624\tAll of the survival systems of the body undergo adaptive \n625\treconstruction in response to external stressors. However, it is not difficult to observe that those systems which \n626\tare of major importance for success in sport undergo an accelerated rate of functional growth.\n627\t350\n628\t\n629\t=========== PDF 362 ===========\n630\tSUPERTRAINING\n631\tIt has been noted already that the specifics of adaptation are determined primarily by two factors, namely the \n632\twork regime in sports, and the gradual, but steady increase in complexity of the body's external interactions \n633\tassociated with the growth of sporting proficiency.\n634\tFor example, improvement of the triple jump requires developing the ability of the motor apparatus to \n635\tproduce great power. Increase in jumping distance, which is accomplished primarily by increasing running \n636\tspeed, is associated with a significant increase in complexity of the interaction of the feet with the support at each \n637\ttake-off, a situation that requires significant improvement in reactive ability.\n638\tCyclic locomotion, to a great extent, necessitates increasing the power and the capacity of the body's systems \n639\twhich are crucial for energy production of muscular work. Energy expenditure increases greatly with increase in \n640\tmovement speed. For example, oxygen requirements increase considerably with running speed, energy \n641\texpenditure being almost proportional to the fourth power of running speed (Sargent, 1926). This rising cost of \n642\trunning speed is associated with a greater reliance being placed on anaerobic processes for generating the \n643\tnecessary energy of work (Henry, 1951; Margaria, 1963).\n644\tAs discussed previously (see 2.2.3, 5.4.3). two forms of functional perfecting of the body may be \n645\tdistinguished in the training process, namely, specialisation by physiological system and specialisation by motor \n646\tability (Verkhoshansky, 1971). The most obvious evidence of specialisation appears when comparing the \n647\tfunctional development of the body in different sports. \n648\tIf we refer to the classification scheme of 6.5, \n649\tspecialisation by physiological system means that acyclic sports rely predominantly on anaerobic processes and \n650\tfunctional hypertrophy of the motor apparatus, whereas cyclic sports place major reliance on aerobic processes. \n651\tIn complex (combined) sports, there is an intense functional development of both the motor apparatus and the \n652\tenergy production systems. \n653\tSpecialisation by motor ability refers to the exact programme of neuromuscular \n654\tcontrol that is developed by repetitive execution of the motor skills required in a given sport (see 2.2.3).\n655\tHowever, it is important to emphasize that specialisation in the first two cases does not imply that \n656\tdevelopment is either strictly aerobic or anaerobic, but rather that there is a particular primary emphasis of \n657\tfunctional specialisation. One can successfully develop a high level of explosive strength in acyclic locomotion \n658\tonly when one possesses sufficiently high aerobic efficiency. At the same time, improving the efficiency of the \n659\tenergy producing systems in cyclic locomotion should be based on highly developed muscular strength and local \n660\tmuscular endurance.\n661\tThe kinesiological patterns of motor activity in various types of sports are approximately equivalent, \n662\talthough there are some qualitative and quantitative differences associated with specific types of sports. Thus, \n663\tsprint swimmers have higher rates and developmental levels of anaerobic productivity than distance swimmers, \n664\twhereas aerobic productivity is superior for distance swimmers. This is determined by the emphasis of the \n665\ttraining.\n666\tIn the multi-year training of sprinters, up to Class I-CMS (Class I - Candidate for Master of Sport), the chief \n667\temphasis is on developing general (aerobic) endurance and speed, whereas at MS-MSIC (Master of Sport - \n668\tMaster of Sport, International Class) level the emphasis is on developing speed (anaerobic) endurance. In the \n669\ttraining of distance athletes of all qualification levels, the chief emphasis is on developing aerobic productivity, \n670\twhile at the MS-MSIC level, the emphasis is on enhancing anaerobic productivity (Vankov, 1978).\n671\tIn cyclic sports, strength preparedness, mainly in the form of strcngth-endurancc, plays an important role. \n672\tResearch shows that, with a relatively moderate increase in muscular strength, together with a rise in the athlete's \n673\tqualification, the qualities of dynamic strength-endurance and power accelerate the increase in functional strength \n674\t(Zhurbinoi, 1978).\n675\tThe process of functional specialisation is characterised by the fact that there is a definite sequence (known \n676\tas hcterochronicity, as detailed in 2.2.3) in the development of adaptation. This means that the body adapts to \n677\texternal influences only when they bccome necessary for the further growth of sporting proficiency, and this \n678\tinvolves only those systems whose functions satisfy all the necessary requirements for enhancing sport specific \n679\tfitness.\n680\tThe multi-year functional specialisation of the body is closely connected with its corresponding physical \n681\tadaptation. This adaptation leaves traces of the training influences on the body for long periods and serves as the \n682\tfoundation for its functional perfecting. These traces have been studied extensively in general terms at the level of \n683\tmuscle tissue, cardiac muscle, skeletal structure, cardiovascular mechanisms and other systems. Further study of \n684\tthe multi-year characteristics of structural-functional specialisation in particular types of sport is important in \n685\tformulating the principles of programming training.\n686\t351\n687\t\n688\t=========== PDF 305 ===========\n689\tSUPERTRAINING\n690\tUnidirectional emphasis on qualities such as strength or endurance may be used not only in individual worko \n691\tbut also during each microcycle (Kudelin, 1980; Budokho et al, 1978; Mironenko, 1980). Research has sho \n692\tthat unidirectional training over periods as long as 4-12 weeks can be very effective, especially if the intensity is \n693\tgradually increased for each form of loading in the given cycle. Moreover, the effectiveness of the conjugate \n694\tsequence system with advanced athletes is such that the training volume over a macrocycle can be reduced by as \n695\tmuch as 20%, a phenomenon referred to as the acceleration o f specific adaptation (see 5.4.2).\n696\tHowever, it must be noted that unidirectional loading is effective only if one uses a diverse complcx of means \n697\twith a single primary emphasis, together with a variety of training methods (Fedorova et al, 1975; Platonov &. \n698\tMonograov, 1977; Verkhoshansky, 1977). Furthermore, an important condition for implementing concentrated \n699\tloading is the relatively low intensity of the means, sincc the frequent use of these means already intensifies the \n700\ttraining. In this context, the loading may be considered concentrated if its volume in the month in which it is \n701\tapplied constitutes 23-25% of the general volume for the year.\n702\tThe system is not without its dangers, since concentrated loading is very stressful and, besides increasing the \n703\tpotential for overtraining, it can decrease motor qualities such as speed-strength. After a phase of emphasis on \n704\theavy strength training, there may be an increase in muscle stiffness and a loss of explosive strength, sporting skill \n705\tor speed. Since the conjugate sequence system is based on exploitation of the delayed training effect, a diminished \n706\tloading and restorative period has to be observed after a given concentrated loading phase to allow the body to \n707\tsupercompensate to the desired level o f preparedness. The gains elicited, for instance, by 4-8 week concentrated \n708\tblocks of strength, speed-strength or speed training, may occur most commonly after a latency period of 1-3 \n709\tweeks, so it is essential for the athlete not to lose patience and hasten into the next concentrated phase without \n710\tadequate restoration. Not only does premature imposition of concentrated loading suppress the delayed training \n711\teffect of the previous stage, but it also lowers the effectiveness of future training.\n712\t5.4 The Principal Aims of Special S trength Training\n713\tDuring the initial stages of training the body reacts to any stimulus with all of its survival mcchanisms and motor \n714\tabilities. As a result of this general adaptation response, the specific training effects which enhance working \n715\tpotential are not produced. Characteristically, there is a relatively high correlation between the various motor \n716\tabilities and the development of even those abilities which are not directly implicated. The transfer of fitness is \n717\tvery distinct here.\n718\tAs sporting proficiency grows, so the adaptation response becomes more selective. Functional adaptation is \n719\tconfined primarily to those systems which are the most active and develops in those directions which art \n720\tdetermined by the specific components of the training stimulus. The close connection between separate motor \n721\tabilities tends to diminish during the stage of high sports proficiency, the rate of development o f motor abilities \n722\twhich are not the direct object of training slows down, and the transfer phenomenon is not displayed as sharply \n723\tas before. Thus, the direction of progress is determined entirely by the specific components of the training \n724\tstimulus. Since sport achievements at the high levels of sports proficiency are produced by a complex of specific \n725\tmotor abilities, the regime of the means used should contain an optimal combination of specific training means.\n726\tIt is now appropriate to formulate a set of general principles for organising special strength training, based on \n727\tthe specific characteristics of physical training and the long-term dynamics of the STS (Sports Training Process). \n728\tIn general, they express the chief ways o f exploiting these characteristics and form the foundation of a new \n729\tsystem of sport training, although they do not exclude all of the traditional principles and rules. These principles \n730\tare:\n731\t• Converging the partial effects of strength training means\n732\t• Accelerating specific adaptation\n733\t• Specific correspondence of the training effect\n734\t• Maintaining the strength training effect.\n735\t5.4.1 Converging the Partial E ffects of Strength Training Means\n736\tThe principle of converging the partial effects o f strength training means is fundamental to the long-term \n737\torganisation of strength training. It is achieved by the convergence of all the different partial training effects, i.e. \n738\tthe gradual convergence of their cumulative training effect to those important specific characteristics which are \n739\tessential to the functioning of the body in a particular sport.\n740\t294\n741\t\n742\t=========== PDF 381 ===========\n743\tSUPERTRAINING\n744\tachieve several simultaneous training objectives with means of different primary influence (Handelsman & \n745\tStetsenko, 1980).\n746\tIt has also been shown that individual workouts devoted solely to perfecting sport technique are appropriate. \n747\tEven when a wide variety of means and regimes of work and rest are used, these types of training session arc \n748\tvery effective in improving technical skill (Struchkov, 1980; Mironenko, 1981; Petrovsky, 1977). It has been \n749\tshown that training sessions with the primary emphasis on developing a single motor ability (under conditions of \n750\ta wide variety of means and methods) exert a more profound effect on special preparedness compared with \n751\ttraining sessions where several objectives are pursued concurrently (Urzhensnevsky, 1969; Gorkin et al, 1973; \n752\tMonogradov & Platonov, 1975; Fedorova et al, 1975; Chepelyev, 1980).\n753\tIn addition to its value during separate workouts, unidirectional loading is also appropriate during \n754\tmicrocycies (Kudelin, 1980; Mikhailova & Sokolova, 1980; Budokho et al, 1978; Mironenko, 1981). For \n755\texample, it has been established that microcycies of a single primary emphasis (in particular, to increase speed or \n756\tvarious types of endurance) powerfully stimulate the trainability of swimmers (Kudelin, 1980). Similarly, it has \n757\tbeen shown that microcycies of a primarily strength emphasis significantly raise the special physical \n758\tpreparedness of track-and-field jumpers (Mironenko, 1981).\n759\tHowever, research shows that unidirectional loading is effective only if it forms part of a complex of several \n760\tmeans of a single primary emphasis involving a variety of methods (Fedorova et al, 1975; Platonov & \n761\tMonogradov, 1977; Vcrkhoshansky, 1977).\n762\tConsiderable work has revealed that the primary use of unidirectional training for prolonged stages (4-12 \n763\tweeks) of training can be very effective. Use of a variety of means, especially when applied with a gradual \n764\tincrease in intensity, has been shown to be particularly appropriate for enhancing sporting technique, speed- \n765\tstrength, and the capacity and power of the ATP-CP and glycolytic-anaerobic energy processes (Mironenko. \n766\t1981; Antonova, 1980; Deniskin, 1976; Levchenko, 1981; Kornelyuk, 1980).\n767\tConcentrated Loading\n768\tThus, the method of concentrated training loads was devised for preparing highly qualified athletes, with the \n769\tloading being concentrated during specific stages of preparation (Verkhoshansky, 1977). The main novelty of \n770\tthis method consists of exerting a concentrated training influence on the body with a high volume of \n771\tunidirectional loading for a limited period (of up to 2 months). This concentrated influence produces a brief, \n772\tfairly stable state of incomplete restoration which is associated with the persistent and relatively prolonged distur­\n773\tbance of homeostasis. \n774\tThis triggers extensive functional changes which are prerequisites for subsequent \n775\tsupercompensation and the raising of the body to a higher level of special preparedness. An important condition \n776\tfor the using concentrated loading is the relatively low intensity of the means, since the frequent use of these \n777\tmeans already intensifies the training. The loading may be defined as concentrated if its volume in the month in \n778\twhich it is concentrated is 23-25% of the general annual volume.\n779\tIt is appropriate to use concentrated loading primarily for increasing the effectiveness o f SPP, and for this \n780\tpurpose one can use loading of any primary emphasis. However, the concentration of specialised strength loading \n781\tis of particular significance, not only for raising the athlete's physical fitness, but also for regulating the entire \n782\tcomplex of loading over the annual cycle in all sports.\n783\tConcentrated strength loading constitutes a relatively independent part or block of training to create a \n784\tfunctional foundation for the subsequent enhancement of technical skill or those motor abilities which chiefly \n785\tdetermine success in a given sport. Hence:\n786\t• The composition of means and their organisation in strength blocks, as well as their logical connection with\n787\tother loading, should be determined by taking into account the training specifics of that type of sport.\n788\t• The strength block should have a specific place in the annual cycle, and consequently, have a beneficial\n789\teffect on the sequence of loading and the organisation of loading of other primary emphasis over time.\n790\tHere the concept of a block has a definite meaning, arising from the programming of technique. To achieve the \n791\tprincipal aims of organising loading in the annual cycle, the coach must select a certain strength block or \n792\tsubstitute one block for another, depending on the situation and the individual. Obviously, in order to do this, he \n793\tneeds to prepare a detailed selection of appropriate strength blocks in advance.\n794\t370\n795\t"}]},"uuid":"6393a2a1-962c-4b25-a691-1a8975d55565","timestamp":"2026-10-03T18:27:16.229Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/r6b_src.txt","content":"\n=========== PDF 347 ===========\nSUPERTRAINING\nfort those who may be interested in investigating this field more thoroughly (e.g., Klein ct al, 1991; Moore-Edeet \nal, 1992; Nagai, 1992; Chadwick & Ackrill, 1996; Redfem & Lcmmer, 1997).\n6.4 Training as a Problem in M anagement\nProgramming and organisation of training require in-depth and comprehensive knowledge of the principles of \ntraining. It is appropriate, therefore, to examine programming as a problem in management.\nThe essence of management may be expressed in terms of the changcs of state of the relevant systems \nproduced by given tasks, while the criterion of effectiveness lies in its functioning or development. Consequently, \nfor practical implementation of management, it is necessary firstly to establish concepts about the structure of the \nmanaged system and the characteristics of raising it from one state to another.\nLet us examine a logical scheme of training organisation for describing the components of management in \nsports training (Fig 6.12). Training is organised in accordance with specific tasks which result in a definite \nimprovement in sports results, so that the degree of improvement in sporting performance is the criterion of the \neffectiveness of training. Sports results arc the observable product of the organisation of the athlete's external \ninteractions. In other words, this is the result of the organisation of the athlete's movements which make effective \nuse of strength and motor potential for executing specific motor tasks.\nThe patterning of the external influences and an increase in the relative contribution of those forces which \ndirectly contribute to the execution of the motor tasks are important conditions for improving sporting \nproficiency. Therefore, one has to identify the major components of management in sports training, as follows:\n1. The complex of the athlete's external influences encountered in competition. The greater the athlete's motor \npotential, the more effectively the complex of external interactions can be organised. Therefore, in multi-year \ntraining, athletes train to increase their motor potential and specific work-capacity.\n2. In this regard, the athlete's fitness state, as a characteristic of motor potential, should be classified as the \nsecond component of management in the system of sports training. In this context, fitness state refers to the \nathlete's structural-functional qualities which determine the athlete's potential to produce sporting prowess \n(Zatsiorsky, 1979). \nThe complcx of external interactions and the athlete's fitness state are established \neffectively as a result of the systematic specialisation of the motor activities. The latter provides a number of \nspecific training influences organised to produce the required changes in the complex comprising the external \ninfluences and the athlete's fitness state.\n3. Consequently, specialised motor activities, i.e. the training load is the third component of management in the \nsystem of sport training (see 6.12).\nThus, the preceding components together represent an hierarchically organised complex which undergoes goal- \ndirected changes during sports training. In training, the ordered influences address all three components of the \nmanagement process simultaneously. However, the basis for changes of fitness state during training lies in a \nspecific, cyclic sequence of events. The dosage of the training load is prescribed to promote changes in the \nathlete’s fitness state which, in turn, entails changcs in the complcx of external interactions of the athlete and a \ncorresponding improvement in sporting results.\nWhen the planned results are achieved, the programme and the organisation of the loading are determined \nfor the next stage of training, and the sequence of the preceding conditions is repeated at higher levels. The \ncyclicity of this process in accordance with sport specific periodisation determines the contents of the athlete's \ntraining programme.\nCompletion of the tasks, executed as separate components of the complex system of management process, \ngives rise to an intricate dynamic complex of cause-effect relations between them, which may be considered as \nthe structure of the managed system. Thus, the aggregate of the components of this complcx system, with its \ncharacteristic cause-cffcct connections, represents the overall managed system.\nThus, management involves all the tasks of training, motivation, the athlete's personality and social factors \nwhich express and integrate the interests of the athlete, coach and team, as well as the practical experience and \ntheory of training construction. In orienting the course of training in a specific direction, model characteristics are \nquantitatively assigned which relate to the training load, the athlete’s fitness state and his external interactions \n(see Fig 6.12).\n336\n\n=========== PDF 348 ===========\nSUPERTRAINING\nFigure 6.12 A logical scheme for organising sports training (Siff & Vcrkhoshansky, 1999).\nThe main idea of managing training consists of raising the fitness state of the body to a higher functional level. \nControl of this process is accomplished by assessing the effect at primarily two levels of management, namely at \nthe level of the athlete's fitness state (control of the effect of the loading on fitness) and at the level of external \ninteractions of the athlete (control of the change in their characteristics as a result of changes in fitness). Based on \na comparison of different effects achieved at the levels indicated by the given model characteristics* suitable \nsolutions are implemented in order to manage the later course of training. \nAnalysis of the contents and \norganisation of training may now be summarised as follows:\n1. Firstly, the interaction between the components of the managed system is determined by the training \npotential and the training effect of the loading (Fig 6.12). Here, the training potential o f the loading is \nunderstood to mean its potential for promoting adaptation of the body and corresponding changes in its \nfitness state and, consequently, in its external interactions. The training potential of the loading is a relative \nconcept which should be examined and assessed in accordance with the athlete's current fitness state. \nAssessment o f the training effect of the loading means measuring the performance change that the loading \nproduces in each case under competitive and laboratory conditions.\nThe training effect is achieved with relatively stable adaptation within the body, by use of any logical \ntraining programme. The basis for the training effect is the accumulation of adaptive traces within the body \nproduced by the entire complex of training influences. The substantive meaning of training, encompassing \nthe concepts of training potential and training effect of the loading has central significance for programming \ntraining and will be examined later in more detail.\n2. The connection between the beginning and end points of training management is highly complex. The \nextent of this connection is determined primarily by the effectiveness of the operations of two \ninterdependent subsystems of regulation (see Fig 6.12): {Training Load - Training Potential o f Loading - \nAthlete's Fitness State} (subsystem A) and {Training Effect o f Loading - Athlete's Fitness State • Athlete's \nExternal Interactions} (subsystem B). Assessment of the predictive reliability and the probability of success \nof regulation at the level of each subsystem shows one can be certain that the lower the measures for the first \none (A), the weaker the link in the entire management system.\n3. The necessity for effective management arises when there is a problem in selecting a training regime. In such \nsituations success depends on the degree of accuracy in choosing the optimal from the multitude of possible \nsolutions.\n337\n\n=========== PDF 349 ===========\nSUPERTRAINING\n6.5 Prerequisites for Organising Training\nA successful solution to the problem of programming and organising training cannot be obtained only by \nassembling the results of individual fragments of research. Intensive research is required to formulate usable \nconcepts concerning the training process and identifying those conditions which determine its efficieni \ndevelopment. A preliminary examination of this problem already enables one to determine the goal of the task, \nthe fundamental direction of research, and the specific information required (Fig 6.13).\nThe scheme need not be described in much detail, because its meaning and contents are sufficiently clear and \ntheir analysis is a matter for later discussion. Formulating a generalised theory of training requires a complcx \napproach to the organisation of research, without repeating those experimental errors which were proliferated \nduring the preceding few decades.\nFigure 6.13 A general theory of structuring sports training (Siff & Verkhoshansky, 1999).\nIn sport physiology especially, a divergence of the professional interests of specialists leads to the human body \nbeing regarded as two fairly distinct systems. Some specialists limit their study primarily to the neuromuscular \nsystem and its regulation by the CNS, applying their work largely to specd-strength and complex-technical types \nof sport. Others focus their interest on the cardiovascular-respiratory systems and metabolic processes which \ndetermine success in primarily cyclic types of sport.\nSuch specialisation is quite convenient for science, but is effective and applicable only on the basis of close \nintegration between theory and practice. All too often, studies are based on the effect of a single factor on \nperformance; very rarely does research focus on the interactive effects of concurrent or sequential complexes of \ntraining methods.\n338\n\n=========== PDF 350 ===========\nSUPERTRAINING\nIn particular, understanding of the scientific and practical fundamentals of the development of general \nendurance suffers. Attention is centred on the mechanism of energy production, which ignores the specialisation \nof the muscular apparatus as the direct executor of work, and general endurance is considered exclusively to be a \n(unction of respiratory potential. Therefore, physiologists were perplexed when information was revealed about \nthe decrease in V02max during the competition period and the unexpectedly low V02max levels among many \nathletes in cyclic sports. However, this should not have been unexpected if they had concurrently examined the \ncontractile and metabolic characteristics of the muscles of athletes who specialise in general endurance sports.\nSport training theory also abounds with misdirected efforts. Here there is a similar division in the interests of \nspecialists who give preference primarily to speed-strength or cyclic sports and tend to minimise the role of \ngeneral endurance training. This professional specialisation cannot be condemned if they limit their theoretical \nand practical generalisations to 'their' types of sport. It is when they attempt to apply the same principles and \nmethods to other types of sport that this single-minded approach becomes misleading.\nA definite weakness in modem sports training theory is the result of underestimating the importance of \ninformation obtained from physiological and biochemical research in sport, as well as from the limited amount of \ndefinitive scientific information which forms the basis for establishing training principles. \nUntil recently, \ngeneralised practical experience was usually regarded as the only valid way of establishing effective training \nprinciples and methods, thereby neglecting the important contributions of scientific research. At the same time, \nscientists disdained this attitude and coaches regarded scientists as impractical theoreticians, with the result that \ntheir individual bodies of information were not shared and training methodology suffered. The advancement of \nsport now depends strongly on close cooperation between scientists, coaches and athletes.\n6.6 Basic M anagem ent Theory\nIn most interactions in the work, social or recreational setting, leaders or managers emerge or are appointed to \ncontrol, coordinate and guide their fellow humans to carry out certain tasks or achieve specific goals or fulfill a \nprescribed purpose.\nThe terms leadership and management are often used interchangeably, but there are distinct differences \nbetween the two, depending on the situation. Small, ephemeral groups may have leaders or elected chairpersons, \nbut usually not managers. The chairman of the board of a company does not play the managerial role of the \nexecutive director, who in turn does not function like the sales manager, who also may act as the highly motivating \nleader of a sales team. Sports teams have captains, who are special types of leader, but they also have managers \nwho have no leadership function whatsoever on the field of play. Similarly, captains usually have no prescribed \nleadership role off the field. Military officers often have to fill roles of leadership and management. What is \ncommon to both leadership and management is the task of marshalling together the abilities and efforts of groups of \nindividuals to reach specific goals, whether social, economic, military, sporting or otherwise. What is also common \nto both is that communication is essential to the entire process.\nTellier states that management roles are determined by position in an organisation and are characterised by \nthree basic elements: responsibility, authority and accountability. Leadership, on the other hand, implies power to \ninfluence others, which relies on factors such as expertise, personality and charisma.\nManagement and leadership both require an understanding of human behaviour in terms of needs, wants and \ndrives, hence the next section introduces you to theories of human behaviour and motivation.\n6.6.1 Human Needs and Motivation\nAlthough many models have been formulated to explain human needs, only a few have been selected here to enable \nyou to appreciate the strengths and weaknesses of each and be able to select a suitable model for a given situation \n(Siff, 1990). The motivation process involved in human drive may be summarized in the following way (Fig 6.14):\n339\n\n=========== PDF 351 ===========\nSUPERTRAINING\nAt this point it is relevant to discuss the relationship between performance and motivation or. arousal. Higher levdr \nof arousal do not necessarily lead to increased performance, on the contrary, excessive arousal may lead to a drop a \nperformance, lowered productivity and an increase in the incidencc of mistakes and accidents. There appears to be \nan optimum level of arousal for any person performing a specific task at a specific time, as was revealed by the \nwork of Yerkes and Dodson (see Fig 6.15).\nThe exact shape of the curve depends on individual characteristics such as level of introversion/extroversion, \nlevel of exhaustion, standard of health, and task complexity. There is no easy formula to determine the \ncharacteristic curve for any individual; instead it depends on the effort of a manager, leader or coach to become \nadequately informed of the personal attributes, performance and characteristics of each worker or athlete. What is \nrelevant is that the manager or coach appreciates that all motivational techniques are not universally applicable to \neveryone. Instead, they are to be applied with a thorough understanding of the individual and the situation.\nCaution must be exercised when applying the Yerkes-Dodson (Y-D) model, since it implies that there is just \none discrete peak for a specific optimal level of arousal or stress. The existence of the 'second wind' phenomenon \n(curve B) and the effect of task complexity on curve shape are two of several reasons why the original curve must \nbe applied to restoration and stress management with circumspection.\nIt also implies that very low and very high levels of arousal invariably lead to diminished performance. While \nthis may be generally true, it is well known that both sensory underload and overload may lead to phases of \nenhanced performance (curves A, C). The consequences of low arousal levels is not necessarily sleep or coma. On \nthe contrary, meditation and similar altered states of consciousness may enhance performance in certain situations \n(curve A).\nMoreover, sleep, reverie, day-dreaming and relaxed visualisation should not be viewed always as unproductive \nand disconnected, since research and experience reveal that problem-solving, creativity and physiological repair \nmay occur strongly in these altered, though perfectly normal, states. The occurrence of nightmares and vigorous \nmuscular activity also suggests that high stress levels may persist even in sleep.\nNotions of optimising one's stress level thus may be seen to be based on a limited mechanistic model of human \nbehaviour. Altered states of consciousness are a normal part of life and are not adequately described by the Y-D or \nSelye curves. In fact, the most efficient use and channeling of 'stress energy' may be mediated during periodic \naltered states which the Y-D model describes as inadequately stressful to produce meaningful performance (cunt \nA). Therefore, both optimisation and transcendental stress management strategies are necessary if effective use is to \nbe made of stress.\nFurthermore, regular exposure to a stressor may produce either habituation or oversensitisation, so that the \nsame level of stress may not produce the same response at a later stage. In either event, timely use of restoration \nmeasures is of central importance.\nPersonality can have a significant effect on the shape of the Y-D curve. For instance, the introvert appears to \nhave a lower optimal arousal zone, unlike the extrovert who requires greater stimulation and can cope better with \nhigh levels of stress. This difference in the effect of high levels of training and competitive stress has important \nimplications for the prescription of restorative procedures, with the introvert probably requiring early restoration \nand the extrovert requiring careful monitoring to prevent overtraining caused by a desire for greater stimulation.\nTask structure also modifies the shape of the Y-D curve. Complex tasks require low levels of arousal to reach \noptimal performance over very limited periods (e.g. in golf, gymnastics and pole vaulting), whereas simple sports \ntasks may be executed over a longer period at higher levels of arousal. \nExcessive exposure of an athlete to\n340\n\n=========== PDF 352 ===========\nSUPERTRAINING\nOther Theories of Needs\nAldcrfer identified the following categories of needs:\n• Existence needs, which concern our physiological and material desires, such as those for hunger and shelter\n• Relatedness needs, which concern relationships between people\n• Growth needs, which concern personal development, change, evolution and creativity.\nMcClelland, like the neurophysiologist, James Olds, however, maintained that there arc only two human needs ~ \nthe need for pleasure and the need to avoid pain. All other needs or motives are learned. On this basis, McClelland \nthen categorized these acquired needs as follows:\n• Achievement. There is a strong need among some people to excel. They have a high achievement need and \nwant to do a task well for its own sake, rather than for its material rewards.\n• Power. This refers to the desire to influence, regulate and control the actions and behaviour of other people.\n• Affiliation This refers to the need for positive relationships with other people and probably is described best \nby the word 'friendship’. A major aspect of the affiliation need is the need for communication.\nAlderfer’s model differs significantly from Maslow's in that it recognizes that satisfied needs may still continue to \nbe influential, particularly if they can substitute for an unsatisfied need. Research by Alderfer also reveals that \nhigher order (growth) needs can arise or exist simultaneously with the lower order needs. It also emerges that \ncertain needs become even more intensified if they are more satisfied than others. It is obvious then that Maslow's \nhierarchy, like all theory, has to be applied with circumspection.\n341\ncomplex training tasks can lead rapidly to ‘overstrcss*, while simple tasks may be insufficiently challenging to \nproduce continued supercompensation. A balance between complexity, simplicity, intensity and volume of load is \nnecessary to ensure growth and to minimise overtraining.\nMaslow's Hierarchy of Needs\nOne of the best known, though simplistic, models of human needs is that of psychologist, Abraham Maslow. He \ndevised an hierarchy of needs ranging from the most basic, which have to be satisfied first before subsequent \nneeds will begin to exert a significant influence on a person. This hierarchy may be arranged in the form of a \ntriangle with the most basic physiological, concrete needs at its base and the highest level, abstract need for \nself-actualization (the need to achieve one's highest potential in a specific situation) at its apex. It may also be \narranged to explain the needs of the individual in both a private or a professional capacity (see Fig 6.16).\nOccasionally, this model may include a state beyond self-actualisation, called transcendence which is \nassociated with states of profoundly altered consciousness such as religious reverie or trance meditation. \nHowever, this state is not simply the preserve of the ascetic or mystic, because many athletes have reported \nachieving world class performances in similar altered states (Murphy & White, 1978)\n\n=========== PDF 353 ===========\nSUPERTRAINING\nAll the above theories overlap in some respects or have strong similarities. They are usefully augmented or \nreplaced in the analysis of management interactions by Vroom's Expectancy Theory o f Motivation, which can b: \nparticularly valuable to apply in the workplace or advertising realm. This theory posits that it is not merely i \nspecific goal, but the individual perception of that goal which motivates people. Vroom stated that Motivate \nForce depends on two factors (Tellier, 1978):\n• the perceived attractiveness (valence V) of the goal or outcome\n• the perceived probability o f achieving that goal or outcome (one's personal belief, B, that success is likely)\nHe then combined these two factors so that the Motivational Force F depends on their arithmetic product F = V X\nB. \nIn other words, if a goal is highly attractive and you believe strongly that it is within your reach, tht \nMotivational Force driving you will be very strong. However, if a goal is extremely attractive, but you believe it to \nbe far outside your reach, you will experience a small Motivational Force and put in minimal effort to attain that \ngoal. Under such circumstances, it is desirable to break down a large or distant goal into smaller goals to be \nachieved over a period or at a rate which you perceive to be more matched to your capabilities or experience.\nVroom's detailed theory involves allocating numerical values to the contributing factors. Perceived \nattractiveness is rated from -5 (extremely undesirable) to +5 (extremely desirable), while belief in success is rated \non a scale from 0 (total disbelief) to 1 (total belief)- The overall Motivational Force is the sum of the motivational \nforces calculated from the products of perceived attractiveness and perceived belief for all the important goals or \noutcomes associated with carrying out the task.\nDetailed examples of this theory are outside the scope of this book, so it is sufficient to note that a manager or \nleader can motivate athletes strongly if he appreciates that motivation depends on perceptions of goal attractiveness \nand attainability. He can improve performance either by modifying the task accordingly or by altering the athlete’s \nperceptions of the task and its outcomes.\n6.6.2 Management Models\nManagement implies the existence of authority. Oncken identifies four types of authority: authority of position or \npower, authority of personality, authority of competence, and authority of integrity.\nThe Traditional Model\nTradition decreed that workers were of secondary importance to productivity, that they were possessions, slaves or \nhired slaves. This linear approach to management may be summarized in the form of the following diagram (Fig \n6.17). All too often this model continues to be applied by managers, leaders and coaches steeped in the traditional\nways.\nE xpectancy Theory of M otivation\nFigure 6.17 The linear, single continuum model of traditional management\nThe Managerial Grid\nExperience and subsequent research have revealed that productivity is enhanced if an appropriate balance is \nestablished between concern for people and production. This led Blake and Mouton to devise the Ohio State \nUniversity model, which emphasizes the relationship between productivity and people concern (Fig 6.18).\nAll management styles may be identified by selecting suitable coordinates from the grid. For instance, the \nautocrat would have a rating of (9,1), whereas the laissez faire leader would have a rating of (1,9). Coordinates \n(1,1) characterize impoverished leadership, while (9,9) refers to ideal management. The middle-of-the-road \nmanager is located at (5,5).\n342\n\n=========== PDF 354 ===========\nSUPERTRAINING\nFigure 6.18 The Blake-Mouton managerial grid\nSituational Leadership\nHcrscy and Blanchard stated that leadership style ought to be implemented according to each situation which arises. \nTheir model illustrates how leadership style may be adapted to a given situation according to the ’maturity' \n(education, experience, responsibility, self-motivation, degree of self-actualization) of the worker or follower (Fig \n6.19).\nFigure 6.19 The Situational Leadership Model (Hersey and Blanchard)\nTo use this system, the coach in playing a role as leader rates the maturity of the follower as low, moderate or high \n(Ml, M2, M3 or M4), then reads off the appropriate leadership style (SI, S2, S3 or S4) in the relevant box above. \nRelationship behaviour includes the amount of time and effort put into interaction with followers. One spends more \ntime in Selling or Participatory situations than in Telling or Delegating situations, hence the shape of the curve.\nThe Leadership Continuum\nTannenbaum and Schmidt devised a leadership continuum extending between the extremes of Leader-ccntredness \nand Worker-centredness. It relates well to the leadership characteristics of Likert’s four management styles, as \nfollows (Fig 6.20).\n343\n\n=========== PDF 355 ===========\nSUPERTRAINING\nFigure 6.20 The Tanncnbaum-Schmidt leadership continuum and its relation to Likert's management style\nDecision Making and Problem Solving\nDecision-making is a vital part of all management situations, so it is essential that some of the formal theory of this \nprocess be covered. Often, managers or committees are called upon to handle problems in order of importance. The \nword 'Importance' is far too unspecific to be of any real value in every situation; it is relative to the individual \nperceptions of all concerned in the problem solving or decision-making process. It is preferable to rate every \nproblem in terms of:\n• Seriousness or size\n• Urgency\n• Growth potential or growth rate\nIn using such a system, one allocates H (high), M (medium) or L (low) to each of these factors relating to all the \nproblems to be considered in a particular situation. Problems identified by triple or double H’s are then handled \nbefore those with fewer or no H's, with triple L's rated problems receiving lowest priority. In attempting to solve \nany problem, it is useful to recognize the main six steps in problem-solving:\n1. Identification and definition of problem\n2. Generation of alternative solutions\n3. Evaluation of the alternative solutions\n4. Decision -making: selection of solution\n5. Implementation of decision\n6. Testing of solution.\nShould the final step verify the value of the chosen solution, the process will terminate. If not, one may return to \nsteps 1, 2 or 3 and repeat the process until a suitable solution emerges. Limitations involving factors such as time, \ninformation, expertise, money and materials may hinder or halt this process. Consequently, one might make \ninappropriate or ill-considered decisions. A better understanding of the nature of problem-solving and \ndecision-making then becomes advisable.\nMaier (1963) identified two fundamental factors in the decision-making process: the objective quality of the \ndecision, and the acceptance of that decision by those concerned, which involves their subjective feelings. \nDepending on one’s individual decision-making style, he will tend to focus separately on quality or acceptance, \nregardless of the problem situation. Roskin, therefore, developed a decision-making inventory to make one more \naware that personal decision-making style should be more flexible and guided by the situation concerned (Maier.\n344\n\n=========== PDF 356 ===========\nSUPERTRAINING\nI%3). In this system, you have to identify the problem type in terms of its relative quality and acceptance, than \ndecide on one of four decision-making styles (Fig 6.21). It is essential to remember that implementation of all \nstyles depends on the time available for managing the different phases of the problem.\nConcluding Remarks\nThis section was included to enable you to apply some of the vast field of management and leadership theory in the \nmajor communication situations you will encounter as a professional. It does not pretend to offer any completeness. \nNot only is thorough coverage of the topic outside the scope of this book, but management is a dynamic and rapidly \nexpanding discipline, with nuances and expertise being added regularly by innovative managers and scientists.\nFor instance, the close interaction of manager and worker, logic and emotion, science and intuition are being \nclosely examined. Researchers have produced the 7-S Framework to define the scope of management more clearly. \nIt stresses that management must take account of the following factors in any organization: structure, staff, systems, \nstrategy, skills, style and shared values (Peters & Waterman, 1983). It is up to interested readers to expand their \nknowledge by reading some of the standard management texts and professional journals.\n6.7 Classification of Sports\nEstablishing the principles and rules of programming training necessitates determining clearly the limits of \ngenerality and specificity in individual sports or groups of related sports. To do this it is necessary to classify \nsports scientifically to establish programming criteria.\nSport is associated first of all, with the spatio-temporal organisation of the athlete's movements, which is \ndetermined by the rules and conditions of competition and by the effective use of motor potential for executing \nthe required motor tasks. \nIn all cases, this requires perfecting the central nervous processes which control \nmovement, as well as raising the functional potential of the muscles and metabolic systems. Classification of \nsports into individual, team, ball or water sports, for example, is not scientifically useful; it is more appropriate to \nclassify sports on the basis of the particular organisation of the sporting movements and characteristics of the \nphysical systems used to produce their working effect.\nThe more prolonged and the lower the intensity of muscular work, the greater the role of aerobic processes \nand the greater the functional specialisation of the muscles to utilise oxygen more fully. \nThe role o f the \nglycolytic mechanisms of energy production grows as the duration of work decreases and the power of muscular \nwork increases. The muscles adapt to working conditions of an inadequate supply of oxygen and the rapid \nremoval of lactate during the exercise.\nThe loading of the motor apparatus and the power of explosive effort increase significantly during brief \nacyclic work. Under conditions of heavy dynamic overload, athletes must overcome significant external \nresistance which they must accomplish in a very short time (tenths and even hundredths of a second). This \ncomplicates movement coordination significantly and requires the development of an effective and reliable \nbiodynamic structure (see 2.1.3). Under these conditions, the neuromuscular apparatus improves intramuscular \nregulation and increases the power of anaerobic energy production. This preamble shows that sports may be \ndivided into two broad groups, namely acyclic and cyclic sports:\n345\n\n=========== PDF 357 ===========\nSUPERTRAINING\n• Acyclic sports characterised by the complex organisation of motor actions and an intense concentration of \nworking effort, displayed briefly under competition conditions. Such sports have an inherently stable \nbiodynamic movement structure and defmite structural-functional specialisation of the neuromuscular \napparatus which recruits its abilities to display powerful explosive effort and anaerobic power; primarily \nthrough ATP-CP energy processes.\n• Cyclic sports characterised by prolonged repetition of stereotyped work cycles of relatively simple \norganisation which do not require maximal muscular tension. The energy acquired for such work comes \nprimarily from stored glycogen or free fatty acids metabolised in the presence of oxygen during the exercise. \nOne of the most important conditions for improving performance in this group of sports is the structural and \nfunctional specialisation of the muscles to improve their ability to oxidise metabolites, as well as to increase \nthe capacity of the metabolic processes and the economy of using the energy substrates during exercise.\nOne should further subdivide the sports in each of these broad groups in terms of specific characteristics of \nmovement organisation and energy production. Thus, the acyclic group embraces sports that require powerful, \nbrief, explosive efforts and others which involve fine motor control and spatially precise movement. In the \ncyclical group there are some sports where the work is executed under conditions of extensive oxygen utilisation \nand others where the muscles have an inadequate oxygen supply.\nFinally, one should identify a third group of sports, characterised by varying competition demands and the \nneed to maintain a high work output under conditions of fatigue. These types of sports combine characteristics of \nthe preceding two groups. They involve constant changes in intensity of the competition activities, as well as \nbursts of high power movements with periodic rest pauses, so that energy production is of a mixed aerobic- \nanaerobic character, with the greater part being derived from glycolytic reactions. Thus we may classify sports \ninto three groups, as already outlined by Farfel (1969):\n• Acyclic sports, in which perfecting of the neuromuscular system for precise regulation of movements and the \nability to produce great power play the dominant roles\n• Cyclic sports (usually of submaximal and of moderate power), associated primarily with the production of \nmuscular work through aerobic processes\n• Complex (combined) sports, where characteristically there is a high variability of motor actions under \nconditions of advancing fatigue and varying intensity of work, typified by team sports and one-on-one events \n(e.g. boxing and fencing).\nIn classifying sports, it is necessary to consider competitive, as well as training activities. This is important, \nbecause in some cases the training exercises are very different from competitive actions, often due to the \nnecessity for repeated reproduction of the competitive movements in training. In practice, we refer to special \nendurance (e.g. speed-jumping-, and strength-endurance) in such cases. For example, the shortest sprint distance \nin track-and-field (100 metres) is covered in approximately 10 seconds. The effort expended to achieve this does \nnot depend on oxidative efficiency. However, in order for a sprinter to prepare himself to effectively display such \neffort, he should execute training loads that develop his aerobic and anaerobic potential, in particular the latter. \nThe general principles of programming training for each of the above groups of sport will be examined later.\n6.8 C haracteristics of the Training Process\nFormulation of theories and practical methods of programming training, as stated before, is possible only through \nunderstanding the training process. Therefore, it is relevant to return to the scheme presented in Figure 6.8 to \nexamine the characteristics of the long-term adaptation to intense muscular work. We will then examine the \ncharacteristics of the structural and functional specialisation of the body as a specific external expression of long­\nterm adaptation to intense muscular work. Finally, we will investigate some of the characteristics of developing \ntechnical proficiency in different sports to understand how the athlete masters the skill to use motor potential \nefficiently in competition.\n6.8.1 Adaptation to Intense Muscular Work\nExtensive experimental data has been collected concerning the restorative processes and the body's reaction after \nbrief training stimuli in sport (the immediate training effect). It has been shown that the after-effect of large \nloading docs not simply restore the expended energy but leads to super-restoration which exceeds the initial level\n346\n\n=========== PDF 358 ===========\nSUPERTRAINING\n(see 1.14). This phenomenon (Weigert’s law of supercompensation) was first formally described by Folbrot \n(1941, 1952, 1958), while its relation to exhaustion-restoration processes under different types of loading has \nbeen studied by several other specialists (Yakovlev, 1955, 1975; Gorkin et al, 1973; Volkov, 1975; Monogarov \n& Platonov, 1975; Sergeyev, 1981). \nApplication of the these findings on the nature of adaptation and \nsupercompensation led to rapid acceptance of the following practical recommendations:\n• It is necessary for the athlete to maintain a state of adaptation during training, so that it is possible to \nexecute the fundamental sporting actions effectively over an extended period\n• Repetition of training loads when the body is in a state of insufficient restoration is generally undesirable, \nalthough this is permissible in certain instances\n• Special work capacity should rise steadily during the course of training; any decrease at given stages of \ntraining would indicate that the training is incorrectly organised.\nUndoubtedly, all of these premises were progressive in their time and to a certain extent are still valid today. \nHowever, modem sporting requirements reveal the necessity to alter the main approach to structuring training and \nobey common sense, which indicates that the fundamental unit of training should be the mesocycle and not the \nmicrocycle. An extensive study of the characteristics of long-term adaptation is required for this. The practical \nvalue of this study will be appreciated only if one can observe the specific effect of given training loads on the \ndynamics of the athlete's state and determine the quantitative characteristics of the adaptation process.\nThe initial results of this research already have convincingly demonstrated its scientific and practical value, \nespecially in the case of sports which require explosive effort. General concepts about the development o f long­\nterm adaptation are the result of observing the dynamics of an athlete's special physical preparedness indicators \nover many years of training. Extensive research allows us to reach the following conclusions:\n1. The absolute and mean level of special strength preparedness increases annually.\n2. The initial level of speed-strength in each annual cycle is lower than the level at the end of the preceding \nyear's, but higher than at its beginning.\n3. The rise in speed-strength from year to year is larger for athletes of medium qualification than for highly \nqualified athletes.\n4. There is a definite trend in the dynamics of special strength preparedness in the annual cycle, which is \ndetermined by the traditional periodisation of training for the given sport and competition calendar. One can \nclearly trace a twin peak in the dynamics of speed-strength with two competition stages, because the level \nof special strength preparedness is higher in the second competition stage than in the first. In types of sports \nwith one competition season, speed-strength rises regularly and uniformly.\nDrawing such conclusions about some of the characteristics of long-term adaptation to intense muscular work in \nsport has important practical significance for programming training.\nThe performance results of the adaptation process, expressed by the dynamics of special work capacity, may \nbe presented schematically in the form of several concurrent graphs (Fig 6.22). Graphs B and C reflect the \ndynamics of the athlete's special work capacity in annual cycles (for bi-cyclic and mono-cyclic periodisation, \nrespectively). Graph A depicts the dynamics of relatively stable, long-term adaptation over many years.\nFigure 6.22 The dynamics o f adaptation in sports training over several years (Siff & Verkhoshansky, 1999).\n347\n\n=========== PDF 359 ===========\nSUPERTRAINING\nThe changcs in the functional indicators (graphs B and C) during the annual cycle are temporary, unstable and to \na certain extent, reversible. \nThe basis for these changes arc the so-called compensatory mechanisms, i.e. \nreactions designed to maintain the necessary level of functioning for brief periods under demanding conditions \nwhich ultimately lead to stable adaptation. The compensatory mechanisms are dynamic physiological means of \nrepairing the body during extreme conditions and gradually fade as adaptation takes place. \nInsofar as these \nmechanisms precede adaptation, they should be designated pre-adaptation phenomena (Kuznyetsov, 1979).\nThus, compensatory adaptation is a prerequisite condition for the development of long-term, stable \nadaptation (graph A). The latter can progressively increase if the functional reconstruction during the course of \ncompensatory adaptation is sufficient to produce a noticeable cffcct on the external interactions of the body and \nincrease its special work capacity. It should be stressed that adaptation in sport consists not only of increased \nmotor potential, but also the improvement of the athlete's skills to more effectively utilise this potential for coping \nwith specific motor tasks (graph D).\nIn the light of scientific research, adaptation cannot be considered an equilibrium process. Adaptation is the \ndynamic maintenance o f a definite level o f imbalance between the body and the environment at a given time, \nwhich is the fundamental reason for the origin and development of accommodative reconstruction (Bauer, 1935; \nBernstein, 1966).\nFigure 6.22 illustrates the gross changes in special preparedness with time and, therefore, reflects only the \ngeneral aspects of long-term adaptation. In reality, changes in special work capacity are produced by an extensive \ncomplex of adaptive processes which involve all of the body's survival systems. The rate of improving the \nperformance of these systems and the stages of acceleratcd physical development can be different. This \nheterochronicity is determined by:\n• the action of particular physiological systems in establishing long-term adaptation of a specific emphasis\n• differences in their reactiveness (or adaptive inertia)\n• changes in the role of these systems at different stages of long-term adaptation.\nA clear picture of the development of long-term adaptation in endurance sports has not been observed as it has \nbeen in explosivc-strcngth sports. In this case, it is not a matter of some specific differences in the adaptation \nprocess, but in the ability to observe it in the factors used for analysis. The measures of aerobic and anaerobic \noutput reflect the general level of special work capacity (i.e. endurance), but they do not express the internal \nchanges associated with adaptation to intense cyclic or acyclic work. A great deal of work still has to be done in \nunderstanding adaptation as the result of the summation of physiological responses to different training stresses, \nin particular regarding the endocrine system, neurohormonal processes, the neuromuscular system and the entire \nnervous system. The research done by Folbrot (1941), Selyc (see 1.16) and others has to be taken much further \nin its application to the development of sporting mastery, especially in endurance sports. Until then one can \nassume that long-term adaptation to endurance work is developed by the same, above-mentioned chief \nmechanisms, although at another level of the physiological systems.\nLong-term compensatory adaptation cannot continue indefinitely. The cffcct of compensatory adaptation on \nspecial work capacity diminishes with each repetition; with the adaptation being described by a parabola whose \npeak is eventually reached with time (Fig 6.22, graph A). This indicates that an athlete's general adaptation \nreserves have a limit that is genetically predetermined. One can judge the limits of compensatory adaptation by \nthe presence of waves in the dynamics of special work capacity (graphs B and C). One of the reasons for the \nappearancc of these waves is the use of traditional periodisation of training (mono- or bi-cyclic periodisation), but \na more important reason is the exhaustion of the so-called current adaptation reserves (CAR) of the body (see \n1.16).\nAt any instant, the body has a definite reserve potential, i.e. a capability of responding to adapt to external \ninfluences and raise itself to a new functional level. The capacity of these adaptive reserves is limited by definite \nphysiological mechanisms which determine the absolute level of the body's adaptive capability. Hence, the \nintensity, volume and duration of the training influences determine the optimal development of the body's CAR. \nIf the magnitude of these are below certain thresholds, the body will not fully utilise its CAR, whereas, if they \nexceed it, exhaustion of reserve potential will occur and the training effect will be low or negative.\nThe adaptation proccss has been divided by different researchers into three phases, based on observations of \nphysiological changes and the corresponding dynamics of sporting achievements, namely: (a) the growth of \ntrainability, (b) sporting form, (c) loss of trainability (Letunov, 1952), or as the similar scheme: (a) adaptation, (b) \nthe highest sport work-capacity, (c) re-adaptation (Prokor, 1959). In the latter case, re-adaptation refers to the\n348\n\n=========== PDF 360 ===========\nS UPER'fRA IN INC\ndecrease in work capacity as the limits of adaptability are exceeded, i.e. the adaptation energy is lowered. \nSubsequent workers have designated these phases simply as acquisition, preservation and brief loss of sporting \nform (Matveyev, 1964).\nThus, one can consider training organisation to be effective when it produces the maximum growth of the \nbody’s CAR by means of the appropriate volume of loading. Hence, useful ways of programming and organising \ntraining emerge if we devise means of assessing the body’s CAR in each case, together with criteria for \ndetermining the contents and volume of the training loads that are necessary for building up the CAR. The \npossibility of devising a quantitative approach to determine the body's reserve capacity has already been \ndiscussed in the literature for several decades. It is based, in particular, on assessments of a number of bio­\nchemical indicators of energy exchange processes (Beckman et al, 1961; Yakovlev, 1977).\nTwo forms of compensatory adaptation, associated with enhancing the CAR by systematic training, which \ndiffer in volume and organisation of the training loads, have been identified and studied in explosive sports (Fig \n623). The first form o f adaptation, produced by distributed loading (A), is characterised by a gradual increase in \nthe functional indicators and is associated with a moderate volume of continuous loading. In this case, periodic \nbrief disturbances of the body's homeostasis occur and the current expenditure of energy resources is \ncompensated during training. This form of compensatory adaptation follows traditional concepts for developing \ntrainability and is typical for athletes of medium classification under contemporary training conditions.\nThe second form of compensatory adaptation, produced by concentrated loading (B), is associated with the \nuse of a large, concentrated volume of special physical preparation means, concentrated in the first half of the \ntraining phase. These large volumes provoke a profound and prolonged disturbance of the body's homeostasis, \nwhich is reflected by decrease of the functional indicators. Then, after the volume of loading is decreased, their \nincrease accelerates and exceeds the level achieved with the first form of adaptation. This way of organising \nloading in the preparatory mesocycles was devised for highly qualified athletes and has been shown by research \nto be effective for all types of sport (Verkhoshansky, 1977).\nThe practical aspects of utilising this form of compensatory adaptation in actual training conditions will be \ndealt with later. It is relevant here to dwell on the results of research which studied compensatory adaptation and \nmethods of maximally enhancing the body’s CAR during the training mesocycle.\nFirstly, the optimal duration of the training influences was determined, since this is vital \nfor maximal \nenhancement of the body's CAR. It was learned that the appropriate duration of continuous training is 5-6 weeks, \nand with concentrated loading, the duration is 3-4 weeks, after which a recuperation period is necessary for \nactivating the compensatory processes.\nIt was also revealed that the trained athlete is able to tolerate three such sequential blocks of loading, \nseparated by short recuperation pauses (7-10 days). After this, a longer recuperation period is necessary to \nfacilitate stabilisation at the new level of adaptation. Thus, the time interval necessary for exhausting the body's \nCAR is between 18-22 weeks (see Fig 6.23). This period coincides with observations of highly qualified athletes \ntraining in different sports, including cyclic types (Zhikharevich, 1976; Sirenko, 1980).\nIn order to apply this information, it is necessary to appreciate that the body cannot indefinitely continue to \nadapt successively to training loads. There are definite time limits during which the body is able to react \npositively to continuous training loads of large volume, and these must be taken into account when programming \ntraining. Whatever training regime is devised, it must always be remembered that it is inappropriate to subject \nthe body to extreme exhaustion of its energy reserves. This requires a longer recuperation period and has a \nnegative effect on the subsequent stages of adaptation.\nThe preceding cautionary remarks apparently have not been fully appreciated by the critics (such as \nKomarova, 1984) of the concentrated loading system. \nKomarova correctly recognises that premature or \nprolonged application of concentrated loading can lead to overtraining, stagnation or injury, as has been \nemphasized regularly in this textbook. However, he errs in extrapolating this analysis to completely dismiss the \nperiodic use of concentrated loading by qualified athletes. This underlines how important it is for the coach to be \nable to select the appropriate form of periodisation to suit the athlete during every stage of the training process.\nResearch aimed at revealing effective ways of maximally developing the body's CAR, has revealed one of \nthe most important features of adaptation associated with the extensive disturbance of the body's homeostasis \nI Verkhoshansky, 1977). It was found that the more extensive and longer the exhaustion of the body's energy \nresources by concentrated loading during specific mesocycles of training (obviously within reasonable limits), the \nhigher their subsequent super-restoration and the longer the new functional level is maintained. The key issue, of\n349\n\n=========== PDF 361 ===========\nSUPERTRAINING\ncourse, is determining the optimal duration of concentrated loading, so as to avoid exhaustion and diminished \nperformance.\nFigure 6.23 Two forms of compensatory adaptation during the large preparation phase (Siff & Verkhoshansky. 1999).\nIt is interesting to note the results of a study done by Bondarchuk (1982) which analysed the effect of different \nvolumes of an identical training programme on a group of hammcr-throwers. He found that a 50% increase in \nvolume of loading had no significant effect on the duration of maintenance of the training effect and sporting \nperformance. Although Bondarchuk stresses that this finding applies strictly to a particular group of athletes, it \ntends to confirm that major changes in intensity have a more profound effect on athletic state than comparable \nchanges in volume. It also implies that calculations of volume are not as critical as those of intensity, thus \ncorroborating the importance o f paying careful attention to zones o f loading intensity, as emphasized earlier in\n6.2.2 (see also Table 6.1).\nTraining organisation which elicits extensive and relatively prolonged disturbance of homeostasis \nnecessitates the inclusion of suitable restorative stages for triggering a compensatory reaction, thereby eliminating \ninappropriately phased peaking of the various functional indicators and stabilising the body at the new functional \nlevel. The general volume of the load should be decreased at this time and General Physical Preparation means \nshould be introduced into training so as to intensify the compensatory reaction. \nThe more extensive and \nprolonged the disturbance of homeostasis, the longer the restorative stage should be. The concept of CAR and \nthe characteristics of compensatory adaptation have great significance for programming training and especially \nfor effective annual periodisation.\n6.8.2 Structural-Functional Specialisation in Training\nStructural-functional specialisation refers to those stable, adaptive changes that are produced by the specific form \nof conditioning imposed by a given sport. \nAll of the survival systems of the body undergo adaptive \nreconstruction in response to external stressors. However, it is not difficult to observe that those systems which \nare of major importance for success in sport undergo an accelerated rate of functional growth.\n350\n\n=========== PDF 362 ===========\nSUPERTRAINING\nIt has been noted already that the specifics of adaptation are determined primarily by two factors, namely the \nwork regime in sports, and the gradual, but steady increase in complexity of the body's external interactions \nassociated with the growth of sporting proficiency.\nFor example, improvement of the triple jump requires developing the ability of the motor apparatus to \nproduce great power. Increase in jumping distance, which is accomplished primarily by increasing running \nspeed, is associated with a significant increase in complexity of the interaction of the feet with the support at each \ntake-off, a situation that requires significant improvement in reactive ability.\nCyclic locomotion, to a great extent, necessitates increasing the power and the capacity of the body's systems \nwhich are crucial for energy production of muscular work. Energy expenditure increases greatly with increase in \nmovement speed. For example, oxygen requirements increase considerably with running speed, energy \nexpenditure being almost proportional to the fourth power of running speed (Sargent, 1926). This rising cost of \nrunning speed is associated with a greater reliance being placed on anaerobic processes for generating the \nnecessary energy of work (Henry, 1951; Margaria, 1963).\nAs discussed previously (see 2.2.3, 5.4.3). two forms of functional perfecting of the body may be \ndistinguished in the training process, namely, specialisation by physiological system and specialisation by motor \nability (Verkhoshansky, 1971). The most obvious evidence of specialisation appears when comparing the \nfunctional development of the body in different sports. \nIf we refer to the classification scheme of 6.5, \nspecialisation by physiological system means that acyclic sports rely predominantly on anaerobic processes and \nfunctional hypertrophy of the motor apparatus, whereas cyclic sports place major reliance on aerobic processes. \nIn complex (combined) sports, there is an intense functional development of both the motor apparatus and the \nenergy production systems. \nSpecialisation by motor ability refers to the exact programme of neuromuscular \ncontrol that is developed by repetitive execution of the motor skills required in a given sport (see 2.2.3).\nHowever, it is important to emphasize that specialisation in the first two cases does not imply that \ndevelopment is either strictly aerobic or anaerobic, but rather that there is a particular primary emphasis of \nfunctional specialisation. One can successfully develop a high level of explosive strength in acyclic locomotion \nonly when one possesses sufficiently high aerobic efficiency. At the same time, improving the efficiency of the \nenergy producing systems in cyclic locomotion should be based on highly developed muscular strength and local \nmuscular endurance.\nThe kinesiological patterns of motor activity in various types of sports are approximately equivalent, \nalthough there are some qualitative and quantitative differences associated with specific types of sports. Thus, \nsprint swimmers have higher rates and developmental levels of anaerobic productivity than distance swimmers, \nwhereas aerobic productivity is superior for distance swimmers. This is determined by the emphasis of the \ntraining.\nIn the multi-year training of sprinters, up to Class I-CMS (Class I - Candidate for Master of Sport), the chief \nemphasis is on developing general (aerobic) endurance and speed, whereas at MS-MSIC (Master of Sport - \nMaster of Sport, International Class) level the emphasis is on developing speed (anaerobic) endurance. In the \ntraining of distance athletes of all qualification levels, the chief emphasis is on developing aerobic productivity, \nwhile at the MS-MSIC level, the emphasis is on enhancing anaerobic productivity (Vankov, 1978).\nIn cyclic sports, strength preparedness, mainly in the form of strcngth-endurancc, plays an important role. \nResearch shows that, with a relatively moderate increase in muscular strength, together with a rise in the athlete's \nqualification, the qualities of dynamic strength-endurance and power accelerate the increase in functional strength \n(Zhurbinoi, 1978).\nThe process of functional specialisation is characterised by the fact that there is a definite sequence (known \nas hcterochronicity, as detailed in 2.2.3) in the development of adaptation. This means that the body adapts to \nexternal influences only when they bccome necessary for the further growth of sporting proficiency, and this \ninvolves only those systems whose functions satisfy all the necessary requirements for enhancing sport specific \nfitness.\nThe multi-year functional specialisation of the body is closely connected with its corresponding physical \nadaptation. This adaptation leaves traces of the training influences on the body for long periods and serves as the \nfoundation for its functional perfecting. These traces have been studied extensively in general terms at the level of \nmuscle tissue, cardiac muscle, skeletal structure, cardiovascular mechanisms and other systems. Further study of \nthe multi-year characteristics of structural-functional specialisation in particular types of sport is important in \nformulating the principles of programming training.\n351\n\n=========== PDF 305 ===========\nSUPERTRAINING\nUnidirectional emphasis on qualities such as strength or endurance may be used not only in individual worko \nbut also during each microcycle (Kudelin, 1980; Budokho et al, 1978; Mironenko, 1980). Research has sho \nthat unidirectional training over periods as long as 4-12 weeks can be very effective, especially if the intensity is \ngradually increased for each form of loading in the given cycle. Moreover, the effectiveness of the conjugate \nsequence system with advanced athletes is such that the training volume over a macrocycle can be reduced by as \nmuch as 20%, a phenomenon referred to as the acceleration o f specific adaptation (see 5.4.2).\nHowever, it must be noted that unidirectional loading is effective only if one uses a diverse complcx of means \nwith a single primary emphasis, together with a variety of training methods (Fedorova et al, 1975; Platonov &. \nMonograov, 1977; Verkhoshansky, 1977). Furthermore, an important condition for implementing concentrated \nloading is the relatively low intensity of the means, sincc the frequent use of these means already intensifies the \ntraining. In this context, the loading may be considered concentrated if its volume in the month in which it is \napplied constitutes 23-25% of the general volume for the year.\nThe system is not without its dangers, since concentrated loading is very stressful and, besides increasing the \npotential for overtraining, it can decrease motor qualities such as speed-strength. After a phase of emphasis on \nheavy strength training, there may be an increase in muscle stiffness and a loss of explosive strength, sporting skill \nor speed. Since the conjugate sequence system is based on exploitation of the delayed training effect, a diminished \nloading and restorative period has to be observed after a given concentrated loading phase to allow the body to \nsupercompensate to the desired level o f preparedness. The gains elicited, for instance, by 4-8 week concentrated \nblocks of strength, speed-strength or speed training, may occur most commonly after a latency period of 1-3 \nweeks, so it is essential for the athlete not to lose patience and hasten into the next concentrated phase without \nadequate restoration. Not only does premature imposition of concentrated loading suppress the delayed training \neffect of the previous stage, but it also lowers the effectiveness of future training.\n5.4 The Principal Aims of Special S trength Training\nDuring the initial stages of training the body reacts to any stimulus with all of its survival mcchanisms and motor \nabilities. As a result of this general adaptation response, the specific training effects which enhance working \npotential are not produced. Characteristically, there is a relatively high correlation between the various motor \nabilities and the development of even those abilities which are not directly implicated. The transfer of fitness is \nvery distinct here.\nAs sporting proficiency grows, so the adaptation response becomes more selective. Functional adaptation is \nconfined primarily to those systems which are the most active and develops in those directions which art \ndetermined by the specific components of the training stimulus. The close connection between separate motor \nabilities tends to diminish during the stage of high sports proficiency, the rate of development o f motor abilities \nwhich are not the direct object of training slows down, and the transfer phenomenon is not displayed as sharply \nas before. Thus, the direction of progress is determined entirely by the specific components of the training \nstimulus. Since sport achievements at the high levels of sports proficiency are produced by a complex of specific \nmotor abilities, the regime of the means used should contain an optimal combination of specific training means.\nIt is now appropriate to formulate a set of general principles for organising special strength training, based on \nthe specific characteristics of physical training and the long-term dynamics of the STS (Sports Training Process). \nIn general, they express the chief ways o f exploiting these characteristics and form the foundation of a new \nsystem of sport training, although they do not exclude all of the traditional principles and rules. These principles \nare:\n• Converging the partial effects of strength training means\n• Accelerating specific adaptation\n• Specific correspondence of the training effect\n• Maintaining the strength training effect.\n5.4.1 Converging the Partial E ffects of Strength Training Means\nThe principle of converging the partial effects o f strength training means is fundamental to the long-term \norganisation of strength training. It is achieved by the convergence of all the different partial training effects, i.e. \nthe gradual convergence of their cumulative training effect to those important specific characteristics which are \nessential to the functioning of the body in a particular sport.\n294\n\n=========== PDF 381 ===========\nSUPERTRAINING\nachieve several simultaneous training objectives with means of different primary influence (Handelsman & \nStetsenko, 1980).\nIt has also been shown that individual workouts devoted solely to perfecting sport technique are appropriate. \nEven when a wide variety of means and regimes of work and rest are used, these types of training session arc \nvery effective in improving technical skill (Struchkov, 1980; Mironenko, 1981; Petrovsky, 1977). It has been \nshown that training sessions with the primary emphasis on developing a single motor ability (under conditions of \na wide variety of means and methods) exert a more profound effect on special preparedness compared with \ntraining sessions where several objectives are pursued concurrently (Urzhensnevsky, 1969; Gorkin et al, 1973; \nMonogradov & Platonov, 1975; Fedorova et al, 1975; Chepelyev, 1980).\nIn addition to its value during separate workouts, unidirectional loading is also appropriate during \nmicrocycies (Kudelin, 1980; Mikhailova & Sokolova, 1980; Budokho et al, 1978; Mironenko, 1981). For \nexample, it has been established that microcycies of a single primary emphasis (in particular, to increase speed or \nvarious types of endurance) powerfully stimulate the trainability of swimmers (Kudelin, 1980). Similarly, it has \nbeen shown that microcycies of a primarily strength emphasis significantly raise the special physical \npreparedness of track-and-field jumpers (Mironenko, 1981).\nHowever, research shows that unidirectional loading is effective only if it forms part of a complex of several \nmeans of a single primary emphasis involving a variety of methods (Fedorova et al, 1975; Platonov & \nMonogradov, 1977; Vcrkhoshansky, 1977).\nConsiderable work has revealed that the primary use of unidirectional training for prolonged stages (4-12 \nweeks) of training can be very effective. Use of a variety of means, especially when applied with a gradual \nincrease in intensity, has been shown to be particularly appropriate for enhancing sporting technique, speed- \nstrength, and the capacity and power of the ATP-CP and glycolytic-anaerobic energy processes (Mironenko. \n1981; Antonova, 1980; Deniskin, 1976; Levchenko, 1981; Kornelyuk, 1980).\nConcentrated Loading\nThus, the method of concentrated training loads was devised for preparing highly qualified athletes, with the \nloading being concentrated during specific stages of preparation (Verkhoshansky, 1977). The main novelty of \nthis method consists of exerting a concentrated training influence on the body with a high volume of \nunidirectional loading for a limited period (of up to 2 months). This concentrated influence produces a brief, \nfairly stable state of incomplete restoration which is associated with the persistent and relatively prolonged distur­\nbance of homeostasis. \nThis triggers extensive functional changes which are prerequisites for subsequent \nsupercompensation and the raising of the body to a higher level of special preparedness. An important condition \nfor the using concentrated loading is the relatively low intensity of the means, since the frequent use of these \nmeans already intensifies the training. The loading may be defined as concentrated if its volume in the month in \nwhich it is concentrated is 23-25% of the general annual volume.\nIt is appropriate to use concentrated loading primarily for increasing the effectiveness o f SPP, and for this \npurpose one can use loading of any primary emphasis. However, the concentration of specialised strength loading \nis of particular significance, not only for raising the athlete's physical fitness, but also for regulating the entire \ncomplex of loading over the annual cycle in all sports.\nConcentrated strength loading constitutes a relatively independent part or block of training to create a \nfunctional foundation for the subsequent enhancement of technical skill or those motor abilities which chiefly \ndetermine success in a given sport. Hence:\n• The composition of means and their organisation in strength blocks, as well as their logical connection with\nother loading, should be determined by taking into account the training specifics of that type of sport.\n• The strength block should have a specific place in the annual cycle, and consequently, have a beneficial\neffect on the sequence of loading and the organisation of loading of other primary emphasis over time.\nHere the concept of a block has a definite meaning, arising from the programming of technique. To achieve the \nprincipal aims of organising loading in the annual cycle, the coach must select a certain strength block or \nsubstitute one block for another, depending on the situation and the individual. Obviously, in order to do this, he \nneeds to prepare a detailed selection of appropriate strength blocks in advance.\n370\n","numLines":795,"startLine":1,"totalLines":795}},"sourceToolAssistantUUID":"1ae49b2c-c489-49d3-9d07-0fb3feed3157","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
