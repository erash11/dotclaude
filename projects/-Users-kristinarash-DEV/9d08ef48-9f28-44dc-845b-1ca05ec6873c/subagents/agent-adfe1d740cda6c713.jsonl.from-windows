d-hansen-show-strength-endurance-training-specificity.md\nframework--acute-delayed-particular-cumulative-training-effect-taxonomy.md\nframework--aerobic-vs-anaerobic-circuit-parameters.md\nframework--annual-models-for-medium-and-long-duration-endurance-sports.md\nframework--apre-autoregulating-progressive-resistance-exercise.md\nframework--bi-cyclic-annual-model-for-explosive-strength-sports.md\nframework--bodymass-strength-scaling-laws.md\nframework--central-vs-peripheral-fatigue-mechanisms.md\nframework--circuit-layout-variants-superset-retrophase-zigzag-detour.md\nframework--clinical-physiological-effects-of-electrostimulation.md\nframework--compensatory-acceleration-training.md\nframework--conditions-for-concentrated-unidirectional-loading.md\nframework--conjugate-sequence-system-of-training-means.md\nframework--continuous-interval-and-mixed-circuit-training-classification.md\nframework--cybernetic-periodisation-rpe-and-rating-of-technique.md\nframework--descriptive-and-prescriptive-training-models.md\nframework--determinants-of-strength-structural-functional.md\nframework--distributed-vs-concentrated-loa","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/kristinarash/.claude/projects/-Users-kristinarash-DEV/9d08ef48-9f28-44dc-845b-1ca05ec6873c/tool-results/b1h3rex1x.txt","persistedOutputSize":43294},"sourceToolAssistantUUID":"a36055bf-934b-4584-8406-29b8c3499933","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
