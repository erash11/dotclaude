-0.061 s (PDF p. 288 / printed p. 277).\n\n**Related** — [[claim--squat-1-5-to-2-bodymass-rule-applies-to-maximal-depth-jumps-only]]; [[claim--eccentric-training-damage-adaptation-and-injury-risk-tradeoff]]; [[claim--optimal-depth-jump-drop-height-for-power-vs-force]]; [[heuristic--rate-plyometric-intensity-by-contact-momentum-from-drop-height]]\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"8347b01f-a129-4a77-a3a2-faf1b5ca25e8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
