{"parentUuid":"fab697c3-e697-44b7-acaa-c22b04febbc1","isSidechain":true,"agentId":"ac8240d61f5c36dd4","message":{"model":"claude-opus-5-5","id":"msg_011CffZZpyASebW9gMz5rLvV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FuH8PDXcdKPfCXwFW1oTZp","name":"Read","input":{"file_path":"/Users/kristinarash/DEV/Flint/staging/_tmp/ch5b_text.txt","limit":420},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":454,"cache_read_input_tokens":104118,"output_tokens":104,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":454},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":104,"cache_read_input_tokens":104118,"cache_creation_input_tokens":454,"cache_creation":{"ephemeral_5m_input_tokens":454,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01FuH8PDXcdKPfCXwFW1oTZp":{"file_path":"/Users/kristinarash/DEV/Flint/staging/_tmp/ch5b_text.txt","limit":420}},"apiBlockIndex":0,"requestId":"req_011CffZZpe53fT4JsSGp9HHx","attributionAgent":"general-purpose","type":"assistant","uuid":"58e13e37-f8df-4861-8b03-a6627abd93c2","timestamp":"2026-10-03T15:45:04.672Z","advisorModel":"claude-fable-5-1","effort":"medium","perTurnEffort":"medium","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"58e13e37-f8df-4861-8b03-a6627abd93c2","isSidechain":true,"agentId":"ac8240d61f5c36dd4","attachment":{"type":"hook_success","hookName":"PreToolUse:Read","toolUseID":"toolu_01FuH8PDXcdKPfCXwFW1oTZp","hookEvent":"PreToolUse","content":"","stdout":"{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"<context_guidance>\\n  <tip>\\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\\n  </tip>\\n</context_guidance>\"}}\n","stderr":"","exitCode":0,"command":"node \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.mjs\"","durationMs":85},"type":"attachment","uuid":"5fdb12fd-57ce-4692-9631-7da2be7dab81","timestamp":"2026-10-03T15:45:04.768Z","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"5fdb12fd-57ce-4692-9631-7da2be7dab81","isSidechain":true,"agentId":"ac8240d61f5c36dd4","attachment":{"type":"hook_additional_context","content":["<context_guidance>\n  <tip>\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\n  </tip>\n</context_guidance>"],"hookName":"PreToolUse:Read","toolUseID":"toolu_01FuH8PDXcdKPfCXwFW1oTZp","hookEvent":"PreToolUse"},"type":"attachment","uuid":"f3aa4007-027e-4453-b8ac-66fe2967ed8d","timestamp":"2026-10-03T15:45:04.769Z","rendered":[{"content":"<system-reminder>\nPreToolUse:Read hook additional context: <context_guidance>\n  <tip>\n    Reading to Edit the file? Read is correct — Edit needs the exact bytes in your conversation to match against.\n    Reading to analyze, summarize, or extract from the file? Use mcp__plugin_context-mode_context-mode__ctx_execute_file(path, language, code) — the bytes stay in the sandbox and only what your code prints enters your conversation.\n  </tip>\n</context_guidance>\n</system-reminder>"}],"renderedRole":"system","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"58e13e37-f8df-4861-8b03-a6627abd93c2","isSidechain":true,"promptId":"624a8cec-33fa-4c0a-a445-c72ce718e6ab","agentId":"ac8240d61f5c36dd4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FuH8PDXcdKPfCXwFW1oTZp","type":"tool_result","content":"1\t\n2\t\n3\t######## PDF 276 / printed 265\n4\tSUPERTRAINING\n5\t1967). With this method, speed of movement increases with and without loads, and experiments have shown that \n6\tthe general increase in speed can reach 146% of the initial level. Movements should be executed with maximal \n7\teffort and the apparatus should be accelerated as rapidly as possible.\n8\tTo promote muscle recruitment in the active state, exercises with light and heavier weights (up to 40% of \n9\tIRM) should be combined (the variable method) and the load should be lifted with the emphasis on acceleration at \n10\tthe beginning of the movement. Plyometric exercises (see 5.2.4), as well as exercises where isometric tension is \n11\tgenerated quickly using 60-80% of 1 RM, should also be included. The optimal combination o f the volume of \n12\texercises with light weights and relatively heavy weights should be in a ratio of 5:1. Regarding sequencing, it has \n13\tbeen found that the alternation of exercises is most effective for the ranked athlete.\n14\tTo develop speed-strength in acyclic movements, plyometric or throwing exercises should be selected on the \n15\tbasis of their relevance to the sports activity. For example, to develop strength for the waterpolo throw, better \n16\tresults are obtained by throwing a medicine ball of 2 kg weight rather than one of 4 kg, the increases in throwing \n17\tdistance being 13.6% and 8.9%, respectively. \n18\tMoreover, throwing a 4 kg ball is detrimental to technique \n19\t(Rogener, 1961).\n20\tTraining with a light (57 grams) and a heavy (184 gm) baseball for throwing ability results in improvements \n21\twith both of them, where the mass of a regulation ball is about 148 gm. However, the transfer of specific fitness \n22\tis not uniform: throwing the light ball improves precision for throwing the heavier ball, but the reverse effect does \n23\tnot occur (Egstrom et al, 1960). The optimal weight for javelin training which does not disrupt technique is 3 kg \n24\t(Matveyev, 1967).\n25\tThe progressive development o f speed-strength is the result of combining means for exploiting the after- \n26\tejfect phenomenon of preceding work to increase the effectiveness of subsequent work. In devising training means \n27\tand methods for perfecting sporting performance, modelling is of central importance, where sports modelling \n28\trefers to the formulation of descriptive models of sporting activities on the basis of biomechanical, kinesiological, \n29\tphysiological and other scientific measures.\n30\tExercise modelling experiments show that the working effect of an explosive movement, as measured by the \n31\theight to which a load was thrown (Fig 5.4), increases by an average of 38-40% after execution of barbell presses \n32\tfor 3 sets of 3 repetitions with 80% of the 1 RM (with a rest interval of 10 minutes between the pressing and the \n33\tthrowing). Movement time decreases, there is an increase in the length of the working path, the average speed, the \n34\tdriving force and power output (Table 5.3). Thus, the repetition of the same stimulus evokes a more pronounced \n35\treaction by the body and greater development of strength and speed.\n36\tResearch shows that speed of movement increases significantly by use of the variation method: for example, by \n37\tputting the shot directly after muscular contraction has been produced by putting a lighter object. \n38\tIn one \n39\texperiment, lighter and heavier shots differing in mass by 250 grams were thrown at different velocities. A \n40\tstatistically significant difference was not found in the mean results of alternately putting standard shots of \n41\tdifferent mass. However, distances close to the mean were obtained with a difference in mass of 250 grams,\n42\t265\n43\t\n44\t\n45\t######## PDF 277 / printed 266\n46\tSUPERTRAINING\n47\twhereas this closeness to the average was not achieved with a difference of 500 grams (Ivanova, 1964; Vasiliev,\n48\t1975).\n49\tTabic 5.3 Aim movement characteristics for throwing a weight before and after tonic work (Verkhoshansky, 1977).\n50\tArm M ovem ent C haracteristic\n51\tFirst Effort\n52\tSecond Effort\n53\tDifference (%)\n54\tHeight of throw (cm)\n55\t44.0\n56\t61.0\n57\t♦38.8\n58\tMovement time (sec)\n59\t0.266\n60\t0.250\n61\t-6.8\n62\tWorking path (cm)\n63\t62.0\n64\t65.0\n65\t44.8\n66\tAverage speed of movement (m/sec)\n67\t2.330\n68\t2.600\n69\t4-11.7\n70\tAverage driving force (kgf)\n71\t5.550\n72\t7.430\n73\t4-33.8\n74\tPower (kg.m/s)\n75\t1.310\n76\t1.930\n77\t447.3\n78\tThus, the transference of throwing speeds from a lighter to a heavier mass (i.e. the normal mass) apparently is \n79\tpossible only by alternating the throwing of shots of different mass. The effectiveness of the variable method of \n80\tdeveloping speed of movement was confirmed in the training of hockey players who successively hit a normal and \n81\ta heavier puck. The optimal mass o f the heavier puck was found to be between 0.6-0.8 kg. However, it is \n82\tnecessary to select the mass for each player individually, based on the athlete's ability to hit the heavier puck effi­\n83\tciently (Savin, 1974).\n84\tIt should be pointed out that certain Eastern European and Chinese athletes train with heavier implements in \n85\ttheir own sports and maintain that this method contributes to their impressive results. For instance, some table \n86\ttennis competitors will eventually train with as much as 2kg bats, which is considerably heavier than typical bats \n87\tof about 100 grams mass. Their coaches stress that this type of training is done only with carefully balanced bats \n88\tby elite athletes about once a week before the competition phase, with less advanced competitors gradually \n89\tincreasing the weight of their bats over a prolonged period. \n90\tThis method should not be emulated by less \n91\texperienced coaches, as the untutored use of this extraordinary approach can lead to overload injuries and altered \n92\tneural control patterns.\n93\tAttempts must be made to resolve the conflict between the magnitude of the load and speed of movement in \n94\tdeveloping speed-strength. In this instance, this may be achieved if strength is used to oppose not the weight \n95\t(gravitational force), but its inertia (acceleration force). Unfortunately this method is very seldom used in practice \n96\tand its potential for enhancing strength is largely unexplored (see Fig 4.4), so that it is difficult to give specific \n97\trecommendations for its application.\n98\tThe next issue is the rest interval between sets of exercises. This interval is determined by level of fitness, \n99\tthe level of special endurance to repeatedly produce maximal tension and the degree of strength exerted. \n100\tExperiments show that, with an optimal pause of 0.5-1 minute, speed-strength output can be maintained at a high \n101\tlevel for a fairly long period without serious deterioration. The possible gradual decrease of speed-strength with \n102\texhausting, monotonous work can be largely eliminated by creating a favourable emotional state.\n103\tSpced-strength as displayed in rapid cyclical movements is characterised by repetitive contractions \n104\tseparated by relaxation phases. Depending on the special exercise, the effect of speed-strcngth can be determined \n105\tby the ability of the neuromuscular apparatus to maintain the strength output for a long period at a specific work \n106\trate.\n107\tThus, the movement tempo and the duration of work are of great significance in the development of speed- \n108\tstrength in speed-cyclic exercises. The resistance and the movement tempo are inversely proportional to one \n109\tanother. In other words, an increase in the resistance decreases the movement tempo and promotes the rapid \n110\tonset of fatigue. Therefore, the optimal combination of resistance and tempo should be selected in each specific \n111\tcase, based on the kinesiological structure of the given exercise. It should be remembered that speed of movement \n112\tdecreases over a long period of training done at a slow tempo and increases through training at the optimal speed \n113\t(Korobkov, 1953; Monogarov, 1958).\n114\tThe ability to correctly execute the full movement cycle, including the appropriate phases of tension and \n115\tmuscular relaxation, should serve as a criterion. The movement tempo should gradually approach the tempo of the \n116\tspecial exercise and even exceed it, while the working time should lengthen (Diachkov, 1961).\n117\tAll that has been stated concerning the development o f speed-strength is related primarily to exercising \n118\tfunctionally the relevant muscle groups by means of the special exercise. However, good results are achieved by \n119\tmaking the special exercise more demanding. Thus, the use of water resistance in rowing or very small loads on\n120\t266\n121\t\n122\t\n123\t######## PDF 278 / printed 267\n124\tSUPERTRAINING\n125\tthe limbs of track-and-field athletes and gymnasts can enhance speed-strength under conditions that are very close \n126\tto those of the special exercise.\n127\tIn certain cases, power can be increased without using additional loads. For example, with jumps from one leg \n128\tto the other, the push-off displays values of power which are greater than in running. Therefore, these jumps are \n129\texcellent for the special strength training of sprinters. It is only necessary to execute them correctly by not \n130\taccentuating the push-off of the body (which does not happen in sprinting), but by active gathering-in of the \n131\tplanted leg (i.e. via hip flexion). These jumps should be executed repetitively over distances of 50-100 meters as \n132\tfast as possible. The addition of small cuffs weighing from 100-150 grams on each thigh can makes such exercises \n133\tmore effective in experienced athletes (based on Verkhoshansky’s experience with top Russian sprinters, such as \n134\tZubov).\n135\tThus, to develop speed-strength one should use exercises, primarily with small resistance (20% of 1 RM) and, \n136\tfor acyclic activities of brief duration, a combination of these exercises with weights up to 40% of 1 RM in a ratio \n137\tof 5 to 1. The work regime should correspond to the special exercise (cyclic or acyclic) and take into account the \n138\tinitial conditions from which force is developed (i.e. with the muscles relaxed, in a state of preliminary tension or \n139\tstretched).\n140\tPerfecting the methods of developing speed-strength is a result of the search for a specific combination of \n141\tmeans that exploit:\n142\t• the positive after-effect of preceding work on the subsequent activity\n143\t• the use of exercises in which muscular force opposes the inertia of the load and not its weight.\n144\tFatigue must be avoided when one is trying to develop speed-strength for acyclic movements. However, fatigue is \n145\ta necessary component of training for spced-strength in cyclic movements which require speed-endurance. Precise \n146\timplementation of these findings is possible only under specific training conditions so, for the present, one has to \n147\trely on empirical methods.\n148\t5.2.4 Developm ent of Explosive Strength and R eactive Ability\n149\tThe development of effective methods to develop explosive strength and reactive ability logically begins with an \n150\tanalysis of the speed-strength methods traditionally used for this purpose. For instance, athletes often attempt \n151\tto develop explosive strength in the legs by using heavy barbell squats. In this case the musclcs work very slowly \n152\t(quasi-isometrically) with a relatively constant tension produced by the load. \n153\tConsequently, the muscles \n154\tprimarily develop isometric strength, but this does not mean that it is impossible for them to execute fast dynamic \n155\tcontractions. It should be added that increase in the weight of the barbell, which is frequently considered a basic \n156\tindicator of special strength fitness, places a large and generally unnecessary load on the spine.\n157\tHowever, to solve the task of speed-strength preparation, athletes use smaller loads. For example, doing \n158\tsquat thrusts with a 60kg barbell on the shoulders produces a large dynamic maximum force. Therefore, exercises \n159\twith heavy weights tend to increase the strength potential of the muscles, while fast exercises with light weights \n160\timprove speed. Nevertheless, these means are not the only way of developing explosive strength.\n161\tExplosive strength is a motor quality requiring specific movements and training means. The above- \n162\tmentioned means of strength training do not adequately enhance specific components of explosive movements \n163\tsuch as the rapid excitation of muscles and the rapid changing from eccentric to concentric work.\n164\tThese and allied skills require a specific training regime which is impossible to imitate with only one \n165\tresistance exercise. Indeed, stimulation of muscular activity with slow resistance movements, and lifting a barbell \n166\tin preparation for squatting or jumping with it, removes the possibility of controlling the mechanisms which are \n167\tcrucial to the rapid switching of muscles to the active state. At the same time, a decrease in the resistance \n168\tdiminishes the dynamic effort required and creates a vicious cycle from which there is no apparent escape.\n169\tThus, if the athlete successfully develops a high level of explosive strength, then it may be attributed to \n170\tcertain means in his training. Consequently, the problem amounts to singling out those means and organising them \n171\tso as to systematise the special strength training.\n172\tThe Plyometric Method\n173\tProlonged research in the direction discussed above led to the development of the so-called 'shock' (plyometric) \n174\tmethod of developing explosive strength and reactive ability (see 1.5). Basically it consists of stimulating the \n175\tmuscles by means of a sudden stretch preceding any voluntary effort (see 4.2.3). Kinetic energy and not heavy\n176\t2 6 7\n177\t\n178\t\n179\t######## PDF 279 / printed 268\n180\tSUPERTRAINING\n181\tweights should be used for this, where the kinetic energy may be accumulated by means o f the body or loads \n182\tdropping from a certain height (see 4.2.3). Depth jumps and medicine ball rebounding are two of the exercise \n183\tregimes commonly used in plyometrics.\n184\tThe increase in popularity of plyometrics in the West deems it necessary that the concept be more rigorously \n185\tdefined. Plyometrics or the 'shock method' means precisely that - a method of mechanical shock stimulation to \n186\tforce the muscle to produce as much tension as possible. This method is characterised by impulsive action of \n187\tminimal duration between the end of the eccentric braking phase and initiation o f the concentric acceleration \n188\tphase. It relies on the production of a very brief explosive-isometric and eccentric-isometric phase which pre­\n189\tcedes the release of the elastic energy stored in the tendons and other components of the scries elastic component \n190\tof the muscle complex during the eccentric deceleration phase (see 1.9, 3.1 and Fig 4.11). If the transition phase \n191\t(or, coupling phase) is prolonged by more than about 0.15 second, the action may be considered to constitute \n192\tordinary jumping and not classical training plyometrics. A useful visualisation is to imagine that the surface being \n193\ttouchcd by the hands or the feet during the plyomctric contact phase is red hot, so that any prolonged contact \n194\twould be dangerous.\n195\tIt is important to note that the activity is not accurately plyometric if the athlete relies upon ongoing \n196\tfeedback processes to control the isometric and concentric actions instead of upon feedforward programmes \n197\testablished before any movement begins (see 1.8 and 1.12). True plyometric training usually involves ballistic \n198\trather than cocontraction processes, a concept discussed earlier (see 1.8).\n199\tPlyometrics as a Discrete Training System\n200\tA thorough discussion of what is meant by the term plyometrics is essential, bccause one must distinguish clearly \n201\tbetween plyometric actions, which occur as part of many \n202\trunning, jumping, hurdling, striking and other \n203\trebounding movements in sport, and plyometric training, which applies plyometric actions as a distinct training \n204\tmodality according to a definite methodology.\n205\tThe fairly recent adoption of plyometrics by Western coaches as a so-called 'Russian training secret’ has \n206\tcreated an unwarranted mystique about a method that has been used extensively in Russia since its scientific \n207\tformalisation in the early 1960s as a discrete training system by Verkhoshansky. In recognising that plyometric \n208\tactions are widespread in most sport, Verkhoshansky has always consistently favoured the use of the term 'shock \n209\tmethod' instead of'plyometrics' to distinguish between naturally occurring plyometric actions in sport and the \n210\tformal discipline he devised as a discrete training system to develop speed-strength in particular. This is why the \n211\tterm powermetrics has been suggested elsewhere in this text to refer to plyometric training, as opposed to \n212\tplyometric actions which occur quite naturally in many natural ballistic movements. The earliest published use of \n213\tthe word plyometrics seems to have been in a Soviet publication (Zanon, 1966).\n214\tPopular adoption of the term 'plyometrics' in the place of'shock method' has produced this confusion, just as \n215\tpopular use of the term 'aerobics' has caused widespread confusion between aerobic (cardiovascular) conditioning \n216\tand acrobics as a form of exercise to music. Consequently, it is probably better to refer to plyometric action as \n217\tstretch-shortening action, as has been done in much of the scientific literature, and to redefine 'plyometrics' as a \n218\tspecific training system in its own right, or, powermetrics.\n219\tPossibly the easiest way of showing that the shock method can indeed be regarded as a separate, goal-directed \n220\ttraining system is to examine the concept of resistance training. Resistance to movement is encountered in all \n221\tsport, so the critics of plyometrics as a definite training method should then agree that it is equally logical to \n222\tconclude that resistance training must not be regarded as a distinct training system. On this basis one might also \n223\tconclude that distance running or cycling are resistance training methods, because the athlete certainly experiences \n224\tresistance and produces high levels of muscular tension in these sports.\n225\tOne might extend this argument further and conclude that all human movement is really resistance training. \n226\tAfter all, it is somewhat artificial to refer to weight training as resistance training and to ignore other sports that \n227\talso involve work against significant resistance, simply because the loads superficially appear to be heavier in \n228\tweight training. Basic biomechanical analysis of the forces and tensions involved show clcarly that the high levels \n229\tof resistance and muscle tension involved in sports such as gymnastics, swimming, rowing and wrestling easily \n230\tjustify any objections to regarding resistance training as a separate training system.\n231\tJust as resistance training has adopted means, methods and apparatus from other sports and physical \n232\tactivities to create a discrete training discipline, so has plyometric training or powermetrics (as distinct from \n233\tplyometric action) done the same to create its own methodology.\n234\t268\n235\t\n236\t\n237\t######## PDF 280 / printed 269\n238\tSUPERTRAINING\n239\tPlyometric Training and Safety\n240\tPiyomctric training (powermetrics) is not without its vociferous opponents, all of whom believe that high impact \n241\tloading of the joints in jumping or other impulsive activities is harmful to the joints and unproven in enhancing \n242\texplosive performance. As yet, the opinion that plyometric drills on their own are dangerous and useless has not \n243\tbeen proved experimentally or clinically, especially since it is very difficult to design an experiment which isolates \n244\tpiyomctric effects from the accompanying effects of other activities associated with a given sport and which \n245\tincludes control groups who are exposed to comparable overall intensity, duration and complexity of loading. \n246\tHiusfar, the dangers of plyometrics are inferred from the magnitude of the impulsive peak forces which have been \n247\tmeasured via force plate research during jumping activities, in particular. The opponents of plyomctrics who use \n248\tthis research or theoretical calculations of force from Newton’s Second Law to proclaim an unqualified \n249\tcondemnation of all piyomctric training (powermetrics) or any other types of ballistic training, for that matter, \n250\tseem to overlook the obvious fact that running, jumping and other ballistic activities are an integral part o f most \n251\tsports. In other words, they are implying that these activities in the context of normal sport are perfectly safe, \n252\tbut in the context of special plyometric drills are dangerous.\n253\tThey also arc implementing the unproved hypothesis that impulsive loading is far more dangerous for the \n254\tjoints than any other forms of less stressful loading. Moreover, they seem to be assuming that the joints do not \n255\tfollow the principle o f Specific Adaptation to Imposed Demands (SAID) and that they can do little else than \n256\tdeteriorate in response to impulsive and ballistic loading.\n257\tIn this regard it is relevant to point out that joints subjected to heavy impact are relatively free from \n258\tosteoarthritis in old age and that those subjected to much lower loading experience a greater incidence of \n259\tosteoarthritis and cartilage fibrillation (Bullough et al, 1973; Kempson et al, 1975; Seedhom & Swann, 1985; \n260\tSeedhom & Wright, 1988; Seedhom et al, 1977). \n261\tSiff s former colleague, Dr Mark Swanepoel, at the University \n262\tof the Witwatersrand in South Africa, pointed out that, as one progresses up the lower extremity from the ankle, \n263\tto the knee, the hip and finally to the lumbar spine, so the extent of fibrillation increases at any given age.\n264\tIt appears that the cartilages of joints subjected to regular impulsive loading with relatively high contact \n265\tstresses is mechanically much stiffer and better adapted to withstand the exceptional loading of running and \n266\tjumping than the softer cartilage associated with low loading. Thus, joint cartilage subjected to regular repetitive \n267\tloading remains healthy and copes very well with impulsive loads, whereas cartilage that is heavily loaded \n268\tinfrequently softens due to decrease in proteoglycan production, the collagen network loses its cohesion and the \n269\tcartilage deteriorates (Swanepoel, 1998).\n270\tThis discussion does not dismiss the risks posed by inappropriate or excessive use of plyometric training \n271\tlpowermetrics), but it stresses that it is not the inherent nature of plyometrics which may produce injury, but the \n272\tmanner in which it is used, as is the case with all forms of training. In the case of plyometrics, the zealous way in \n273\twhich this so-called Russian training secret has been modified, extended and implemented in the West certainly \n274\tdoes warrant a great deal of the criticism that has been levelled at it. Virtually every Western book or article on \n275\tthe subject presents encyclopaedic compilations of drills offered in extended, isolated and highly repetitive forms \n276\twhich often create the impression that quantity is more important than quality. \n277\tComplexity of drills and \n278\tapparatus often seems to replace optimal simplicity, technical correctness and elegance. Many repetitions of \n279\tplyometric drills frequently are prescribed for some sports because of assumptions that this sort of training will \n280\timprove fatigue resistance in repeated actions such as rebounding in basketball, yet research has shown this to be \n281\tuntrue (Nicol ct al, 1997).\n282\tOften, plyometric drills are prescribed without adequate attention being paid to the entire context of training, \n283\tincluding the interaction with other physical activities, loading imposed by other work or play, the psychological \n284\tmodification of reflexes or the use of formal restoration. More often than not, plyometric enthusiasts do not \n285\tconsider the possibility that the athlete's sport alone may offer all or most o f the piyomctric training that is \n286\taccessary and that adding more of this type of loading may be excessive or unwarranted. All exercise has to be \n287\toffered in a way which is concordant with its advantages, disadvantages, scope and limitations - and plyomctrics \n288\tare no exception.\n289\tThus, any lack of safety in plyometric training has more to do with inappropriate and ineffective prescription \n290\tthan this mode of exercise itself, with overtraining being a major contributory factor (see 8.8). In this regard, \n291\tovertraining comprises two distinct components: overload (the imposition of too great a force at any given time) \n292\tand overuse (the imposition of too great a volume of exercise). \n293\tThus, the prescription of an individually \n294\tappropriate volume and intensity (e.g. via choice of drop height) of plyometric exercises according to the principle\n295\t269\n296\t\n297\t\n298\t######## PDF 281 / printed 270\n299\tSUPERTRAINING\n300\tof gradual progressive overload integrated periodically into an overall training programme with adcqutil \n301\trestoration regimes need pose no greater risks than the naturally occurring plyometric actions found in running « \n302\tjumping. Finally, in designing a training programme, it might be preferable to avoid use of the popular tenu \n303\tplyometric drills, because drills tend to be associated with militarism and authoritarianism rather than wi&l \n304\tindividual flow, sensitivity, flair and nuances of personal interpretation. \n305\tI\n306\tThe Fundamental Theory of Plyometrics\n307\tPlyometric activity is characterised by the following phases of action between initiation and termination of ihel \n308\tsequence of events (Fig 5.5):\n309\t1. An initial momentum phase during which the body or part of the body is moving because of kinetic energy] \n310\t(KE) it has accumulated from a preceding action.\n311\t2. An electromechanical delay phase which occurs when some event such as contact with a surface prevents il \n312\tlimb from moving further and provokes the muscles to contract. This delay refers to the time elapsing] \n313\tbetween the onset of the action potential in the motor nerves and the onset of the muscle contraction. Some \n314\tworkers define this phase to include the lengthening of the SEC (Series Elastic Component) of the muscic \n315\tcomplex, but the name electromechanical was coined to mean the start of the electrical signal to the start of \n316\tthe mechanical contraction in a muscic, which does not include the passive stretching of connective tissue.\n317\t3. An amortisation phase when the ICE produces a powerful myotatic stretch reflex which leads to eccentric \n318\tmuscle contraction accompanied by explosive isometric contraction (see Fig 3.33) and stretching of the SEC \n319\t(Series Elastic Component, e.g. tendons) o f the muscle complex (sec Figs 1.14, 1.18). \n320\tThe explosive \n321\tisometric phase between the end of the eccentric action and the beginning of the concentric action lasts for a \n322\tperiod known as the coupling time (Fig 5.5), which will be discussed shortly in greater detail.\n323\t4. A rebound phase involving the release of elastic energy from the SEC, together with the involuntary \n324\tconcentric muscle contraction evoked by the myotatic stretch reflex, as well as possible local change in the \n325\tmuscle fibre mechanics. This phase may include the contribution added by voluntary concentric contraction.\n326\t5. A final momentum phase which occurs after the concentric contraction is complete and the body or limb \n327\tconcerned continues to move by means of the kinetic energy imparted by concentric contraction and the \n328\trelease of elastic energy from the SEC.\n329\tFigure 5.5 The different phases o f a plyometric action. EM delay = Electromechanical delay between signal to terminate initial \n330\tmomentum phase and instant when eccentric contraction begins.\n331\tDiscussion of the coupling time is of great importance because it has a fundamental bearing on whether or not any \n332\taction may be accurately classified as classical plyomctrics. Earlier it was stated that classical plyometrics arc \n333\tcharacterised by a delay o f no more than approximately 0.15 second between the eccentric and subsequent \n334\tconcentric contractions, a statement which requires some qualification. For instance, research by Wilson et al \n335\t(1990) examining different delay times in the bench press showed that the benefits of prior stretch may endure for \n336\tas long as 4 seconds, at which stage it is suggested that all stored elastic energy is lost (see Fig 5.6).\n337\t270\n338\t\n339\t\n340\t######## PDF 282 / printed 271\n341\tSUPERTRAINING\n342\tChapman and Caldwell (1985), on the other hand, found that the benefits of prior stretching during forearm \n343\tmovement were dissipated within 0.25 second, a figure which agrees with S iff s analysis of explosive rebound \n344\telbow flexion without additional loading (Fig 5.7). Other work by Wilson et al (1991) examining rebound action \n345\tof the chest/arms concluded that no benefits of prior stretching arc evident after 0.37 second.\n346\tThis research seems to suggest that delays of as long as a sccond or two can still produce significant \n347\taugmentation of the subsequent concentric phase for some activities, but delays as short as 0.2 second are \n348\tsufficient to dissipate the benefits of prior stretch during other activities. Research by Bosco et al (1982a) offers \n349\ta partial solution to this apparent contradiction. They proposed that individuals with a high percentage of FT \n350\tfibres in the leg muscles exhibit a maximum plyometric effect when the eccentric phase is short, movement range \n351\tis small and coupling time is brief. On the other hand, subjects with a high percentage of ST fibres apparently \n352\tproduce their best jumping performance when the cccentric phase is longer, movement range is greater and the \n353\tcoupling time is longer, since the actin-myosin cross-bridging attachment time is of greater duration.\n354\tIt is also tempting to attribute these major differences in coupling times to the existence of specific maximum \n355\tdelays for each joint action. While this probably is true for different simple and complex joint actions, it is also \n356\timportant to note that the human body exhibits many different reflexes, each of which acts under different \n357\tconditions and at different rates (see 3.5.3).\n358\tIn particular, there are tonic (static) and phasic (dynamic) stretch reflexes and very rapid receptors such as \n359\tpacinian corpuscles in joint capsules that detect the rates of movement and allow the nervous system to predict \n360\twhere the extremities will be at any precise moment, thereby facilitating anticipatory modifications in limb \n361\tposition to ensure effective control and stability (Guyton, 1984). Loss of this predictive function apparently \n362\tmakes it virtually impossible for one to run, jump, throw or catch. Other receptors such as the Ruffini endings\n363\t271\n364\t\n365\t\n366\t######## PDF 283 / printed 272\n367\tSUPERTRAINING\n368\tand receptors in the ligaments like the Golgi tendon organs are strongly stimulated when a joint is suddenly moved \n369\tand after a slight initial adaptation, they transmit a steady response.\n370\tIn addition, weightlifters and sometimes bodybuilders use the so-called pre-stretch principle to produce a \n371\tmore powerful concentric muscle contraction to enable them to lift heavier loads. In doing so, they begin a \n372\tmovement from a starting position which imposes an intense stretch on the relevant muscles, hold it for a couple \n373\tof seconds and then thrust as strongly as possible from that position. It would seem that this longer delay would \n374\timplicate the more tonic type of reflex with a characteristically greater coupling time. The action could certainly \n375\tnot be called plyometric, despite the fact that prior stretch had contributed to the subsequent concentric action. \n376\tConversely, phasic reflex activity would more likely be implicated in the explosive movements which typify \n377\tclassical plyometrics and the type of activity described graphically in Figure 5.7.\n378\tThis explanation also serves to further distinguish between piyomctric action and piyomctric training, an issue \n379\tdiscussed earlier in this section. One cannot simply distinguish between plyometric and non-plyomctric solely on \n380\tthe basis of coupling times, otherwise one would have to classify jogging or even brisk walking as classical \n381\tplyometrics, because the time taken for the ground reaction force to reach a maximum can be less than 0.15 \n382\tsecond. One also has to take the force-time pattern and the rate of force development (RFD) into account (see Fig \n383\t2.13).\n384\tOn this scicntific basis, the argument as to whether a given action is classically plyometric or not becomes \n385\tcomplex and academic, with no real benefit to the prescription of plyometric training. It is better to recognise the \n386\texistence of different types of plyometric training {powermetrics). At the outset, a distinction should be made \n387\tbetween maximal plyometrics training and sub-maximal plyometric training. In doing so, it is valuable to apply a \n388\tpowermetrics intensity scale similar to that used in weightlifting, where exercises arc ranked in terms of \n389\tpercentages of one’s 1 RM.\n390\tThe concept of 1 RMs is meaningless in plyometric training, so one must rely on estimates of muscle tension \n391\tproduced by a given drill or on estimates of the impulse (see 5.1) produced during the contact phase of body with \n392\tthe ground or projectile. Impulse is equivalent to the change of momentum (m.AV) during the amortisation phase, \n393\tso that its magnitude for a falling body depends on the height from which the body drops. Thus, the momentum \n394\tjust before contact (estimated from height of the drop jump or distance fallen by the object) may serve as a \n395\tmeasure o f intensity. At one end o f the scale lies maximal plyometrics (the equivalent of the emotionally \n396\tdemanding competitive maximum, CFmax) and at the other end lies preparatory non-impact plyometrics (see Fig \n397\t5.8). Maximal, submaximal and non-plyometrics are depicted in the same box in this diagram as a reminder that \n398\tthere is really a continuum of intensities, rather than an abrupt difference between each type of plyometric \n399\ttraining.\n400\tMaximal plyometrics essentially are low-repetition activities where the intensity of the depth jump or \n401\trebound exercise is such that maximal or near-maximal rebound tension is produced in the relevant muscles. Just \n402\tlike maximal strength training with weights, these powerful impulses are not meant to be imposed on the \n403\tmusculature every workout, nor are multiple repetitions even possible or advisable. Moreover, a rest interval of \n404\t2-4 minutes is recommended between successive repetitions and as much as 10-12 minutes between sets.\n405\tSub-maximal plyometrics involve mechanical impulses which do not produce maximal muscular tension, \n406\talthough they are still performed with a minimally long contact phase with the floor or projected object. For \n407\texample, lower box heights are used for depth jumps and the athlete does not strive to reach maximal rebound \n408\theight. Rapid double-footed bouncing or low skipping on the spot are other typical sub-maximal exercises.\n409\tTwo broad classes of plyometric training may be recognised: impact plyometrics and non-impact plyometrics \n410\t(Fig 5.8). During impact plyometrics the rebound is stimulated by contact with a surface or object, whereas the \n411\trecoil in non-impact plyometrics is mediated by explosive eccentric action of the muscles that produce a movement \n412\tnot terminated by contact with a surface. Depth jumps are a typical example of impact plyomctrics, while snap \n413\tkicks or rapidly-retracted blows in boxing or the martial arts exemplify non-impact plyometrics. Depending on \n414\tthe power of the movements, non-impact plyomctrics may also be maximal or submaximal.\n415\tPlyometric training, in turn, involves several distinct categories of activities: classical plyometric exercises, \n416\tsupplementary plyometrics and preparatory drills for plyomctrics (Fig 5.8). Classical plyometric exercises are \n417\teither functional or non-functional, the former referring to activities which arc matched as closely as possible to \n418\tthe specific explosive actions of the particular sport with respect to movement pattern, muscle involvement, \n419\ttiming and direction o f motion. Non-functional plyometrics are exercises intended to offer general training of the \n420\texplosive qualities required by the sport. For example, functional plyometrics in long jump would use forward"}]},"uuid":"ed446f6d-6f4f-486f-ab84-fbefd95a6324","timestamp":"2026-10-03T15:45:05.031Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kristinarash/DEV/Flint/staging/_tmp/ch5b_text.txt","content":"\n\n######## PDF 276 / printed 265\nSUPERTRAINING\n1967). With this method, speed of movement increases with and without loads, and experiments have shown that \nthe general increase in speed can reach 146% of the initial level. Movements should be executed with maximal \neffort and the apparatus should be accelerated as rapidly as possible.\nTo promote muscle recruitment in the active state, exercises with light and heavier weights (up to 40% of \nIRM) should be combined (the variable method) and the load should be lifted with the emphasis on acceleration at \nthe beginning of the movement. Plyometric exercises (see 5.2.4), as well as exercises where isometric tension is \ngenerated quickly using 60-80% of 1 RM, should also be included. The optimal combination o f the volume of \nexercises with light weights and relatively heavy weights should be in a ratio of 5:1. Regarding sequencing, it has \nbeen found that the alternation of exercises is most effective for the ranked athlete.\nTo develop speed-strength in acyclic movements, plyometric or throwing exercises should be selected on the \nbasis of their relevance to the sports activity. For example, to develop strength for the waterpolo throw, better \nresults are obtained by throwing a medicine ball of 2 kg weight rather than one of 4 kg, the increases in throwing \ndistance being 13.6% and 8.9%, respectively. \nMoreover, throwing a 4 kg ball is detrimental to technique \n(Rogener, 1961).\nTraining with a light (57 grams) and a heavy (184 gm) baseball for throwing ability results in improvements \nwith both of them, where the mass of a regulation ball is about 148 gm. However, the transfer of specific fitness \nis not uniform: throwing the light ball improves precision for throwing the heavier ball, but the reverse effect does \nnot occur (Egstrom et al, 1960). The optimal weight for javelin training which does not disrupt technique is 3 kg \n(Matveyev, 1967).\nThe progressive development o f speed-strength is the result of combining means for exploiting the after- \nejfect phenomenon of preceding work to increase the effectiveness of subsequent work. In devising training means \nand methods for perfecting sporting performance, modelling is of central importance, where sports modelling \nrefers to the formulation of descriptive models of sporting activities on the basis of biomechanical, kinesiological, \nphysiological and other scientific measures.\nExercise modelling experiments show that the working effect of an explosive movement, as measured by the \nheight to which a load was thrown (Fig 5.4), increases by an average of 38-40% after execution of barbell presses \nfor 3 sets of 3 repetitions with 80% of the 1 RM (with a rest interval of 10 minutes between the pressing and the \nthrowing). Movement time decreases, there is an increase in the length of the working path, the average speed, the \ndriving force and power output (Table 5.3). Thus, the repetition of the same stimulus evokes a more pronounced \nreaction by the body and greater development of strength and speed.\nResearch shows that speed of movement increases significantly by use of the variation method: for example, by \nputting the shot directly after muscular contraction has been produced by putting a lighter object. \nIn one \nexperiment, lighter and heavier shots differing in mass by 250 grams were thrown at different velocities. A \nstatistically significant difference was not found in the mean results of alternately putting standard shots of \ndifferent mass. However, distances close to the mean were obtained with a difference in mass of 250 grams,\n265\n\n\n######## PDF 277 / printed 266\nSUPERTRAINING\nwhereas this closeness to the average was not achieved with a difference of 500 grams (Ivanova, 1964; Vasiliev,\n1975).\nTabic 5.3 Aim movement characteristics for throwing a weight before and after tonic work (Verkhoshansky, 1977).\nArm M ovem ent C haracteristic\nFirst Effort\nSecond Effort\nDifference (%)\nHeight of throw (cm)\n44.0\n61.0\n♦38.8\nMovement time (sec)\n0.266\n0.250\n-6.8\nWorking path (cm)\n62.0\n65.0\n44.8\nAverage speed of movement (m/sec)\n2.330\n2.600\n4-11.7\nAverage driving force (kgf)\n5.550\n7.430\n4-33.8\nPower (kg.m/s)\n1.310\n1.930\n447.3\nThus, the transference of throwing speeds from a lighter to a heavier mass (i.e. the normal mass) apparently is \npossible only by alternating the throwing of shots of different mass. The effectiveness of the variable method of \ndeveloping speed of movement was confirmed in the training of hockey players who successively hit a normal and \na heavier puck. The optimal mass o f the heavier puck was found to be between 0.6-0.8 kg. However, it is \nnecessary to select the mass for each player individually, based on the athlete's ability to hit the heavier puck effi­\nciently (Savin, 1974).\nIt should be pointed out that certain Eastern European and Chinese athletes train with heavier implements in \ntheir own sports and maintain that this method contributes to their impressive results. For instance, some table \ntennis competitors will eventually train with as much as 2kg bats, which is considerably heavier than typical bats \nof about 100 grams mass. Their coaches stress that this type of training is done only with carefully balanced bats \nby elite athletes about once a week before the competition phase, with less advanced competitors gradually \nincreasing the weight of their bats over a prolonged period. \nThis method should not be emulated by less \nexperienced coaches, as the untutored use of this extraordinary approach can lead to overload injuries and altered \nneural control patterns.\nAttempts must be made to resolve the conflict between the magnitude of the load and speed of movement in \ndeveloping speed-strength. In this instance, this may be achieved if strength is used to oppose not the weight \n(gravitational force), but its inertia (acceleration force). Unfortunately this method is very seldom used in practice \nand its potential for enhancing strength is largely unexplored (see Fig 4.4), so that it is difficult to give specific \nrecommendations for its application.\nThe next issue is the rest interval between sets of exercises. This interval is determined by level of fitness, \nthe level of special endurance to repeatedly produce maximal tension and the degree of strength exerted. \nExperiments show that, with an optimal pause of 0.5-1 minute, speed-strength output can be maintained at a high \nlevel for a fairly long period without serious deterioration. The possible gradual decrease of speed-strength with \nexhausting, monotonous work can be largely eliminated by creating a favourable emotional state.\nSpced-strength as displayed in rapid cyclical movements is characterised by repetitive contractions \nseparated by relaxation phases. Depending on the special exercise, the effect of speed-strcngth can be determined \nby the ability of the neuromuscular apparatus to maintain the strength output for a long period at a specific work \nrate.\nThus, the movement tempo and the duration of work are of great significance in the development of speed- \nstrength in speed-cyclic exercises. The resistance and the movement tempo are inversely proportional to one \nanother. In other words, an increase in the resistance decreases the movement tempo and promotes the rapid \nonset of fatigue. Therefore, the optimal combination of resistance and tempo should be selected in each specific \ncase, based on the kinesiological structure of the given exercise. It should be remembered that speed of movement \ndecreases over a long period of training done at a slow tempo and increases through training at the optimal speed \n(Korobkov, 1953; Monogarov, 1958).\nThe ability to correctly execute the full movement cycle, including the appropriate phases of tension and \nmuscular relaxation, should serve as a criterion. The movement tempo should gradually approach the tempo of the \nspecial exercise and even exceed it, while the working time should lengthen (Diachkov, 1961).\nAll that has been stated concerning the development o f speed-strength is related primarily to exercising \nfunctionally the relevant muscle groups by means of the special exercise. However, good results are achieved by \nmaking the special exercise more demanding. Thus, the use of water resistance in rowing or very small loads on\n266\n\n\n######## PDF 278 / printed 267\nSUPERTRAINING\nthe limbs of track-and-field athletes and gymnasts can enhance speed-strength under conditions that are very close \nto those of the special exercise.\nIn certain cases, power can be increased without using additional loads. For example, with jumps from one leg \nto the other, the push-off displays values of power which are greater than in running. Therefore, these jumps are \nexcellent for the special strength training of sprinters. It is only necessary to execute them correctly by not \naccentuating the push-off of the body (which does not happen in sprinting), but by active gathering-in of the \nplanted leg (i.e. via hip flexion). These jumps should be executed repetitively over distances of 50-100 meters as \nfast as possible. The addition of small cuffs weighing from 100-150 grams on each thigh can makes such exercises \nmore effective in experienced athletes (based on Verkhoshansky’s experience with top Russian sprinters, such as \nZubov).\nThus, to develop speed-strength one should use exercises, primarily with small resistance (20% of 1 RM) and, \nfor acyclic activities of brief duration, a combination of these exercises with weights up to 40% of 1 RM in a ratio \nof 5 to 1. The work regime should correspond to the special exercise (cyclic or acyclic) and take into account the \ninitial conditions from which force is developed (i.e. with the muscles relaxed, in a state of preliminary tension or \nstretched).\nPerfecting the methods of developing speed-strength is a result of the search for a specific combination of \nmeans that exploit:\n• the positive after-effect of preceding work on the subsequent activity\n• the use of exercises in which muscular force opposes the inertia of the load and not its weight.\nFatigue must be avoided when one is trying to develop speed-strength for acyclic movements. However, fatigue is \na necessary component of training for spced-strength in cyclic movements which require speed-endurance. Precise \nimplementation of these findings is possible only under specific training conditions so, for the present, one has to \nrely on empirical methods.\n5.2.4 Developm ent of Explosive Strength and R eactive Ability\nThe development of effective methods to develop explosive strength and reactive ability logically begins with an \nanalysis of the speed-strength methods traditionally used for this purpose. For instance, athletes often attempt \nto develop explosive strength in the legs by using heavy barbell squats. In this case the musclcs work very slowly \n(quasi-isometrically) with a relatively constant tension produced by the load. \nConsequently, the muscles \nprimarily develop isometric strength, but this does not mean that it is impossible for them to execute fast dynamic \ncontractions. It should be added that increase in the weight of the barbell, which is frequently considered a basic \nindicator of special strength fitness, places a large and generally unnecessary load on the spine.\nHowever, to solve the task of speed-strength preparation, athletes use smaller loads. For example, doing \nsquat thrusts with a 60kg barbell on the shoulders produces a large dynamic maximum force. Therefore, exercises \nwith heavy weights tend to increase the strength potential of the muscles, while fast exercises with light weights \nimprove speed. Nevertheless, these means are not the only way of developing explosive strength.\nExplosive strength is a motor quality requiring specific movements and training means. The above- \nmentioned means of strength training do not adequately enhance specific components of explosive movements \nsuch as the rapid excitation of muscles and the rapid changing from eccentric to concentric work.\nThese and allied skills require a specific training regime which is impossible to imitate with only one \nresistance exercise. Indeed, stimulation of muscular activity with slow resistance movements, and lifting a barbell \nin preparation for squatting or jumping with it, removes the possibility of controlling the mechanisms which are \ncrucial to the rapid switching of muscles to the active state. At the same time, a decrease in the resistance \ndiminishes the dynamic effort required and creates a vicious cycle from which there is no apparent escape.\nThus, if the athlete successfully develops a high level of explosive strength, then it may be attributed to \ncertain means in his training. Consequently, the problem amounts to singling out those means and organising them \nso as to systematise the special strength training.\nThe Plyometric Method\nProlonged research in the direction discussed above led to the development of the so-called 'shock' (plyometric) \nmethod of developing explosive strength and reactive ability (see 1.5). Basically it consists of stimulating the \nmuscles by means of a sudden stretch preceding any voluntary effort (see 4.2.3). Kinetic energy and not heavy\n2 6 7\n\n\n######## PDF 279 / printed 268\nSUPERTRAINING\nweights should be used for this, where the kinetic energy may be accumulated by means o f the body or loads \ndropping from a certain height (see 4.2.3). Depth jumps and medicine ball rebounding are two of the exercise \nregimes commonly used in plyometrics.\nThe increase in popularity of plyometrics in the West deems it necessary that the concept be more rigorously \ndefined. Plyometrics or the 'shock method' means precisely that - a method of mechanical shock stimulation to \nforce the muscle to produce as much tension as possible. This method is characterised by impulsive action of \nminimal duration between the end of the eccentric braking phase and initiation o f the concentric acceleration \nphase. It relies on the production of a very brief explosive-isometric and eccentric-isometric phase which pre­\ncedes the release of the elastic energy stored in the tendons and other components of the scries elastic component \nof the muscle complex during the eccentric deceleration phase (see 1.9, 3.1 and Fig 4.11). If the transition phase \n(or, coupling phase) is prolonged by more than about 0.15 second, the action may be considered to constitute \nordinary jumping and not classical training plyometrics. A useful visualisation is to imagine that the surface being \ntouchcd by the hands or the feet during the plyomctric contact phase is red hot, so that any prolonged contact \nwould be dangerous.\nIt is important to note that the activity is not accurately plyometric if the athlete relies upon ongoing \nfeedback processes to control the isometric and concentric actions instead of upon feedforward programmes \nestablished before any movement begins (see 1.8 and 1.12). True plyometric training usually involves ballistic \nrather than cocontraction processes, a concept discussed earlier (see 1.8).\nPlyometrics as a Discrete Training System\nA thorough discussion of what is meant by the term plyometrics is essential, bccause one must distinguish clearly \nbetween plyometric actions, which occur as part of many \nrunning, jumping, hurdling, striking and other \nrebounding movements in sport, and plyometric training, which applies plyometric actions as a distinct training \nmodality according to a definite methodology.\nThe fairly recent adoption of plyometrics by Western coaches as a so-called 'Russian training secret’ has \ncreated an unwarranted mystique about a method that has been used extensively in Russia since its scientific \nformalisation in the early 1960s as a discrete training system by Verkhoshansky. In recognising that plyometric \nactions are widespread in most sport, Verkhoshansky has always consistently favoured the use of the term 'shock \nmethod' instead of'plyometrics' to distinguish between naturally occurring plyometric actions in sport and the \nformal discipline he devised as a discrete training system to develop speed-strength in particular. This is why the \nterm powermetrics has been suggested elsewhere in this text to refer to plyometric training, as opposed to \nplyometric actions which occur quite naturally in many natural ballistic movements. The earliest published use of \nthe word plyometrics seems to have been in a Soviet publication (Zanon, 1966).\nPopular adoption of the term 'plyometrics' in the place of'shock method' has produced this confusion, just as \npopular use of the term 'aerobics' has caused widespread confusion between aerobic (cardiovascular) conditioning \nand acrobics as a form of exercise to music. Consequently, it is probably better to refer to plyometric action as \nstretch-shortening action, as has been done in much of the scientific literature, and to redefine 'plyometrics' as a \nspecific training system in its own right, or, powermetrics.\nPossibly the easiest way of showing that the shock method can indeed be regarded as a separate, goal-directed \ntraining system is to examine the concept of resistance training. Resistance to movement is encountered in all \nsport, so the critics of plyometrics as a definite training method should then agree that it is equally logical to \nconclude that resistance training must not be regarded as a distinct training system. On this basis one might also \nconclude that distance running or cycling are resistance training methods, because the athlete certainly experiences \nresistance and produces high levels of muscular tension in these sports.\nOne might extend this argument further and conclude that all human movement is really resistance training. \nAfter all, it is somewhat artificial to refer to weight training as resistance training and to ignore other sports that \nalso involve work against significant resistance, simply because the loads superficially appear to be heavier in \nweight training. Basic biomechanical analysis of the forces and tensions involved show clcarly that the high levels \nof resistance and muscle tension involved in sports such as gymnastics, swimming, rowing and wrestling easily \njustify any objections to regarding resistance training as a separate training system.\nJust as resistance training has adopted means, methods and apparatus from other sports and physical \nactivities to create a discrete training discipline, so has plyometric training or powermetrics (as distinct from \nplyometric action) done the same to create its own methodology.\n268\n\n\n######## PDF 280 / printed 269\nSUPERTRAINING\nPlyometric Training and Safety\nPiyomctric training (powermetrics) is not without its vociferous opponents, all of whom believe that high impact \nloading of the joints in jumping or other impulsive activities is harmful to the joints and unproven in enhancing \nexplosive performance. As yet, the opinion that plyometric drills on their own are dangerous and useless has not \nbeen proved experimentally or clinically, especially since it is very difficult to design an experiment which isolates \npiyomctric effects from the accompanying effects of other activities associated with a given sport and which \nincludes control groups who are exposed to comparable overall intensity, duration and complexity of loading. \nHiusfar, the dangers of plyometrics are inferred from the magnitude of the impulsive peak forces which have been \nmeasured via force plate research during jumping activities, in particular. The opponents of plyomctrics who use \nthis research or theoretical calculations of force from Newton’s Second Law to proclaim an unqualified \ncondemnation of all piyomctric training (powermetrics) or any other types of ballistic training, for that matter, \nseem to overlook the obvious fact that running, jumping and other ballistic activities are an integral part o f most \nsports. In other words, they are implying that these activities in the context of normal sport are perfectly safe, \nbut in the context of special plyometric drills are dangerous.\nThey also arc implementing the unproved hypothesis that impulsive loading is far more dangerous for the \njoints than any other forms of less stressful loading. Moreover, they seem to be assuming that the joints do not \nfollow the principle o f Specific Adaptation to Imposed Demands (SAID) and that they can do little else than \ndeteriorate in response to impulsive and ballistic loading.\nIn this regard it is relevant to point out that joints subjected to heavy impact are relatively free from \nosteoarthritis in old age and that those subjected to much lower loading experience a greater incidence of \nosteoarthritis and cartilage fibrillation (Bullough et al, 1973; Kempson et al, 1975; Seedhom & Swann, 1985; \nSeedhom & Wright, 1988; Seedhom et al, 1977). \nSiff s former colleague, Dr Mark Swanepoel, at the University \nof the Witwatersrand in South Africa, pointed out that, as one progresses up the lower extremity from the ankle, \nto the knee, the hip and finally to the lumbar spine, so the extent of fibrillation increases at any given age.\nIt appears that the cartilages of joints subjected to regular impulsive loading with relatively high contact \nstresses is mechanically much stiffer and better adapted to withstand the exceptional loading of running and \njumping than the softer cartilage associated with low loading. Thus, joint cartilage subjected to regular repetitive \nloading remains healthy and copes very well with impulsive loads, whereas cartilage that is heavily loaded \ninfrequently softens due to decrease in proteoglycan production, the collagen network loses its cohesion and the \ncartilage deteriorates (Swanepoel, 1998).\nThis discussion does not dismiss the risks posed by inappropriate or excessive use of plyometric training \nlpowermetrics), but it stresses that it is not the inherent nature of plyometrics which may produce injury, but the \nmanner in which it is used, as is the case with all forms of training. In the case of plyometrics, the zealous way in \nwhich this so-called Russian training secret has been modified, extended and implemented in the West certainly \ndoes warrant a great deal of the criticism that has been levelled at it. Virtually every Western book or article on \nthe subject presents encyclopaedic compilations of drills offered in extended, isolated and highly repetitive forms \nwhich often create the impression that quantity is more important than quality. \nComplexity of drills and \napparatus often seems to replace optimal simplicity, technical correctness and elegance. Many repetitions of \nplyometric drills frequently are prescribed for some sports because of assumptions that this sort of training will \nimprove fatigue resistance in repeated actions such as rebounding in basketball, yet research has shown this to be \nuntrue (Nicol ct al, 1997).\nOften, plyometric drills are prescribed without adequate attention being paid to the entire context of training, \nincluding the interaction with other physical activities, loading imposed by other work or play, the psychological \nmodification of reflexes or the use of formal restoration. More often than not, plyometric enthusiasts do not \nconsider the possibility that the athlete's sport alone may offer all or most o f the piyomctric training that is \naccessary and that adding more of this type of loading may be excessive or unwarranted. All exercise has to be \noffered in a way which is concordant with its advantages, disadvantages, scope and limitations - and plyomctrics \nare no exception.\nThus, any lack of safety in plyometric training has more to do with inappropriate and ineffective prescription \nthan this mode of exercise itself, with overtraining being a major contributory factor (see 8.8). In this regard, \novertraining comprises two distinct components: overload (the imposition of too great a force at any given time) \nand overuse (the imposition of too great a volume of exercise). \nThus, the prescription of an individually \nappropriate volume and intensity (e.g. via choice of drop height) of plyometric exercises according to the principle\n269\n\n\n######## PDF 281 / printed 270\nSUPERTRAINING\nof gradual progressive overload integrated periodically into an overall training programme with adcqutil \nrestoration regimes need pose no greater risks than the naturally occurring plyometric actions found in running « \njumping. Finally, in designing a training programme, it might be preferable to avoid use of the popular tenu \nplyometric drills, because drills tend to be associated with militarism and authoritarianism rather than wi&l \nindividual flow, sensitivity, flair and nuances of personal interpretation. \nI\nThe Fundamental Theory of Plyometrics\nPlyometric activity is characterised by the following phases of action between initiation and termination of ihel \nsequence of events (Fig 5.5):\n1. An initial momentum phase during which the body or part of the body is moving because of kinetic energy] \n(KE) it has accumulated from a preceding action.\n2. An electromechanical delay phase which occurs when some event such as contact with a surface prevents il \nlimb from moving further and provokes the muscles to contract. This delay refers to the time elapsing] \nbetween the onset of the action potential in the motor nerves and the onset of the muscle contraction. Some \nworkers define this phase to include the lengthening of the SEC (Series Elastic Component) of the muscic \ncomplex, but the name electromechanical was coined to mean the start of the electrical signal to the start of \nthe mechanical contraction in a muscic, which does not include the passive stretching of connective tissue.\n3. An amortisation phase when the ICE produces a powerful myotatic stretch reflex which leads to eccentric \nmuscle contraction accompanied by explosive isometric contraction (see Fig 3.33) and stretching of the SEC \n(Series Elastic Component, e.g. tendons) o f the muscle complex (sec Figs 1.14, 1.18). \nThe explosive \nisometric phase between the end of the eccentric action and the beginning of the concentric action lasts for a \nperiod known as the coupling time (Fig 5.5), which will be discussed shortly in greater detail.\n4. A rebound phase involving the release of elastic energy from the SEC, together with the involuntary \nconcentric muscle contraction evoked by the myotatic stretch reflex, as well as possible local change in the \nmuscle fibre mechanics. This phase may include the contribution added by voluntary concentric contraction.\n5. A final momentum phase which occurs after the concentric contraction is complete and the body or limb \nconcerned continues to move by means of the kinetic energy imparted by concentric contraction and the \nrelease of elastic energy from the SEC.\nFigure 5.5 The different phases o f a plyometric action. EM delay = Electromechanical delay between signal to terminate initial \nmomentum phase and instant when eccentric contraction begins.\nDiscussion of the coupling time is of great importance because it has a fundamental bearing on whether or not any \naction may be accurately classified as classical plyomctrics. Earlier it was stated that classical plyometrics arc \ncharacterised by a delay o f no more than approximately 0.15 second between the eccentric and subsequent \nconcentric contractions, a statement which requires some qualification. For instance, research by Wilson et al \n(1990) examining different delay times in the bench press showed that the benefits of prior stretch may endure for \nas long as 4 seconds, at which stage it is suggested that all stored elastic energy is lost (see Fig 5.6).\n270\n\n\n######## PDF 282 / printed 271\nSUPERTRAINING\nChapman and Caldwell (1985), on the other hand, found that the benefits of prior stretching during forearm \nmovement were dissipated within 0.25 second, a figure which agrees with S iff s analysis of explosive rebound \nelbow flexion without additional loading (Fig 5.7). Other work by Wilson et al (1991) examining rebound action \nof the chest/arms concluded that no benefits of prior stretching arc evident after 0.37 second.\nThis research seems to suggest that delays of as long as a sccond or two can still produce significant \naugmentation of the subsequent concentric phase for some activities, but delays as short as 0.2 second are \nsufficient to dissipate the benefits of prior stretch during other activities. Research by Bosco et al (1982a) offers \na partial solution to this apparent contradiction. They proposed that individuals with a high percentage of FT \nfibres in the leg muscles exhibit a maximum plyometric effect when the eccentric phase is short, movement range \nis small and coupling time is brief. On the other hand, subjects with a high percentage of ST fibres apparently \nproduce their best jumping performance when the cccentric phase is longer, movement range is greater and the \ncoupling time is longer, since the actin-myosin cross-bridging attachment time is of greater duration.\nIt is also tempting to attribute these major differences in coupling times to the existence of specific maximum \ndelays for each joint action. While this probably is true for different simple and complex joint actions, it is also \nimportant to note that the human body exhibits many different reflexes, each of which acts under different \nconditions and at different rates (see 3.5.3).\nIn particular, there are tonic (static) and phasic (dynamic) stretch reflexes and very rapid receptors such as \npacinian corpuscles in joint capsules that detect the rates of movement and allow the nervous system to predict \nwhere the extremities will be at any precise moment, thereby facilitating anticipatory modifications in limb \nposition to ensure effective control and stability (Guyton, 1984). Loss of this predictive function apparently \nmakes it virtually impossible for one to run, jump, throw or catch. Other receptors such as the Ruffini endings\n271\n\n\n######## PDF 283 / printed 272\nSUPERTRAINING\nand receptors in the ligaments like the Golgi tendon organs are strongly stimulated when a joint is suddenly moved \nand after a slight initial adaptation, they transmit a steady response.\nIn addition, weightlifters and sometimes bodybuilders use the so-called pre-stretch principle to produce a \nmore powerful concentric muscle contraction to enable them to lift heavier loads. In doing so, they begin a \nmovement from a starting position which imposes an intense stretch on the relevant muscles, hold it for a couple \nof seconds and then thrust as strongly as possible from that position. It would seem that this longer delay would \nimplicate the more tonic type of reflex with a characteristically greater coupling time. The action could certainly \nnot be called plyometric, despite the fact that prior stretch had contributed to the subsequent concentric action. \nConversely, phasic reflex activity would more likely be implicated in the explosive movements which typify \nclassical plyometrics and the type of activity described graphically in Figure 5.7.\nThis explanation also serves to further distinguish between piyomctric action and piyomctric training, an issue \ndiscussed earlier in this section. One cannot simply distinguish between plyometric and non-plyomctric solely on \nthe basis of coupling times, otherwise one would have to classify jogging or even brisk walking as classical \nplyometrics, because the time taken for the ground reaction force to reach a maximum can be less than 0.15 \nsecond. One also has to take the force-time pattern and the rate of force development (RFD) into account (see Fig \n2.13).\nOn this scicntific basis, the argument as to whether a given action is classically plyometric or not becomes \ncomplex and academic, with no real benefit to the prescription of plyometric training. It is better to recognise the \nexistence of different types of plyometric training {powermetrics). At the outset, a distinction should be made \nbetween maximal plyometrics training and sub-maximal plyometric training. In doing so, it is valuable to apply a \npowermetrics intensity scale similar to that used in weightlifting, where exercises arc ranked in terms of \npercentages of one’s 1 RM.\nThe concept of 1 RMs is meaningless in plyometric training, so one must rely on estimates of muscle tension \nproduced by a given drill or on estimates of the impulse (see 5.1) produced during the contact phase of body with \nthe ground or projectile. Impulse is equivalent to the change of momentum (m.AV) during the amortisation phase, \nso that its magnitude for a falling body depends on the height from which the body drops. Thus, the momentum \njust before contact (estimated from height of the drop jump or distance fallen by the object) may serve as a \nmeasure o f intensity. At one end o f the scale lies maximal plyometrics (the equivalent of the emotionally \ndemanding competitive maximum, CFmax) and at the other end lies preparatory non-impact plyometrics (see Fig \n5.8). Maximal, submaximal and non-plyometrics are depicted in the same box in this diagram as a reminder that \nthere is really a continuum of intensities, rather than an abrupt difference between each type of plyometric \ntraining.\nMaximal plyometrics essentially are low-repetition activities where the intensity of the depth jump or \nrebound exercise is such that maximal or near-maximal rebound tension is produced in the relevant muscles. Just \nlike maximal strength training with weights, these powerful impulses are not meant to be imposed on the \nmusculature every workout, nor are multiple repetitions even possible or advisable. Moreover, a rest interval of \n2-4 minutes is recommended between successive repetitions and as much as 10-12 minutes between sets.\nSub-maximal plyometrics involve mechanical impulses which do not produce maximal muscular tension, \nalthough they are still performed with a minimally long contact phase with the floor or projected object. For \nexample, lower box heights are used for depth jumps and the athlete does not strive to reach maximal rebound \nheight. Rapid double-footed bouncing or low skipping on the spot are other typical sub-maximal exercises.\nTwo broad classes of plyometric training may be recognised: impact plyometrics and non-impact plyometrics \n(Fig 5.8). During impact plyometrics the rebound is stimulated by contact with a surface or object, whereas the \nrecoil in non-impact plyometrics is mediated by explosive eccentric action of the muscles that produce a movement \nnot terminated by contact with a surface. Depth jumps are a typical example of impact plyomctrics, while snap \nkicks or rapidly-retracted blows in boxing or the martial arts exemplify non-impact plyometrics. Depending on \nthe power of the movements, non-impact plyomctrics may also be maximal or submaximal.\nPlyometric training, in turn, involves several distinct categories of activities: classical plyometric exercises, \nsupplementary plyometrics and preparatory drills for plyomctrics (Fig 5.8). Classical plyometric exercises are \neither functional or non-functional, the former referring to activities which arc matched as closely as possible to \nthe specific explosive actions of the particular sport with respect to movement pattern, muscle involvement, \ntiming and direction o f motion. Non-functional plyometrics are exercises intended to offer general training of the \nexplosive qualities required by the sport. For example, functional plyometrics in long jump would use forward","numLines":420,"startLine":1,"totalLines":1206}},"sourceToolAssistantUUID":"58e13e37-f8df-4861-8b03-a6627abd93c2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"ed446f6d-6f4f-486f-ab84-fbefd95a6324","isSidechain":true,"agentId":"ac8240d61f5c36dd4","attachment":{"type":"nested_memory","path":"/Users/kristinarash/DEV/Flint/CLAUDE.md","content":{"path":"/Users/kristinarash/DEV/Flint/CLAUDE.md","type":"Project","content":"@AGENTS.md\n","contentDiffersFromDisk":false},"displayPath":"CLAUDE.md"},"type":"attachment","uuid":"9c794274-f72a-4436-9201-1aa7c4663316","timestamp":"2026-10-03T15:45:05.036Z","rendered":[{"content":"<system-reminder>\nContents of /Users/kristinarash/DEV/Flint/CLAUDE.md:\n\n@AGENTS.md\n\n</system-reminder>"}],"renderedRole":"system","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
{"parentUuid":"9c794274-f72a-4436-9201-1aa7c4663316","isSidechain":true,"agentId":"ac8240d61f5c36dd4","attachment":{"type":"nested_memory","path":"/Users/kristinarash/DEV/Flint/AGENTS.md","content":{"path":"/Users/kristinarash/DEV/Flint/AGENTS.md","type":"Project","content":"# AGENTS.md\n\nProject: Flint\n\n## What this is\nFlint is Claude working as Eric's sport-science, performance, S&C and rehab thought\npartner. This repo builds the knowledge base behind that role. It catalogs Eric's\nDrive (his own material, TB's Training Info, Landon Evans, courses, papers), routes the\nhigh-value sources into Zotero and the SecondBrain vault, and writes per-discipline\nsynthesis notes that compare the sources against Eric's own method. It is a side-lane\nproject, outside the prioritization-slate cap. See `README.md` for the approach and\n`docs/PLAN.md` for the checklist.\n\n## Session routine\n- Start: run `git pull`, then read docs/STATUS.md before doing anything else.\n- End: update docs/STATUS.md (done, next, open questions), commit, and `git push`.\n- Never leave uncommitted work at the end of a session.\n\n## Conventions\n- Durable notes and decisions go in docs/, committed. Not in chat, not in cloud project docs.\n- Documents, data exports, and deliverables live on the primary storage drive (Google Drive 00_Primary_Storage_Drive), not in the repo. Files over 95 MB never go in git.\n- `data/` is gitignored except aggregate summaries. Regenerate the file-level manifest with `pwsh scripts/build_manifest.ps1`.\n- Codex workers read staged copies in `staging/`, never the Drive root. DexaProject, athlete snapshots, Catapult and PFF exports are never catalogued.\n- The ingest review gate has two stages.\n  1. Before atomizing, verify the source artifact by an independent route: page order, scanned versus text, transcripts checked against captions.\n  2. Before promoting, Codex reviews the staged entries against the staged sources, with instructions to falsify (`staging/review_<source>_codex.md`). Nothing reaches the vault without a GO or a GO AFTER FIXES that has been applied.\n- Library entries label every voice. The source author's statements are plain. Eric's judgments get \"Eric's review:\". The entry writer's own reasoning gets \"Inference:\". No unlabeled judgments. Every number carries a timestamp or page the reviewer can check, and a claim is only tagged \"confirmed in PDF\" if that PDF is staged. (Learned from the Harries review, 2026-09-26: 25 of 35 files needed fixes, mostly for attribution.)\n- Writing: plain, direct, no em dashes. Documents use the Baylor design system.\n","contentDiffersFromDisk":false,"parent":"/Users/kristinarash/DEV/Flint/CLAUDE.md"},"displayPath":"AGENTS.md"},"type":"attachment","uuid":"193179a4-2519-49c2-9384-f6a17812327d","timestamp":"2026-10-03T15:45:05.036Z","rendered":[{"content":"<system-reminder>\nContents of /Users/kristinarash/DEV/Flint/AGENTS.md:\n\n# AGENTS.md\n\nProject: Flint\n\n## What this is\nFlint is Claude working as Eric's sport-science, performance, S&C and rehab thought\npartner. This repo builds the knowledge base behind that role. It catalogs Eric's\nDrive (his own material, TB's Training Info, Landon Evans, courses, papers), routes the\nhigh-value sources into Zotero and the SecondBrain vault, and writes per-discipline\nsynthesis notes that compare the sources against Eric's own method. It is a side-lane\nproject, outside the prioritization-slate cap. See `README.md` for the approach and\n`docs/PLAN.md` for the checklist.\n\n## Session routine\n- Start: run `git pull`, then read docs/STATUS.md before doing anything else.\n- End: update docs/STATUS.md (done, next, open questions), commit, and `git push`.\n- Never leave uncommitted work at the end of a session.\n\n## Conventions\n- Durable notes and decisions go in docs/, committed. Not in chat, not in cloud project docs.\n- Documents, data exports, and deliverables live on the primary storage drive (Google Drive 00_Primary_Storage_Drive), not in the repo. Files over 95 MB never go in git.\n- `data/` is gitignored except aggregate summaries. Regenerate the file-level manifest with `pwsh scripts/build_manifest.ps1`.\n- Codex workers read staged copies in `staging/`, never the Drive root. DexaProject, athlete snapshots, Catapult and PFF exports are never catalogued.\n- The ingest review gate has two stages.\n  1. Before atomizing, verify the source artifact by an independent route: page order, scanned versus text, transcripts checked against captions.\n  2. Before promoting, Codex reviews the staged entries against the staged sources, with instructions to falsify (`staging/review_<source>_codex.md`). Nothing reaches the vault without a GO or a GO AFTER FIXES that has been applied.\n- Library entries label every voice. The source author's statements are plain. Eric's judgments get \"Eric's review:\". The entry writer's own reasoning gets \"Inference:\". No unlabeled judgments. Every number carries a timestamp or page the reviewer can check, and a claim is only tagged \"confirmed in PDF\" if that PDF is staged. (Learned from the Harries review, 2026-09-26: 25 of 35 files needed fixes, mostly for attribution.)\n- Writing: plain, direct, no em dashes. Documents use the Baylor design system.\n\n</system-reminder>"}],"renderedRole":"system","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Flint","sessionId":"9d08ef48-9f28-44dc-845b-1ca05ec6873c","version":"2.1.288","gitBranch":"supertraining-ch4-3-4"}
