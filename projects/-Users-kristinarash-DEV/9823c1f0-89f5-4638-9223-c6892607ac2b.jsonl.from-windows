{"parentUuid":"bd414f8e-6de1-41d3-b3d6-f4cb2b0a99a2","isSidechain":false,"promptId":"88b6ccb8-7105-4de5-afa1-ccbae8a94e54","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LxXVcMzk2AyVdur3pVG3RD","type":"tool_result","content":"Command running in background with ID: brfxusjl1. Output is being written to: /private/tmp/claude-501/-Users-kristinarash-DEV/9823c1f0-89f5-4638-9223-c6892607ac2b/tasks/brfxusjl1.output. You will be notified when it completes. To check interim output, use Read on that file path.","is_error":false}]},"uuid":"78d3fe68-eb37-4f32-af9c-b0c657d0fefb","timestamp":"2026-09-13T06:13:06.729Z","toolUseResult":{"stdout":"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"backgroundTaskId":"brfxusjl1"},"sourceToolAssistantUUID":"bd414f8e-6de1-41d3-b3d6-f4cb2b0a99a2","session_id":"9823c1f0-89f5-4638-9223-c6892607ac2b","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"9823c1f0-89f5-4638-9223-c6892607ac2b","version":"2.1.270","gitBranch":"main"}
{"parentUuid":"c8a09b7a-31f9-474d-9f2e-bf4b3d169ad0","isSidechain":false,"promptId":"88b6ccb8-7105-4de5-afa1-ccbae8a94e54","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0158cYzgU9eSbAK7Q1N4Zro9","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Check every skill in the canonical repo against the portable frontmatter\n3\tcontract. Exit 0 = all pass, 1 = failures, 2 = empty/missing inventory or\n4\tunavailable evidence (unreadable settings, failed git probe).\n5\tstdlib only (PEP 668 machine). Validates the YAML subset we actually use and\n6\trejects anything outside it, rather than guessing what a loader would do.\"\"\"\n7\timport os, re, sys, glob, json, subprocess\n8\t\n9\tCANON = os.path.expanduser(\"~/.claude/skills\")\n10\t# R8-03: every key the roster actually uses today, measured with\n11\t#   grep '^[a-z-]*:' ~/.claude/skills/*/SKILL.md | sort | uniq -c\n12\t# The contract may not outlaw keys Claude Code honours. `effort` and\n13\t# `user-invocable` are live Claude Code keys; `repository` and `homepage`\n14\t# are package metadata. Genuinely unknown keys are still reported.\n15\tALLOWED = {\"name\", \"description\", \"metadata\", \"argument-hint\", \"allowed-tools\",\n16\t           \"model\", \"disable-model-invocation\", \"license\", \"version\", \"author\",\n17\t           \"effort\", \"user-invocable\", \"repository\", \"homepage\"}\n18\tPOSITIVE = (\"use when\", \"use for\", \"use this skill when\", \"invoke when\")\n19\tNEGATIVE = (\"do not use\", \"don't use\", \"not for\", \"never use\")\n20\t\n21\tclass EvidenceError(Exception):\n22\t    \"\"\"Required evidence could not be read. Gate B r2 K2-03: never a pass.\"\"\"\n23\t\n24\tdef frontmatter(text):\n25\t    if not text.startswith(\"---\"):\n26\t        return None\n27\t    end = text.find(\"\\n---\", 3)\n28\t    return None if end == -1 else text[4:end]\n29\t\n30\tdef top_keys(fm):\n31\t    return [m.group(1) for m in re.finditer(r\"(?m)^([A-Za-z][A-Za-z0-9_-]*)\\s*:\", fm)]\n32\t\n33\tdef scalar(fm, key):\n34\t    \"\"\"Read a flat scalar, including >- and | block styles.\"\"\"\n35\t    m = re.search(rf\"(?ms)^{re.escape(key)}\\s*:[ \\t]*(.*?)(?=^[A-Za-z][A-Za-z0-9_-]*\\s*:|\\Z)\", fm)\n36\t    if not m:\n37\t        return \"\"\n38\t    raw = m.group(1)\n39\t    raw = re.sub(r\"^[>|][-+]?\\s*\\n\", \"\", raw)          # strip a block indicator\n40\t    val = \" \".join(l.strip() for l in raw.splitlines() if l.strip())\n41\t    return val.strip().strip('\"').strip(\"'\")\n42\t\n43\t# --- YAML subset validation (R13-03, B-01, Gate B r2 K2-01) -------------------\n44\t# The regex reader above accepts text a YAML loader rejects or silently\n45\t# truncates, and a harness that cannot load a frontmatter never sees the skill.\n46\t# Supported: `key: value` lines (top level and nested), `- item` lines, plain\n47\t# scalars without ': ' or ' #', single- and double-quoted scalars closed on the\n48\t# same line with valid escapes, `|` / `>` block scalars, and `[a, b]` flow\n49\t# sequences of plain scalars. Everything else is REJECTED as unsupported:\n50\t# flow mappings, anchors, aliases, tags, multi-line quoted scalars, tab\n51\t# indentation. Not validated: indentation consistency between nested levels.\n52\tKEY_LINE = re.compile(r\"([A-Za-z_][A-Za-z0-9_.-]*)[ \\t]*:(?:[ \\t]+(.*))?$\")\n53\tBLOCK_HEADER = re.compile(r\"[|>](?:[1-9][-+]?|[-+][1-9]?)?(?:[ \\t]+#.*)?$\")\n54\tDQ_SIMPLE = set('0abtnvfre \"/\\\\N_LP\\t')\n55\tUNSUPPORTED_START = \"{&*!%@`\"\n56\t\n57\tdef _indent(line):\n58\t    return len(line) - len(line.lstrip(\" \"))\n59\t\n60\tdef _after_close(tail):\n61\t    if not tail.strip() or re.match(r\"[ \\t]+#\", tail):\n62\t        return None\n63\t    return \"text after the closing quote\"\n64\t\n65\tdef _double_quoted(s):\n66\t    i = 1\n67\t    while i < len(s):\n68\t        c = s[i]\n69\t        if c == \"\\\\\":\n70\t            e = s[i + 1:i + 2]\n71\t            if e and e in DQ_SIMPLE:\n72\t                i += 2\n73\t                continue\n74\t            width = {\"x\": 2, \"u\": 4, \"U\": 8}.get(e)\n75\t            if width and re.fullmatch(r\"[0-9A-Fa-f]{%d}\" % width, s[i + 2:i + 2 + width]):\n76\t                i += 2 + width\n77\t                continue\n78\t            return f\"invalid escape '\\\\{e}' in a double-quoted scalar\"\n79\t        if c == '\"':\n80\t            return _after_close(s[i + 1:])\n81\t        i += 1\n82\t    return \"double-quoted scalar does not close on its line (multi-line quoted scalars are unsupported)\"\n83\t\n84\tdef _single_quoted(s):\n85\t    i = 1\n86\t    while i < len(s):\n87\t        if s[i] == \"'\":\n88\t            if s[i + 1:i + 2] == \"'\":                # '' is an escaped quote\n89\t                i += 2\n90\t                continue\n91\t            return _after_close(s[i + 1:])\n92\t        i += 1\n93\t    return \"single-quoted scalar does not close on its line (multi-line quoted scalars are unsupported)\"\n94\t\n95\tdef _plain(text):\n96\t    if text[:1] in \"-?:\" and text[1:2] in (\"\", \" \"):\n97\t        return \"plain scalar starts with an indicator ('-', '?' or ':')\"\n98\t    if \": \" in text or text.endswith(\":\") or \" #\" in text:\n99\t        return (\"plain scalar contains ': ' or ' #' - a YAML loader rejects or \"\n100\t                \"truncates it; quote it or use a '>-' block\")\n101\t    return None\n102\t\n103\tdef _flow_sequence(value):\n104\t    m = re.fullmatch(r\"\\[([^\\[\\]{}\\\"']*)\\](?:[ \\t]+#.*)?\", value)\n105\t    if not m:\n106\t        return \"unsupported flow sequence - only [a, b] of plain scalars is validated\"\n107\t    if not m.group(1).strip():\n108\t        return None\n109\t    for item in (x.strip() for x in m.group(1).split(\",\")):\n110\t        if not item or item[:1] in \"#|>\" + UNSUPPORTED_START or _plain(item) or \",\" in item:\n111\t            return \"unsupported flow sequence item - only [a, b] of plain scalars is validated\"\n112\t    return None\n113\t\n114\tdef _value(value):\n115\t    if not value or value.startswith(\"#\"):\n116\t        return None\n117\t    c = value[0]\n118\t    if c == '\"':\n119\t        return _double_quoted(value)\n120\t    if c == \"'\":\n121\t        return _single_quoted(value)\n122\t    if c == \"[\":\n123\t        return _flow_sequence(value)\n124\t    if c in UNSUPPORTED_START:\n125\t        return (f\"unsupported YAML syntax starting with '{c}' \"\n126\t                \"(flow mapping, anchor, alias, tag or reserved indicator)\")\n127\t    if c in \"|>\":\n128\t        return None if BLOCK_HEADER.match(value) else \"malformed block scalar header\"\n129\t    return _plain(value)\n130\t\n131\tdef syntax_problems(fm):\n132\t    out = []\n133\t    lines = fm.split(\"\\n\")\n134\t    i = 0\n135\t    while i < len(lines):\n136\t        raw, n = lines[i], i + 1\n137\t        i += 1\n138\t        stripped = raw.strip()\n139\t        if not stripped or stripped.startswith(\"#\"):\n140\t            continue\n141\t        lead = raw[:len(raw) - len(raw.lstrip(\" \\t\"))]\n142\t        if \"\\t\" in lead:\n143\t            out.append(f\"frontmatter line {n}: tab in indentation - YAML forbids it\")\n144\t            continue\n145\t        base = len(lead)\n146\t        body = stripped\n147\t        if body == \"-\":\n148\t            continue\n149\t        if body.startswith(\"- \"):\n150\t            body = body[2:].lstrip()\n151\t        # Column where this line's key (or item) starts. For `- kind: go` that is\n152\t        # after the dash, and the sibling `module:` on the next line sits at that\n153\t        # column - it is not a continuation of `go`. Only deeper lines are.\n154\t        base += len(stripped) - len(body)\n155\t        m = KEY_LINE.match(body)\n156\t        if m:\n157\t            key, value = m.group(1), (m.group(2) or \"\").strip()\n158\t        elif base == 0:\n159\t            out.append(f\"frontmatter line {n}: not a 'key: value' line - unsupported\")\n160\t            continue\n161\t        else:\n162\t            key, value = f\"line {n}\", body\n163\t        problem = _value(value)\n164\t        # `value and`: \"\" in \"|>\" is True in Python, which once swallowed every\n165\t        # nested line under an empty-valued key such as `metadata:` unchecked.\n166\t        if value and value[0] in \"|>\" and problem is None:\n167\t            # Block scalar: its content is every following blank or deeper line.\n168\t            while i < len(lines) and (not lines[i].strip() or _indent(lines[i]) > base):\n169\t                i += 1\n170\t        elif value and value[0] not in \"\\\"'[#\" + UNSUPPORTED_START:\n171\t            # Plain scalar: deeper non-blank lines continue it - check them joined.\n172\t            parts = [value]\n173\t            while (i < len(lines) and lines[i].strip() and _indent(lines[i]) > base\n174\t                   and not lines[i].strip().startswith(\"#\")):\n175\t                parts.append(lines[i].strip())\n176\t                i += 1\n177\t            if len(parts) > 1:\n178\t                problem = _plain(\" \".join(parts))\n179\t        if problem:\n180\t            out.append(f\"'{key}': {problem}\")\n181\t    return out\n182\t\n183\tdef check(path):\n184\t    name = os.path.basename(os.path.dirname(path))\n185\t    problems = []\n186\t    fm = frontmatter(open(path, encoding=\"utf-8\", errors=\"ignore\").read())\n187\t    if fm is None:\n188\t        return name, [\"no YAML frontmatter\"]\n189\t    keys = top_keys(fm)\n190\t    declared = scalar(fm, \"name\")\n191\t    if \"name\" not in keys:\n192\t        problems.append(\"missing 'name'\")\n193\t    elif declared != name:\n194\t        problems.append(f\"name '{declared}' != directory '{name}'\")\n195\t    desc = scalar(fm, \"description\")\n196\t    if not desc:\n197\t        problems.append(\"missing 'description'\")\n198\t    else:\n199\t        low = desc.lower()\n200\t        if len(desc) > 1024:\n201\t            problems.append(f\"description {len(desc)} chars (>1024)\")\n202\t        problems.extend(clause_problems(low))\n203\t    # R2-05: reject syntax outside the supported subset rather than\n204\t    # silently accepting it. Duplicate keys and unbalanced quotes both\n205\t    # parse \"successfully\" with a regex reader and mean something else\n206\t    # to a real YAML loader.\n207\t    for k in keys:\n208\t        if k not in ALLOWED:\n209\t            problems.append(f\"unknown frontmatter key '{k}'\")\n210\t    dupes = {k for k in keys if keys.count(k) > 1}\n211\t    for k in sorted(dupes):\n212\t        problems.append(f\"duplicate frontmatter key '{k}' - unsupported\")\n213\t    for key in (\"name\", \"description\"):\n214\t        raw = raw_scalar(fm, key)\n215\t        if raw and raw[:1] in (\"'\", '\"') and not raw.endswith(raw[0]):\n216\t            problems.append(f\"'{key}' has an unbalanced quote\")\n217\t    problems.extend(syntax_problems(fm))\n218\t    return name, problems\n219\t\n220\tdef raw_scalar(fm, key):\n221\t    m = re.search(rf\"(?m)^{re.escape(key)}\\s*:[ \\t]*(.*)$\", fm)\n222\t    return m.group(1).strip() if m else \"\"\n223\t\n224\tdef clause_problems(low):\n225\t    \"\"\"A positive phrase governed by a negative phrase does not count as a\n226\t    trigger. 'do not use when auditing' must NOT satisfy the positive check.\n227\t\n228\t    R3-04: containment was the wrong test. 'do not use' spans [0,10) and\n229\t    'use when' spans [7,15) - the positive is not CONTAINED, it OVERLAPS.\n230\t    A negative span is therefore extended through any immediately following\n231\t    'when'/'for' so it governs the whole construction, and any positive match\n232\t    OVERLAPPING a negative span is discarded.\"\"\"\n233\t    out = []\n234\t\n235\t    # Build negative spans, extended through a trailing 'when'/'for' so that\n236\t    # 'do not use when' is one governing construction, not 'do not use' + a\n237\t    # stray 'use when' the positive check could claim.\n238\t    neg_spans = []\n239\t    for n in NEGATIVE:\n240\t        # R8-10: whole words only. A bare substring match let \"not formatted\"\n241\t        # count as \"not for\" and \"because formatting\" as \"use for\".\n242\t        for m in re.finditer(r\"\\b\" + re.escape(n) + r\"\\b\", low):\n243\t            start, end = m.start(), m.end()\n244\t            for word in (\" when\", \" for\"):\n245\t                w_end = end + len(word)\n246\t                if low.startswith(word, end) and (w_end == len(low) or not low[w_end].isalnum()):\n247\t                    end = w_end\n248\t                    break\n249\t            neg_spans.append((start, end))\n250\t\n251\t    def overlaps_negative(i, j):\n252\t        return any(i < b and a < j for a, b in neg_spans)   # interval overlap\n253\t\n254\t    pos_found = False\n255\t    for p in POSITIVE:\n256\t        for m in re.finditer(r\"\\b\" + re.escape(p) + r\"\\b\", low):\n257\t            if not overlaps_negative(m.start(), m.end()):\n258\t                pos_found = True\n259\t                break\n260\t        if pos_found:\n261\t            break\n262\t\n263\t    if not pos_found:\n264\t        out.append(\"no standalone positive clause ('Use when ...') - Claude will \"\n265\t                   \"not trigger (a 'use when' governed by 'do not use when' does not count)\")\n266\t    if not neg_spans:\n267\t        out.append(\"no negative clause ('Do not use ...') - Codex over-fires\")\n268\t    return out\n269\t\n270\tdef claude_overrides():\n271\t    \"\"\"B-02: frontmatter can be perfect while Claude Code never shows the skill.\n272\t    `skillOverrides` in ~/.claude/settings.json (settings.local.json wins) can\n273\t    set a skill \"off\"; Codex and Pi do not read that file, so the same skill is\n274\t    live there. K2-03: a settings file that exists but cannot be read or parsed\n275\t    is missing evidence, not an empty configuration - raise, never pass.\"\"\"\n276\t    merged = {}\n277\t    for f in (\"settings.json\", \"settings.local.json\"):\n278\t        p = os.path.expanduser(f\"~/.claude/{f}\")\n279\t        if not os.path.lexists(p):\n280\t            continue                                  # absent = no overrides\n281\t        try:\n282\t            data = json.load(open(p, encoding=\"utf-8\"))\n283\t        except (OSError, ValueError) as e:\n284\t            raise EvidenceError(f\"cannot read {p}: {e}\")\n285\t        if not isinstance(data, dict):\n286\t            raise EvidenceError(f\"{p} is not a JSON object\")\n287\t        ov = data.get(\"skillOverrides\")\n288\t        if ov is None:\n289\t            continue\n290\t        if not isinstance(ov, dict):\n291\t            raise EvidenceError(f\"{p} skillOverrides is not an object\")\n292\t        merged.update(ov)\n293\t    return merged\n294\t\n295\tdef tracked_spellings():\n296\t    \"\"\"R13-02: on a case-insensitive disk the directory spelling seen here can\n297\t    differ from the spelling git records, and a fresh checkout (the other\n298\t    machine) gets git's. Map lower-cased top directory -> spellings in git.\n299\t    K2-03: a repo whose git probe fails is missing evidence - raise.\"\"\"\n300\t    if not os.path.lexists(os.path.join(CANON, \".git\")):\n301\t        return {}                                     # not a repo: nothing to compare\n302\t    try:\n303\t        out = subprocess.run([\"git\", \"-C\", CANON, \"ls-files\", \"-z\"],\n304\t                             capture_output=True, timeout=60)\n305\t    except (OSError, subprocess.SubprocessError) as e:\n306\t        raise EvidenceError(f\"git ls-files failed in {CANON}: {e}\")\n307\t    if out.returncode != 0:\n308\t        raise EvidenceError(f\"git ls-files exited {out.returncode} in {CANON}: \"\n309\t                            f\"{out.stderr.decode(errors='replace').strip()}\")\n310\t    spell = {}\n311\t    for p in out.stdout.split(b\"\\0\"):\n312\t        p = os.fsdecode(p)\n313\t        if \"/\" in p:\n314\t            top = p.split(\"/\", 1)[0]\n315\t            spell.setdefault(top.lower(), set()).add(top)\n316\t    return spell\n317\t\n318\tdef main():\n319\t    if not os.path.isdir(CANON):\n320\t        print(f\"FATAL canonical dir missing: {CANON}\", file=sys.stderr)\n321\t        return 2\n322\t    # R8-01: check only OWNED skills - real directories. A symlinked skill was\n323\t    # installed by the skills CLI or vendored; its frontmatter belongs to a\n324\t    # third party, and demanding our contract of it makes \"0 failing\"\n325\t    # unreachable. Ownership is structural, so no name list is kept.\n326\t    paths = [p for p in sorted(glob.glob(os.path.join(CANON, \"*\", \"SKILL.md\")))\n327\t             if not os.path.islink(os.path.dirname(p))]\n328\t    if not paths:\n329\t        print(f\"FATAL no SKILL.md found under {CANON} - refusing to report success\",\n330\t              file=sys.stderr)\n331\t        return 2\n332\t    try:\n333\t        overrides = claude_overrides()\n334\t        spellings = tracked_spellings()\n335\t    except EvidenceError as e:\n336\t        print(f\"FATAL {e} - refusing to report a result without that evidence\",\n337\t              file=sys.stderr)\n338\t        return 2\n339\t    failed = 0\n340\t    for p in paths:\n341\t        name, probs = check(p)\n342\t        if overrides.get(name) == \"off\":\n343\t            probs.append(\"off in Claude Code (settings skillOverrides) but published to the \"\n344\t                         \"Codex and Pi views - re-enable it or retire it from canonical\")\n345\t        tracked = spellings.get(name.lower())\n346\t        if tracked is not None and name not in tracked:\n347\t            probs.append(f\"directory is '{name}' on disk but git records \"\n348\t                         f\"{sorted(tracked)} - a fresh checkout gets git's spelling\")\n349\t        if probs:\n350\t            failed += 1\n351\t            print(f\"FAIL {name}\")\n352\t            for x in probs:\n353\t                print(f\"       - {x}\")\n354\t    print(f\"\\nchecked {len(paths)} skills, {failed} failing, {len(paths)-failed} portable\")\n355\t    return 1 if failed else 0\n356\t\n357\tif __name__ == \"__main__\":\n358\t    sys.exit(main())\n359\t"}]},"uuid":"dd03f911-293f-4b73-a76e-085f0bb66305","timestamp":"2026-09-13T06:13:06.888Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kristinarash/DEV/KeystoneOS/scripts/skill-portability-check.py","content":"#!/usr/bin/env python3\n\"\"\"Check every skill in the canonical repo against the portable frontmatter\ncontract. Exit 0 = all pass, 1 = failures, 2 = empty/missing inventory or\nunavailable evidence (unreadable settings, failed git probe).\nstdlib only (PEP 668 machine). Validates the YAML subset we actually use and\nrejects anything outside it, rather than guessing what a loader would do.\"\"\"\nimport os, re, sys, glob, json, subprocess\n\nCANON = os.path.expanduser(\"~/.claude/skills\")\n# R8-03: every key the roster actually uses today, measured with\n#   grep '^[a-z-]*:' ~/.claude/skills/*/SKILL.md | sort | uniq -c\n# The contract may not outlaw keys Claude Code honours. `effort` and\n# `user-invocable` are live Claude Code keys; `repository` and `homepage`\n# are package metadata. Genuinely unknown keys are still reported.\nALLOWED = {\"name\", \"description\", \"metadata\", \"argument-hint\", \"allowed-tools\",\n           \"model\", \"disable-model-invocation\", \"license\", \"version\", \"author\",\n           \"effort\", \"user-invocable\", \"repository\", \"homepage\"}\nPOSITIVE = (\"use when\", \"use for\", \"use this skill when\", \"invoke when\")\nNEGATIVE = (\"do not use\", \"don't use\", \"not for\", \"never use\")\n\nclass EvidenceError(Exception):\n    \"\"\"Required evidence could not be read. Gate B r2 K2-03: never a pass.\"\"\"\n\ndef frontmatter(text):\n    if not text.startswith(\"---\"):\n        return None\n    end = text.find(\"\\n---\", 3)\n    return None if end == -1 else text[4:end]\n\ndef top_keys(fm):\n    return [m.group(1) for m in re.finditer(r\"(?m)^([A-Za-z][A-Za-z0-9_-]*)\\s*:\", fm)]\n\ndef scalar(fm, key):\n    \"\"\"Read a flat scalar, including >- and | block styles.\"\"\"\n    m = re.search(rf\"(?ms)^{re.escape(key)}\\s*:[ \\t]*(.*?)(?=^[A-Za-z][A-Za-z0-9_-]*\\s*:|\\Z)\", fm)\n    if not m:\n        return \"\"\n    raw = m.group(1)\n    raw = re.sub(r\"^[>|][-+]?\\s*\\n\", \"\", raw)          # strip a block indicator\n    val = \" \".join(l.strip() for l in raw.splitlines() if l.strip())\n    return val.strip().strip('\"').strip(\"'\")\n\n# --- YAML subset validation (R13-03, B-01, Gate B r2 K2-01) -------------------\n# The regex reader above accepts text a YAML loader rejects or silently\n# truncates, and a harness that cannot load a frontmatter never sees the skill.\n# Supported: `key: value` lines (top level and nested), `- item` lines, plain\n# scalars without ': ' or ' #', single- and double-quoted scalars closed on the\n# same line with valid escapes, `|` / `>` block scalars, and `[a, b]` flow\n# sequences of plain scalars. Everything else is REJECTED as unsupported:\n# flow mappings, anchors, aliases, tags, multi-line quoted scalars, tab\n# indentation. Not validated: indentation consistency between nested levels.\nKEY_LINE = re.compile(r\"([A-Za-z_][A-Za-z0-9_.-]*)[ \\t]*:(?:[ \\t]+(.*))?$\")\nBLOCK_HEADER = re.compile(r\"[|>](?:[1-9][-+]?|[-+][1-9]?)?(?:[ \\t]+#.*)?$\")\nDQ_SIMPLE = set('0abtnvfre \"/\\\\N_LP\\t')\nUNSUPPORTED_START = \"{&*!%@`\"\n\ndef _indent(line):\n    return len(line) - len(line.lstrip(\" \"))\n\ndef _after_close(tail):\n    if not tail.strip() or re.match(r\"[ \\t]+#\", tail):\n        return None\n    return \"text after the closing quote\"\n\ndef _double_quoted(s):\n    i = 1\n    while i < len(s):\n        c = s[i]\n        if c == \"\\\\\":\n            e = s[i + 1:i + 2]\n            if e and e in DQ_SIMPLE:\n                i += 2\n                continue\n            width = {\"x\": 2, \"u\": 4, \"U\": 8}.get(e)\n            if width and re.fullmatch(r\"[0-9A-Fa-f]{%d}\" % width, s[i + 2:i + 2 + width]):\n                i += 2 + width\n                continue\n            return f\"invalid escape '\\\\{e}' in a double-quoted scalar\"\n        if c == '\"':\n            return _after_close(s[i + 1:])\n        i += 1\n    return \"double-quoted scalar does not close on its line (multi-line quoted scalars are unsupported)\"\n\ndef _single_quoted(s):\n    i = 1\n    while i < len(s):\n        if s[i] == \"'\":\n            if s[i + 1:i + 2] == \"'\":                # '' is an escaped quote\n                i += 2\n                continue\n            return _after_close(s[i + 1:])\n        i += 1\n    return \"single-quoted scalar does not close on its line (multi-line quoted scalars are unsupported)\"\n\ndef _plain(text):\n    if text[:1] in \"-?:\" and text[1:2] in (\"\", \" \"):\n        return \"plain scalar starts with an indicator ('-', '?' or ':')\"\n    if \": \" in text or text.endswith(\":\") or \" #\" in text:\n        return (\"plain scalar contains ': ' or ' #' - a YAML loader rejects or \"\n                \"truncates it; quote it or use a '>-' block\")\n    return None\n\ndef _flow_sequence(value):\n    m = re.fullmatch(r\"\\[([^\\[\\]{}\\\"']*)\\](?:[ \\t]+#.*)?\", value)\n    if not m:\n        return \"unsupported flow sequence - only [a, b] of plain scalars is validated\"\n    if not m.group(1).strip():\n        return None\n    for item in (x.strip() for x in m.group(1).split(\",\")):\n        if not item or item[:1] in \"#|>\" + UNSUPPORTED_START or _plain(item) or \",\" in item:\n            return \"unsupported flow sequence item - only [a, b] of plain scalars is validated\"\n    return None\n\ndef _value(value):\n    if not value or value.startswith(\"#\"):\n        return None\n    c = value[0]\n    if c == '\"':\n        return _double_quoted(value)\n    if c == \"'\":\n        return _single_quoted(value)\n    if c == \"[\":\n        return _flow_sequence(value)\n    if c in UNSUPPORTED_START:\n        return (f\"unsupported YAML syntax starting with '{c}' \"\n                \"(flow mapping, anchor, alias, tag or reserved indicator)\")\n    if c in \"|>\":\n        return None if BLOCK_HEADER.match(value) else \"malformed block scalar header\"\n    return _plain(value)\n\ndef syntax_problems(fm):\n    out = []\n    lines = fm.split(\"\\n\")\n    i = 0\n    while i < len(lines):\n        raw, n = lines[i], i + 1\n        i += 1\n        stripped = raw.strip()\n        if not stripped or stripped.startswith(\"#\"):\n            continue\n        lead = raw[:len(raw) - len(raw.lstrip(\" \\t\"))]\n        if \"\\t\" in lead:\n            out.append(f\"frontmatter line {n}: tab in indentation - YAML forbids it\")\n            continue\n        base = len(lead)\n        body = stripped\n        if body == \"-\":\n            continue\n        if body.startswith(\"- \"):\n            body = body[2:].lstrip()\n        # Column where this line's key (or item) starts. For `- kind: go` that is\n        # after the dash, and the sibling `module:` on the next line sits at that\n        # column - it is not a continuation of `go`. Only deeper lines are.\n        base += len(stripped) - len(body)\n        m = KEY_LINE.match(body)\n        if m:\n            key, value = m.group(1), (m.group(2) or \"\").strip()\n        elif base == 0:\n            out.append(f\"frontmatter line {n}: not a 'key: value' line - unsupported\")\n            continue\n        else:\n            key, value = f\"line {n}\", body\n        problem = _value(value)\n        # `value and`: \"\" in \"|>\" is True in Python, which once swallowed every\n        # nested line under an empty-valued key such as `metadata:` unchecked.\n        if value and value[0] in \"|>\" and problem is None:\n            # Block scalar: its content is every following blank or deeper line.\n            while i < len(lines) and (not lines[i].strip() or _indent(lines[i]) > base):\n                i += 1\n        elif value and value[0] not in \"\\\"'[#\" + UNSUPPORTED_START:\n            # Plain scalar: deeper non-blank lines continue it - check them joined.\n            parts = [value]\n            while (i < len(lines) and lines[i].strip() and _indent(lines[i]) > base\n                   and not lines[i].strip().startswith(\"#\")):\n                parts.append(lines[i].strip())\n                i += 1\n            if len(parts) > 1:\n                problem = _plain(\" \".join(parts))\n        if problem:\n            out.append(f\"'{key}': {problem}\")\n    return out\n\ndef check(path):\n    name = os.path.basename(os.path.dirname(path))\n    problems = []\n    fm = frontmatter(open(path, encoding=\"utf-8\", errors=\"ignore\").read())\n    if fm is None:\n        return name, [\"no YAML frontmatter\"]\n    keys = top_keys(fm)\n    declared = scalar(fm, \"name\")\n    if \"name\" not in keys:\n        problems.append(\"missing 'name'\")\n    elif declared != name:\n        problems.append(f\"name '{declared}' != directory '{name}'\")\n    desc = scalar(fm, \"description\")\n    if not desc:\n        problems.append(\"missing 'description'\")\n    else:\n        low = desc.lower()\n        if len(desc) > 1024:\n            problems.append(f\"description {len(desc)} chars (>1024)\")\n        problems.extend(clause_problems(low))\n    # R2-05: reject syntax outside the supported subset rather than\n    # silently accepting it. Duplicate keys and unbalanced quotes both\n    # parse \"successfully\" with a regex reader and mean something else\n    # to a real YAML loader.\n    for k in keys:\n        if k not in ALLOWED:\n            problems.append(f\"unknown frontmatter key '{k}'\")\n    dupes = {k for k in keys if keys.count(k) > 1}\n    for k in sorted(dupes):\n        problems.append(f\"duplicate frontmatter key '{k}' - unsupported\")\n    for key in (\"name\", \"description\"):\n        raw = raw_scalar(fm, key)\n        if raw and raw[:1] in (\"'\", '\"') and not raw.endswith(raw[0]):\n            problems.append(f\"'{key}' has an unbalanced quote\")\n    problems.extend(syntax_problems(fm))\n    return name, problems\n\ndef raw_scalar(fm, key):\n    m = re.search(rf\"(?m)^{re.escape(key)}\\s*:[ \\t]*(.*)$\", fm)\n    return m.group(1).strip() if m else \"\"\n\ndef clause_problems(low):\n    \"\"\"A positive phrase governed by a negative phrase does not count as a\n    trigger. 'do not use when auditing' must NOT satisfy the positive check.\n\n    R3-04: containment was the wrong test. 'do not use' spans [0,10) and\n    'use when' spans [7,15) - the positive is not CONTAINED, it OVERLAPS.\n    A negative span is therefore extended through any immediately following\n    'when'/'for' so it governs the whole construction, and any positive match\n    OVERLAPPING a negative span is discarded.\"\"\"\n    out = []\n\n    # Build negative spans, extended through a trailing 'when'/'for' so that\n    # 'do not use when' is one governing construction, not 'do not use' + a\n    # stray 'use when' the positive check could claim.\n    neg_spans = []\n    for n in NEGATIVE:\n        # R8-10: whole words only. A bare substring match let \"not formatted\"\n        # count as \"not for\" and \"because formatting\" as \"use for\".\n        for m in re.finditer(r\"\\b\" + re.escape(n) + r\"\\b\", low):\n            start, end = m.start(), m.end()\n            for word in (\" when\", \" for\"):\n                w_end = end + len(word)\n                if low.startswith(word, end) and (w_end == len(low) or not low[w_end].isalnum()):\n                    end = w_end\n                    break\n            neg_spans.append((start, end))\n\n    def overlaps_negative(i, j):\n        return any(i < b and a < j for a, b in neg_spans)   # interval overlap\n\n    pos_found = False\n    for p in POSITIVE:\n        for m in re.finditer(r\"\\b\" + re.escape(p) + r\"\\b\", low):\n            if not overlaps_negative(m.start(), m.end()):\n                pos_found = True\n                break\n        if pos_found:\n            break\n\n    if not pos_found:\n        out.append(\"no standalone positive clause ('Use when ...') - Claude will \"\n                   \"not trigger (a 'use when' governed by 'do not use when' does not count)\")\n    if not neg_spans:\n        out.append(\"no negative clause ('Do not use ...') - Codex over-fires\")\n    return out\n\ndef claude_overrides():\n    \"\"\"B-02: frontmatter can be perfect while Claude Code never shows the skill.\n    `skillOverrides` in ~/.claude/settings.json (settings.local.json wins) can\n    set a skill \"off\"; Codex and Pi do not read that file, so the same skill is\n    live there. K2-03: a settings file that exists but cannot be read or parsed\n    is missing evidence, not an empty configuration - raise, never pass.\"\"\"\n    merged = {}\n    for f in (\"settings.json\", \"settings.local.json\"):\n        p = os.path.expanduser(f\"~/.claude/{f}\")\n        if not os.path.lexists(p):\n            continue                                  # absent = no overrides\n        try:\n            data = json.load(open(p, encoding=\"utf-8\"))\n        except (OSError, ValueError) as e:\n            raise EvidenceError(f\"cannot read {p}: {e}\")\n        if not isinstance(data, dict):\n            raise EvidenceError(f\"{p} is not a JSON object\")\n        ov = data.get(\"skillOverrides\")\n        if ov is None:\n            continue\n        if not isinstance(ov, dict):\n            raise EvidenceError(f\"{p} skillOverrides is not an object\")\n        merged.update(ov)\n    return merged\n\ndef tracked_spellings():\n    \"\"\"R13-02: on a case-insensitive disk the directory spelling seen here can\n    differ from the spelling git records, and a fresh checkout (the other\n    machine) gets git's. Map lower-cased top directory -> spellings in git.\n    K2-03: a repo whose git probe fails is missing evidence - raise.\"\"\"\n    if not os.path.lexists(os.path.join(CANON, \".git\")):\n        return {}                                     # not a repo: nothing to compare\n    try:\n        out = subprocess.run([\"git\", \"-C\", CANON, \"ls-files\", \"-z\"],\n                             capture_output=True, timeout=60)\n    except (OSError, subprocess.SubprocessError) as e:\n        raise EvidenceError(f\"git ls-files failed in {CANON}: {e}\")\n    if out.returncode != 0:\n        raise EvidenceError(f\"git ls-files exited {out.returncode} in {CANON}: \"\n                            f\"{out.stderr.decode(errors='replace').strip()}\")\n    spell = {}\n    for p in out.stdout.split(b\"\\0\"):\n        p = os.fsdecode(p)\n        if \"/\" in p:\n            top = p.split(\"/\", 1)[0]\n            spell.setdefault(top.lower(), set()).add(top)\n    return spell\n\ndef main():\n    if not os.path.isdir(CANON):\n        print(f\"FATAL canonical dir missing: {CANON}\", file=sys.stderr)\n        return 2\n    # R8-01: check only OWNED skills - real directories. A symlinked skill was\n    # installed by the skills CLI or vendored; its frontmatter belongs to a\n    # third party, and demanding our contract of it makes \"0 failing\"\n    # unreachable. Ownership is structural, so no name list is kept.\n    paths = [p for p in sorted(glob.glob(os.path.join(CANON, \"*\", \"SKILL.md\")))\n             if not os.path.islink(os.path.dirname(p))]\n    if not paths:\n        print(f\"FATAL no SKILL.md found under {CANON} - refusing to report success\",\n              file=sys.stderr)\n        return 2\n    try:\n        overrides = claude_overrides()\n        spellings = tracked_spellings()\n    except EvidenceError as e:\n        print(f\"FATAL {e} - refusing to report a result without that evidence\",\n              file=sys.stderr)\n        return 2\n    failed = 0\n    for p in paths:\n        name, probs = check(p)\n        if overrides.get(name) == \"off\":\n            probs.append(\"off in Claude Code (settings skillOverrides) but published to the \"\n                         \"Codex and Pi views - re-enable it or retire it from canonical\")\n        tracked = spellings.get(name.lower())\n        if tracked is not None and name not in tracked:\n            probs.append(f\"directory is '{name}' on disk but git records \"\n                         f\"{sorted(tracked)} - a fresh checkout gets git's spelling\")\n        if probs:\n            failed += 1\n            print(f\"FAIL {name}\")\n            for x in probs:\n                print(f\"       - {x}\")\n    print(f\"\\nchecked {len(paths)} skills, {failed} failing, {len(paths)-failed} portable\")\n    return 1 if failed else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":359,"startLine":1,"totalLines":359}},"sourceToolAssistantUUID":"c8a09b7a-31f9-474d-9f2e-bf4b3d169ad0","session_id":"9823c1f0-89f5-4638-9223-c6892607ac2b","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"9823c1f0-89f5-4638-9223-c6892607ac2b","version":"2.1.270","gitBranch":"main"}
