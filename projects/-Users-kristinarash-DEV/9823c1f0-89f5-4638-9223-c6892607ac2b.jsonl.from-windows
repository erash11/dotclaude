\n    \"desc-number\":      ([\"name: desc-number\", \"description: 42\"], True, True),\n    \"desc-null-multi\":  ([\"name: desc-null-multi\", \"description:\", \"  ~\"], True, True),\n    # --- controls: quoted forms and look-alike strings are strings ---\n    \"yes\":              (['name: \"yes\"', f\"description: {GOOD_DESC}\"], False, True),\n    \"404\":              ([\"name: '404'\", f\"description: {GOOD_DESC}\"], False, True),\n    \"true-thing\":       ([\"name: true-thing\", f\"description: {GOOD_DESC}\"], False, True),\n    \"v1.2.3\":           ([\"name: v1.2.3\", f\"description: {GOOD_DESC}\"], False, True),\n}\nIR03 = [\"true\", \"null\", \"123\", \"1.5\", \"2026-09-13\", \"Off\", \"desc-bool\", \"desc-number\", \"desc-null-multi\"]\n\ndef loader_kind(v):\n    if isinstance(v, list): return \"sequence\"\n    if isinstance(v, dict): return \"mapping\"\n    if v is None: return \"null\"\n    if isinstance(v, bool): return \"boolean\"\n    if isinstance(v, (int, float)): return \"number\"\n    if isinstance(v, (datetime.date, datetime.datetime)): return \"timestamp\"\n    return \"scalar\"\n\nH = f\"{T}/t5g-fx\"\nfor n, (lines, _, _) in FX.items():\n    skill(H, n, lines)\nr = run(H)\nprint(\"FIXTURES exit\", r.returncode, \"|\", r.stdout.strip().splitlines()[-1])\nfailing, reasons, cur = set(), {}, None\nfor l in r.stdout.splitlines():\n    if l.startswith(\"FAIL \"):\n        cur = l[5:]; failing.add(cur); reasons[cur] = []\n    elif cur and l.strip().startswith(\"- \"):\n        reasons[cur].append(l.strip()[2:])\nbad = []\nfor n, (lines, expect_flag, loader_ok) in FX.items():\n    flagged = n in failing\n    try:\n        doc = yaml.safe_load(\"\\n\".join(lines)); loads = True\n    except yaml.YAMLError:\n        doc, loads = None, False\n    note = \"\"\n    if loader_ok is not None and loads != loader_ok:\n        note = f\" (loader assumption wrong: loads={loads})\"\n    if loads and isinstance(doc, dict):\n        fm = \"\\n\".join(lines)\n        for k in (\"name\", \"description\"):\n            want, got = loader_kind(doc.get(k)), chk.value_kind(fm, k)\n            if got != want and not (want == \"null\" and got == \"empty\"):\n                note += f\" (value_kind {k}={got}, loader says {want})\"\n    status = \"PASS\" if flagged == expect_flag and not note else \"FAIL\"\n    if status == \"FAIL\":\n        bad.append(n)\n    first = (reasons.get(n) or [\"\"])[0][:70]\n    print(f\"  {status} {n}: flagged={flagged} expect={expect_flag} loads={loads}{note} | {first}\")\n\nprint(\"RED-GREEN (pre-IR-03 checker 2bcdda2 vs current) on the IR-03 fixtures:\")\nrg_ok = True\nfor n in IR03:\n    p = f\"{H}/.claude/skills/{n}/SKILL.md\"\n    o, c = bool(old.check(p)[1]), bool(chk.check(p)[1])\n    # desc-bool/desc-number were already flagged by the old checker (no clauses); the\n    # red-green claim is about the TYPE message, so check that too.\n    typed = any(\"not a string\" in x for x in chk.check(p)[1])\n    print(f\"  {n:16} old_flagged={o!s:5} new_flagged={c!s:5} type_reported={typed}\")\n    rg_ok &= c and typed\nprint(\"  red-green:\", \"PASS\" if rg_ok else \"FAIL\")\n\ndis, kind_dis = [], []\nreal = [p for p in sorted(glob.glob(os.path.expanduser(\"~/.claude/skills/*/SKILL.md\")))\n        if not os.path.islink(os.path.dirname(p))]\nfor p in real:\n    fm = chk.frontmatter(open(p, encoding=\"utf-8\").read())\n    flagged = bool(chk.syntax_problems(fm))\n    try:\n        doc = yaml.safe_load(fm); loads = True\n    except yaml.YAMLError:\n        doc, loads = None, False\n    if flagged == loads:\n        dis.append((p.split(\"/\")[-2], chk.syntax_problems(fm)[:1], loads))\n    if loads:\n        for k in (\"name\", \"description\"):\n            want, got = loader_kind(doc.get(k)), chk.value_kind(fm, k)\n            if got != want:\n                kind_dis.append((p.split(\"/\")[-2], k, got, want))\nprint(\"REAL roster files:\", len(real), \"syntax disagreements:\", dis, \"kind disagreements:\", kind_dis)\nr = run()\nprint(\"REAL checker exit\", r.returncode, \"|\", r.stdout.strip().splitlines()[-1])\n\ndef evidence_home(tag):\n    h = f\"{T}/t5g-ev-{tag}\"\n    skill(h, \"ok\", [\"name: ok\", f\"description: {GOOD_DESC}\"])\n    return h\nh = evidence_home(\"badjson\"); open(f\"{h}/.claude/settings.json\", \"w\").write(\"{not json\")\nprint(\"malformed settings.json -> exit\", run(h).returncode, \"(expect 2)\")\nh = evidence_home(\"nonobject\"); open(f\"{h}/.claude/settings.json\", \"w\").write('{\"skillOverrides\": [\"x\"]}')\nprint(\"skillOverrides not an object -> exit\", run(h).returncode, \"(expect 2)\")\nh = evidence_home(\"unreadable\"); open(f\"{h}/.claude/settings.json\", \"w\").write(\"{}\")\nos.chmod(f\"{h}/.claude/settings.json\", 0)\nprint(\"unreadable settings.json -> exit\", run(h).returncode, \"(expect 2)\")\nos.chmod(f\"{h}/.claude/settings.json\", stat.S_IRUSR | stat.S_IWUSR)\nh = evidence_home(\"brokengit\"); open(f\"{h}/.claude/skills/.git\", \"w\").write(\"gitdir: /nonexistent/repo\\n\")\nprint(\"git probe fails -> exit\", run(h).returncode, \"(expect 2)\")\nh = evidence_home(\"nosettings\")\nprint(\"no settings, no git (control) -> exit\", run(h).returncode, \"(expect 0)\")\nfor hh, exp in ((f\"{T}/t5-badcanon\", 1), (f\"{T}/t5-emptycanon\", 2), (f\"{T}/t5b-fx-yaml\", 1), (f\"{T}/t5b-fx-spell\", 1)):\n    print(os.path.basename(hh), \"exit\", run(hh).returncode, \"(expect\", exp, \")\")\nprint(\"FIXTURE FAILURES:\", bad or \"none\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"c9e209b8-2214-4c38-bd76-4c085f11a197","session_id":"9823c1f0-89f5-4638-9223-c6892607ac2b","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"9823c1f0-89f5-4638-9223-c6892607ac2b","version":"2.1.270","gitBranch":"main"}
