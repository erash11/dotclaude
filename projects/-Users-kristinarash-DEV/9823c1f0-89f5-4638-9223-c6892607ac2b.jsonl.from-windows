"true|True|TRUE|false|False|FALSE\",\n    r\"[-+]?[0-9]+\", r\"0o[0-7]+\", r\"0x[0-9a-fA-F]+\",\n    r\"[-+]?(\\.[0-9]+|[0-9]+(\\.[0-9]*)?)([eE][-+]?[0-9]+)?\",\n    r\"[-+]?(\\.inf|\\.Inf|\\.INF)\", r\"\\.nan|\\.NaN|\\.NAN\")]\n\ndef pyyaml_kind(s):\n    try:\n        v = yaml.safe_load(f\"k: {s}\\n\")\n    except yaml.YAMLError:\n        return None\n    if not isinstance(v, dict) or \"k\" not in v:\n        return None\n    v = v[\"k\"]\n    if isinstance(v, str): return \"scalar\"\n    if v is None: return \"null\"\n    if isinstance(v, bool): return \"boolean\"\n    if isinstance(v, (int, float)): return \"number\"\n    if isinstance(v, (datetime.date, datetime.datetime)): return \"timestamp\"\n    return type(v).__name__\n\ncorpus = set()\nalphabet = \"0189_.:-+eExob\"\nfor n in range(1, 5):\n    corpus.update(\"\".join(p) for p in itertools.product(alphabet, repeat=n))\ncorpus.update(\"\"\"0008 0129 0:1 1:20 1:20.5 0:1.5 190:20:30 2026-09-13 2026-9-3 2026-9-3T1:02:03Z\n2026-09-13T10:00:00 .inf -.Inf +.INF .nan NaN inf yes Yes y n on ON oN true tRUE null Null nULL ~\n0x1F 0o17 0o8 0b101 0b2 1_000 1e3 1e+3 1.0e+3 1. .5 +1 -1 v1 12a 0x 1__2 _1 1_\"\"\".split())\n\nbad_neg, over, unjustified, total = [], 0, [], 0\nfor s in sorted(corpus):\n    pk = pyyaml_kind(s)\n    if pk is None:\n        continue                     # not a valid plain scalar in this position\n    total += 1\n    ck = chk._plain_kind(s)\n    if pk != \"scalar\" and ck == \"scalar\":\n        bad_neg.append((s, pk))\n    if pk == \"scalar\" and ck != \"scalar\":\n        over += 1\n        if not any(rx.fullmatch(s) for rx in CORE):\n            unjustified.append((s, ck))\nprint(f\"corpus values loaded by PyYAML: {total}\")\nprint(f\"PyYAML non-string but checker says string (must be 0): {len(bad_neg)} {bad_neg[:10]}\")\nprint(f\"checker non-string where PyYAML says string: {over}; not justified by YAML 1.2 core (must be 0): \"\n      f\"{len(unjustified)} {unjustified[:10]}\")\n\nprint(\"named cases (value: checker kind | PyYAML kind | 1.2 core match | previous checker kind):\")\nfor s in [\"0008\", \"0129\", \"0:1\", \"1:20\", \"2026-9-3\", \"2026-09-13\", \"2026-9-3 1:02:03\", \"1e3\", \"0o17\", \"v1.2.3\", \"1_000\"]:\n    print(f\"  {s:18} {chk._plain_kind(s):9} | {pyyaml_kind(s)!s:9} | {any(r.fullmatch(s) for r in CORE)!s:5} | {prev._plain_kind(s)}\")\nok = not bad_neg and not unjustified and chk._plain_kind(\"0:1\") == \"scalar\" and chk._plain_kind(\"2026-9-3\") == \"scalar\"\nprint(\"CORPUS CHECK\", \"PASS\" if ok else \"FAIL\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"b6ffcf58-54f6-48ad-9e98-df6215ba00c0","session_id":"9823c1f0-89f5-4638-9223-c6892607ac2b","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"9823c1f0-89f5-4638-9223-c6892607ac2b","version":"2.1.270","gitBranch":"main"}
