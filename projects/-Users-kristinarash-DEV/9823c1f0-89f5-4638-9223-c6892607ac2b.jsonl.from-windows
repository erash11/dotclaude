return \"scalar\"\n        # Empty after the colon: the node is whatever the next content line opens.\n        for nxt in lines[i + 1:]:\n            s = nxt.strip()\n            if not s or s.startswith(\"#\"):\n                continue\n            if s == \"-\" or s.startswith(\"- \"):\n                return \"sequence\"                     # block sequence, any indent\n            if _indent(nxt) == 0:\n                return \"empty\"                        # the next top-level key\n            if KEY_LINE.match(s):\n                return \"mapping\"\n            return \"scalar\"                           # multi-line plain scalar\n        return \"empty\"\n    return \"missing\"\n\nNOT_STRING = (\"sequence\", \"mapping\")\n\ndef check(path):\n    name = os.path.basename(os.path.dirname(path))\n    problems = []\n    fm = frontmatter(open(path, encoding=\"utf-8\", errors=\"ignore\").read())\n    if fm is None:\n        return name, [\"no YAML frontmatter\"]\n    keys = top_keys(fm)\n    # IR-01: type before content. A list or map is reported once, and its\n    # flattened text is never content-checked as if it were a string.\n    kinds = {k: value_kind(fm, k) for k in (\"name\", \"description\")}\n    for k, kind in kinds.items():\n        if kind in NOT_STRING:\n            problems.append(f\"'{k}' is a YAML {kind}, not a string - harnesses need a string\")\n    declared = scalar(fm, \"name\")\n    if \"name\" not in keys:\n        problems.append(\"missing 'name'\")\n    elif kinds[\"name\"] not in NOT_STRING and declared != name:\n        problems.append(f\"name '{declared}' != directory '{name}'\")\n    desc = scalar(fm, \"description\")\n    if kinds[\"description\"] in NOT_STRING:\n        pass                                          # already reported above\n    elif not desc:\n        problems.append(\"missing 'description'\")","originalFile":null,"structuredPatch":[{"oldStart":180,"oldLines":6,"newStart":180,"newLines":41,"lines":["             out