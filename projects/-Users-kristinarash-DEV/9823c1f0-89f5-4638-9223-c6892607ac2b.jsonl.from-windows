pture_output=True, text=True).returncode\n\ndef stale_lock():\n    clear_lock()\n    os.mkdir(LOCK)\n    open(f\"{LOCK}/pid\", \"w\").write(\"999999\")               # a pid that cannot exist\n\nok_all = True\ndef report(label, good, detail):\n    global ok_all\n    ok_all &= good\n    print(f\"{'PASS' if good else 'FAIL'} {label}: {detail}\")\n\n# 1. Missing metrics script must fail the job and add no row.\nr0, off = rows(), os.path.getsize(LOG)\nos.rename(MET, BAK)\ntry:\n    rc = run()\nfinally:\n    os.rename(BAK, MET)\nt = log_tail_from(off)\nreport(\"missing metrics script\", rc == 1 and \"FAIL metrics script errored\" in t and rows() == r0,\n       f\"exit={rc} rows {r0}->{rows()} log_has_FAIL={'FAIL metrics script errored' in t}\")\n\n# 2. A LIVE lock must make the job stand down, no row.\nclear_lock()\nos.mkdir(LOCK)\nopen(f\"{LOCK}/pid\", \"w\").write(str(os.getpid()))          # this process is alive\nr0, off = rows(), os.path.getsize(LOG)\nrc = run()\nt = log_tail_from(off)\nreport(\"live lock\", rc == 0 and \"ABORT live run\" in t and rows() == r0,\n       f\"exit={rc} rows {r0}->{rows()} log_has_ABORT={'ABORT live run' in t}\")\n\n# 3. A STALE lock must be RECLAIMED and one row added.\nclear_lock()\nos.mkdir(LOCK)\nopen(f\"{LOCK}/pid\", \"w\").write(\"999999\")                   # a pid that cannot exist\nr0, off = rows(), os.path.getsize(LOG)\nrc = run()\nt = log_tail_from(off)\nreport(\"stale lock reclaimed\", rc == 0 and \"RECLAIM stale lock\" in t and rows() == r0 + 1,\n       f\"exit={rc} rows {r0}->{rows()} log_has_RECLAIM={'RECLAIM stale lock' in t}\")\nclear_lock()\nreport(\"lock released afterwards\", not os.path.exists(LOCK), f\"lock exists={os.path.exists(LOCK)}\")\nreport(\"metrics script restored\", os.path.isfile(MET) and os.access(MET, os.X_OK), MET)\nprint(\"ALL FAILURE PATHS PASS\" if ok_all else \"SOME FAILURE PATHS FAILED\")\n","structuredPatch":[{"oldStart":75,"oldLines":7,"newStart":75,"newLines":50,"lines":[" t = log_tail_from(off