 \"Use when \\\\\"x\\\\\" \\\\x41 \\\\u00e9. Do not use otherwise.\"'], False, True),\n    \"dq-unclosed\":      ([\"name: dq-unclosed\", 'description: \"Use when testing.', '  Do not use otherwise.\"'], True, None),\n    \"dq-trailing-text\": ([\"name: dq-trailing-text\", 'description: \"Use when testing. Do not use otherwise.\" extra'], True, False),\n    \"sq-good-doubled\":  ([\"name: sq-good-doubled\", \"description: 'Use when it''s testing. Do not use otherwise.'\"], False, True),\n    \"sq-unclosed\":      ([\"name: sq-unclosed\", \"description: 'Use when testing. Do not use otherwise.\"], True, False),\n    \"flow-map\":         ([\"name: flow-map\", f\"description: {GOOD_DESC}\", \"metadata: {a: b}\"], True, None),\n    \"flow-seq-good\":    ([\"name: flow-seq-good\", f\"description: {GOOD_DESC}\", \"metadata:\", \"  bins: [one, two-cli]\"], False, True),\n    \"flow-seq-nested\":  ([\"name: flow-seq-nested\", f\"description: {GOOD_DESC}\", \"metadata:\", \"  bins: [[one], two]\"], True, None),\n    \"tag\":              ([\"name: tag\", f\"description: !!str {GOOD_DESC}\"], True, None),\n    \"anchor\":           ([\"name: anchor\", f\"description: &d {GOOD_DESC}\"], True, None),\n    \"tab-indent\":       ([\"name: tab-indent\", \"description: >-\", f\"\\t{GOOD_DESC}\"], True, False),\n    \"nested-colon\":     ([\"name: nested-colon\", f\"description: {GOOD_DESC}\", \"metadata:\", \"  short-description: bad: value\"], True, False),\n    \"block-good\":       ([\"name: block-good\", \"description: >-\", \"  Use when testing: a # b. Do not use otherwise.\"], False, True),\n    \"list-items-good\":  ([\"name: list-items-good\", f\"description: {GOOD_DESC}\", \"metadata:\", \"  install:\", \"    - kind: go\", \"      module: github.com/x/y\"], False, True),\n    \"top-junk\":         ([\"name: top-junk\", f\"description: {GOOD_DESC}\", \"just words\"], True, False),\n    # --- new for IR-01: wrong node type for name/description ---\n    \"desc-flow-seq\":    ([\"name: desc-flow-seq\", f\"description: [{GOOD_DESC}]\"], True, True),\n    \"desc-block-seq\":   ([\"name: desc-block-seq\", \"description:\", f\"  - {GOOD_DESC}\"], True, True),\n    \"desc-block-seq0\":  ([\"name: desc-block-seq0\", \"description:\", f\"- {GOOD_DESC}\"], True, True),\n    \"desc-block-map\":   ([\"name: desc-block-map\", \"description:\", f\"  when: {GOOD_DESC}\"], True, True),\n    \"desc-flow-map\":    ([\"name: desc-flow-map\", \"description: {when: yes}\"], True, True),\n    \"name-flow-seq\":    ([\"name: [name-flow-seq]\", f\"description: {GOOD_DESC}\"], True, True),\n    # --- controls: strings in every supported shape must still pass ---\n    \"desc-plain-multi\": ([\"name: desc-plain-multi\", \"description:\", \"  Use when testing.\", \"  Do not use otherwise.\"], False, True),\n    \"desc-folded-then-key\": ([\"name: desc-folded-then-key\", \"description: >-\", f\"  {GOOD_DESC}\", \"metadata:\", \"  a: b\"], False, True),\n}\n\nH = f\"{T}/t5f-fx\"\nfor n, (lines, _, _) in FX.items():\n    skill(H, n, lines)\nr = run(H)\nprint(\"FIXTURES exit\", r.returncode, \"|\", r.stdout.strip().splitlines()[-1])\nfailing, reasons, cur = set(), {}, None\nfor l in r.stdout.splitlines():\n    if l.startswith(\"FAIL \"):\n        cur = l[5:]; failing.add(cur); reasons[cur] = []\n    elif cur and l.strip().startswith(\"- \"):\n        reasons[cur].append(l.strip()[2:])\nbad = []\nfor n, (lines, expect_flag, loader_ok) in FX.items():\n    flagged = n in failing\n    try:\n        doc = yaml.safe_load(\"\\n\".join(lines))\n        loads = True\n    except yaml.YAMLError:\n        doc, loads = None, False\n    note = \"\"\n    if loader_ok is not None and loads != loader_ok:\n        note = f\" (loader assumption wrong: loads={loads})\"\n    # Type agreement: whenever the loader succeeds, value_kind must match its type.\n    if loads and isinstance(doc, dict):\n        fm = \"\\n\".join(lines)\n        for k in (\"name\", \"description\"):\n            