cp__zotero__learnings","mcp__zotero__learnings_candidates","mcp__zotero__learnings_confirm","mcp__zotero__learnings_forget","mcp__zotero__learnings_list","mcp__zotero__learnings_reject","mcp__zotero__learnings_stats","mcp__zotero__playbook","mcp__zotero__playbook_amend","mcp__zotero__playbook_list","mcp__zotero__recall","mcp__zotero__search","mcp__zotero__searches_get","mcp__zotero__searches_list","mcp__zotero__sql","mcp__zotero__sync","mcp__zotero__tags_list","mcp__zotero__tail","mcp__zotero__teach","mcp__zotero__teach_lookup","mcp__zotero__teach_pattern","mcp__zotero__teach_playbook","mcp__zotero__workflow","mcp__zotero__workflow_archive","mcp__zotero__workflow_status"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":[],"failedMcpServers":[]},"type":"attachment","uuid":"1e94c060-ad45-4833-8aa4-196a6bc7c9cb","timestamp":"2026-09-13T06:05:00.969Z","rendered":[{"content":"<system-reminder>\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nCronCreate\nCronDelete\nCronList\nDesignSync\nEndConversation\nEnterPlanMode\nExitPlanMode\nExitWorktree\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nSendUserFile\nTaskCreate\nTaskGet\nTaskList\nTaskOutput\nTaskStop\nTaskUpdate\nWebFetch\nWebSearch\nmcp__claude-in-chrome__browser_batch\nmcp__claude-in-chrome__computer\nmcp__claude-in-chrome__file_upload\nmcp__claude-in-chrome__find\nmcp__claude-in-chrome__form_input\nmcp__claude-in-chrome__get_page_text\nmcp__claude-in-chrome__gif_creator\nmcp__claude-in-chrome__javascript_tool\nmcp__claude-in-chrome__list_connected_browsers\nmcp__claude-in-chrome__navigate\nmcp__claude-in-chrome__read_console_messages\nmcp__claude-in-chrome__read_network_requests\nmcp__claude-in-c