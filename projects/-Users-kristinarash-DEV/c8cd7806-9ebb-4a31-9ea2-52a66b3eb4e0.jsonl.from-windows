rite_file","mcp__plugin_desktop-commander_desktop-commander__write_pdf","mcp__plugin_pdf-viewer_pdf__display_pdf","mcp__plugin_pdf-viewer_pdf__interact","mcp__plugin_pdf-viewer_pdf__list_pdfs","mcp__zotero__analytics","mcp__zotero__cache","mcp__zotero__cache_index_fulltext","mcp__zotero__cache_reindex","mcp__zotero__cache_status","mcp__zotero__cite","mcp__zotero__collections_get","mcp__zotero__collections_items","mcp__zotero__collections_list","mcp__zotero__collections_subcollections","mcp__zotero__collections_top","mcp__zotero__collections_tree","mcp__zotero__context","mcp__zotero__deleted_list","mcp__zotero__export","mcp__zotero__full_text_deep_search","mcp__zotero__fulltext_changed","mcp__zotero__ground","mcp__zotero__items_children","mcp__zotero__items_fulltext","mcp__zotero__items_get","mcp__zotero__items_list","mcp__zotero__items_recent","mcp__zotero__items_top","mcp__zotero__items_trash","mcp__zotero__keys_current","mcp__zotero__learnings","mcp__zotero__learnings_candidates","mcp__zotero__learnings_confirm","mcp__zotero__learnings_forget","mcp__zotero__learnings_list","mcp__zotero__learnings_reject","mcp__zotero__learnings_stats","mcp__zotero__playbook","mcp__zotero__playbook_amend","mcp__zotero__playbook_list","mcp__zotero__recall","mcp__zotero__search","mcp__zotero__searches_get","mcp__zotero__searches_list","mcp__zotero__sql","mcp__zotero__sync","mcp__zotero__tags_list","mcp__zotero__tail","mcp__zotero__teach","mcp__zotero__teach_lookup","mcp__zotero__teach_pattern","mcp__zotero__teach_playbook","mcp__zotero__workflow","mcp__zotero__workflow_archive","mcp__zotero__workflow_status"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":[],"failedMcpServers":[],"surfacedNames":["mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update","mcp__claude_ai_Firecrawl__firecrawl_scrape","mcp__claude_ai_Firecrawl__firecrawl_search"],"surfacedDefinitions":[{"name":"mcp__claude_ai_Claude_Docs__batch","listing":"b18caec4513bd82d","definition":{"name":"mcp__claude_ai_Claude_Docs__batch","description":"Create a doc, or apply several operations to one doc atomically.","input_schema":{"type":"object","properties":{"batch":{"type":"array"},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"create":{"type":"object"}},"required":["kind"]},"verbose":{"type":"boolean"},"opId":{"type":"string"}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__guide","listing":"1f2c30a590811b06","definition":{"name":"mcp__claude_ai_Claude_Docs__guide","description":"Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].","input_schema":{"type":"object","properties":{"items":{"type":"array","description":"topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine."}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__update","listing":"b1347b8d2c5727e2","definition":{"name":"mcp__claude_ai_Claude_Docs__update","description":"Edit a tab's contents, rename a doc or tab, or change a stored value.","input_schema":{"type":"object","properties":{"ref":{"type":"object","properties":{"object":{"type":"string","enum":["project","file","node","utterance","enum"]},"id":{"type":"string"}},"required":["object","id"]},"engine":{"type":"string"},"payload":{"anyOf":[{"type":"object"},{"type":"string"}]},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"version":{"type":"string"}},"required":["kind","id"]},"verbose":{"type":"boolean"},"opId":{"type":"string"},"answering":{"type":"string","maxLength":64}},"required":["ref","payload"]},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Firecrawl__firecrawl_scrape","listing":"854570666ad382a8","definition":{"name":"mcp__claude_ai_Firecrawl__firecrawl_scrape","description":"\nScrape one URL and return its content, or execute catalogued Alexandria capabilities. URL mode returns markdown by default, or HTML, links, screenshots, branding data, a targeted answer, or JSON matching a supplied schema, plus page metadata. Firecrawl may serve recently indexed content; set `maxAge: 0` for a live fetch. A successful response does not by itself confirm the page is still current. A named browser profile loads saved session data without saving changes to it.\n\n`firecrawl_search` with `sources` unset and `firecrawl_find_tools` can discover providers for the same fields across several pages; a matching Alexandria provider returns typed records in one call.\n\nAlexandria mode: `alexandria` selects catalogued capability execution and is mutually exclusive with `url`. Alexandria execution is billed at the capability's listed price and needs a team with Alexandria enabled.\n","input_schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"formats":{"type":"array","items":{"type":"string","enum":["markdown","html","rawHtml","screenshot","links","summary","changeTracking","branding","json","query","audio"]}},"jsonOptions":{"type":"object","properties":{"prompt":{"type":"string"},"schema":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":false}},"additionalProperties":false},"queryOptions":{"type":"object","properties":{"prompt":{"type":"string","maxLength":10000},"mode":{"default":"freeform","type":"string","enum":["directQuote","freeform"]}},"required":["prompt"],"additionalProperties":false},"screenshotOptions":{"type":"object","properties":{"fullPage":{"type":"boolean"},"quality":{"type":"number"},"viewport":{"type":"object","properties":{"width":{"type":"number"},"height":{"type":"number"}},"required":["width","height"],"additionalProperties":false}},"additionalProperties":false},"parsers":{"type":"array","items":{"type":"string","enum":["pdf"]}},"pdfOptions":{"type":"object","properties":{"maxPages":{"type":"integer","minimum":1,"maximum":10000}},"additionalProperties":false},"onlyMainContent":{"type":"boolean"},"redactPII":{"type":"boolean"},"includeTags":{"type":"array","items":{"type":"string"}},"excludeTags":{"type":"array","items":{"type":"string"}},"waitFor":{"type":"number"},"mobile":{"type":"boolean"},"skipTlsVerification":{"type":"boolean"},"removeBase64Images":{"type":"boolean"},"location":{"type":"object","properties":{"country":{"type":"string"},"languages":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},"storeInCache":{"type":"boolean"},"zeroDataRetention":{"type":"boolean"},"maxAge":{"type":"number"},"lockdown":{"type":"boolean"},"proxy":{"type":"string","enum":["basic","stealth","enhanced","auto"]},"profile":{"description":"Loads a saved browser profile without saving changes to it.","type":"object","properties":{"name":{"type":"string"}},"required":["name"],"additionalProperties":false},"timeout":{"description":"Execution timeout in milliseconds.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"requestId":{"description":"Idempotency key bound to one Alexandria execution payload. Generated when omitted and returned with the result.","type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"alexandria":{"description":"Catalogued Alexandria capability invocation, mutually exclusive with url. One {provider, capability, options} object or an array of 1-10, with contracts available through firecrawl_search or firecrawl_find_tools. Each call may include version to pin a published workflow; omitting it uses latest. Only requestId and timeout are supported alongside alexandria. The selected contract marks required inputs and any requiresOneOf groups (at least one member per group); it may include example.request/example.response and response.key (which may differ from records). Where pagination is declared, its fields govern paging with the same filters; catalogue next is separate from provider pagination. Returns per-capability results in data.alexandria with data, records, or an error with a code; individual capabilities can fail even when the outer response succeeds. Requires an API key on a team with Alexandria enabled. Some providers require accepted terms; blocked requests return the applicable requirements.","anyOf":[{"type":"object","properties":{"provider":{"description":"Provider slug, e.g. \"fred\".","type":"string","minLength":1},"capability":{"description":"Capability address as returned by search or discover, e.g. \"series/observations\".","type":"string","minLength":1},"version":{"description":"Optional published workflow version. Omit to use the latest version.","type":"string","minLength":1,"maxLength":128},"options":{"description":"Capability options as declared by its contract.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["provider","capability"]},{"minItems":1,"maxItems":10,"type":"array","items":{"type":"object","properties":{"provider":{"description":"Provider slug, e.g. \"fred\".","type":"string","minLength":1},"capability":{"description":"Capability address as returned by search or discover, e.g. \"series/observations\".","type":"string","minLength":1},"version":{"description":"Optional published workflow version. Omit to use the latest version.","type":"string","minLength":1,"maxLength":128},"options":{"description":"Capability options as declared by its contract.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["provider","capability"]}}]},"toolDetail":{"description":"URL mode only: domain discovery detail, summary by default; compact returns provider/capability/description, full includes contracts. Ignored with alexandria.","type":"string","enum":["compact","summary","full"]},"domainTools":{"description":"URL mode only: include domain-matched Alexandria tools for the page in tools on the returned document. Ignored with alexandria.","type":"boolean"}},"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Firecrawl__firecrawl_search","listing":"b2a452ba5fcf4c86","definition":{"name":"mcp__claude_ai_Firecrawl__firecrawl_search","description":"\nSearch web and specialized indexes, returning ranked results with query-relevant highlights. Each web result is a title, URL, and description. Operators include quoted phrases, `-term`, `site:host`, `inurl:term`, `intitle:term`, and `related:host`; the set is non-exhaustive. `includeDomains` and `excludeDomains` are mutually exclusive hostname filters; categories limit result types to `research`, `pdf`, `developer`, or `gov`.\n\nFor a programming question, add `categories: [\"developer\"]`. It searches an index of public repositories, GitHub issues, merged pull requests, repository READMEs, and code documentation, and returns the results in `data.web` with `category: \"developer\"`.\n\nFor a legal or regulatory question, `categories: [\"gov\"]` returns results in `data.web` with `category: \"gov\"` and cannot be combined with other categories; `firecrawl_gov_search` is the dedicated tool.\n\nAuthenticated search combines web results, semantic tool summaries and domain matches. Use sources: [\"alexandria\"] for semantic tools only. A search with sources: [\"web\"] omits semantic provider discovery; domainTools: true can still return website-matched tools. Web-only results use domainTools: false. Tool matches describe available structured-data capabilities, not executed data. toolDetail: \"compact\" (default) returns only provider, capability and description; \"summary\" adds metadata; \"full\" includes their input and output contracts. firecrawl_scrape with an alexandria body executes a selected capability; firecrawl_find_tools provides catalogue browsing and full contracts.\n\nReturns result groups in `data` and an operation `id`.\n","input_schema":{"type":"object","properties":{"toolDetail":{"description":"Compact by default. Compact returns only provider, capability and description; full includes contracts. Inspect selected compact tools with firecrawl_find_tools providers and capabilities.","type":"string","enum":["compact","summary","full"]},"query":{"description":"Query for web and semantic tool discovery. Operators include quoted phrases, `-term`, `site:host`, `inurl:term`, `intitle:term`, and `related:host`; the set is non-exhaustive. Catalogue browsing is available through firecrawl_find_tools.","type":"string","minLength":1},"objective":{"description":"Optional broader goal for this search, if known. Avoid sensitive information.","type":"string","minLength":1,"maxLength":5000},"clientModel":{"description":"Optional model identifier, if known.","type":"string","minLength":1,"maxLength":128},"domainTools":{"description":"Include domain-matched tools for result URLs. Defaults to true when Alexandria is combined with web, news or images; semantic-only search leaves domain matching off.","type":"boolean"},"highlights":{"description":"Return query-relevant page excerpts for web and news results when available (default). Highlights appear in web `description` and news `snippet`; otherwise, original snippets are returned. Set to false to keep the original search snippets.","type":"boolean"},"limit":{"type":"integer","minimum":1,"maximum":100},"tbs":{"type":"string"},"filter":{"type":"string"},"location":{"type":"string"},"includeDomains":{"description":"Hostnames to restrict results to. Mutually exclusive with excludeDomains.","type":"array","items":{"type":"string","minLength":1,"maxLength":253,"pattern":"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"}},"excludeDomains":{"description":"Hostnames to leave out of results. Mutually exclusive with includeDomains.","type":"array","items":{"type":"string","minLength":1,"maxLength":253,"pattern":"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"}},"sources":{"description":"Search sources; authenticated sessions default to web + alexandria, keyless sessions to web only. A search with sources: [\"web\"] omits semantic provider discovery; domainTools: true can still return website-matched tools. Web-only results use domainTools: false. Use [\"alexandria\"] alone for provider discovery without web results.","type":"array","items":{"anyOf":[{"type":"string","enum":["web","images","news","alexandria","exchange"]},{"type":"object","properties":{"type":{"type":"string","enum":["web","images","news","alexandria","exchange"]}},"required":["type"],"additionalProperties":false}]}},"categories":{"description":"Limit results to specific source types. `research` restricts ordinary web results to research-affiliated websites and returns page snippets, which is separate from the `firecrawl_research_*` tools that search paper abstracts and full text across biomedical (PubMed, bioRxiv, medRxiv) and arXiv literature; `pdf` searches PDF results; `developer` searches an index built for coding agents over public repositories, GitHub issues, merged pull requests, repository READMEs, and code documentation; `gov` searches the Government Index of US federal, state, and local legal and regulatory sources, the index behind firecrawl_gov_search, and cannot be combined with other categories. `developer` and `gov` return hits in `data.web` with `category` set to their name; the other categories also filter `data.web`.","type":"array","items":{"type":"string","enum":["research","pdf","developer","gov"]}},"enterprise":{"type":"array","items":{"type":"string","enum":["default","anon","zdr"]}}},"required":["query"],"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false},"eager_input_streaming":true}}]},"type":"attachment","uuid":"ea48dc05-9f4b-42b1-9cce-0ad0301d9df8","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\nmcp__claude_ai_Firecrawl__firecrawl_scrape\nmcp__claude_ai_Firecrawl__firecrawl_search\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nArtifactComments\nArtifactData\nCronCreate\nCronDelete\nCronList\nDesignSync\nEndConversation\nEnterPlanMode\nEnterWorktree\nExitPlanMode\nExitWorktree\nFetchInboxMessage\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nSendUserFile\nTaskStop\nWebFetch\nWebSearch\nmcp__claude-in-chrome__browser_batch\nmcp__claude-in-chrome__computer\nmcp__claude-in-chrome__file_upload\nmcp__claude-in-chrome__find\nmcp__claude-in-chrome__form_input\nmcp__claude-in-chrome__get_page_text\nmcp__claude-in-chrome__gif_creator\nmcp__claude-in-chrome__javascript_tool\nmcp__claude-in-chrome__list_connected_browsers\nmcp__claude-in-chrome__navigate\nmcp__claude-in-chrome__read_console_messages\nmcp__claude-in-chrome__read_network_requests\nmcp__claude-in-chrome__read_page\nmcp__claude-in-chrome__resize_window\nmcp__claude-in-chrome__select_browser\nmcp__claude-in-chrome__shortcuts_execute\nmcp__claude-in-chrome__shortcuts_list\nmcp__claude-in-chrome__switch_browser\nmcp__claude-in-chrome__tabs_close_mcp\nmcp__claude-in-chrome__tabs_context_mcp\nmcp__claude-in-chrome__tabs_create_mcp\nmcp__claude-in-chrome__upload_image\nmcp__claude_ai_Box__authenticate\nmcp__claude_ai_Box__complete_authentication\nmcp__claude_ai_Claude_Docs__create\nmcp__claude_ai_Claude_Docs__delete\nmcp__claude_ai_Claude_Docs__export\nmcp__claude_ai_Claude_Docs__query\nmcp__claude_ai_Claude_Docs__read\nmcp__claude_ai_Firecrawl__firecrawl_developer_search\nmcp__claude_ai_Firecrawl__firecrawl_find_tools\nmcp__claude_ai_Firecrawl__firecrawl_gov_search\nmcp__claude_ai_Firecrawl__firecrawl_research_inspect_paper\nmcp__claude_ai_Firecrawl__firecrawl_research_read_paper\nmcp__claude_ai_Firecrawl__firecrawl_research_related_papers\nmcp__claude_ai_Firecrawl__firecrawl_research_search_papers\nmcp__claude_ai_Fireflies__fireflies_create_soundbite\nmcp__claude_ai_Fireflies__fireflies_fetch\nmcp__claude_ai_Fireflies__fireflies_get_active_meetings\nmcp__claude_ai_Fireflies__fireflies_get_analytics\nmcp__claude_ai_Fireflies__fireflies_get_channel\nmcp__claude_ai_Fireflies__fireflies_get_rule_executions\nmcp__claude_ai_Fireflies__fireflies_get_soundbites\nmcp__claude_ai_Fireflies__fireflies_get_summary\nmcp__claude_ai_Fireflies__fireflies_get_transcript\nmcp__claude_ai_Fireflies__fireflies_get_transcripts\nmcp__claude_ai_Fireflies__fireflies_get_user\nmcp__claude_ai_Fireflies__fireflies_get_user_contacts\nmcp__claude_ai_Fireflies__fireflies_get_usergroups\nmcp__claude_ai_Fireflies__fireflies_list_channels\nmcp__claude_ai_Fireflies__fireflies_move_meeting\nmcp__claude_ai_Fireflies__fireflies_revoke_meeting_access\nmcp__claude_ai_Fireflies__fireflies_search\nmcp__claude_ai_Fireflies__fireflies_share_meeting\nmcp__claude_ai_Fireflies__fireflies_update_meeting_privacy\nmcp__claude_ai_Fireflies__fireflies_update_meeting_title\nmcp__claude_ai_Gmail__apply_sensitive_message_label\nmcp__claude_ai_Gmail__apply_sensitive_thread_label\nmcp__claude_ai_Gmail__create_draft\nmcp__claude_ai_Gmail__create_label\nmcp__claude_ai_Gmail__delete_draft\nmcp__claude_ai_Gmail__delete_label\nmcp__claude_ai_Gmail__forward\nmcp__claude_ai_Gmail__get_draft\nmcp__claude_ai_Gmail__get_message\nmcp__claude_ai_Gmail__get_thread\nmcp__claude_ai_Gmail__label_message\nmcp__claude_ai_Gmail__label_thread\nmcp__claude_ai_Gmail__list_drafts\nmcp__claude_ai_Gmail__list_labels\nmcp__claude_ai_Gmail__mark_message_spam\nmcp__claude_ai_Gmail__mark_thread_spam\nmcp__claude_ai_Gmail__reply\nmcp__claude_ai_Gmail__search_threads\nmcp__claude_ai_Gmail__send_message\nmcp__claude_ai_Gmail__trash_message\nmcp__claude_ai_Gmail__trash_thread\nmcp__claude_ai_Gmail__unlabel_message\nmcp__claude_ai_Gmail__unlabel_thread\nmcp__claude_ai_Gmail__unmark_message_spam\nmcp__claude_ai_Gmail__unmark_thread_spam\nmcp__claude_ai_Gmail__untrash_message\nmcp__claude_ai_Gmail__untrash_thread\nmcp__claude_ai_Gmail__update_draft\nmcp__claude_ai_Gmail__update_label\nmcp__claude_ai_Gmail__update_message_labels\nmcp__claude_ai_Google_Calendar__create_event\nmcp__claude_ai_Google_Calendar__delete_event\nmcp__claude_ai_Google_Calendar__get_event\nmcp__claude_ai_Google_Calendar__list_calendars\nmcp__claude_ai_Google_Calendar__list_events\nmcp__claude_ai_Google_Calendar__respond_to_event\nmcp__claude_ai_Google_Calendar__search_events\nmcp__claude_ai_Google_Calendar__suggest_time\nmcp__claude_ai_Google_Calendar__update_event\nmcp__claude_ai_Google_Drive__copy_file\nmcp__claude_ai_Google_Drive__create_file\nmcp__claude_ai_Google_Drive__download_file_content\nmcp__claude_ai_Google_Drive__get_file_metadata\nmcp__claude_ai_Google_Drive__get_file_permissions\nmcp__claude_ai_Google_Drive__list_recent_files\nmcp__claude_ai_Google_Drive__read_file_content\nmcp__claude_ai_Google_Drive__search_files\nmcp__claude_ai_Google_Drive__share_file\nmcp__claude_ai_Google_Drive__trash_file\nmcp__claude_ai_Google_Drive__update_file\nmcp__claude_ai_HyperFrames_by_HeyGen__compose\nmcp__claude_ai_HyperFrames_by_HeyGen__get-design-import-job-status\nmcp__claude_ai_HyperFrames_by_HeyGen__get-send-to-hyperframes-guide\nmcp__claude_ai_HyperFrames_by_HeyGen__get_project\nmcp__claude_ai_HyperFrames_by_HeyGen__get_project_status\nmcp__claude_ai_HyperFrames_by_HeyGen__get_render_status\nmcp__claude_ai_HyperFrames_by_HeyGen__import-claude-design-from-url\nmcp__claude_ai_HyperFrames_by_HeyGen__list_projects\nmcp__claude_ai_HyperFrames_by_HeyGen__render_video\nmcp__claude_ai_HyperFrames_by_HeyGen__submit_feedback\nmcp__claude_ai_Wispr_Flow__get_account_info\nmcp__claude_ai_Wispr_Flow__get_calendar_event\nmcp__claude_ai_Wispr_Flow__get_meeting\nmcp__claude_ai_Wispr_Flow__get_meeting_by_calendar_id\nmcp__claude_ai_Wispr_Flow__get_meeting_participants_enriched\nmcp__claude_ai_Wispr_Flow__get_scratchpad_note\nmcp__claude_ai_Wispr_Flow__get_upcoming_meeting\nmcp__claude_ai_Wispr_Flow__list_meeting_series\nmcp__claude_ai_Wispr_Flow__list_upcoming_meetings\nmcp__claude_ai_Wispr_Flow__resolve_calendar_link\nmcp__claude_ai_Wispr_Flow__resolve_share_link\nmcp__claude_ai_Wispr_Flow__search_calendar_events\nmcp__claude_ai_Wispr_Flow__search_meetings\nmcp__claude_ai_Wispr_Flow__search_scratchpad_notes\nmcp__plugin_browser-use_browser-use__browser_exec\nmcp__plugin_browser-use_browser-use__browser_screenshot\nmcp__plugin_context-mode_context-mode__ctx_batch_execute\nmcp__plugin_context-mode_context-mode__ctx_doctor\nmcp__plugin_context-mode_context-mode__ctx_execute\nmcp__plugin_context-mode_context-mode__ctx_execute_file\nmcp__plugin_context-mode_context-mode__ctx_fetch_and_index\nmcp__plugin_context-mode_context-mode__ctx_index\nmcp__plugin_context-mode_context-mode__ctx_insight\nmcp__plugin_context-mode_context-mode__ctx_purge\nmcp__plugin_context-mode_context-mode__ctx_search\nmcp__plugin_context-mode_context-mode__ctx_stats\nmcp__plugin_context-mode_context-mode__ctx_upgrade\nmcp__plugin_data_amplitude__authenticate\nmcp__plugin_data_amplitude__complete_authentication\nmcp__plugin_data_atlassian__authenticate\nmcp__plugin_data_atlassian__complete_authentication\nmcp__plugin_desktop-commander_desktop-commander__create_directory\nmcp__plugin_desktop-commander_desktop-commander__edit_block\nmcp__plugin_desktop-commander_desktop-commander__force_terminate\nmcp__plugin_desktop-commander_desktop-commander__get_config\nmcp__plugin_desktop-commander_desktop-commander__get_file_info\nmcp__plugin_desktop-commander_desktop-commander__get_more_search_results\nmcp__plugin_desktop-commander_desktop-commander__get_prompts\nmcp__plugin_desktop-commander_desktop-commander__get_recent_tool_calls\nmcp__plugin_desktop-commander_desktop-commander__get_usage_stats\nmcp__plugin_desktop-commander_desktop-commander__give_feedback_to_desktop_commander\nmcp__plugin_desktop-commander_desktop-commander__interact_with_process\nmcp__plugin_desktop-commander_desktop-commander__kill_process\nmcp__plugin_desktop-commander_desktop-commander__list_directory\nmcp__plugin_desktop-commander_desktop-commander__list_processes\nmcp__plugin_desktop-commander_desktop-commander__list_searches\nmcp__plugin_desktop-commander_desktop-commander__list_sessions\nmcp__plugin_desktop-commander_desktop-commander__move_file\nmcp__plugin_desktop-commander_desktop-commander__read_file\nmcp__plugin_desktop-commander_desktop-commander__read_multiple_files\nmcp__plugin_desktop-commander_desktop-commander__read_process_output\nmcp__plugin_desktop-commander_desktop-commander__set_config_value\nmcp__plugin_desktop-commander_desktop-commander__start_process\nmcp__plugin_desktop-commander_desktop-commander__start_search\nmcp__plugin_desktop-commander_desktop-commander__stop_search\nmcp__plugin_desktop-commander_desktop-commander__write_file\nmcp__plugin_desktop-commander_desktop-commander__write_pdf\nmcp__plugin_pdf-viewer_pdf__display_pdf\nmcp__plugin_pdf-viewer_pdf__interact\nmcp__plugin_pdf-viewer_pdf__list_pdfs\nmcp__zotero__analytics\nmcp__zotero__cache\nmcp__zotero__cache_index_fulltext\nmcp__zotero__cache_reindex\nmcp__zotero__cache_status\nmcp__zotero__cite\nmcp__zotero__collections_get\nmcp__zotero__collections_items\nmcp__zotero__collections_list\nmcp__zotero__collections_subcollections\nmcp__zotero__collections_top\nmcp__zotero__collections_tree\nmcp__zotero__context\nmcp__zotero__deleted_list\nmcp__zotero__export\nmcp__zotero__full_text_deep_search\nmcp__zotero__fulltext_changed\nmcp__zotero__ground\nmcp__zotero__items_children\nmcp__zotero__items_fulltext\nmcp__zotero__items_get\nmcp__zotero__items_list\nmcp__zotero__items_recent\nmcp__zotero__items_top\nmcp__zotero__items_trash\nmcp__zotero__keys_current\nmcp__zotero__learnings\nmcp__zotero__learnings_candidates\nmcp__zotero__learnings_confirm\nmcp__zotero__learnings_forget\nmcp__zotero__learnings_list\nmcp__zotero__learnings_reject\nmcp__zotero__learnings_stats\nmcp__zotero__playbook\nmcp__zotero__playbook_amend\nmcp__zotero__playbook_list\nmcp__zotero__recall\nmcp__zotero__search\nmcp__zotero__searches_get\nmcp__zotero__searches_list\nmcp__zotero__sql\nmcp__zotero__sync\nmcp__zotero__tags_list\nmcp__zotero__tail\nmcp__zotero__teach\nmcp__zotero__teach_lookup\nmcp__zotero__teach_pattern\nmcp__zotero__teach_playbook\nmcp__zotero__workflow\nmcp__zotero__workflow_archive\nmcp__zotero__workflow_status\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"ea48dc05-9f4b-42b1-9cce-0ad0301d9df8","isSidechain":false,"attachment":{"type":"agent_listing_delta","addedTypes":["claude","claude-code-guide","codex:codex-rescue","Explore","general-purpose","impeccable-asset-producer","impeccable-documenter","impeccable-finish-reviewer","impeccable-manual-edit-applier","Plan","statusline-setup"],"addedLines":["- claude: Catch-all for any task that doesn't fit a more specific agent. FleetView's default when no agent name is typed. (Tools: *)","- claude-code-guide: Use this agent when the user asks questions (\"Can Claude...\", \"Does Claude...\", \"How do I...\") about: (1) Claude Code (the CLI tool) - features, hooks, slash commands, MCP servers, settings, IDE integrations, keyboard shortcuts; (2) Claude Agent SDK - building custom agents; (3) Claude API (formerly Anthropic API) - Messages API for directly passing messages to Claude, Tool Runner (`client.beta.messages.tool_runner`) for running an agentic loop over your own tools, manual tool-use loops, Managed Agents for server-hosted agents with a managed sandbox, prompt caching, and general Anthropic SDK usage; (4) Claude Tag (Claude in Slack) - what it is, setting it up for a Slack workspace, `/install-slack-app`; (5) `claude plugin eval` (writing and running plugin eval suites, its JSON/report, sandbox, CI) and the `/skill-doctor` report. **IMPORTANT:** Before spawning a new agent, check if there is already a running or recently completed claude-code-guide agent that you can continue via SendMessage. (Tools: Bash, Read, WebFetch, WebSearch)","- codex:codex-rescue: Proactively use when Claude Code is stuck, wants a second implementation or diagnosis pass, needs a deeper root-cause investigation, or should hand a substantial coding task to Codex through the shared runtime (Tools: Bash)","- Explore: Read-only search agent for broad fan-out searches — when answering means sweeping many files, directories, or naming conventions and you only need the conclusion, not the file dumps. It reads excerpts rather than whole files, so it locates code; it doesn't review or audit it. Specify search breadth: \"medium\" for moderate exploration, \"very thorough\" for multiple locations and naming conventions. (Tools: All tools except Agent, Artifact, ArtifactComments, ArtifactData, ArtifactCheck, ExitPlanMode, Edit, Write, NotebookEdit)","- general-purpose: General-purpose agent for researching complex questions, searching for code, and executing multi-step tasks. When you are searching for a keyword or file and are not confident that you will find the right match in the first few tries use this agent to perform the search for you. (Tools: *)","- impeccable-asset-producer: Produces clean reusable raster assets from approved Impeccable mock references without redesigning the direction. (Tools: Read, Write, Edit, Bash, Glob, Grep)","- impeccable-documenter: Records DESIGN.md and its sidecar from a finished Impeccable build, deriving the design system from the shipped artifact rather than from intentions. (Tools: Read, Write, Bash, Glob, Grep)","- impeccable-finish-reviewer: Reviews a finished Impeccable build against its direction contract, the approved comp, and the chosen world's quality bar, returning an ordered list of material fixes. (Tools: Read, Bash, Glob, Grep)","- impeccable-manual-edit-applier: Applies leased Impeccable live manual copy-edit batches to source and returns canonical Apply results. (Tools: Read, Write, Edit, Bash, Glob, Grep)","- Plan: Software architect agent for designing implementation plans. Use this when you need to plan the implementation strategy for a task. Returns step-by-step plans, identifies critical files, and considers architectural trade-offs. (Tools: All tools except Agent, Artifact, ArtifactComments, ArtifactData, ArtifactCheck, ExitPlanMode, Edit, Write, NotebookEdit)","- statusline-setup: Use this agent to configure the user's Claude Code status line setting. (Tools: Read, Edit)"],"builtInTypes":["claude","claude-code-guide","Explore","general-purpose","Plan","statusline-setup"],"removedTypes":[],"isInitial":true,"showConcurrencyNote":true},"type":"attachment","uuid":"41e99eef-0350-4701-92c6-d2ce12e46c95","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\nAvailable agent types for the Agent tool:\n- claude: Catch-all for any task that doesn't fit a more specific agent. FleetView's default when no agent name is typed. (Tools: *)\n- claude-code-guide: Use this agent when the user asks questions (\"Can Claude...\", \"Does Claude...\", \"How do I...\") about: (1) Claude Code (the CLI tool) - features, hooks, slash commands, MCP servers, settings, IDE integrations, keyboard shortcuts; (2) Claude Agent SDK - building custom agents; (3) Claude API (formerly Anthropic API) - Messages API for directly passing messages to Claude, Tool Runner (`client.beta.messages.tool_runner`) for running an agentic loop over your own tools, manual tool-use loops, Managed Agents for server-hosted agents with a managed sandbox, prompt caching, and general Anthropic SDK usage; (4) Claude Tag (Claude in Slack) - what it is, setting it up for a Slack workspace, `/install-slack-app`; (5) `claude plugin eval` (writing and running plugin eval suites, its JSON/report, sandbox, CI) and the `/skill-doctor` report. **IMPORTANT:** Before spawning a new agent, check if there is already a running or recently completed claude-code-guide agent that you can continue via SendMessage. (Tools: Bash, Read, WebFetch, WebSearch)\n- codex:codex-rescue: Proactively use when Claude Code is stuck, wants a second implementation or diagnosis pass, needs a deeper root-cause investigation, or should hand a substantial coding task to Codex through the shared runtime (Tools: Bash)\n- Explore: Read-only search agent for broad fan-out searches — when answering means sweeping many files, directories, or naming conventions and you only need the conclusion, not the file dumps. It reads excerpts rather than whole files, so it locates code; it doesn't review or audit it. Specify search breadth: \"medium\" for moderate exploration, \"very thorough\" for multiple locations and naming conventions. (Tools: All tools except Agent, Artifact, ArtifactComments, ArtifactData, ArtifactCheck, ExitPlanMode, Edit, Write, NotebookEdit)\n- general-purpose: General-purpose agent for researching complex questions, searching for code, and executing multi-step tasks. When you are searching for a keyword or file and are not confident that you will find the right match in the first few tries use this agent to perform the search for you. (Tools: *)\n- impeccable-asset-producer: Produces clean reusable raster assets from approved Impeccable mock references without redesigning the direction. (Tools: Read, Write, Edit, Bash, Glob, Grep)\n- impeccable-documenter: Records DESIGN.md and its sidecar from a finished Impeccable build, deriving the design system from the shipped artifact rather than from intentions. (Tools: Read, Write, Bash, Glob, Grep)\n- impeccable-finish-reviewer: Reviews a finished Impeccable build against its direction contract, the approved comp, and the chosen world's quality bar, returning an ordered list of material fixes. (Tools: Read, Bash, Glob, Grep)\n- impeccable-manual-edit-applier: Applies leased Impeccable live manual copy-edit batches to source and returns canonical Apply results. (Tools: Read, Write, Edit, Bash, Glob, Grep)\n- Plan: Software architect agent for designing implementation plans. Use this when you need to plan the implementation strategy for a task. Returns step-by-step plans, identifies critical files, and considers architectural trade-offs. (Tools: All tools except Agent, Artifact, ArtifactComments, ArtifactData, ArtifactCheck, ExitPlanMode, Edit, Write, NotebookEdit)\n- statusline-setup: Use this agent to configure the user's Claude Code status line setting. (Tools: Read, Edit)\n\nWhen you launch multiple agents for independent work, send them in a single message with multiple tool uses so they run concurrently.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"41e99eef-0350-4701-92c6-d2ce12e46c95","isSidechain":false,"attachment":{"type":"mcp_instructions_delta","addedNames":["claude-in-chrome","claude.ai Claude Docs","claude.ai Firecrawl","claude.ai HyperFrames by HeyGen","claude.ai Wispr Flow","plugin:browser-use:browser-use"],"addedBlocks":["## claude-in-chrome\n**IMPORTANT: If the Chrome browser tools are deferred (must be loaded via ToolSearch before use), load them with ToolSearch before calling them, and batch every tool you expect to need into ONE ToolSearch call (the select query accepts a comma-separated list). Do NOT load tools one at a time; each separate ToolSearch call wastes a full round-trip.**\n\nStart a browser task whose tools are not yet loaded with a single call loading the core set:\n\nToolSearch with query \"select:mcp__claude-in-chrome__tabs_context_mcp,mcp__claude-in-chrome__navigate,mcp__claude-in-chrome__computer,mcp__claude-in-chrome__read_page,mcp__claude-in-chrome__tabs_create_mcp,mcp__claude-in-chrome__tabs_close_mcp\"\n\nAdd task-specific tools to the same call when the task obviously needs them: read_console_messages / read_network_requests for debugging, form_input for forms, gif_creator for recordings, javascript_tool for page scripting. Only issue a second ToolSearch if the task later needs a tool you did not anticipate.","## claude.ai Claude Docs\nClaude Docs: living docs you create and edit here. A docs skill your client lists → load it before any docs call — also before a `read`, comment or tab change on a claude.ai …/artifact/… link (the link is a doc; never web-fetch it). No docs skill or guide text loaded → `guide( items = [\"topic.index\"] )` alone before any docs call but a doc's birth. Make a doc here — not a local file, even when coding — only when the user asks for one, and make it FIRST: the turn's first tool call is its skeleton (title, byline, a `pending` block per section) — a reflex: send it before any search, file read, plan, `guide` or thinking it through; think once it is open — `batch( container = {\"kind\":\"project\",\"create\":{\"name\":\"<title>\",\"doc\":{\"blocks\":{\"asof\":{\"type\":\"date\",\"value\":\"<today>\"},\"me\":{\"type\":\"mention\",\"user\":\"me\"},\"s1\":{\"type\":\"pending\",\"intent\":\"Goals: the three outcomes this quarter commits to\"},\"s2\":{…}},\"markdown\":\"# <title>\\n\\n<?claude block asof?> · <?claude block me?>\\n\\n<?claude block s1?>\\n\\n<?claude block s2?>\"}}}, batch = [] )` (`<?claude block k?>` ↔ `blocks.k`); its ack links the doc → `open` it with your Artifact tool (none → start your next message with the link, once); they're likely watching it fill — keep them posted in a short line naming what you're on (outline up; now <topic>); findings go in the doc, not chat; then `guide( items = [\"topic.index\"] )`, research, and fill each section: `replace` its pending id with `## <heading>` + body; end with one line + the link, never the document. Summoned by a doc comment (turn headed `[Artifact comment sent to Claude]`, `;thread=<root id>`): answer ONLY with a doc comment under that root (`create` an utterance, parent `<root id>`) — no artifact/platform comment tool: that relay thread is resolved and never reaches the doc; an edit asked there → `update` with `answering: \"<root id>\"`.","## claude.ai Firecrawl\nAuthenticated search combines web results, semantic tool summaries and domain matches. Use sources: [\"alexandria\"] for semantic tools only. A search with sources: [\"web\"] omits semantic provider discovery; domainTools: true can still return website-matched tools. Web-only results use domainTools: false. Tool matches describe available structured-data capabilities, not executed data. toolDetail: \"compact\" (default) returns only provider, capability and description; \"summary\" adds metadata; \"full\" includes their input and output contracts. firecrawl_scrape with an alexandria body executes a selected capability; firecrawl_find_tools provides catalogue browsing and full contracts. Firecrawl provides web, developer, government, and research search, and executes catalogued Alexandria data providers. Use firecrawl_search to find relevant results across the web and specialized indexes; authenticated searches also return matching Alexandria providers in data.tools. firecrawl_find_tools provides catalogue browsing and provider contracts; firecrawl_scrape with an alexandria body executes a selected capability; firecrawl_scrape with a url retrieves one supplied page. For a programming question, firecrawl_developer_search searches indexed public repositories, GitHub issues, merged pull requests, READMEs, and code documentation and returns the matched passages, and skills: \"only\" narrows it to agent-skill files; firecrawl_search with categories: [\"developer\"] reaches the same index beside ordinary web results, returning the hits in the web group rather than as passages and offering no skills filter. For a legal or regulatory question, firecrawl_gov_search searches primary law and regulatory material from US federal, state, and local government sources: statutes, regulations, codes, court opinions, and other government publications; firecrawl_search with categories: [\"gov\"] reaches the same sources in the web group and cannot be combined with other categories. For a biomedical, life-science, clinical, or arXiv literature questi… [truncated]","## claude.ai HyperFrames by HeyGen\n\n[HeyGen HyperFrames MCP] — Programmable HTML video projects.\n\n## When to use this MCP\n\nThis MCP is the primary HyperFrames surface for hosted chat clients (Claude.ai\nweb/desktop, ChatGPT, Grok, and similar), where the user has no local filesystem\nand the agent cannot author HyperFrames code directly.\n\nFrom a CLI/IDE agent on the user's machine (Claude Code, Cursor, Codex, the\nlocalhost MCP Inspector, etc.), **`compose` and `render_video` are disabled** — these clients have a local\nfilesystem, so author HyperFrames with the local HyperFrames skills instead, which\nproduce standalone HTML compositions the user can edit, diff, and commit. Calls to\nthose two tools from such clients are rejected with a pointer to install them:\n\n    npx skills add heygen-com/hyperframes\n\nThe read tools (list_projects, get_project, get_project_status, get_render_status)\nstay available to every client.\n\nAfter installation they expose slash commands like `/hyperframes` (compose),\n`/hyperframes-cli` (init, lint, preview, render), and `/hyperframes-media`\n(TTS, transcribe, remove-background). See\nhttps://github.com/heygen-com/hyperframes for the full skill list and docs.\n\nBut the skills and this MCP are *not* drop-in equivalents:\n\n- Local skills → standalone HTML/GSAP files on disk. No `project_id`, no hosted\n  artifact, no integrated cloud render pipeline.\n- This MCP → hosted HeyGen project with a `project_id`, a live canvas at\n  `app.heygen.com/projects/{id}`, and the cloud render queue.\n\nRoute by what the user actually wants:\n- \"Make a local HTML composition / something I can edit\" → use a local skill.\n- \"Make a HeyGen project I can share / render in the cloud / open in the app\"\n  → use this MCP, even from a CLI agent.\n\n## What it does\n\nHyperFrames is HeyGen's framework for creating, editing, and rendering programmable\nHTML-based video projects. Projects are authored interactively (Magic Edit\nchat-driven flow) and rendered to MP4, WebM, or MOV at any framerate. Tools exposed\nhere cover composing, listing, fetching, and rendering projects… [truncated]","## claude.ai Wispr Flow\nUse this server when the user asks about meetings, notes, transcripts, or calendar information stored in Wispr Flow. For questions that may span multiple connected sources, use the relevant sources needed to answer the request. Read https://notes.wisprflow.ai/shared/ links with resolve_share_link rather than fetching the page. All timestamps returned by these tools are UTC (ISO 8601, ending in 'Z'). Before showing any time to the user, convert it to their local time zone — never present the raw UTC value.","## plugin:browser-use:browser-use\n---\nname: browser-use\ndescription: \"Direct browser control via CDP for web interaction: automation, scraping, testing, screenshots, and site/app work.\"\nhomepage: https://browser-use.com\nmetadata:\n  {\n    \"openclaw\":\n      {\n        \"requires\": { \"bins\": [\"browser-use\"] },\n        \"install\":\n          [\n            {\n              \"id\": \"uv\",\n              \"kind\": \"uv\",\n              \"package\": \"browser-use\",\n              \"bins\": [\"browser-use\"],\n              \"label\": \"Install Browser Use CLI (uv)\",\n            },\n          ],\n      },\n  }\n---\n\n# Browser Use\n\nDirect browser control via CDP. For task-specific edits, use `agent-workspace/agent_helpers.py`. For setup, install, or connection problems, read https://github.com/browser-use/browser-harness/blob/main/install.md.\n\n## When Not to Use\n\nA basic fetch of public information needs no browser. If a plain HTTP request can read it — a public page, an API, docs — use `curl` or your fetch tool, and leave the browser alone. Use browser-use when the task needs interaction (click, type, navigate), the user's logged-in session, JS rendering, or a bot-protected page. If a direct fetch fails or returns a shell page, then escalate to the browser.\n\nDomain skills are off by default. Set `BH_DOMAIN_SKILLS=1` to enable them; see the bottom section.\n\n**If `BH_DOMAIN_SKILLS=1` and the task is site-specific, read every file in the matching `$BH_AGENT_WORKSPACE/domain-skills/<site>/` directory before inventing an approach.**\n\n## Usage\n\n```bash\nbrowser-use <<'PY'\nprint(page_info())\nPY\n```\n\n- Invoke as `browser-use`. Use heredocs for multi-line commands.\n- Helpers are pre-imported. `run.py` calls `ensure_daemon()` before `exec`.\n- First navigation for a task is `new_tab(url)`, not `goto_url(url)`. The daemon\n  preserves the attached tab across separate CLI invocations, so do not call\n  `new_tab()` again in every script.\n- Keep one working tab per task/site. Before opening another, inspect\n  `current_tab()` and `list_tabs()` and use `switch_tab()` to reuse a matching\n  tab. Do not le… [truncated]"],"removedNames":[]},"type":"attachment","uuid":"5175279a-61f6-4558-b7e3-84a5a2bae307","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\n# MCP Server Instructions\n\nThe following MCP servers have provided instructions for how to use their tools and resources:\n\n## claude-in-chrome\n**IMPORTANT: If the Chrome browser tools are deferred (must be loaded via ToolSearch before use), load them with ToolSearch before calling them, and batch every tool you expect to need into ONE ToolSearch call (the select query accepts a comma-separated list). Do NOT load tools one at a time; each separate ToolSearch call wastes a full round-trip.**\n\nStart a browser task whose tools are not yet loaded with a single call loading the core set:\n\nToolSearch with query \"select:mcp__claude-in-chrome__tabs_context_mcp,mcp__claude-in-chrome__navigate,mcp__claude-in-chrome__computer,mcp__claude-in-chrome__read_page,mcp__claude-in-chrome__tabs_create_mcp,mcp__claude-in-chrome__tabs_close_mcp\"\n\nAdd task-specific tools to the same call when the task obviously needs them: read_console_messages / read_network_requests for debugging, form_input for forms, gif_creator for recordings, javascript_tool for page scripting. Only issue a second ToolSearch if the task later needs a tool you did not anticipate.\n\n## claude.ai Claude Docs\nClaude Docs: living docs you create and edit here. A docs skill your client lists → load it before any docs call — also before a `read`, comment or tab change on a claude.ai …/artifact/… link (the link is a doc; never web-fetch it). No docs skill or guide text loaded → `guide( items = [\"topic.index\"] )` alone before any docs call but a doc's birth. Make a doc here — not a local file, even when coding — only when the user asks for one, and make it FIRST: the turn's first tool call is its skeleton (title, byline, a `pending` block per section) — a reflex: send it before any search, file read, plan, `guide` or thinking it through; think once it is open — `batch( container = {\"kind\":\"project\",\"create\":{\"name\":\"<title>\",\"doc\":{\"blocks\":{\"asof\":{\"type\":\"date\",\"value\":\"<today>\"},\"me\":{\"type\":\"mention\",\"user\":\"me\"},\"s1\":{\"type\":\"pending\",\"intent\":\"Goals: the three outcomes this quarter commits to\"},\"s2\":{…}},\"markdown\":\"# <title>\\n\\n<?claude block asof?> · <?claude block me?>\\n\\n<?claude block s1?>\\n\\n<?claude block s2?>\"}}}, batch = [] )` (`<?claude block k?>` ↔ `blocks.k`); its ack links the doc → `open` it with your Artifact tool (none → start your next message with the link, once); they're likely watching it fill — keep them posted in a short line naming what you're on (outline up; now <topic>); findings go in the doc, not chat; then `guide( items = [\"topic.index\"] )`, research, and fill each section: `replace` its pending id with `## <heading>` + body; end with one line + the link, never the document. Summoned by a doc comment (turn headed `[Artifact comment sent to Claude]`, `;thread=<root id>`): answer ONLY with a doc comment under that root (`create` an utterance, parent `<root id>`) — no artifact/platform comment tool: that relay thread is resolved and never reaches the doc; an edit asked there → `update` with `answering: \"<root id>\"`.\n\n## claude.ai Firecrawl\nAuthenticated search combines web results, semantic tool summaries and domain matches. Use sources: [\"alexandria\"] for semantic tools only. A search with sources: [\"web\"] omits semantic provider discovery; domainTools: true can still return website-matched tools. Web-only results use domainTools: false. Tool matches describe available structured-data capabilities, not executed data. toolDetail: \"compact\" (default) returns only provider, capability and description; \"summary\" adds metadata; \"full\" includes their input and output contracts. firecrawl_scrape with an alexandria body executes a selected capability; firecrawl_find_tools provides catalogue browsing and full contracts. Firecrawl provides web, developer, government, and research search, and executes catalogued Alexandria data providers. Use firecrawl_search to find relevant results across the web and specialized indexes; authenticated searches also return matching Alexandria providers in data.tools. firecrawl_find_tools provides catalogue browsing and provider contracts; firecrawl_scrape with an alexandria body executes a selected capability; firecrawl_scrape with a url retrieves one supplied page. For a programming question, firecrawl_developer_search searches indexed public repositories, GitHub issues, merged pull requests, READMEs, and code documentation and returns the matched passages, and skills: \"only\" narrows it to agent-skill files; firecrawl_search with categories: [\"developer\"] reaches the same index beside ordinary web results, returning the hits in the web group rather than as passages and offering no skills filter. For a legal or regulatory question, firecrawl_gov_search searches primary law and regulatory material from US federal, state, and local government sources: statutes, regulations, codes, court opinions, and other government publications; firecrawl_search with categories: [\"gov\"] reaches the same sources in the web group and cannot be combined with other categories. For a biomedical, life-science, clinical, or arXiv literature questi… [truncated]\n\n## claude.ai HyperFrames by HeyGen\n\n[HeyGen HyperFrames MCP] — Programmable HTML video projects.\n\n## When to use this MCP\n\nThis MCP is the primary HyperFrames surface for hosted chat clients (Claude.ai\nweb/desktop, ChatGPT, Grok, and similar), where the user has no local filesystem\nand the agent cannot author HyperFrames code directly.\n\nFrom a CLI/IDE agent on the user's machine (Claude Code, Cursor, Codex, the\nlocalhost MCP Inspector, etc.), **`compose` and `render_video` are disabled** — these clients have a local\nfilesystem, so author HyperFrames with the local HyperFrames skills instead, which\nproduce standalone HTML compositions the user can edit, diff, and commit. Calls to\nthose two tools from such clients are rejected with a pointer to install them:\n\n    npx skills add heygen-com/hyperframes\n\nThe read tools (list_projects, get_project, get_project_status, get_render_status)\nstay available to every client.\n\nAfter installation they expose slash commands like `/hyperframes` (compose),\n`/hyperframes-cli` (init, lint, preview, render), and `/hyperframes-media`\n(TTS, transcribe, remove-background). See\nhttps://github.com/heygen-com/hyperframes for the full skill list and docs.\n\nBut the skills and this MCP are *not* drop-in equivalents:\n\n- Local skills → standalone HTML/GSAP files on disk. No `project_id`, no hosted\n  artifact, no integrated cloud render pipeline.\n- This MCP → hosted HeyGen project with a `project_id`, a live canvas at\n  `app.heygen.com/projects/{id}`, and the cloud render queue.\n\nRoute by what the user actually wants:\n- \"Make a local HTML composition / something I can edit\" → use a local skill.\n- \"Make a HeyGen project I can share / render in the cloud / open in the app\"\n  → use this MCP, even from a CLI agent.\n\n## What it does\n\nHyperFrames is HeyGen's framework for creating, editing, and rendering programmable\nHTML-based video projects. Projects are authored interactively (Magic Edit\nchat-driven flow) and rendered to MP4, WebM, or MOV at any framerate. Tools exposed\nhere cover composing, listing, fetching, and rendering projects… [truncated]\n\n## claude.ai Wispr Flow\nUse this server when the user asks about meetings, notes, transcripts, or calendar information stored in Wispr Flow. For questions that may span multiple connected sources, use the relevant sources needed to answer the request. Read https://notes.wisprflow.ai/shared/ links with resolve_share_link rather than fetching the page. All timestamps returned by these tools are UTC (ISO 8601, ending in 'Z'). Before showing any time to the user, convert it to their local time zone — never present the raw UTC value.\n\n## plugin:browser-use:browser-use\n---\nname: browser-use\ndescription: \"Direct browser control via CDP for web interaction: automation, scraping, testing, screenshots, and site/app work.\"\nhomepage: https://browser-use.com\nmetadata:\n  {\n    \"openclaw\":\n      {\n        \"requires\": { \"bins\": [\"browser-use\"] },\n        \"install\":\n          [\n            {\n              \"id\": \"uv\",\n              \"kind\": \"uv\",\n              \"package\": \"browser-use\",\n              \"bins\": [\"browser-use\"],\n              \"label\": \"Install Browser Use CLI (uv)\",\n            },\n          ],\n      },\n  }\n---\n\n# Browser Use\n\nDirect browser control via CDP. For task-specific edits, use `agent-workspace/agent_helpers.py`. For setup, install, or connection problems, read https://github.com/browser-use/browser-harness/blob/main/install.md.\n\n## When Not to Use\n\nA basic fetch of public information needs no browser. If a plain HTTP request can read it — a public page, an API, docs — use `curl` or your fetch tool, and leave the browser alone. Use browser-use when the task needs interaction (click, type, navigate), the user's logged-in session, JS rendering, or a bot-protected page. If a direct fetch fails or returns a shell page, then escalate to the browser.\n\nDomain skills are off by default. Set `BH_DOMAIN_SKILLS=1` to enable them; see the bottom section.\n\n**If `BH_DOMAIN_SKILLS=1` and the task is site-specific, read every file in the matching `$BH_AGENT_WORKSPACE/domain-skills/<site>/` directory before inventing an approach.**\n\n## Usage\n\n```bash\nbrowser-use <<'PY'\nprint(page_info())\nPY\n```\n\n- Invoke as `browser-use`. Use heredocs for multi-line commands.\n- Helpers are pre-imported. `run.py` calls `ensure_daemon()` before `exec`.\n- First navigation for a task is `new_tab(url)`, not `goto_url(url)`. The daemon\n  preserves the attached tab across separate CLI invocations, so do not call\n  `new_tab()` again in every script.\n- Keep one working tab per task/site. Before opening another, inspect\n  `current_tab()` and `list_tabs()` and use `switch_tab()` to reuse a matching\n  tab. Do not le… [truncated]\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"5175279a-61f6-4558-b7e3-84a5a2bae307","isSidechain":false,"attachment":{"type":"skill_listing","content":"- anti-sleep\n- articulation-skill: Help users explain complex ideas simply to non-technical audiences with proven communication frameworks. Use when users need to explain technical concepts, structure presentations or writing, create clear documentation, improve communication clarity, or translate jargon into accessible language. Triggers include requests like \"help me explain this clearly\", \"how do I structure this presentation\", \"make this less technical\", \"help me articulate this idea\", or any request to simplify complex communication. Do not use for building a slide deck (use five-slides-generator or research-in-5) or for light copyediting of text that is already clear.\n- ArXiv\n- backup\n- brain-audit\n- capture-insight\n- claude-stack-doctor: Health-check Eric's automation/memory stack in one pass and verify the Mac-to-Windows handoff works: launchd agents / Windows scheduled tasks, Python venvs, memsearch, the memory-compiler flush pipeline, backup freshness, and context budget. Use when the user says \"/claude-stack-doctor\", \"stack doctor\", \"is my stack healthy\", \"did my scheduled jobs run\", \"check the memory pipeline\", \"why didn't the backup run\", or when closeout/morning sessions should verify automation health. Do not use to run the backup itself (use backup) or to audit context-engineering practice (use doctor-plus).\n- claudex-loop\n- claudex-route\n- cli-hub-meta-skill\n- closeout\n- codex-build\n- codex-review: Have Codex independently review an existing implementation plan while Claude coordinates a bounded revision loop. For automatic reviewer selection from either host, use claudex-loop with mode=review.\n- decision-audit: Decision Drain Audit: sort the decisions Eric has been avoiding into four buckets (decide now, needs one piece of information, waiting on someone, not mine), name why they are stuck, give 3 tiny next actions, then optionally decide them and record each answer where it lives. Use when the user says \"/decision-audit\", \"decision drain audit\", \"what decisions am I avoiding\", \"what's stuck\", \"fill out my pending decisions\", or \"let's work through the decisions\". Do not use for the Friday synthesis (use weekly-review), ranking projects (use project), or the biweekly report (use status-report).\n- design-taste-frontend\n- dev-sync\n- doctor-plus\n- fireflies-intake: One-command Fireflies pipeline — sync new meeting transcripts into the SecondBrain vault, rename generically-titled meetings, then report exactly what was ingested. Use when the user says \"/fireflies-intake\", \"ingest my recent fireflies meetings\", \"sync meetings that aren't in the second brain yet\", \"pull in the new meetings\", \"meeting ingestion\", or asks whether all recent meetings have been ingested. Do not use to search what was said in transcripts (use pp-fireflies).\n- five-slides-generator\n- forecast-capture\n- graphify: Use for any question about a codebase, its architecture, file relationships, or project content — especially when graphify-out/ exists, where the question should be treated as a graphify query first. Turns any input (code, docs, papers, images, videos) into a persistent knowledge graph with god nodes, community detection, and query/path/explain tools. Do not use for a quick lookup of one known file or symbol, or for sport-science literature questions (use sports-science-research-grounding).\n- harvest\n- html-to-pdf: Render any local HTML report, deck, or dashboard to a print-ready PDF via headless Chrome — replaces the manual Ctrl+P → Save as PDF ritual. Use when the user says \"export this to PDF\", \"print version\", \"PDF for the coaches\", \"make this printable\", or a coach-facing HTML deliverable needs a shareable/printable copy. Do not use to build the report or deck itself (use status-report or five-slides-generator).\n- impeccable: Use when the user wants to design, redesign, shape, critique, audit, polish, clarify, distill, harden, optimize, adapt, animate, colorize, extract, or otherwise improve a frontend interface. Covers websites, landing pages, dashboards, product UI, app shells, components, forms, settings, onboarding, and empty states. Handles UX review, visual hierarchy, information architecture, cognitive load, accessibility, performance, responsive behavior, theming, anti-patterns, typography, fonts, spacing, layout, alignment, color, motion, micro-interactions, UX copy, error states, edge cases, i18n, and reusable design systems or tokens. Also use for bland designs that need to become bolder or more delightful, loud designs that should become quieter, live browser iteration on UI elements, or ambitious visual effects that should feel technically extraordinary. Not for backend-only or non-UI tasks.\n- improve-system\n- ingest-book\n- ingest-resource\n- interview-me\n- ISA\n- library-advisor\n- library-review\n- meeting-prep: Pre-meeting readiness brief for a project — what changed, what's open, every deliverable path. Use when the user says \"/meeting-prep <project>\", \"I have a meeting with <person> — are we in a good spot on <project>?\", \"verify we're up to speed before the meeting\", \"get me ready for this afternoon's meeting\", or names an upcoming coach/staff meeting. Do not use for the biweekly supervisor report (use status-report) or to sync meeting transcripts (use meeting-sync).\n- meeting-sync\n- memory-write: Writes, updates, removes, and recalls facts in the two-tier memory system (~/.claude/global-memory/ and ~/.claude/projects/<slug>/memory/). Use for write requests such as \"remember this\", \"note that\", \"update memory\", \"save this\", and \"forget about\", and for recall requests such as \"did we already…?\", \"what did we decide about X?\", and \"do you remember…?\". Picks the tier, dedups, and enforces caps; recall checks the injected snapshot, then memsearch. Do not use for a story or lesson worth a vault note (use capture-insight) or an article to keep (use ingest-resource).\n- name-meetings: Detects Fireflies meetings with generic titles (empty, \"Zoom Meeting\", \"Recording\", date-only, etc.), proposes structured names based on AI summary + participants, and applies approved renames via the Fireflies API. Use when user says \"/name-meetings\", \"name my meetings\", \"rename untitled meetings\", \"fix meeting titles\", \"my meetings have no names\", or when invoked by meeting-sync. Do not use to sync transcripts or audit vault filenames (use meeting-sync).\n- new-project\n- next-decision\n- pbir-report-builder\n- persistent-localhost\n- pp-catapult-openfield-connect\n- pp-zotero-research-library\n- project: Manage the portfolio project registry (ideas, updates, ranking, promotion, dev stages, start/park/done, receivers) and open the live project board. Use when the user says \"/project\", \"new idea:\", \"log progress on\", \"project update\", \"add to my project inbox\", \"show my projects\", \"re-rank my projects\", \"set the stage on\", \"mark <project> as spec'd/planned/shipped\", \"start/park <project>\". Do not use for the DEV drift dashboard (use project-triage) or to scaffold a new repo (use new-project).\n- project-triage\n- research-in-5: Build a \"Research in 5\" weekly paper review for Baylor Athletics staff: a 5-slide deck (dark and light), a Teams post, and a staff email from one paper. Use when the user says \"/research-in-5\", \"research in 5 on this paper\", \"weekly research review\", \"review this paper for the staff\", \"make the slides for this paper\", hands over a paper (PDF, DOI, URL, Zotero item), or wants a review rebuilt or versioned (#001, v2). Do not use for a sport-science question (use sports-science-research-grounding), a deck with no single paper (use five-slides-generator), or a plain Zotero search.\n- Science\n- scroll-craft\n- session-miner\n- sports-science-research-grounding: Use when the user asks a substantive question about sport science, return to play or sport, rehabilitation, strength and conditioning, workload, recovery, testing, athlete health, injury, performance, or wants a research-backed answer, and for Zotero full-library batch processing. Searches the user's Zotero library first, clearly labels external peer-reviewed fallback sources, and applies tier-aware model routing during bounded batch work. Do not use for sports scores or schedules (use pp-espn) or for a simple Zotero search or sync (use pp-zotero-research-library).\n- startup\n- status-report: Build the every-two-weeks Applied Performance status report for Kenny Boyd and Chris Ruf — paste-ready email, one-page PDF, internal record. Use when the user says \"/status-report\", \"build my status report\", \"time for the Chris report\", \"biweekly update\", \"status update for Chris and Kenny\", \"what do I send Chris this week\", or when a scheduled report date arrives. Do not use for a single meeting brief (use meeting-prep) or the end-of-day supervisor log interview (use interview-me).\n- weekly-review\n- codex:rescue: Delegate investigation, an explicit fix request, or follow-up rescue work to the Codex rescue subagent\n- codex:setup: Check whether the local Codex CLI is ready and optionally toggle the stop-time review gate\n- firecrawl:skill-gen: Generate a complete Agent Skill from a documentation URL using Firecrawl\n- pdf-viewer:annotate: Collaboratively annotate a PDF — propose markup, review together, iterate\n- pdf-viewer:fill-form: Fill PDF form fields interactively with live visual feedback\n- pdf-viewer:open: Open a PDF in the interactive viewer\n- pdf-viewer:sign: Place a signature or initials image on a PDF\n- superpowers:brainstorming: You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.\n- superpowers:diagnosing-superpowers: Use when a superpowers session went wrong and your human partner wants to know why — repeated work, ignored plans, stumbles, poor results, a skill that didn't fire, \"it took too long\", \"why is it so expensive\", \"what is it doing\" — or wants to build a bug report for the superpowers maintainers, for the current session or a past one identified by id or path, on any harness.\n- superpowers:dispatching-parallel-agents: Use when facing 2+ independent tasks that can be worked on without shared state or sequential dependencies\n- superpowers:executing-plans: Use when executing an implementation plan in the current session as the implementer yourself — your human partner chose inline execution, or no subagent tool is available\n- superpowers:finishing-a-development-branch: Use when implementation is complete, all tests pass, and you need to decide how to integrate the work\n- superpowers:receiving-code-review: Use when receiving code review feedback, before implementing suggestions, especially if feedback seems unclear or technically questionable - requires technical rigor and verification, not performative agreement or blind implementation\n- superpowers:requesting-code-review: Use when completing tasks, implementing major features, or before merging to verify work meets requirements\n- superpowers:subagent-driven-development: Use when executing implementation plans with independent tasks in the current session\n- superpowers:systematic-debugging: Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes\n- superpowers:test-driven-development: Use when implementing any feature or bugfix, before writing implementation code\n- superpowers:using-git-worktrees: Use when starting feature work that needs isolation from current workspace or before executing implementation plans - ensures an isolated workspace exists via native tools or git worktree fallback\n- superpowers:using-superpowers: Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions\n- superpowers:verification-before-completion: Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always\n- superpowers:writing-plans: Use when you have a spec or requirements for a multi-step task, before touching code\n- superpowers:writing-skills: Use when creating new skills, editing existing skills, or verifying skills work before deployment\n- last30days:last30days: Research what people actually say about any topic in the last 30 days. Pulls posts and engagement from Reddit, X, YouTube, TikTok, Hacker News, Polymarket, GitHub, and the web. Includes a doctor health check to diagnose broken or missing sources.\n- context-mode:context-mode: Use context-mode tools (ctx_execute, ctx_execute_file) instead of Bash/cat when processing\nlarge outputs. Triggers: \"analyze logs\", \"summarize output\", \"process data\",\n\"parse JSON\", \"filter results\", \"extract errors\", \"check build output\",\n\"analyze dependencies\", \"process API response\", \"large file analysis\",\n\"page snapshot\", \"browser snapshot\", \"DOM structure\", \"inspect page\",\n\"accessibility tree\", \"Playwright snapshot\",\n\"run tests\", \"test output\", \"coverage report\", \"git log\", \"recent commits\",\n\"diff between branches\", \"list containers\", \"pod status\", \"disk usage\",\n\"fetch docs\", \"API reference\", \"index documentation\",\n\"call API\", \"check response\", \"query results\",\n\"find TODOs\", \"count lines\", \"codebase statistics\", \"security audit\",\n\"outdated packages\", \"dependency tree\", \"cloud resources\", \"CI/CD output\".\nAlso triggers on ANY MCP tool output that may exceed 20 lines.\nSubagent routing is handled automatically via PreToolUse hook.\n- context-mode:ctx-doctor: Run context-mode diagnostics. Checks runtimes, hooks, FTS5,\nplugin registration, npm and marketplace versions.\nTrigger: /context-mode:ctx-doctor\n- context-mode:ctx-index: Index a local file or directory into context-mode's persistent FTS5 knowledge base\nso future ctx_search calls can retrieve focused snippets without rereading raw files.\nTrigger: /context-mode:ctx-index\n- context-mode:ctx-insight: Open the context-mode Insight dashboard in your default browser.\nInsight is the hosted analytics layer for AI-assisted engineering teams —\nper-engineer productive rate, retry waste, blocker detection, role-narrowed views.\nTrigger: /context-mode:ctx-insight\n- context-mode:ctx-purge: Purge the context-mode knowledge base. Permanently deletes all indexed content\nand resets session stats. This is destructive and cannot be undone.\nTrigger: /context-mode:ctx-purge\n- context-mode:ctx-search: Search context-mode's persistent FTS5 knowledge base for previously indexed\nlocal project content, documentation, or session memory.\nTrigger: /context-mode:ctx-search\n- context-mode:ctx-stats: Show how much context window context-mode saved this session.\nDisplays token consumption, context savings ratio, and per-tool breakdown.\nRead-only — shows stats only, no reset capability.\nTo wipe the knowledge base entirely, use ctx_purge instead.\nTrigger: /context-mode:ctx-stats\n- context-mode:ctx-upgrade: Update context-mode from GitHub and fix hooks/settings.\nPulls latest, builds, installs, updates npm global, configures hooks.\nTrigger: /context-mode:ctx-upgrade\n- codex:codex-cli-runtime: Internal helper contract for calling the codex-companion runtime from Claude Code\n- codex:codex-result-handling: Internal guidance for presenting Codex helper output back to the user\n- codex:gpt-5-4-prompting: Internal guidance for composing Codex and GPT-5.4 prompts for coding, review, diagnosis, and research tasks inside the Codex Claude Code plugin\n- mattpocock-skills:diagnosing-bugs: Diagnosis loop for hard bugs and performance regressions. Use when the user says \"diagnose\"/\"debug this\", or reports something broken/throwing/failing/slow.\n- mattpocock-skills:tdd: Test-driven development. Use when the user wants to build features or fix bugs test-first, mentions \"red-green-refactor\", or wants integration tests.\n- mattpocock-skills:prototype: Build a throwaway prototype to answer a design question. Use when the user wants to sanity-check whether a state model or logic feels right, or explore what a UI should look like.\n- mattpocock-skills:research: Investigate a question against high-trust primary sources and capture the findings as a Markdown file in the repo. Use when the user wants a topic researched, docs or API facts gathered, or reading legwork delegated to a background agent.\n- mattpocock-skills:domain-modeling: Build and sharpen a project's domain model. Use when discussing codebase terminology, writing or editing a GLOSSARY.md, or recording or editing an ADR.\n- mattpocock-skills:codebase-design: Shared vocabulary for designing deep modules. Use when the user wants to design or improve a module's interface, find deepening opportunities, decide where a seam goes, make code more testable or AI-navigable, or when another skill needs the deep-module vocabulary.\n- mattpocock-skills:code-review: Review the changes since a fixed point (commit, branch, tag, or merge-base) along two axes: Standards (does the code follow this repo's documented coding standards?) and Spec (does the code match what the originating issue/spec asked for?). Runs both reviews in parallel sub-agents and reports them side by side. Use when the user wants to review a branch, a PR, work-in-progress changes, or asks to \"review since X\".\n- mattpocock-skills:pr: Use when writing a PR body.\n- mattpocock-skills:wizard: Generate an interactive bash wizard that walks a human through steps only they can perform. Use when provisioning infrastructure, setting up credentials or CI secrets, walking an unfamiliar third-party dashboard, or running a one-off migration or cutover. Don't invoke this for steps the agent can perform itself.\n- mattpocock-skills:grilling: Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any 'grill' trigger phrases.\n- mattpocock-skills:writing-for-agents: Writing documents for agents. Use when creating or editing skills, or modifying AGENTS.md or CLAUDE.md.\n- watch:watch: Watch a video (URL or local path). Downloads with yt-dlp, extracts auto-scaled frames with ffmpeg, pulls the transcript from captions (or local WhisperX / cloud Whisper fallback), and hands the result to the agent so it can answer questions about what's in the video. With a Gemini API key, Google's agentic video model watches the full video instead.\n- typesafe:typesafe-ai: Build AI-powered software with TypeSafe: small units of AI intelligence you can use like programming primitives. Its System One models, including Jev, turn natural language and application state into typed judgments and probabilities that code can combine. Use when a feature needs programmable common sense, when brainstorming what AI could make possible in an app, or when an LLM prompt-and-parse step could become a structured decision. Applications include routing, ranking, extraction, verification, and interactive experiences; these are starting points, not the limits. Read live docs and cookbooks to find useful patterns and discover new combinations.\n- cowork-plugin-management:cowork-plugin-customizer: Customize a Claude Code plugin for a specific organization's tools and workflows. Use when: customize plugin, set up plugin, configure plugin, tailor plugin, adjust plugin settings, customize plugin connectors, customize plugin skill, tweak plugin, modify plugin configuration.\n- cowork-plugin-management:create-cowork-plugin: Guide users through creating a new plugin from scratch in a cowork session. Use when users want to create a plugin, build a plugin, make a new plugin, develop a plugin, scaffold a plugin, start a plugin from scratch, or design a plugin. This skill requires Cowork mode with access to the outputs directory for delivering the final .plugin file.\n- desktop-commander:ai-tools-setup: Set up, connect, validate, and repair Claude Desktop and MCP servers using Desktop Commander — inspecting and fixing mcp.json / claude_desktop_config.json, getting MCP servers to connect, and diagnosing local AI tooling. Use when a user wants to install, configure, connect, validate, or fix Claude Desktop, an MCP server, an MCP config file, or a local AI agent/gateway. Trigger on the symptoms that actually bring people in: \"Claude can't see my tools\", \"my MCP server isn't showing up\", \"tools aren't loading in Claude\", \"add an MCP server\", \"my MCP isn't connecting\", \"fix my Claude Desktop config\", \"the agent won't respond\", \"wire up Ollama / LM Studio\", \"restart Claude Desktop\". Also covers local agent gateways like OpenClaw and Hermes.\n- desktop-commander:computer-health-check\n- desktop-commander:desktop-commander-overview: Use for Desktop Commander MCP capabilities — persistent shells and REPLs, long-running processes, filesystem beyond the workspace, structured files (.xlsx, .docx, .pdf, images) and large local data files such as CSVs, ripgrep search at scale, SSH, or cross-turn state.\n- desktop-commander:knowledge-base: Create and maintain a Markdown knowledge base that any AI agent can read, search, and update. Use when the user wants to start a knowledge base, add or update notes, organize docs/notes for an agent or LLM to consume, build an index of notes, or run a cleanup/maintenance pass on an existing MD knowledge base. Triggers include \"knowledge base\", \"KB\", \"notes for the agent\", \"index of notes\", \"second brain\", \"docs for AI context\", \"add a note\", \"update the KB\".\n- desktop-commander:obsidian-vault\n- desktop-commander:terminal\n- firecrawl:firecrawl\n- firecrawl:firecrawl-agent: Autonomously navigate websites and extract structured data across pages. Use when the task requires navigation or no suitable ready-made workflow or data provider covers it.\n- firecrawl:firecrawl-alexandria\n- firecrawl:firecrawl-crawl\n- firecrawl:firecrawl-developer-index\n- firecrawl:firecrawl-download\n- firecrawl:firecrawl-interact\n- firecrawl:firecrawl-map\n- firecrawl:firecrawl-monitor\n- firecrawl:firecrawl-parse\n- firecrawl:firecrawl-research-index\n- firecrawl:firecrawl-scrape\n- firecrawl:firecrawl-search\n- pdf-viewer:view-pdf\n- data:analyze\n- data:build-dashboard\n- data:create-viz\n- data:data-context-extractor\n- data:data-visualization\n- data:explore-data\n- data:sql-queries\n- data:statistical-analysis\n- data:validate-data\n- data:write-query\n- dataviz: Use this skill whenever you are about to create ANY chart, graph, plot, dashboard, or data visualization, in ANY output medium — an HTML or React artifact, inline SVG, plotting code in any library (matplotlib, plotly, d3, Recharts, …), an image/PNG you will render and upload, or a chart shared into Slack. Read it BEFORE writing the first line of chart code, choosing chart colors, building a stat tile / meter / KPI row, or laying out a dashboard. When the destination is a first-party document connector (host-designated, never self-described) that renders live charts, hand it the rows (inline, or as an uploaded data file the chart cites) rather than a rendered PNG/SVG — a picture of a chart loses hover, data inspection and per-value comments. Produces visualizations that read as one system — elegant, accessible, consistent in light and dark — using a brand-neutral placeholder palette you swap for your own. Teaches a design-system-agnostic method: a form heuristic, a color formula with a runnable validator, mark specs, and interaction rules. A validated default palette is documented in `references/palette.md` — swap that file's values for your brand's. Triggers on: \"chart\", \"graph\", \"plot\", \"data viz\", \"visualization\", \"dashboard\", \"analytics\", \"visualize data\", \"categorical colors\", \"sequential / diverging palette\", \"stat tile\", \"sparkline\", \"heatmap\", \"legend\", \"axis\", \"tooltip\", \"chart colors\", \"color by series\".\n- artifact-design: Design guidance and fundamentals for Artifacts. - Load before writing any artifact, including a skill-instructed Markdown one - Markdown is never a shortcut past the design pass.\n- artifact-diagramming: Diagramming know-how for Artifacts - when a picture earns its place, how to draw one that shows the real mechanism, and the inline-SVG mechanics that keep it legible in both themes.\n- artifact-capabilities: Runtime capabilities a published Artifact page can be granted — behavior static HTML cannot provide on its own, such as the page reading live or connected data, remembering what people do on it (a poll, a sign-up sheet, a checklist, a document edited in place — it saves new versions of itself), keeping state shared across viewers, knowing who is viewing, asking Claude a question of its own, storing files people add, handing the viewer a file to save, or using the viewer's camera, microphone, location, screen or device motion. Serves this user's live capability roster and the typed call definitions. Load it whenever any such runtime behavior would make an artifact more useful, before writing the page.\n- update-config: Use this skill to configure the Claude Code harness via settings.json. Automated behaviors (\"from now on when X\", \"each time X\", \"whenever X\", \"before/after X\") require hooks configured in settings.json - the harness executes these, not Claude, so memory/preferences cannot fulfill them. Also use for: permissions (\"allow X\", \"add permission\", \"move permission to\"), env vars (\"set X=Y\"), hook troubleshooting, or any changes to settings.json/settings.local.json files. Examples: \"allow npm commands\", \"add bq permission to global settings\", \"move permission to user settings\", \"set DEBUG=true\", \"when claude stops show X\". For simple settings like theme/model, suggest the /config command.\n- keybindings-help: Use when the user wants to customize keyboard shortcuts, rebind keys, add chord bindings, or modify ~/.claude/keybindings.json. Examples: \"rebind ctrl+s\", \"add a chord shortcut\", \"change the submit key\", \"customize keybindings\".\n- simplify: Review the changed code for reuse, simplification, efficiency, and altitude cleanups, then apply the fixes. Quality only — it does not hunt for bugs; use /code-review for that.\n- fewer-permission-prompts: Scan your transcripts for common read-only Bash and MCP tool calls, then add a prioritized allowlist to project .claude/settings.json to reduce permission prompts.\n- loop: Run a prompt or slash command on a recurring interval (e.g. /loop 5m /foo). Omit the interval to let the model self-pace. - When the user wants to set up a recurring task, poll for status, or run something repeatedly on an interval (e.g. \"check the deploy every 5 minutes\", \"keep running /babysit-prs\"). Do NOT invoke for one-off tasks.\n- schedule: Create, update, list, or run scheduled cloud agents (routines) that execute on a cron schedule. - When the user wants to schedule a recurring cloud agent, set up automated tasks, create a cron job for Claude Code, or manage their scheduled agents/routines. Also use when the user wants a one-time scheduled run (\"run this once at 3pm\", \"remind me to check X tomorrow\").\n- claude-api: Reference for the Claude API / Anthropic SDK — model ids, pricing, params, streaming, tool use, MCP, agents, caching, token counting, model migration.\nTRIGGER — read BEFORE opening the target file; don't skip because it \"looks like a one-liner\" — whenever: the prompt names Claude/Anthropic in any form (Claude, Anthropic, Fable, Opus, Sonnet, Haiku, `anthropic`, `@anthropic-ai`, `claude-*`, `us.anthropic.*`, `[1m]`); the user asks about an LLM (pricing/model choice/limits/caching) — never answer from memory; OR the task is LLM-shaped with provider unstated (agent/MCP/tool-definition/multi-agent/RAG/LLM-judge/computer-use; generate/summarize/extract/classify/rewrite/converse over NL; debugging refusals/cutoffs/streaming/tool-calls/tokens).\nSKIP only when another provider is being worked on (overrides all triggers): OpenAI/GPT/Gemini/Llama/Mistral/Cohere/Ollama named in the query; OR `grep -rE 'openai|langchain_openai|google.generativeai|genai|mistralai|cohere|ollama'` over the project hits (run this grep FIRST if no provider named — don't Read the file).\n- workflow-authoring: Reference for writing a Workflow tool script (script API and gotchas, resume, quality patterns, worked examples). Load before authoring a script for a workflow the user already opted into; it does not itself authorize running one.\n- claude-in-chrome: Automates your Chrome browser to interact with web pages - clicking elements, filling forms, capturing screenshots, reading console logs, and navigating sites. Opens pages in new tabs within your existing Chrome session. Requires site-level permissions before executing (configured in the extension). - When the user wants to interact with web pages, automate browser tasks, capture screenshots, read console logs, or perform any browser-based actions. Always invoke BEFORE attempting to use any mcp__claude-in-chrome__* tools.\n- run: Launch and drive this project's app to see a change working. Use when asked to run, start, or screenshot the app, or to confirm a change works in the real app (not just tests). First looks for a project skill that already covers launching the app; otherwise falls back to built-in patterns per project type (CLI, server, TUI, Electron, browser-driven, library).\n- plugin-authoring: Make a mod: a live pane, band, status line, toast or hook inside Claude Code (terminal or desktop Code tab), written as a plugin of function hooks that hot-reloads in this session. Load before writing or debugging a hooks module.\n- init: Initialize a new CLAUDE.md file with codebase documentation\n- security-review\n- anthropic-skills:built-in-browser\n- anthropic-skills:chrome-browser\n- anthropic-skills:computer-use\n- anthropic-skills:docs\n- anthropic-skills:docx\n- anthropic-skills:google-workspace\n- anthropic-skills:humanizer\n- anthropic-skills:import-memory\n- anthropic-skills:mcp-builder\n- anthropic-skills:migrate-project-to-disk\n- anthropic-skills:morning\n- anthropic-skills:pdf\n- anthropic-skills:pptx\n- anthropic-skills:slide-deck-generator\n- anthropic-skills:xlsx","skillCount":162,"isInitial":true,"names":["anti-sleep","articulation-skill","ArXiv","backup","brain-audit","capture-insight","claude-stack-doctor","claudex-loop","claudex-route","cli-hub-meta-skill","closeout","codex-build","codex-review","decision-audit","design-taste-frontend","dev-sync","doctor-plus","fireflies-intake","five-slides-generator","forecast-capture","graphify","harvest","html-to-pdf","impeccable","improve-system","ingest-book","ingest-resource","interview-me","ISA","library-advisor","library-review","meeting-prep","meeting-sync","memory-write","name-meetings","new-project","next-decision","pbir-report-builder","persistent-localhost","pp-catapult-openfield-connect","pp-zotero-research-library","project","project-triage","research-in-5","Science","scroll-craft","session-miner","sports-science-research-grounding","startup","status-report","weekly-review","codex:rescue","codex:setup","firecrawl:skill-gen","pdf-viewer:annotate","pdf-viewer:fill-form","pdf-viewer:open","pdf-viewer:sign","superpowers:brainstorming","superpowers:diagnosing-superpowers","superpowers:dispatching-parallel-agents","superpowers:executing-plans","superpowers:finishing-a-development-branch","superpowers:receiving-code-review","superpowers:requesting-code-review","superpowers:subagent-driven-development","superpowers:systematic-debugging","superpowers:test-driven-development","superpowers:using-git-worktrees","superpowers:using-superpowers","superpowers:verification-before-completion","superpowers:writing-plans","superpowers:writing-skills","last30days:last30days","context-mode:context-mode","context-mode:ctx-doctor","context-mode:ctx-index","context-mode:ctx-insight","context-mode:ctx-purge","context-mode:ctx-search","context-mode:ctx-stats","context-mode:ctx-upgrade","codex:codex-cli-runtime","codex:codex-result-handling","codex:gpt-5-4-prompting","mattpocock-skills:diagnosing-bugs","mattpocock-skills:tdd","mattpocock-skills:prototype","mattpocock-skills:research","mattpocock-skills:domain-modeling","mattpocock-skills:codebase-design","mattpocock-skills:code-review","mattpocock-skills:pr","mattpocock-skills:wizard","mattpocock-skills:grilling","mattpocock-skills:writing-for-agents","watch:watch","typesafe:typesafe-ai","cowork-plugin-management:cowork-plugin-customizer","cowork-plugin-management:create-cowork-plugin","desktop-commander:ai-tools-setup","desktop-commander:computer-health-check","desktop-commander:desktop-commander-overview","desktop-commander:knowledge-base","desktop-commander:obsidian-vault","desktop-commander:terminal","firecrawl:firecrawl","firecrawl:firecrawl-agent","firecrawl:firecrawl-alexandria","firecrawl:firecrawl-crawl","firecrawl:firecrawl-developer-index","firecrawl:firecrawl-download","firecrawl:firecrawl-interact","firecrawl:firecrawl-map","firecrawl:firecrawl-monitor","firecrawl:firecrawl-parse","firecrawl:firecrawl-research-index","firecrawl:firecrawl-scrape","firecrawl:firecrawl-search","pdf-viewer:view-pdf","data:analyze","data:build-dashboard","data:create-viz","data:data-context-extractor","data:data-visualization","data:explore-data","data:sql-queries","data:statistical-analysis","data:validate-data","data:write-query","dataviz","artifact-design","artifact-diagramming","artifact-capabilities","update-config","keybindings-help","simplify","fewer-permission-prompts","loop","schedule","claude-api","workflow-authoring","claude-in-chrome","run","plugin-authoring","init","security-review","anthropic-skills:built-in-browser","anthropic-skills:chrome-browser","anthropic-skills:computer-use","anthropic-skills:docs","anthropic-skills:docx","anthropic-skills:google-workspace","anthropic-skills:humanizer","anthropic-skills:import-memory","anthropic-skills:mcp-builder","anthropic-skills:migrate-project-to-disk","anthropic-skills:morning","anthropic-skills:pdf","anthropic-skills:pptx","anthropic-skills:slide-deck-generator","anthropic-skills:xlsx"]},"type":"attachment","uuid":"c84efc91-87a2-4be9-87c6-7ea4cfdf0137","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\nThe following skills are available for use with the Skill tool:\n\n- anti-sleep\n- articulation-skill: Help users explain complex ideas simply to non-technical audiences with proven communication frameworks. Use when users need to explain technical concepts, structure presentations or writing, create clear documentation, improve communication clarity, or translate jargon into accessible language. Triggers include requests like \"help me explain this clearly\", \"how do I structure this presentation\", \"make this less technical\", \"help me articulate this idea\", or any request to simplify complex communication. Do not use for building a slide deck (use five-slides-generator or research-in-5) or for light copyediting of text that is already clear.\n- ArXiv\n- backup\n- brain-audit\n- capture-insight\n- claude-stack-doctor: Health-check Eric's automation/memory stack in one pass and verify the Mac-to-Windows handoff works: launchd agents / Windows scheduled tasks, Python venvs, memsearch, the memory-compiler flush pipeline, backup freshness, and context budget. Use when the user says \"/claude-stack-doctor\", \"stack doctor\", \"is my stack healthy\", \"did my scheduled jobs run\", \"check the memory pipeline\", \"why didn't the backup run\", or when closeout/morning sessions should verify automation health. Do not use to run the backup itself (use backup) or to audit context-engineering practice (use doctor-plus).\n- claudex-loop\n- claudex-route\n- cli-hub-meta-skill\n- closeout\n- codex-build\n- codex-review: Have Codex independently review an existing implementation plan while Claude coordinates a bounded revision loop. For automatic reviewer selection from either host, use claudex-loop with mode=review.\n- decision-audit: Decision Drain Audit: sort the decisions Eric has been avoiding into four buckets (decide now, needs one piece of information, waiting on someone, not mine), name why they are stuck, give 3 tiny next actions, then optionally decide them and record each answer where it lives. Use when the user says \"/decision-audit\", \"decision drain audit\", \"what decisions am I avoiding\", \"what's stuck\", \"fill out my pending decisions\", or \"let's work through the decisions\". Do not use for the Friday synthesis (use weekly-review), ranking projects (use project), or the biweekly report (use status-report).\n- design-taste-frontend\n- dev-sync\n- doctor-plus\n- fireflies-intake: One-command Fireflies pipeline — sync new meeting transcripts into the SecondBrain vault, rename generically-titled meetings, then report exactly what was ingested. Use when the user says \"/fireflies-intake\", \"ingest my recent fireflies meetings\", \"sync meetings that aren't in the second brain yet\", \"pull in the new meetings\", \"meeting ingestion\", or asks whether all recent meetings have been ingested. Do not use to search what was said in transcripts (use pp-fireflies).\n- five-slides-generator\n- forecast-capture\n- graphify: Use for any question about a codebase, its architecture, file relationships, or project content — especially when graphify-out/ exists, where the question should be treated as a graphify query first. Turns any input (code, docs, papers, images, videos) into a persistent knowledge graph with god nodes, community detection, and query/path/explain tools. Do not use for a quick lookup of one known file or symbol, or for sport-science literature questions (use sports-science-research-grounding).\n- harvest\n- html-to-pdf: Render any local HTML report, deck, or dashboard to a print-ready PDF via headless Chrome — replaces the manual Ctrl+P → Save as PDF ritual. Use when the user says \"export this to PDF\", \"print version\", \"PDF for the coaches\", \"make this printable\", or a coach-facing HTML deliverable needs a shareable/printable copy. Do not use to build the report or deck itself (use status-report or five-slides-generator).\n- impeccable: Use when the user wants to design, redesign, shape, critique, audit, polish, clarify, distill, harden, optimize, adapt, animate, colorize, extract, or otherwise improve a frontend interface. Covers websites, landing pages, dashboards, product UI, app shells, components, forms, settings, onboarding, and empty states. Handles UX review, visual hierarchy, information architecture, cognitive load, accessibility, performance, responsive behavior, theming, anti-patterns, typography, fonts, spacing, layout, alignment, color, motion, micro-interactions, UX copy, error states, edge cases, i18n, and reusable design systems or tokens. Also use for bland designs that need to become bolder or more delightful, loud designs that should become quieter, live browser iteration on UI elements, or ambitious visual effects that should feel technically extraordinary. Not for backend-only or non-UI tasks.\n- improve-system\n- ingest-book\n- ingest-resource\n- interview-me\n- ISA\n- library-advisor\n- library-review\n- meeting-prep: Pre-meeting readiness brief for a project — what changed, what's open, every deliverable path. Use when the user says \"/meeting-prep <project>\", \"I have a meeting with <person> — are we in a good spot on <project>?\", \"verify we're up to speed before the meeting\", \"get me ready for this afternoon's meeting\", or names an upcoming coach/staff meeting. Do not use for the biweekly supervisor report (use status-report) or to sync meeting transcripts (use meeting-sync).\n- meeting-sync\n- memory-write: Writes, updates, removes, and recalls facts in the two-tier memory system (~/.claude/global-memory/ and ~/.claude/projects/<slug>/memory/). Use for write requests such as \"remember this\", \"note that\", \"update memory\", \"save this\", and \"forget about\", and for recall requests such as \"did we already…?\", \"what did we decide about X?\", and \"do you remember…?\". Picks the tier, dedups, and enforces caps; recall checks the injected snapshot, then memsearch. Do not use for a story or lesson worth a vault note (use capture-insight) or an article to keep (use ingest-resource).\n- name-meetings: Detects Fireflies meetings with generic titles (empty, \"Zoom Meeting\", \"Recording\", date-only, etc.), proposes structured names based on AI summary + participants, and applies approved renames via the Fireflies API. Use when user says \"/name-meetings\", \"name my meetings\", \"rename untitled meetings\", \"fix meeting titles\", \"my meetings have no names\", or when invoked by meeting-sync. Do not use to sync transcripts or audit vault filenames (use meeting-sync).\n- new-project\n- next-decision\n- pbir-report-builder\n- persistent-localhost\n- pp-catapult-openfield-connect\n- pp-zotero-research-library\n- project: Manage the portfolio project registry (ideas, updates, ranking, promotion, dev stages, start/park/done, receivers) and open the live project board. Use when the user says \"/project\", \"new idea:\", \"log progress on\", \"project update\", \"add to my project inbox\", \"show my projects\", \"re-rank my projects\", \"set the stage on\", \"mark <project> as spec'd/planned/shipped\", \"start/park <project>\". Do not use for the DEV drift dashboard (use project-triage) or to scaffold a new repo (use new-project).\n- project-triage\n- research-in-5: Build a \"Research in 5\" weekly paper review for Baylor Athletics staff: a 5-slide deck (dark and light), a Teams post, and a staff email from one paper. Use when the user says \"/research-in-5\", \"research in 5 on this paper\", \"weekly research review\", \"review this paper for the staff\", \"make the slides for this paper\", hands over a paper (PDF, DOI, URL, Zotero item), or wants a review rebuilt or versioned (#001, v2). Do not use for a sport-science question (use sports-science-research-grounding), a deck with no single paper (use five-slides-generator), or a plain Zotero search.\n- Science\n- scroll-craft\n- session-miner\n- sports-science-research-grounding: Use when the user asks a substantive question about sport science, return to play or sport, rehabilitation, strength and conditioning, workload, recovery, testing, athlete health, injury, performance, or wants a research-backed answer, and for Zotero full-library batch processing. Searches the user's Zotero library first, clearly labels external peer-reviewed fallback sources, and applies tier-aware model routing during bounded batch work. Do not use for sports scores or schedules (use pp-espn) or for a simple Zotero search or sync (use pp-zotero-research-library).\n- startup\n- status-report: Build the every-two-weeks Applied Performance status report for Kenny Boyd and Chris Ruf — paste-ready email, one-page PDF, internal record. Use when the user says \"/status-report\", \"build my status report\", \"time for the Chris report\", \"biweekly update\", \"status update for Chris and Kenny\", \"what do I send Chris this week\", or when a scheduled report date arrives. Do not use for a single meeting brief (use meeting-prep) or the end-of-day supervisor log interview (use interview-me).\n- weekly-review\n- codex:rescue: Delegate investigation, an explicit fix request, or follow-up rescue work to the Codex rescue subagent\n- codex:setup: Check whether the local Codex CLI is ready and optionally toggle the stop-time review gate\n- firecrawl:skill-gen: Generate a complete Agent Skill from a documentation URL using Firecrawl\n- pdf-viewer:annotate: Collaboratively annotate a PDF — propose markup, review together, iterate\n- pdf-viewer:fill-form: Fill PDF form fields interactively with live visual feedback\n- pdf-viewer:open: Open a PDF in the interactive viewer\n- pdf-viewer:sign: Place a signature or initials image on a PDF\n- superpowers:brainstorming: You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.\n- superpowers:diagnosing-superpowers: Use when a superpowers session went wrong and your human partner wants to know why — repeated work, ignored plans, stumbles, poor results, a skill that didn't fire, \"it took too long\", \"why is it so expensive\", \"what is it doing\" — or wants to build a bug report for the superpowers maintainers, for the current session or a past one identified by id or path, on any harness.\n- superpowers:dispatching-parallel-agents: Use when facing 2+ independent tasks that can be worked on without shared state or sequential dependencies\n- superpowers:executing-plans: Use when executing an implementation plan in the current session as the implementer yourself — your human partner chose inline execution, or no subagent tool is available\n- superpowers:finishing-a-development-branch: Use when implementation is complete, all tests pass, and you need to decide how to integrate the work\n- superpowers:receiving-code-review: Use when receiving code review feedback, before implementing suggestions, especially if feedback seems unclear or technically questionable - requires technical rigor and verification, not performative agreement or blind implementation\n- superpowers:requesting-code-review: Use when completing tasks, implementing major features, or before merging to verify work meets requirements\n- superpowers:subagent-driven-development: Use when executing implementation plans with independent tasks in the current session\n- superpowers:systematic-debugging: Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes\n- superpowers:test-driven-development: Use when implementing any feature or bugfix, before writing implementation code\n- superpowers:using-git-worktrees: Use when starting feature work that needs isolation from current workspace or before executing implementation plans - ensures an isolated workspace exists via native tools or git worktree fallback\n- superpowers:using-superpowers: Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions\n- superpowers:verification-before-completion: Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always\n- superpowers:writing-plans: Use when you have a spec or requirements for a multi-step task, before touching code\n- superpowers:writing-skills: Use when creating new skills, editing existing skills, or verifying skills work before deployment\n- last30days:last30days: Research what people actually say about any topic in the last 30 days. Pulls posts and engagement from Reddit, X, YouTube, TikTok, Hacker News, Polymarket, GitHub, and the web. Includes a doctor health check to diagnose broken or missing sources.\n- context-mode:context-mode: Use context-mode tools (ctx_execute, ctx_execute_file) instead of Bash/cat when processing\nlarge outputs. Triggers: \"analyze logs\", \"summarize output\", \"process data\",\n\"parse JSON\", \"filter results\", \"extract errors\", \"check build output\",\n\"analyze dependencies\", \"process API response\", \"large file analysis\",\n\"page snapshot\", \"browser snapshot\", \"DOM structure\", \"inspect page\",\n\"accessibility tree\", \"Playwright snapshot\",\n\"run tests\", \"test output\", \"coverage report\", \"git log\", \"recent commits\",\n\"diff between branches\", \"list containers\", \"pod status\", \"disk usage\",\n\"fetch docs\", \"API reference\", \"index documentation\",\n\"call API\", \"check response\", \"query results\",\n\"find TODOs\", \"count lines\", \"codebase statistics\", \"security audit\",\n\"outdated packages\", \"dependency tree\", \"cloud resources\", \"CI/CD output\".\nAlso triggers on ANY MCP tool output that may exceed 20 lines.\nSubagent routing is handled automatically via PreToolUse hook.\n- context-mode:ctx-doctor: Run context-mode diagnostics. Checks runtimes, hooks, FTS5,\nplugin registration, npm and marketplace versions.\nTrigger: /context-mode:ctx-doctor\n- context-mode:ctx-index: Index a local file or directory into context-mode's persistent FTS5 knowledge base\nso future ctx_search calls can retrieve focused snippets without rereading raw files.\nTrigger: /context-mode:ctx-index\n- context-mode:ctx-insight: Open the context-mode Insight dashboard in your default browser.\nInsight is the hosted analytics layer for AI-assisted engineering teams —\nper-engineer productive rate, retry waste, blocker detection, role-narrowed views.\nTrigger: /context-mode:ctx-insight\n- context-mode:ctx-purge: Purge the context-mode knowledge base. Permanently deletes all indexed content\nand resets session stats. This is destructive and cannot be undone.\nTrigger: /context-mode:ctx-purge\n- context-mode:ctx-search: Search context-mode's persistent FTS5 knowledge base for previously indexed\nlocal project content, documentation, or session memory.\nTrigger: /context-mode:ctx-search\n- context-mode:ctx-stats: Show how much context window context-mode saved this session.\nDisplays token consumption, context savings ratio, and per-tool breakdown.\nRead-only — shows stats only, no reset capability.\nTo wipe the knowledge base entirely, use ctx_purge instead.\nTrigger: /context-mode:ctx-stats\n- context-mode:ctx-upgrade: Update context-mode from GitHub and fix hooks/settings.\nPulls latest, builds, installs, updates npm global, configures hooks.\nTrigger: /context-mode:ctx-upgrade\n- codex:codex-cli-runtime: Internal helper contract for calling the codex-companion runtime from Claude Code\n- codex:codex-result-handling: Internal guidance for presenting Codex helper output back to the user\n- codex:gpt-5-4-prompting: Internal guidance for composing Codex and GPT-5.4 prompts for coding, review, diagnosis, and research tasks inside the Codex Claude Code plugin\n- mattpocock-skills:diagnosing-bugs: Diagnosis loop for hard bugs and performance regressions. Use when the user says \"diagnose\"/\"debug this\", or reports something broken/throwing/failing/slow.\n- mattpocock-skills:tdd: Test-driven development. Use when the user wants to build features or fix bugs test-first, mentions \"red-green-refactor\", or wants integration tests.\n- mattpocock-skills:prototype: Build a throwaway prototype to answer a design question. Use when the user wants to sanity-check whether a state model or logic feels right, or explore what a UI should look like.\n- mattpocock-skills:research: Investigate a question against high-trust primary sources and capture the findings as a Markdown file in the repo. Use when the user wants a topic researched, docs or API facts gathered, or reading legwork delegated to a background agent.\n- mattpocock-skills:domain-modeling: Build and sharpen a project's domain model. Use when discussing codebase terminology, writing or editing a GLOSSARY.md, or recording or editing an ADR.\n- mattpocock-skills:codebase-design: Shared vocabulary for designing deep modules. Use when the user wants to design or improve a module's interface, find deepening opportunities, decide where a seam goes, make code more testable or AI-navigable, or when another skill needs the deep-module vocabulary.\n- mattpocock-skills:code-review: Review the changes since a fixed point (commit, branch, tag, or merge-base) along two axes: Standards (does the code follow this repo's documented coding standards?) and Spec (does the code match what the originating issue/spec asked for?). Runs both reviews in parallel sub-agents and reports them side by side. Use when the user wants to review a branch, a PR, work-in-progress changes, or asks to \"review since X\".\n- mattpocock-skills:pr: Use when writing a PR body.\n- mattpocock-skills:wizard: Generate an interactive bash wizard that walks a human through steps only they can perform. Use when provisioning infrastructure, setting up credentials or CI secrets, walking an unfamiliar third-party dashboard, or running a one-off migration or cutover. Don't invoke this for steps the agent can perform itself.\n- mattpocock-skills:grilling: Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any 'grill' trigger phrases.\n- mattpocock-skills:writing-for-agents: Writing documents for agents. Use when creating or editing skills, or modifying AGENTS.md or CLAUDE.md.\n- watch:watch: Watch a video (URL or local path). Downloads with yt-dlp, extracts auto-scaled frames with ffmpeg, pulls the transcript from captions (or local WhisperX / cloud Whisper fallback), and hands the result to the agent so it can answer questions about what's in the video. With a Gemini API key, Google's agentic video model watches the full video instead.\n- typesafe:typesafe-ai: Build AI-powered software with TypeSafe: small units of AI intelligence you can use like programming primitives. Its System One models, including Jev, turn natural language and application state into typed judgments and probabilities that code can combine. Use when a feature needs programmable common sense, when brainstorming what AI could make possible in an app, or when an LLM prompt-and-parse step could become a structured decision. Applications include routing, ranking, extraction, verification, and interactive experiences; these are starting points, not the limits. Read live docs and cookbooks to find useful patterns and discover new combinations.\n- cowork-plugin-management:cowork-plugin-customizer: Customize a Claude Code plugin for a specific organization's tools and workflows. Use when: customize plugin, set up plugin, configure plugin, tailor plugin, adjust plugin settings, customize plugin connectors, customize plugin skill, tweak plugin, modify plugin configuration.\n- cowork-plugin-management:create-cowork-plugin: Guide users through creating a new plugin from scratch in a cowork session. Use when users want to create a plugin, build a plugin, make a new plugin, develop a plugin, scaffold a plugin, start a plugin from scratch, or design a plugin. This skill requires Cowork mode with access to the outputs directory for delivering the final .plugin file.\n- desktop-commander:ai-tools-setup: Set up, connect, validate, and repair Claude Desktop and MCP servers using Desktop Commander — inspecting and fixing mcp.json / claude_desktop_config.json, getting MCP servers to connect, and diagnosing local AI tooling. Use when a user wants to install, configure, connect, validate, or fix Claude Desktop, an MCP server, an MCP config file, or a local AI agent/gateway. Trigger on the symptoms that actually bring people in: \"Claude can't see my tools\", \"my MCP server isn't showing up\", \"tools aren't loading in Claude\", \"add an MCP server\", \"my MCP isn't connecting\", \"fix my Claude Desktop config\", \"the agent won't respond\", \"wire up Ollama / LM Studio\", \"restart Claude Desktop\". Also covers local agent gateways like OpenClaw and Hermes.\n- desktop-commander:computer-health-check\n- desktop-commander:desktop-commander-overview: Use for Desktop Commander MCP capabilities — persistent shells and REPLs, long-running processes, filesystem beyond the workspace, structured files (.xlsx, .docx, .pdf, images) and large local data files such as CSVs, ripgrep search at scale, SSH, or cross-turn state.\n- desktop-commander:knowledge-base: Create and maintain a Markdown knowledge base that any AI agent can read, search, and update. Use when the user wants to start a knowledge base, add or update notes, organize docs/notes for an agent or LLM to consume, build an index of notes, or run a cleanup/maintenance pass on an existing MD knowledge base. Triggers include \"knowledge base\", \"KB\", \"notes for the agent\", \"index of notes\", \"second brain\", \"docs for AI context\", \"add a note\", \"update the KB\".\n- desktop-commander:obsidian-vault\n- desktop-commander:terminal\n- firecrawl:firecrawl\n- firecrawl:firecrawl-agent: Autonomously navigate websites and extract structured data across pages. Use when the task requires navigation or no suitable ready-made workflow or data provider covers it.\n- firecrawl:firecrawl-alexandria\n- firecrawl:firecrawl-crawl\n- firecrawl:firecrawl-developer-index\n- firecrawl:firecrawl-download\n- firecrawl:firecrawl-interact\n- firecrawl:firecrawl-map\n- firecrawl:firecrawl-monitor\n- firecrawl:firecrawl-parse\n- firecrawl:firecrawl-research-index\n- firecrawl:firecrawl-scrape\n- firecrawl:firecrawl-search\n- pdf-viewer:view-pdf\n- data:analyze\n- data:build-dashboard\n- data:create-viz\n- data:data-context-extractor\n- data:data-visualization\n- data:explore-data\n- data:sql-queries\n- data:statistical-analysis\n- data:validate-data\n- data:write-query\n- dataviz: Use this skill whenever you are about to create ANY chart, graph, plot, dashboard, or data visualization, in ANY output medium — an HTML or React artifact, inline SVG, plotting code in any library (matplotlib, plotly, d3, Recharts, …), an image/PNG you will render and upload, or a chart shared into Slack. Read it BEFORE writing the first line of chart code, choosing chart colors, building a stat tile / meter / KPI row, or laying out a dashboard. When the destination is a first-party document connector (host-designated, never self-described) that renders live charts, hand it the rows (inline, or as an uploaded data file the chart cites) rather than a rendered PNG/SVG — a picture of a chart loses hover, data inspection and per-value comments. Produces visualizations that read as one system — elegant, accessible, consistent in light and dark — using a brand-neutral placeholder palette you swap for your own. Teaches a design-system-agnostic method: a form heuristic, a color formula with a runnable validator, mark specs, and interaction rules. A validated default palette is documented in `references/palette.md` — swap that file's values for your brand's. Triggers on: \"chart\", \"graph\", \"plot\", \"data viz\", \"visualization\", \"dashboard\", \"analytics\", \"visualize data\", \"categorical colors\", \"sequential / diverging palette\", \"stat tile\", \"sparkline\", \"heatmap\", \"legend\", \"axis\", \"tooltip\", \"chart colors\", \"color by series\".\n- artifact-design: Design guidance and fundamentals for Artifacts. - Load before writing any artifact, including a skill-instructed Markdown one - Markdown is never a shortcut past the design pass.\n- artifact-diagramming: Diagramming know-how for Artifacts - when a picture earns its place, how to draw one that shows the real mechanism, and the inline-SVG mechanics that keep it legible in both themes.\n- artifact-capabilities: Runtime capabilities a published Artifact page can be granted — behavior static HTML cannot provide on its own, such as the page reading live or connected data, remembering what people do on it (a poll, a sign-up sheet, a checklist, a document edited in place — it saves new versions of itself), keeping state shared across viewers, knowing who is viewing, asking Claude a question of its own, storing files people add, handing the viewer a file to save, or using the viewer's camera, microphone, location, screen or device motion. Serves this user's live capability roster and the typed call definitions. Load it whenever any such runtime behavior would make an artifact more useful, before writing the page.\n- update-config: Use this skill to configure the Claude Code harness via settings.json. Automated behaviors (\"from now on when X\", \"each time X\", \"whenever X\", \"before/after X\") require hooks configured in settings.json - the harness executes these, not Claude, so memory/preferences cannot fulfill them. Also use for: permissions (\"allow X\", \"add permission\", \"move permission to\"), env vars (\"set X=Y\"), hook troubleshooting, or any changes to settings.json/settings.local.json files. Examples: \"allow npm commands\", \"add bq permission to global settings\", \"move permission to user settings\", \"set DEBUG=true\", \"when claude stops show X\". For simple settings like theme/model, suggest the /config command.\n- keybindings-help: Use when the user wants to customize keyboard shortcuts, rebind keys, add chord bindings, or modify ~/.claude/keybindings.json. Examples: \"rebind ctrl+s\", \"add a chord shortcut\", \"change the submit key\", \"customize keybindings\".\n- simplify: Review the changed code for reuse, simplification, efficiency, and altitude cleanups, then apply the fixes. Quality only — it does not hunt for bugs; use /code-review for that.\n- fewer-permission-prompts: Scan your transcripts for common read-only Bash and MCP tool calls, then add a prioritized allowlist to project .claude/settings.json to reduce permission prompts.\n- loop: Run a prompt or slash command on a recurring interval (e.g. /loop 5m /foo). Omit the interval to let the model self-pace. - When the user wants to set up a recurring task, poll for status, or run something repeatedly on an interval (e.g. \"check the deploy every 5 minutes\", \"keep running /babysit-prs\"). Do NOT invoke for one-off tasks.\n- schedule: Create, update, list, or run scheduled cloud agents (routines) that execute on a cron schedule. - When the user wants to schedule a recurring cloud agent, set up automated tasks, create a cron job for Claude Code, or manage their scheduled agents/routines. Also use when the user wants a one-time scheduled run (\"run this once at 3pm\", \"remind me to check X tomorrow\").\n- claude-api: Reference for the Claude API / Anthropic SDK — model ids, pricing, params, streaming, tool use, MCP, agents, caching, token counting, model migration.\nTRIGGER — read BEFORE opening the target file; don't skip because it \"looks like a one-liner\" — whenever: the prompt names Claude/Anthropic in any form (Claude, Anthropic, Fable, Opus, Sonnet, Haiku, `anthropic`, `@anthropic-ai`, `claude-*`, `us.anthropic.*`, `[1m]`); the user asks about an LLM (pricing/model choice/limits/caching) — never answer from memory; OR the task is LLM-shaped with provider unstated (agent/MCP/tool-definition/multi-agent/RAG/LLM-judge/computer-use; generate/summarize/extract/classify/rewrite/converse over NL; debugging refusals/cutoffs/streaming/tool-calls/tokens).\nSKIP only when another provider is being worked on (overrides all triggers): OpenAI/GPT/Gemini/Llama/Mistral/Cohere/Ollama named in the query; OR `grep -rE 'openai|langchain_openai|google.generativeai|genai|mistralai|cohere|ollama'` over the project hits (run this grep FIRST if no provider named — don't Read the file).\n- workflow-authoring: Reference for writing a Workflow tool script (script API and gotchas, resume, quality patterns, worked examples). Load before authoring a script for a workflow the user already opted into; it does not itself authorize running one.\n- claude-in-chrome: Automates your Chrome browser to interact with web pages - clicking elements, filling forms, capturing screenshots, reading console logs, and navigating sites. Opens pages in new tabs within your existing Chrome session. Requires site-level permissions before executing (configured in the extension). - When the user wants to interact with web pages, automate browser tasks, capture screenshots, read console logs, or perform any browser-based actions. Always invoke BEFORE attempting to use any mcp__claude-in-chrome__* tools.\n- run: Launch and drive this project's app to see a change working. Use when asked to run, start, or screenshot the app, or to confirm a change works in the real app (not just tests). First looks for a project skill that already covers launching the app; otherwise falls back to built-in patterns per project type (CLI, server, TUI, Electron, browser-driven, library).\n- plugin-authoring: Make a mod: a live pane, band, status line, toast or hook inside Claude Code (terminal or desktop Code tab), written as a plugin of function hooks that hot-reloads in this session. Load before writing or debugging a hooks module.\n- init: Initialize a new CLAUDE.md file with codebase documentation\n- security-review\n- anthropic-skills:built-in-browser\n- anthropic-skills:chrome-browser\n- anthropic-skills:computer-use\n- anthropic-skills:docs\n- anthropic-skills:docx\n- anthropic-skills:google-workspace\n- anthropic-skills:humanizer\n- anthropic-skills:import-memory\n- anthropic-skills:mcp-builder\n- anthropic-skills:migrate-project-to-disk\n- anthropic-skills:morning\n- anthropic-skills:pdf\n- anthropic-skills:pptx\n- anthropic-skills:slide-deck-generator\n- anthropic-skills:xlsx\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"c84efc91-87a2-4be9-87c6-7ea4cfdf0137","isSidechain":false,"attachment":{"type":"auto_mode","autoModeConsentFlow":false,"bashFirst":true,"bashFirstSteer":"relaxed","steerOnly":true,"bypass":true},"type":"attachment","uuid":"c7f302e1-949d-4916-84ec-4e9558e77e7e","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\nWhile bypass permissions mode is active:\n\nYou can do much of your work through the Bash tool when it is the simpler route: read files with cat, head, or sed -n, search with grep and find, and make small, mechanical file changes with sed, heredocs, or short scripts instead of the dedicated Read, Edit, or Write tools. The choice is yours: prefer Edit or Write when a shell edit would be fragile, such as exact or multi-line replacements, or sed/awk flags that differ between GNU and BSD/macOS.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"c7f302e1-949d-4916-84ec-4e9558e77e7e","isSidechain":false,"attachment":{"type":"output_style","style":"ELI5"},"type":"attachment","uuid":"32602746-9ed7-472b-aeb9-cdeae869f47c","timestamp":"2026-10-07T16:39:14.230Z","rendered":[{"content":"<system-reminder>\nELI5 output style is active. Remember to follow the specific guidelines for this style.\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"32602746-9ed7-472b-aeb9-cdeae869f47c","isSidechain":false,"attachment":{"type":"command_permissions","allowedTools":[]},"type":"attachment","uuid":"6402102c-5192-4afe-9b0a-f83b69f755a2","timestamp":"2026-10-07T16:39:14.230Z","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
{"parentUuid":"6402102c-5192-4afe-9b0a-f83b69f755a2","isSidechain":false,"attachment":{"type":"instructions","files":[{"path":"/Users/kristinarash/.claude/CLAUDE.md","type":"User","content":"# Machine\n\nMachine-specific shell, paths, and traps live in `~/.claude/machine.md` (gitignored; copy `machine.macos.md` or `machine.windows.md` to `machine.md` on a new machine). It is imported below.\n\n@machine.md\n\nTwo machines share this setup: the MacBook (`~/DEV`) and the Baylor Windows laptop (`~/Desktop/DEV`). Projects sync through GitHub (`erash11`), documents through Google Drive.\n\n**Session routine.** When working inside a project repo, follow the Session routine in its `AGENTS.md`: `git pull` and read `docs/STATUS.md` at the start; update `STATUS.md`, commit, and `git push` at the end. This is what keeps the two machines in step.\n\n# Workflow Expectations\n\n- When asked to **create, merge, or consolidate an artifact** (calendar, deck, doc), finish with the produced file in hand. Check what exists first, then build the file even when a similar one already exists.\n- When the user types `/graphify`, invoke the Skill tool with `skill: \"graphify\"` before doing anything else.\n- Skills are tools: invoke one when it clearly fits the task.\n\n# Session Startup\n\nThe `keystone-unified-snapshot.js` SessionStart hook injects `global-memory/USER.md`, `global-memory/MEMORY.md`, a summary of `transcripts/.errors.log` (only when non-empty), and a pointer to the KeystoneOS snapshot. Work from the injected copy.\n\n- If hook failures appear, surface them once on the first response, then continue. Entries mean a hook or scheduled job failed.\n- If a **\"SessionStart hook could not read a required memory file\"** block appears, say so on the first response.\n- **If no `## User profile` block is in context at session start, the hook did not fire.** Say so, then read `USER.md`, `MEMORY.md` and `transcripts/.errors.log` by hand.\n- The injection is a frozen snapshot: mid-session writes take effect next session. Load anything further only when a question needs it.\n\n# Memory — routing only\n\nThe two-tier memory system (`~/.claude/global-memory/` and `~/.claude/projects/<slug>/memory/`) is owned by the **`memory-write` skill**, which holds the tier rules, character caps, slug rules, write steps, retrieval ladder, and daily-compiled-log rules.\n\nThe active project's Tier A memory (`~/.claude/projects/<slug>/memory/`, indexed by its `MEMORY.md`) is **auto-injected by the harness** each session. Tier A files are also indexed by memsearch, so they stay recallable across projects.\n\n- Writing a fact — \"remember this\", \"note that\", \"save this\", \"forget about\" → `Skill(\"memory-write\")`\n- Recalling past context — \"did we already…?\", \"what did we decide about X\" → `Skill(\"memory-write\")`, retrieval-ladder section\n- Daily compiled logs at `~/.claude/claude-memory-compiler/daily/` are written only by `claude-memory-compiler`. Read one only when a question needs that day.\n- **Slugs differ per machine** (Mac `-Users-kristinarash-DEV-<X>`, Windows `C--Users-eric-rash-Desktop-DEV-<X>`). Tier A written on one is not auto-injected on the other; memsearch still finds it. Durable project facts belong in the repo's `docs/` so both machines see them.\n\n---\n\nMaintainer note: `AGENTS.md` diverges from this file on purpose (Codex has no Skill tool, so it spells out the memory rules). Keep them as separate files; the memory procedure's one home is the `memory-write` skill."},{"path":"/Users/kristinarash/.claude/machine.md","type":"User","content":"# Shell / Environment (macOS)\n\n- zsh/bash is the native surface on this machine. PowerShell 7 (`pwsh`, `/opt/homebrew/bin/pwsh`) is installed only to run the KeystoneOS `.ps1` jobs natively.\n- **The tool-path list has one home: `~/.claude/TOOLPATHS.md`.** Read that file when you need a path. Only the traps below are kept, because acting on them wrongly is expensive.\n- **Verify, don't trust any list.** `which -a <tool>` is authoritative. To read PATH honestly, scrub the environment first:\n  `env -i HOME=\"$HOME\" USER=\"$USER\" TERM=xterm SHELL=/bin/zsh /bin/zsh -lic 'echo $PATH'`\n- Traps:\n  - Python is PEP 668-managed. Use venvs or `uv`, never `pip install` globally.\n  - `uv` is a standalone install at `~/.local/bin/uv`, **not** Homebrew. Claude Code hooks call `$HOME/.local/bin/uv`; do not delete or relocate it.\n  - `timeout` is NOT installed (no GNU coreutils). Don't use it in scripts.\n  - Homebrew owns `/opt/homebrew/bin`. `/usr/local/bin` is empty and stays that way.\n  - Secrets live in the macOS Keychain, not in `~/.zshrc`.\n- DEV projects live at `~/DEV` (not `~/Desktop/DEV`). Workspace map: `~/DEV/CLAUDE.md`.\n- Primary storage drive (documents, data, deliverables): `~/Library/CloudStorage/GoogleDrive-eric.rash11@gmail.com/My Drive/00_Primary_Storage_Drive`."},{"path":"/Users/kristinarash/DEV/CLAUDE.md","type":"Project","content":"# ~/DEV — workspace map\n\nEric Rash — Applied Performance, Baylor Athletics. Sport science and\nfootball analytics, plus the agent system that runs them.\n\nThis file is a **map, not a rulebook**. Behavior rules live in\n`~/.claude/CLAUDE.md`. Read only the index you need.\n\n## Areas\n\n| Area | Index | What lives there |\n|---|---|---|\n| Football | `FOOTBALL.md` | Game film, player analytics, CFB prediction. ~39k files — about two thirds of DEV. |\n| Performance | `PERFORMANCE.md` | Athlete monitoring, testing, load, risk. GPS, force plate, VALD, DEXA, S2. |\n| Research | `RESEARCH.md` | Literature, Zotero, book library, reading pipelines. |\n| Platform | `PLATFORM.md` | KeystoneOS, dashboards, CLIs, scheduled jobs. |\n| Program | `PROGRAM.md` | Staff reporting, curriculum, proposals, vetting, brand. |\n| Personal | `PERSONAL.md` | Side projects. Not Baylor work. |\n| Commands | `COMMANDS.md` | Desk reference: every report/project command Eric can run himself. |\n| Workflow | `WORKFLOW.md` | The ideal day, week and semester: which skill, mod and ritual, when and why. |\n\n## Elsewhere on disk\n\n`~/DEV` in this file means the workspace root: `~/DEV` on the Mac,\n`~/Desktop/DEV` on Windows. Paths that differ per machine are in `~/.claude/machine.md`.\n\n| Path | What it is |\n|---|---|\n| `~/DEV/_ARCHIVE/` | Parked projects. Not a git repo, so the consolidation sweep skips it. Has its own `README.md`. |\n| `~/DEV/_INBOX/` | Loose files from the `~/DEV` root. Own repo. |\n| SecondBrain vault | Obsidian vault, ~850 notes. Own `CLAUDE.md`. Mac `~/SecondBrain`, Windows `~/Desktop/SecondBrain`. |\n| `~/.claude/skills/` | ~45 skills (plugins add more) |\n| `~/go/bin/` | ~8 custom CLIs built with `cli-printing-press` |\n| `~/.claude/claude-memory-compiler/knowledge/` | ~190 compiled articles |\n\n## Layout rules\n\nFull rules — grouping depth, the depth-2 discovery limit, and the gitignored-subtree\ntrap — live in project memory: `project_dev-layout-and-discovery.md`.\n\n- 23 projects carry their own `CLAUDE.md`. Read it before working in one.\n\n## Handling care\n\n- `DexaProject/` holds identifiable health data. It lives on Google Drive, not in\n  `~/DEV`, on **both** machines — one copy, reached by each machine's own path:\n  - Mac: `~/Library/CloudStorage/GoogleDrive-eric.rash11@gmail.com/My Drive/00_Primary_Storage_Drive/DexaProject`\n  - Windows: `G:\\My Drive\\00_Primary_Storage_Drive\\DexaProject`\n\n  See `PERFORMANCE.md`.\n  Never paste its contents into chat, an artifact, or an external service.\n\n## Keeping this true\n\nWhen a file moves or a new project starts, **update the router in the same\nturn**. A stale pointer is worse than no pointer.\n\nThe counts above are approximate on purpose — they convey scale, not state, and\na `~` keeps ordinary growth from making this file wrong. Re-measure them only\nwhen one is off by enough to change a decision. Counts last checked 2026-10-02.\n\nMemory files named in these indexes (`project_*.md`, `user_*.md`) live in the\nworkspace's Tier A folder: Mac `~/.claude/projects/-Users-kristinarash-DEV/memory/`,\nWindows `~/.claude/projects/C--Users-eric-rash-Desktop-DEV/memory/`. They auto-load\nonly when cwd is the workspace root itself — from inside a sub-project, open them by path.\n\nSearch everything with `memsearch search \"<query>\" --top-k 5`."},{"path":"/Users/kristinarash/.claude/projects/-Users-kristinarash-DEV/memory/MEMORY.md","type":"AutoMem","content":"# Memory Index\n\nOne line per memory: title, file, and a hook that says when to open it.\nNever put memory content here — the file itself holds the facts.\n\n- [Printing Press spec traps](project_printing-press-spec-traps.md) — writing a CLI spec\n- [zsh shell traps](project_zsh-shell-traps.md) — a zsh script misbehaves\n- [Status report sourcing](project_status-report-sourcing.md) — building the status report\n- [Fireflies CLI on Mac](project_fireflies-cli-broken-on-mac.md) — Fireflies CLI errors or renames\n- [gws Google Forms API](project_gws-forms-api.md) — creating or editing a Google Form\n- [Kenny Boyd doc review](project_kenny-boyd-doc-review-preferences.md) — writing a review doc for Kenny\n- [Kenny Boyd writing voice](project_kenny-boyd-writing-voice.md) — writing to, for, or like Kenny; SAS Leadership meeting\n- [Terminal Fluency workspace](project_terminal-fluency-workspace.md) — resuming Terminal Fluency\n- [PATH shadowing and cleanup](project_path-shadowing-and-cleanup.md) — PATH questions; before deleting any binary\n- [Backup/sync system](project_backup-sync-system.md) — backup routing or verification\n- [CFB Analytics Lab](project_cfb-analytics-lab.md) — resuming CFB Analytics Lab\n- [CFB forecast capture](project_cfb-forecast-capture.md) — weekly Big 12 forecast capture\n- [Drive FUSE rsync loop](project_drive-fuse-rsync-mtime-loop.md) — rsync keeps re-sending files to Drive, or hangs copying into Drive\n- [SecondBrain vault location](project_secondbrain-vault-location.md) — vault path questions\n- [Milvus lock misdiagnosis](project_milvus-lock-misdiagnosis.md) — Zotero/Milvus errors\n- [Memory compiler pipeline](project_memory-compiler-pipeline.md) — flush or daily-log problems\n- [memsearch index path drift](project_memsearch-index-path-drift.md) — memsearch indexes fewer paths\n- [memsearch hook timeout cap](project_memsearch-hook-timeout-cap.md) — memsearch slow or timing out\n- [Morning briefing retired](project_morning-briefing-retired.md) — old morning-briefing code or config\n- [graphify runtime setup](project_graphify-runtime-setup.md) — installing or rebuilding graphify\n- [graphify semantic extraction](project_graphify-semantic-extraction.md) — graphify quota or 429 errors\n- [Automation cadence](project_automation-cadence.md) — when a scheduled job or ritual runs\n- [S2 Cognition analysis](project_s2-cognition-analysis.md) — S2 Cognition work\n- [Sports teams](user_sports-teams.md) — an ambiguous WNBA ask\n- [Working-conditions bottleneck](user_working-conditions-bottleneck.md) — deciding whether to act unasked\n- [Zero-edit YouTube pipeline](reference_zero-edit-youtube-pipeline.md) — Claude Code video pipeline\n- [DEV layout and discovery](project_dev-layout-and-discovery.md) — moving or adding folders in ~/DEV\n- [KeystoneOS verification habits](project_keystoneos-verification-habits.md) — before asserting KeystoneOS state\n- [Portfolio registry provenance](project_portfolio-registry-write-provenance.md) — changing portfolio.json\n- [Command centre](project_command-centre.md) — retired 10-03 (board replaced it); localhost web-service security rules\n- [Vendored skill install](project_vendored-skill-install.md) — installing a vendored skill\n- [Vendored skill repair](project_vendored-skill-repair.md) — a skill returns empty output\n- [Personal site build routes](project_personal-site-build-routes.md) — building the personal site\n- [Book scan page ordering](project_book-scan-page-ordering.md) — scanned book pages out of order\n- [Ingest review gate](feedback_ingest-review-gate.md) — before ingest-book or other costly atomization\n- [Dormant threads](project_dormant-threads.md) — resuming Tezino CampPrep or FaceComps\n- [RTP CLA course](project_rtp-cla-course.md) — RTP CLA course work\n- [Post-merge cleanup](feedback_post-merge-cleanup.md) — after a merge; deleting worktrees or branches\n- [SCN sprint course](project_scn-sprint-course.md) — SCN sprint course work\n- [ATH Tech framework](project_ath-tech-framework.md) — ATH Tech framework work\n- [Supervisor log pipeline](project_supervisor-log-pipeline.md) — supervisor log or Kenny/Chris report\n- [dcg guard blocks](project_dcg-guard-blocks.md) — a Bash command was blocked\n- [Headless tool-deny gap](project_headless-claude-tool-deny-gap.md) — before calling a headless run read-only\n- [Config encoding damage from Windows](project_settings-json-bom-trap.md) — \"hook missing\" or garbled statusline\n- [Tech inventory refresh](project_tech-inventory-refresh.md) — refreshing the tech inventory\n- [Brain audit loop](project_brain-audit-loop.md) — scoring the second brain\n- [Hook two-copies trap](project_hook-two-copies-trap.md) — a hook patch \"reverts\"\n- [Child dental plan](user_child-dental-plan.md) — child dental care\n- [ELI5 output style](user_eli5-output-style.md) — output-style rules\n- [GitHub consolidation](project_github-consolidation.md) — ~/DEV repo layout or merge traps\n- [Skill bloat and promotion](project_skill-bloat-and-promotion.md) — before touching ANY skill folder\n- [Prioritization slate](project_prioritization-slate.md) — Eric proposes a new project or idea\n- [Baylor department names](user_baylor-department-names.md) — writing staff-facing text\n- [Git Bash MSYS/AD stall](project_git-bash-msys-ad-stall.md) — Windows bash dies with `add_item errno 1`\n- [Backup task sleep-kill signature](project_backup-task-sleepkill-signature.md) — Windows backup exit 3221225786\n- [Sport-science thought partner](user_sport-science-thought-partner.md) — performance, S&C or rehab questions\n- [Third-party skill install](project_third-party-skill-install.md) — installing a third-party skill\n- [Admin docs house style](feedback_admin-docs-house-style.md) — building any doc for administration; Baylor_Doc_Style only, ask before breaking a page limit\n- [Box access via Box Drive](project_box-access-via-box-drive.md) — any Box request: Baylor blocks the MCP/connector, use the local Box Drive folder\n- [42Analytics YouTube pipeline](project_42analytics-youtube-pipeline.md) — YouTube channel to Flint; caption 429s, subagent summary.md block, empty Jev key\n- [Session hygiene](feedback_session-hygiene.md) — deleting sessions, \"where was I\", starting the day\n- [M365 agent access](project_m365-agent-access.md) — automating Teams, Outlook, Excel, Word or PowerPoint\n- [Harness time budget](feedback_harness-time-budget.md) — before any hook/skill/memory/system fix outside Friday's slot\n- [Defer to Pocock skills](feedback_defer-to-mattpocock-skills.md) — debugging, TDD, grilling, PR body, skill/CLAUDE.md edits: use mattpocock-skills first"}]},"type":"attachment","uuid":"7b5d102e-f623-48f4-84c1-79d022e1d409","timestamp":"2026-10-07T16:39:14.617Z","rendered":[{"content":"<system-reminder>\nCodebase and user instructions are shown below. Be sure to adhere to these instructions. IMPORTANT: These instructions OVERRIDE any default behavior and you MUST follow them exactly as written.\n\nContents of /Users/kristinarash/.claude/CLAUDE.md (user's private global instructions for all projects):\n\n# Machine\n\nMachine-specific shell, paths, and traps live in `~/.claude/machine.md` (gitignored; copy `machine.macos.md` or `machine.windows.md` to `machine.md` on a new machine). It is imported below.\n\n@machine.md\n\nTwo machines share this setup: the MacBook (`~/DEV`) and the Baylor Windows laptop (`~/Desktop/DEV`). Projects sync through GitHub (`erash11`), documents through Google Drive.\n\n**Session routine.** When working inside a project repo, follow the Session routine in its `AGENTS.md`: `git pull` and read `docs/STATUS.md` at the start; update `STATUS.md`, commit, and `git push` at the end. This is what keeps the two machines in step.\n\n# Workflow Expectations\n\n- When asked to **create, merge, or consolidate an artifact** (calendar, deck, doc), finish with the produced file in hand. Check what exists first, then build the file even when a similar one already exists.\n- When the user types `/graphify`, invoke the Skill tool with `skill: \"graphify\"` before doing anything else.\n- Skills are tools: invoke one when it clearly fits the task.\n\n# Session Startup\n\nThe `keystone-unified-snapshot.js` SessionStart hook injects `global-memory/USER.md`, `global-memory/MEMORY.md`, a summary of `transcripts/.errors.log` (only when non-empty), and a pointer to the KeystoneOS snapshot. Work from the injected copy.\n\n- If hook failures appear, surface them once on the first response, then continue. Entries mean a hook or scheduled job failed.\n- If a **\"SessionStart hook could not read a required memory file\"** block appears, say so on the first response.\n- **If no `## User profile` block is in context at session start, the hook did not fire.** Say so, then read `USER.md`, `MEMORY.md` and `transcripts/.errors.log` by hand.\n- The injection is a frozen snapshot: mid-session writes take effect next session. Load anything further only when a question needs it.\n\n# Memory — routing only\n\nThe two-tier memory system (`~/.claude/global-memory/` and `~/.claude/projects/<slug>/memory/`) is owned by the **`memory-write` skill**, which holds the tier rules, character caps, slug rules, write steps, retrieval ladder, and daily-compiled-log rules.\n\nThe active project's Tier A memory (`~/.claude/projects/<slug>/memory/`, indexed by its `MEMORY.md`) is **auto-injected by the harness** each session. Tier A files are also indexed by memsearch, so they stay recallable across projects.\n\n- Writing a fact — \"remember this\", \"note that\", \"save this\", \"forget about\" → `Skill(\"memory-write\")`\n- Recalling past context — \"did we already…?\", \"what did we decide about X\" → `Skill(\"memory-write\")`, retrieval-ladder section\n- Daily compiled logs at `~/.claude/claude-memory-compiler/daily/` are written only by `claude-memory-compiler`. Read one only when a question needs that day.\n- **Slugs differ per machine** (Mac `-Users-kristinarash-DEV-<X>`, Windows `C--Users-eric-rash-Desktop-DEV-<X>`). Tier A written on one is not auto-injected on the other; memsearch still finds it. Durable project facts belong in the repo's `docs/` so both machines see them.\n\n---\n\nMaintainer note: `AGENTS.md` diverges from this file on purpose (Codex has no Skill tool, so it spells out the memory rules). Keep them as separate files; the memory procedure's one home is the `memory-write` skill.\n\nContents of /Users/kristinarash/.claude/machine.md (user's private global instructions for all projects):\n\n# Shell / Environment (macOS)\n\n- zsh/bash is the native surface on this machine. PowerShell 7 (`pwsh`, `/opt/homebrew/bin/pwsh`) is installed only to run the KeystoneOS `.ps1` jobs natively.\n- **The tool-path list has one home: `~/.claude/TOOLPATHS.md`.** Read that file when you need a path. Only the traps below are kept, because acting on them wrongly is expensive.\n- **Verify, don't trust any list.** `which -a <tool>` is authoritative. To read PATH honestly, scrub the environment first:\n  `env -i HOME=\"$HOME\" USER=\"$USER\" TERM=xterm SHELL=/bin/zsh /bin/zsh -lic 'echo $PATH'`\n- Traps:\n  - Python is PEP 668-managed. Use venvs or `uv`, never `pip install` globally.\n  - `uv` is a standalone install at `~/.local/bin/uv`, **not** Homebrew. Claude Code hooks call `$HOME/.local/bin/uv`; do not delete or relocate it.\n  - `timeout` is NOT installed (no GNU coreutils). Don't use it in scripts.\n  - Homebrew owns `/opt/homebrew/bin`. `/usr/local/bin` is empty and stays that way.\n  - Secrets live in the macOS Keychain, not in `~/.zshrc`.\n- DEV projects live at `~/DEV` (not `~/Desktop/DEV`). Workspace map: `~/DEV/CLAUDE.md`.\n- Primary storage drive (documents, data, deliverables): `~/Library/CloudStorage/GoogleDrive-eric.rash11@gmail.com/My Drive/00_Primary_Storage_Drive`.\n\nContents of /Users/kristinarash/DEV/CLAUDE.md (project instructions, checked into the codebase):\n\n# ~/DEV — workspace map\n\nEric Rash — Applied Performance, Baylor Athletics. Sport science and\nfootball analytics, plus the agent system that runs them.\n\nThis file is a **map, not a rulebook**. Behavior rules live in\n`~/.claude/CLAUDE.md`. Read only the index you need.\n\n## Areas\n\n| Area | Index | What lives there |\n|---|---|---|\n| Football | `FOOTBALL.md` | Game film, player analytics, CFB prediction. ~39k files — about two thirds of DEV. |\n| Performance | `PERFORMANCE.md` | Athlete monitoring, testing, load, risk. GPS, force plate, VALD, DEXA, S2. |\n| Research | `RESEARCH.md` | Literature, Zotero, book library, reading pipelines. |\n| Platform | `PLATFORM.md` | KeystoneOS, dashboards, CLIs, scheduled jobs. |\n| Program | `PROGRAM.md` | Staff reporting, curriculum, proposals, vetting, brand. |\n| Personal | `PERSONAL.md` | Side projects. Not Baylor work. |\n| Commands | `COMMANDS.md` | Desk reference: every report/project command Eric can run himself. |\n| Workflow | `WORKFLOW.md` | The ideal day, week and semester: which skill, mod and ritual, when and why. |\n\n## Elsewhere on disk\n\n`~/DEV` in this file means the workspace root: `~/DEV` on the Mac,\n`~/Desktop/DEV` on Windows. Paths that differ per machine are in `~/.claude/machine.md`.\n\n| Path | What it is |\n|---|---|\n| `~/DEV/_ARCHIVE/` | Parked projects. Not a git repo, so the consolidation sweep skips it. Has its own `README.md`. |\n| `~/DEV/_INBOX/` | Loose files from the `~/DEV` root. Own repo. |\n| SecondBrain vault | Obsidian vault, ~850 notes. Own `CLAUDE.md`. Mac `~/SecondBrain`, Windows `~/Desktop/SecondBrain`. |\n| `~/.claude/skills/` | ~45 skills (plugins add more) |\n| `~/go/bin/` | ~8 custom CLIs built with `cli-printing-press` |\n| `~/.claude/claude-memory-compiler/knowledge/` | ~190 compiled articles |\n\n## Layout rules\n\nFull rules — grouping depth, the depth-2 discovery limit, and the gitignored-subtree\ntrap — live in project memory: `project_dev-layout-and-discovery.md`.\n\n- 23 projects carry their own `CLAUDE.md`. Read it before working in one.\n\n## Handling care\n\n- `DexaProject/` holds identifiable health data. It lives on Google Drive, not in\n  `~/DEV`, on **both** machines — one copy, reached by each machine's own path:\n  - Mac: `~/Library/CloudStorage/GoogleDrive-eric.rash11@gmail.com/My Drive/00_Primary_Storage_Drive/DexaProject`\n  - Windows: `G:\\My Drive\\00_Primary_Storage_Drive\\DexaProject`\n\n  See `PERFORMANCE.md`.\n  Never paste its contents into chat, an artifact, or an external service.\n\n## Keeping this true\n\nWhen a file moves or a new project starts, **update the router in the same\nturn**. A stale pointer is worse than no pointer.\n\nThe counts above are approximate on purpose — they convey scale, not state, and\na `~` keeps ordinary growth from making this file wrong. Re-measure them only\nwhen one is off by enough to change a decision. Counts last checked 2026-10-02.\n\nMemory files named in these indexes (`project_*.md`, `user_*.md`) live in the\nworkspace's Tier A folder: Mac `~/.claude/projects/-Users-kristinarash-DEV/memory/`,\nWindows `~/.claude/projects/C--Users-eric-rash-Desktop-DEV/memory/`. They auto-load\nonly when cwd is the workspace root itself — from inside a sub-project, open them by path.\n\nSearch everything with `memsearch search \"<query>\" --top-k 5`.\n\nContents of /Users/kristinarash/.claude/projects/-Users-kristinarash-DEV/memory/MEMORY.md (user's auto-memory, persists across conversations):\n\n# Memory Index\n\nOne line per memory: title, file, and a hook that says when to open it.\nNever put memory content here — the file itself holds the facts.\n\n- [Printing Press spec traps](project_printing-press-spec-traps.md) — writing a CLI spec\n- [zsh shell traps](project_zsh-shell-traps.md) — a zsh script misbehaves\n- [Status report sourcing](project_status-report-sourcing.md) — building the status report\n- [Fireflies CLI on Mac](project_fireflies-cli-broken-on-mac.md) — Fireflies CLI errors or renames\n- [gws Google Forms API](project_gws-forms-api.md) — creating or editing a Google Form\n- [Kenny Boyd doc review](project_kenny-boyd-doc-review-preferences.md) — writing a review doc for Kenny\n- [Kenny Boyd writing voice](project_kenny-boyd-writing-voice.md) — writing to, for, or like Kenny; SAS Leadership meeting\n- [Terminal Fluency workspace](project_terminal-fluency-workspace.md) — resuming Terminal Fluency\n- [PATH shadowing and cleanup](project_path-shadowing-and-cleanup.md) — PATH questions; before deleting any binary\n- [Backup/sync system](project_backup-sync-system.md) — backup routing or verification\n- [CFB Analytics Lab](project_cfb-analytics-lab.md) — resuming CFB Analytics Lab\n- [CFB forecast capture](project_cfb-forecast-capture.md) — weekly Big 12 forecast capture\n- [Drive FUSE rsync loop](project_drive-fuse-rsync-mtime-loop.md) — rsync keeps re-sending files to Drive, or hangs copying into Drive\n- [SecondBrain vault location](project_secondbrain-vault-location.md) — vault path questions\n- [Milvus lock misdiagnosis](project_milvus-lock-misdiagnosis.md) — Zotero/Milvus errors\n- [Memory compiler pipeline](project_memory-compiler-pipeline.md) — flush or daily-log problems\n- [memsearch index path drift](project_memsearch-index-path-drift.md) — memsearch indexes fewer paths\n- [memsearch hook timeout cap](project_memsearch-hook-timeout-cap.md) — memsearch slow or timing out\n- [Morning briefing retired](project_morning-briefing-retired.md) — old morning-briefing code or config\n- [graphify runtime setup](project_graphify-runtime-setup.md) — installing or rebuilding graphify\n- [graphify semantic extraction](project_graphify-semantic-extraction.md) — graphify quota or 429 errors\n- [Automation cadence](project_automation-cadence.md) — when a scheduled job or ritual runs\n- [S2 Cognition analysis](project_s2-cognition-analysis.md) — S2 Cognition work\n- [Sports teams](user_sports-teams.md) — an ambiguous WNBA ask\n- [Working-conditions bottleneck](user_working-conditions-bottleneck.md) — deciding whether to act unasked\n- [Zero-edit YouTube pipeline](reference_zero-edit-youtube-pipeline.md) — Claude Code video pipeline\n- [DEV layout and discovery](project_dev-layout-and-discovery.md) — moving or adding folders in ~/DEV\n- [KeystoneOS verification habits](project_keystoneos-verification-habits.md) — before asserting KeystoneOS state\n- [Portfolio registry provenance](project_portfolio-registry-write-provenance.md) — changing portfolio.json\n- [Command centre](project_command-centre.md) — retired 10-03 (board replaced it); localhost web-service security rules\n- [Vendored skill install](project_vendored-skill-install.md) — installing a vendored skill\n- [Vendored skill repair](project_vendored-skill-repair.md) — a skill returns empty output\n- [Personal site build routes](project_personal-site-build-routes.md) — building the personal site\n- [Book scan page ordering](project_book-scan-page-ordering.md) — scanned book pages out of order\n- [Ingest review gate](feedback_ingest-review-gate.md) — before ingest-book or other costly atomization\n- [Dormant threads](project_dormant-threads.md) — resuming Tezino CampPrep or FaceComps\n- [RTP CLA course](project_rtp-cla-course.md) — RTP CLA course work\n- [Post-merge cleanup](feedback_post-merge-cleanup.md) — after a merge; deleting worktrees or branches\n- [SCN sprint course](project_scn-sprint-course.md) — SCN sprint course work\n- [ATH Tech framework](project_ath-tech-framework.md) — ATH Tech framework work\n- [Supervisor log pipeline](project_supervisor-log-pipeline.md) — supervisor log or Kenny/Chris report\n- [dcg guard blocks](project_dcg-guard-blocks.md) — a Bash command was blocked\n- [Headless tool-deny gap](project_headless-claude-tool-deny-gap.md) — before calling a headless run read-only\n- [Config encoding damage from Windows](project_settings-json-bom-trap.md) — \"hook missing\" or garbled statusline\n- [Tech inventory refresh](project_tech-inventory-refresh.md) — refreshing the tech inventory\n- [Brain audit loop](project_brain-audit-loop.md) — scoring the second brain\n- [Hook two-copies trap](project_hook-two-copies-trap.md) — a hook patch \"reverts\"\n- [Child dental plan](user_child-dental-plan.md) — child dental care\n- [ELI5 output style](user_eli5-output-style.md) — output-style rules\n- [GitHub consolidation](project_github-consolidation.md) — ~/DEV repo layout or merge traps\n- [Skill bloat and promotion](project_skill-bloat-and-promotion.md) — before touching ANY skill folder\n- [Prioritization slate](project_prioritization-slate.md) — Eric proposes a new project or idea\n- [Baylor department names](user_baylor-department-names.md) — writing staff-facing text\n- [Git Bash MSYS/AD stall](project_git-bash-msys-ad-stall.md) — Windows bash dies with `add_item errno 1`\n- [Backup task sleep-kill signature](project_backup-task-sleepkill-signature.md) — Windows backup exit 3221225786\n- [Sport-science thought partner](user_sport-science-thought-partner.md) — performance, S&C or rehab questions\n- [Third-party skill install](project_third-party-skill-install.md) — installing a third-party skill\n- [Admin docs house style](feedback_admin-docs-house-style.md) — building any doc for administration; Baylor_Doc_Style only, ask before breaking a page limit\n- [Box access via Box Drive](project_box-access-via-box-drive.md) — any Box request: Baylor blocks the MCP/connector, use the local Box Drive folder\n- [42Analytics YouTube pipeline](project_42analytics-youtube-pipeline.md) — YouTube channel to Flint; caption 429s, subagent summary.md block, empty Jev key\n- [Session hygiene](feedback_session-hygiene.md) — deleting sessions, \"where was I\", starting the day\n- [M365 agent access](project_m365-agent-access.md) — automating Teams, Outlook, Excel, Word or PowerPoint\n- [Harness time budget](feedback_harness-time-budget.md) — before any hook/skill/memory/system fix outside Friday's slot\n- [Defer to Pocock skills](feedback_defer-to-mattpocock-skills.md) — debugging, TDD, grilling, PR body, skill/CLAUDE.md edits: use mattpocock-skills first\n</system-reminder>"}],"renderedRole":"user","session_id":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c8cd7806-9ebb-4a31-9ea2-52a66b3eb4e0","version":"2.1.292","gitBranch":"main"}
