{"parentUuid":"a65876fc-ef59-41b6-8d59-d7d7fb83dc76","isSidechain":true,"promptId":"25464faf-de35-487d-80c8-05bd17310fd6","agentId":"a00473bf11fbca24d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0179T3gyYEXznejpgXowzPXi","type":"tool_result","content":"1\t\"\"\"Catapult OpenField Cloud REST API client.\n2\t\n3\tUses a pre-issued long-lived JWT Bearer token (set CATAPULT_TOKEN in .env).\n4\tHandles paginated requests and retry logic. All HTTP interaction lives here.\n5\t\"\"\"\n6\t\n7\timport json\n8\timport logging\n9\timport os\n10\timport time\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\timport requests\n15\t\n16\tfrom src.utils import get_logger\n17\t\n18\tlogger = get_logger(__name__)\n19\t\n20\t# Base URLs by region\n21\t_BASE_URLS = {\n22\t    \"us\": \"https://connect-us.catapultsports.com/api/v6\",\n23\t    \"eu\": \"https://connect-eu.catapultsports.com/api/v6\",\n24\t    \"au\": \"https://connect-au.catapultsports.com/api/v6\",\n25\t}\n26\t\n27\t_ACTIVITIES_ENDPOINT = \"/activities\"\n28\t_ATHLETES_ENDPOINT = \"/athletes\"\n29\t\n30\t\n31\tclass CatapultAPIError(Exception):\n32\t    \"\"\"Raised when the Catapult API returns an unrecoverable error.\"\"\"\n33\t\n34\t    def __init__(self, status_code: int, message: str):\n35\t        self.status_code = status_code\n36\t        super().__init__(f\"Catapult API error {status_code}: {message}\")\n37\t\n38\t\n39\tclass CatapultClient:\n40\t    \"\"\"Stateful client for the Catapult OpenField Cloud API.\"\"\"\n41\t\n42\t    def __init__(self, region: str = \"us\"):\n43\t        self.base_url = _BASE_URLS.get(region.lower(), _BASE_URLS[\"us\"])\n44\t        self._token = os.environ.get(\"CATAPULT_TOKEN\", \"\").strip()\n45\t        if not self._token:\n46\t            raise EnvironmentError(\n47\t                \"CATAPULT_TOKEN must be set in .env\"\n48\t            )\n49\t        self._debug_dump_done: bool = False\n50\t\n51\t    # ------------------------------------------------------------------\n52\t    # Raw HTTP helpers\n53\t    # ------------------------------------------------------------------\n54\t\n55\t    def _get(self, path: str, params: dict | None = None, retries: int = 4) -> dict:\n56\t        \"\"\"GET request with exponential backoff on 429 / 5xx.\"\"\"\n57\t        url = self.base_url + path\n58\t        headers = {\"Authorization\": f\"Bearer {self._token}\"}\n59\t        delay = 2\n60\t        for attempt in range(retries):\n61\t            resp = requests.get(url, headers=headers, params=params, timeout=30)\n62\t            if resp.status_code == 200:\n63\t                return resp.json()\n64\t            if resp.status_code in (429, 503, 502):\n65\t                logger.warning(\n66\t                    \"Rate limit / server error %d on %s. Retrying in %ds (attempt %d/%d).\",\n67\t                    resp.status_code, path, delay, attempt + 1, retries,\n68\t                )\n69\t                time.sleep(delay)\n70\t                delay *= 2\n71\t                continue\n72\t            raise CatapultAPIError(resp.status_code, resp.text)\n73\t        raise CatapultAPIError(429, f\"Max retries exceeded for {path}\")\n74\t\n75\t    def _post(self, path: str, body: dict, retries: int = 4) -> Any:\n76\t        \"\"\"POST request with exponential backoff on 429 / 5xx.\"\"\"\n77\t        url = self.base_url + path\n78\t        headers = {\n79\t            \"Authorization\": f\"Bearer {self._token}\",\n80\t            \"Content-Type\": \"application/json\",\n81\t            \"Accept\": \"application/json\",\n82\t        }\n83\t        delay = 2\n84\t        for attempt in range(retries):\n85\t            resp = requests.post(url, headers=headers, json=body, timeout=60)\n86\t            if resp.status_code == 200:\n87\t                return resp.json()\n88\t            if resp.status_code in (429, 503, 502):\n89\t                logger.warning(\n90\t                    \"Rate limit / server error %d on %s. Retrying in %ds (attempt %d/%d).\",\n91\t                    resp.status_code, path, delay, attempt + 1, retries,\n92\t                )\n93\t                time.sleep(delay)\n94\t                delay *= 2\n95\t                continue\n96\t            raise CatapultAPIError(resp.status_code, resp.text)\n97\t        raise CatapultAPIError(429, f\"Max retries exceeded for {path}\")\n98\t\n99\t    def _get_all_pages(self, path: str, params: dict | None = None) -> list[dict]:\n100\t        \"\"\"Fetch all pages from a paginated endpoint and return combined items.\n101\t\n102\t        The Connect v6 API returns a plain JSON array (no pagination wrapper),\n103\t        so we simply return the list directly.\n104\t        \"\"\"\n105\t        params = dict(params or {})\n106\t        data = self._get(path, params)\n107\t        # Connect v6 returns a plain list\n108\t        if isinstance(data, list):\n109\t            logger.debug(\"Fetched %d items from %s\", len(data), path)\n110\t            return data\n111\t        # Fallback: wrapped response\n112\t        items = (\n113\t            data.get(\"data\")\n114\t            or data.get(\"activities\")\n115\t            or data.get(\"athletes\")\n116\t            or []\n117\t        )\n118\t        logger.debug(\"Fetched %d items from %s\", len(items), path)\n119\t        return items\n120\t\n121\t    # ------------------------------------------------------------------\n122\t    # Debug helper — dumps raw JSON on first call to help verify field names\n123\t    # ------------------------------------------------------------------\n124\t\n125\t    def _maybe_dump_debug(self, label: str, payload: Any) -> None:\n126\t        if self._debug_dump_done:\n127\t            return\n128\t        debug_path = Path(\"logs\") / \"debug_first_response.json\"\n129\t        debug_path.parent.mkdir(exist_ok=True)\n130\t        with open(debug_path, \"w\", encoding=\"utf-8\") as f:\n131\t            json.dump({label: payload[:2] if isinstance(payload, list) else payload}, f, indent=2)\n132\t        logger.info(\"First-run debug dump written to %s — check field names there.\", debug_path)\n133\t        self._debug_dump_done = True\n134\t\n135\t    # ------------------------------------------------------------------\n136\t    # Public API methods\n137\t    # ------------------------------------------------------------------\n138\t\n139\t    def list_activities(self, start_time: str, end_time: str) -> list[dict]:\n140\t        \"\"\"Return all activities within a time window (ISO 8601 strings).\"\"\"\n141\t        items = self._get_all_pages(\n142\t            _ACTIVITIES_ENDPOINT,\n143\t            {\"start_time\": start_time, \"end_time\": end_time},\n144\t        )\n145\t        logger.info(\"Found %d activit(ies) for the requested window.\", len(items))\n146\t        return items\n147\t\n148\t    def list_athletes(self) -> list[dict]:\n149\t        \"\"\"Return the full roster.\"\"\"\n150\t        items = self._get_all_pages(_ATHLETES_ENDPOINT)\n151\t        logger.info(\"Fetched %d athletes from roster.\", len(items))\n152\t        self._maybe_dump_debug(\"athletes\", items)\n153\t        return items\n154\t\n155\t    def list_positions(self) -> list[str]:\n156\t        \"\"\"Return a sorted list of unique position strings from the current roster.\"\"\"\n157\t        athletes = self.list_athletes()\n158\t        positions = sorted(\n159\t            {str(a.get(\"position\", \"\")).strip() for a in athletes if a.get(\"position\")}\n160\t        )\n161\t        return positions\n162\t\n163\t    def get_athlete_stats(self, activity_id: str) -> list[dict]:\n164\t        \"\"\"Return per-athlete summary stats for a single activity via POST /stats.\"\"\"\n165\t        body = {\n166\t            \"filters\": [\n167\t                {\"name\": \"activity_id\", \"comparison\": \"=\", \"values\": [activity_id]}\n168\t            ],\n169\t            \"parameters\": [\n170\t                # Core load / distance\n171\t                \"average_player_load\",\n172\t                \"total_distance\",\n173\t                \"max_vel\",\n174\t                \"velocity_band3_total_distance\",\n175\t                \"velocity_band4_total_distance\",\n176\t                \"velocity_band5_total_distance\",\n177\t                \"velocity_band6_total_distance\",\n178\t                \"velocity_band7_total_distance\",\n179\t                \"velocity_band8_total_distance\",\n180\t                \"acceleration_density\",\n181\t                \"explosive_efforts\",\n182\t                # Velocity band effort counts\n183\t                \"velocity_band3_total_effort_count\",\n184\t                \"velocity_band4_total_effort_count\",\n185\t                # Intensity / rate metrics\n186\t                \"total_duration\",\n187\t                \"total_acceleration_load\",\n188\t                \"average_velocity\",\n189\t                \"meterage_per_minute\",\n190\t                \"player_load_per_minute\",\n191\t                \"explosive_ratio_(avg)\",\n192\t                # IMA high-intensity counts\n193\t                \"ima_band3_accel_count\",\n194\t                \"ima_band3_decel_count\",\n195\t                \"ima_band3_right_count\",\n196\t                \"ima_band3_left_count\",\n197\t                \"high_ima_accel/decel\",\n198\t                \"total_high_ima\",\n199\t                \"total_medium_ima\",\n200\t                \"total_low_ima_movements\",\n201\t                \"ima/min\",\n202\t                \"total_high_ima/min\",\n203\t                \"total_high_ima_(avg)\",\n204\t                # Impacts\n205\t                \"impacts_low\",\n206\t                \"impacts_med\",\n207\t                \"impacts_high\",\n208\t                \"impact_low_(avg)\",\n209\t                \"impacts_med_(avg)\",\n210\t                \"impacts_high_(avg)\",\n211\t                # Player load bands\n212\t                \"pl_low\",\n213\t                \"pl_med\",\n214\t                \"pl_high\",\n215\t                \"pl_veryhigh\",\n216\t                \"pl_med_(avg)\",\n217\t                \"pl_veryhigh_(avg)\",\n218\t                \"pl_veryhigh/min\",\n219\t                # Sport-specific\n220\t                \"total_lineman_contact_count\",\n221\t                \"total_qb_throw_count\",\n222\t                \"total_football_impact_count\",\n223\t            ],\n224\t            \"group_by\": [\"athlete\"],\n225\t            \"source\": \"cached_stats\",\n226\t        }\n227\t        result = self._post(\"/stats\", body)\n228\t        self._maybe_dump_debug(\"stats\", result)\n229\t        rows = result if isinstance(result, list) else [result]\n230\t        logger.info(\"Fetched stats for activity %s — %d athlete rows.\", activity_id, len(rows))\n231\t        return rows\n232\t"}]},"uuid":"82358501-0cb4-44d1-a930-2880478cb6c6","timestamp":"2026-09-13T20:06:05.491Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kristinarash/DEV/DataBase_GPS_Reporting/gps_report/src/api_client.py","content":"\"\"\"Catapult OpenField Cloud REST API client.\n\nUses a pre-issued long-lived JWT Bearer token (set CATAPULT_TOKEN in .env).\nHandles paginated requests and retry logic. All HTTP interaction lives here.\n\"\"\"\n\nimport json\nimport logging\nimport os\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nimport requests\n\nfrom src.utils import get_logger\n\nlogger = get_logger(__name__)\n\n# Base URLs by region\n_BASE_URLS = {\n    \"us\": \"https://connect-us.catapultsports.com/api/v6\",\n    \"eu\": \"https://connect-eu.catapultsports.com/api/v6\",\n    \"au\": \"https://connect-au.catapultsports.com/api/v6\",\n}\n\n_ACTIVITIES_ENDPOINT = \"/activities\"\n_ATHLETES_ENDPOINT = \"/athletes\"\n\n\nclass CatapultAPIError(Exception):\n    \"\"\"Raised when the Catapult API returns an unrecoverable error.\"\"\"\n\n    def __init__(self, status_code: int, message: str):\n        self.status_code = status_code\n        super().__init__(f\"Catapult API error {status_code}: {message}\")\n\n\nclass CatapultClient:\n    \"\"\"Stateful client for the Catapult OpenField Cloud API.\"\"\"\n\n    def __init__(self, region: str = \"us\"):\n        self.base_url = _BASE_URLS.get(region.lower(), _BASE_URLS[\"us\"])\n        self._token = os.environ.get(\"CATAPULT_TOKEN\", \"\").strip()\n        if not self._token:\n            raise EnvironmentError(\n                \"CATAPULT_TOKEN must be set in .env\"\n            )\n        self._debug_dump_done: bool = False\n\n    # ------------------------------------------------------------------\n    # Raw HTTP helpers\n    # ------------------------------------------------------------------\n\n    def _get(self, path: str, params: dict | None = None, retries: int = 4) -> dict:\n        \"\"\"GET request with exponential backoff on 429 / 5xx.\"\"\"\n        url = self.base_url + path\n        headers = {\"Authorization\": f\"Bearer {self._token}\"}\n        delay = 2\n        for attempt in range(retries):\n            resp = requests.get(url, headers=headers, params=params, timeout=30)\n            if resp.status_code == 200:\n                return resp.json()\n            if resp.status_code in (429, 503, 502):\n                logger.warning(\n                    \"Rate limit / server error %d on %s. Retrying in %ds (attempt %d/%d).\",\n                    resp.status_code, path, delay, attempt + 1, retries,\n                )\n                time.sleep(delay)\n                delay *= 2\n                continue\n            raise CatapultAPIError(resp.status_code, resp.text)\n        raise CatapultAPIError(429, f\"Max retries exceeded for {path}\")\n\n    def _post(self, path: str, body: dict, retries: int = 4) -> Any:\n        \"\"\"POST request with exponential backoff on 429 / 5xx.\"\"\"\n        url = self.base_url + path\n        headers = {\n            \"Authorization\": f\"Bearer {self._token}\",\n            \"Content-Type\": \"application/json\",\n            \"Accept\": \"application/json\",\n        }\n        delay = 2\n        for attempt in range(retries):\n            resp = requests.post(url, headers=headers, json=body, timeout=60)\n            if resp.status_code == 200:\n                return resp.json()\n            if resp.status_code in (429, 503, 502):\n                logger.warning(\n                    \"Rate limit / server error %d on %s. Retrying in %ds (attempt %d/%d).\",\n                    resp.status_code, path, delay, attempt + 1, retries,\n                )\n                time.sleep(delay)\n                delay *= 2\n                continue\n            raise CatapultAPIError(resp.status_code, resp.text)\n        raise CatapultAPIError(429, f\"Max retries exceeded for {path}\")\n\n    def _get_all_pages(self, path: str, params: dict | None = None) -> list[dict]:\n        \"\"\"Fetch all pages from a paginated endpoint and return combined items.\n\n        The Connect v6 API returns a plain JSON array (no pagination wrapper),\n        so we simply return the list directly.\n        \"\"\"\n        params = dict(params or {})\n        data = self._get(path, params)\n        # Connect v6 returns a plain list\n        if isinstance(data, list):\n            logger.debug(\"Fetched %d items from %s\", len(data), path)\n            return data\n        # Fallback: wrapped response\n        items = (\n            data.get(\"data\")\n            or data.get(\"activities\")\n            or data.get(\"athletes\")\n            or []\n        )\n        logger.debug(\"Fetched %d items from %s\", len(items), path)\n        return items\n\n    # ------------------------------------------------------------------\n    # Debug helper — dumps raw JSON on first call to help verify field names\n    # ------------------------------------------------------------------\n\n    def _maybe_dump_debug(self, label: str, payload: Any) -> None:\n        if self._debug_dump_done:\n            return\n        debug_path = Path(\"logs\") / \"debug_first_response.json\"\n        debug_path.parent.mkdir(exist_ok=True)\n        with open(debug_path, \"w\", encoding=\"utf-8\") as f:\n            json.dump({label: payload[:2] if isinstance(payload, list) else payload}, f, indent=2)\n        logger.info(\"First-run debug dump written to %s — check field names there.\", debug_path)\n        self._debug_dump_done = True\n\n    # ------------------------------------------------------------------\n    # Public API methods\n    # ------------------------------------------------------------------\n\n    def list_activities(self, start_time: str, end_time: str) -> list[dict]:\n        \"\"\"Return all activities within a time window (ISO 8601 strings).\"\"\"\n        items = self._get_all_pages(\n            _ACTIVITIES_ENDPOINT,\n            {\"start_time\": start_time, \"end_time\": end_time},\n        )\n        logger.info(\"Found %d activit(ies) for the requested window.\", len(items))\n        return items\n\n    def list_athletes(self) -> list[dict]:\n        \"\"\"Return the full roster.\"\"\"\n        items = self._get_all_pages(_ATHLETES_ENDPOINT)\n        logger.info(\"Fetched %d athletes from roster.\", len(items))\n        self._maybe_dump_debug(\"athletes\", items)\n        return items\n\n    def list_positions(self) -> list[str]:\n        \"\"\"Return a sorted list of unique position strings from the current roster.\"\"\"\n        athletes = self.list_athletes()\n        positions = sorted(\n            {str(a.get(\"position\", \"\")).strip() for a in athletes if a.get(\"position\")}\n        )\n        return positions\n\n    def get_athlete_stats(self, activity_id: str) -> list[dict]:\n        \"\"\"Return per-athlete summary stats for a single activity via POST /stats.\"\"\"\n        body = {\n            \"filters\": [\n                {\"name\": \"activity_id\", \"comparison\": \"=\", \"values\": [activity_id]}\n            ],\n            \"parameters\": [\n                # Core load / distance\n                \"average_player_load\",\n                \"total_distance\",\n                \"max_vel\",\n                \"velocity_band3_total_distance\",\n                \"velocity_band4_total_distance\",\n                \"velocity_band5_total_distance\",\n                \"velocity_band6_total_distance\",\n                \"velocity_band7_total_distance\",\n                \"velocity_band8_total_distance\",\n                \"acceleration_density\",\n                \"explosive_efforts\",\n                # Velocity band effort counts\n                \"velocity_band3_total_effort_count\",\n                \"velocity_band4_total_effort_count\",\n                # Intensity / rate metrics\n                \"total_duration\",\n                \"total_acceleration_load\",\n                \"average_velocity\",\n                \"meterage_per_minute\",\n                \"player_load_per_minute\",\n                \"explosive_ratio_(avg)\",\n                # IMA high-intensity counts\n                \"ima_band3_accel_count\",\n                \"ima_band3_decel_count\",\n                \"ima_band3_right_count\",\n                \"ima_band3_left_count\",\n                \"high_ima_accel/decel\",\n                \"total_high_ima\",\n                \"total_medium_ima\",\n                \"total_low_ima_movements\",\n                \"ima/min\",\n                \"total_high_ima/min\",\n                \"total_high_ima_(avg)\",\n                # Impacts\n                \"impacts_low\",\n                \"impacts_med\",\n                \"impacts_high\",\n                \"impact_low_(avg)\",\n                \"impacts_med_(avg)\",\n                \"impacts_high_(avg)\",\n                # Player load bands\n                \"pl_low\",\n                \"pl_med\",\n                \"pl_high\",\n                \"pl_veryhigh\",\n                \"pl_med_(avg)\",\n                \"pl_veryhigh_(avg)\",\n                \"pl_veryhigh/min\",\n                # Sport-specific\n                \"total_lineman_contact_count\",\n                \"total_qb_throw_count\",\n                \"total_football_impact_count\",\n            ],\n            \"group_by\": [\"athlete\"],\n            \"source\": \"cached_stats\",\n        }\n        result = self._post(\"/stats\", body)\n        self._maybe_dump_debug(\"stats\", result)\n        rows = result if isinstance(result, list) else [result]\n        logger.info(\"Fetched stats for activity %s — %d athlete rows.\", activity_id, len(rows))\n        return rows\n","numLines":232,"startLine":1,"totalLines":232}},"sourceToolAssistantUUID":"a65876fc-ef59-41b6-8d59-d7d7fb83dc76","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"764640dd-fa00-46b9-a4d9-f83074a06408","version":"2.1.270","gitBranch":"main"}
{"parentUuid":"82358501-0cb4-44d1-a930-2880478cb6c6","isSidechain":true,"agentId":"a00473bf11fbca24d","message":{"model":"claude-opus-5","id":"msg_011Cf23HoK83wMEj4Dee9Qxq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lzy37F9cuEudFW4uTVaFSB","name":"Read","input":{"file_path":"/Users/kristinarash/DEV/DataBase_GPS_Reporting/gps_report/run_report.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":4582,"cache_read_input_tokens":49822,"cache_creation":{"ephemeral_5m_input_tokens":4582,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":2,"requestId":"req_011Cf23Hnk8g1A7kveYxnMn7","attributionAgent":"general-purpose","type":"assistant","uuid":"5bcbdb89-3ea9-4433-9e51-5e4ff7cb137b","timestamp":"2026-09-13T20:06:05.794Z","advisorModel":"claude-fable-5-1","effort":"high","perTurnEffort":null,"sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"764640dd-fa00-46b9-a4d9-f83074a06408","version":"2.1.270","gitBranch":"main"}
{"parentUuid":"5bcbdb89-3ea9-4433-9e51-5e4ff7cb137b","isSidechain":true,"promptId":"25464faf-de35-487d-80c8-05bd17310fd6","agentId":"a00473bf11fbca24d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lzy37F9cuEudFW4uTVaFSB","type":"tool_result","content":"1\t\"\"\"run_report.py — Post-Practice GPS Report Generator\n2\t\n3\tUsage:\n4\t  python run_report.py                          # interactive: shows today's sessions, prompts to pick one\n5\t  python run_report.py --date 2026-03-10        # sessions for a specific date\n6\t  python run_report.py --session-id <uuid>      # skip session picker, use known ID\n7\t  python run_report.py --list-positions         # print Catapult position strings (setup helper)\n8\t  python run_report.py --force                  # re-import session even if already in DB\n9\t\"\"\"\n10\t\n11\timport argparse\n12\timport os\n13\timport sys\n14\tfrom datetime import date, datetime\n15\t\n16\timport yaml\n17\tfrom dotenv import load_dotenv\n18\t\n19\t# ── Bootstrap ──────────────────────────────────────────────────────────────────\n20\t# Load .env before any src imports that read env vars\n21\tload_dotenv()\n22\t\n23\tfrom src.utils import setup_logging, today_in_tz, iso_day_bounds\n24\tfrom src.api_client import CatapultClient, CatapultAPIError\n25\tfrom src.storage import Storage\n26\tfrom src.baseline import compute_flags, has_sufficient_baseline\n27\tfrom src.report_builder import (\n28\t    build_team_summary,\n29\t    build_position_groups,\n30\t    build_volume_trend,\n31\t    build_top_speeds,\n32\t    build_position_group_players,\n33\t    build_email_text,\n34\t    render_report,\n35\t    save_outputs,\n36\t)\n37\t\n38\t\n39\tdef load_config(path: str = \"config.yaml\") -> dict:\n40\t    with open(path, \"r\", encoding=\"utf-8\") as f:\n41\t        return yaml.safe_load(f)\n42\t\n43\t\n44\tdef map_position_group(raw_position: str | None, position_groups: dict[str, list[str]]) -> str:\n45\t    \"\"\"Return the group label for a raw Catapult position string.\"\"\"\n46\t    if not raw_position:\n47\t        return \"Unknown\"\n48\t    pos = raw_position.strip().upper()\n49\t    for group_name, members in position_groups.items():\n50\t        if pos in [m.upper() for m in members]:\n51\t            return group_name\n52\t    return \"Unknown\"\n53\t\n54\t\n55\tdef _derive_metric(row: dict, bands: list[int]) -> float | None:\n56\t    \"\"\"Sum raw velocity band values for the given band numbers. Returns None if all zero.\"\"\"\n57\t    total = sum(float(row.get(f\"velocity_band{b}_total_distance\") or 0) for b in bands)\n58\t    return total or None\n59\t\n60\t\n61\tdef parse_athlete_activity(row: dict, session_id: str, session_date: date, derived_cfg: dict | None = None) -> dict:\n62\t    \"\"\"Normalise a Catapult POST /stats row into our storage schema.\n63\t\n64\t    Raw velocity bands (vb3–vb8) are stored as ground truth. Derived metrics\n65\t    (high_speed_distance_m, sprint_distance_m) are computed from the bands using\n66\t    the config's metrics.derived definitions, so changing band assignments only\n67\t    requires updating config.yaml and re-running backfill.\n68\t    \"\"\"\n69\t    max_vel_mph = row.get(\"max_vel\") or 0\n70\t\n71\t    # Raw band values (ground truth)\n72\t    bands = {b: float(row.get(f\"velocity_band{b}_total_distance\") or 0) for b in range(3, 9)}\n73\t\n74\t    # Derived metrics from config (default: HSD=band3, Sprint=bands4-8)\n75\t    derived = derived_cfg or {}\n76\t    hsd_bands    = derived.get(\"high_speed_distance_m\", {}).get(\"bands\", [3])\n77\t    sprint_bands = derived.get(\"sprint_distance_m\", {}).get(\"bands\", [4, 5, 6, 7, 8])\n78\t\n79\t    hsd_m    = sum(bands.get(b, 0) for b in hsd_bands) or None\n80\t    sprint_m = sum(bands.get(b, 0) for b in sprint_bands) or None\n81\t\n82\t    def _int(key: str) -> int | None:\n83\t        v = row.get(key)\n84\t        return int(v) if v is not None else None\n85\t\n86\t    def _flt(key: str) -> float | None:\n87\t        v = row.get(key)\n88\t        return float(v) if v is not None else None\n89\t\n90\t    return {\n91\t        \"session_id\":            session_id,\n92\t        \"athlete_id\":            str(row.get(\"athlete_id\") or \"\"),\n93\t        \"session_date\":          session_date,\n94\t        # Core load / distance\n95\t        \"total_player_load\":     _flt(\"average_player_load\"),\n96\t        \"total_distance_m\":      _flt(\"total_distance\"),\n97\t        \"max_velocity_ms\":       (max_vel_mph * 0.44704) if max_vel_mph else None,\n98\t        \"high_speed_distance_m\": hsd_m,\n99\t        \"sprint_distance_m\":     sprint_m,\n100\t        \"accel_density\":         _flt(\"acceleration_density\"),\n101\t        \"explosive_efforts\":     _int(\"explosive_efforts\"),\n102\t        # Raw velocity bands (ground truth)\n103\t        \"vb1_distance_m\":        None,\n104\t        \"vb2_distance_m\":        None,\n105\t        \"vb3_distance_m\":        bands[3] or None,\n106\t        \"vb4_distance_m\":        bands[4] or None,\n107\t        \"vb5_distance_m\":        bands[5] or None,\n108\t        \"vb6_distance_m\":        bands[6] or None,\n109\t        \"vb7_distance_m\":        bands[7] or None,\n110\t        \"vb8_distance_m\":        bands[8] or None,\n111\t        # Velocity band effort counts\n112\t        \"vb3_effort_count\":      _int(\"velocity_band3_total_effort_count\"),\n113\t        \"vb4_effort_count\":      _int(\"velocity_band4_total_effort_count\"),\n114\t        # Intensity / rate metrics\n115\t        \"total_duration_s\":      _flt(\"total_duration\"),\n116\t        \"total_accel_load\":      _flt(\"total_acceleration_load\"),\n117\t        \"average_velocity_ms\":   _flt(\"average_velocity\"),\n118\t        \"meterage_per_minute\":   _flt(\"meterage_per_minute\"),\n119\t        \"player_load_per_minute\":_flt(\"player_load_per_minute\"),\n120\t        \"explosive_ratio_avg\":   _flt(\"explosive_ratio_(avg)\"),\n121\t        # IMA high-intensity counts\n122\t        \"ima_high_accel\":        _int(\"ima_band3_accel_count\"),\n123\t        \"ima_high_decel\":        _int(\"ima_band3_decel_count\"),\n124\t        \"ima_high_right\":        _int(\"ima_band3_right_count\"),\n125\t        \"ima_high_left\":         _int(\"ima_band3_left_count\"),\n126\t        \"ima_high_accel_decel\":  _int(\"high_ima_accel/decel\"),\n127\t        \"total_high_ima\":        _int(\"total_high_ima\"),\n128\t        \"total_medium_ima\":      _int(\"total_medium_ima\"),\n129\t        \"total_low_ima\":         _int(\"total_low_ima_movements\"),\n130\t        \"ima_per_minute\":        _flt(\"ima/min\"),\n131\t        \"total_high_ima_per_min\":_flt(\"total_high_ima/min\"),\n132\t        \"total_high_ima_avg\":    _flt(\"total_high_ima_(avg)\"),\n133\t        # Impacts\n134\t        \"impacts_low\":           _int(\"impacts_low\"),\n135\t        \"impacts_med\":           _int(\"impacts_med\"),\n136\t        \"impacts_high\":          _int(\"impacts_high\"),\n137\t        \"impacts_low_avg\":       _flt(\"impact_low_(avg)\"),\n138\t        \"impacts_med_avg\":       _flt(\"impacts_med_(avg)\"),\n139\t        \"impacts_high_avg\":      _flt(\"impacts_high_(avg)\"),\n140\t        # Player load bands\n141\t        \"pl_low\":                _flt(\"pl_low\"),\n142\t        \"pl_med\":                _flt(\"pl_med\"),\n143\t        \"pl_high\":               _flt(\"pl_high\"),\n144\t        \"pl_veryhigh\":           _flt(\"pl_veryhigh\"),\n145\t        \"pl_high_avg\":           _flt(\"pl_med_(avg)\"),\n146\t        \"pl_veryhigh_avg\":       _flt(\"pl_veryhigh_(avg)\"),\n147\t        \"pl_veryhigh_per_min\":   _flt(\"pl_veryhigh/min\"),\n148\t        # Sport-specific\n149\t        \"total_contacts\":        _int(\"total_lineman_contact_count\"),\n150\t        \"total_throws\":          _int(\"total_qb_throw_count\"),\n151\t        \"total_fb_impacts\":      _int(\"total_football_impact_count\"),\n152\t    }\n153\t\n154\t\n155\tdef parse_athlete(row: dict, position_groups: dict[str, list[str]]) -> dict:\n156\t    \"\"\"Normalise a raw Catapult athlete dict.\"\"\"\n157\t    def _get(*keys, default=None):\n158\t        for k in keys:\n159\t            if k in row and row[k] is not None:\n160\t                return row[k]\n161\t        return default\n162\t\n163\t    raw_pos = str(_get(\"position_name\", \"position\", default=\"\") or \"\").strip()\n164\t    athlete_id = str(_get(\"id\", \"athlete_id\", default=\"\") or \"\")\n165\t    first = str(row.get(\"first_name\") or \"\").strip()\n166\t    last  = str(row.get(\"last_name\")  or \"\").strip()\n167\t    full_name = f\"{first} {last}\".strip() or _get(\"full_name\", \"name\", \"displayName\")\n168\t    raw_jersey = _get(\"jersey\", \"jersey_number\", \"jerseyNumber\", \"number\")\n169\t    try:\n170\t        jersey = int(raw_jersey) if raw_jersey is not None else None\n171\t    except (ValueError, TypeError):\n172\t        jersey = None\n173\t    return {\n174\t        \"catapult_id\":    athlete_id,\n175\t        \"name\":           full_name or None,\n176\t        \"jersey_number\":  jersey,\n177\t        \"position\":       raw_pos or None,\n178\t        \"position_group\": map_position_group(raw_pos, position_groups),\n179\t    }\n180\t\n181\t\n182\t# ── Main ───────────────────────────────────────────────────────────────────────\n183\t\n184\tdef main() -> None:\n185\t    parser = argparse.ArgumentParser(description=\"Generate a post-practice GPS report.\")\n186\t    parser.add_argument(\"--date\", help=\"Session date YYYY-MM-DD (default: today)\")\n187\t    parser.add_argument(\"--session-id\", help=\"Catapult activity UUID — skips session picker\")\n188\t    parser.add_argument(\"--list-positions\", action=\"store_true\",\n189\t                        help=\"Print all position strings from the roster and exit\")\n190\t    parser.add_argument(\"--force\", action=\"store_true\",\n191\t                        help=\"Re-import session even if already in DB\")\n192\t    parser.add_argument(\"--config\", default=\"config.yaml\", help=\"Path to config.yaml\")\n193\t    args = parser.parse_args()\n194\t\n195\t    run_ts = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n196\t    logger = setup_logging(log_dir=\"logs\", run_ts=run_ts)\n197\t    logger.info(\"=== GPS Report run started ===\")\n198\t\n199\t    # ── Load config ──────────────────────────────────────────────────\n200\t    try:\n201\t        cfg = load_config(args.config)\n202\t    except FileNotFoundError:\n203\t        print(f\"ERROR: config file not found: {args.config}\")\n204\t        sys.exit(1)\n205\t\n206\t    catapult_cfg   = cfg.get(\"catapult\", {})\n207\t    report_cfg     = cfg.get(\"report\", {})\n208\t    flagging_cfg   = cfg.get(\"flagging\", {})\n209\t    metrics_cfg    = cfg.get(\"metrics\", {})\n210\t    derived_cfg    = metrics_cfg.get(\"derived\", {})\n211\t    pos_groups     = cfg.get(\"position_groups\", {})\n212\t\n213\t    display_names = metrics_cfg.get(\"display_names\", {})\n214\t    metrics_to_flag = metrics_cfg.get(\"flagged\", [\"total_player_load\", \"total_distance_m\", \"high_speed_distance_m\"])\n215\t    timezone      = report_cfg.get(\"timezone\", \"America/Chicago\")\n216\t    output_dir    = report_cfg.get(\"output_base_dir\", \"Reports\")\n217\t    report_title  = report_cfg.get(\"title\", \"Baylor Football \\u2014 Practice GPS Report\")\n218\t    sport         = catapult_cfg.get(\"sport\", \"Football\")\n219\t    region        = catapult_cfg.get(\"region\", \"us\")\n220\t\n221\t    # ── Init Catapult client ──────────────────────────────────────────\n222\t    try:\n223\t        client = CatapultClient(region=region)\n224\t    except EnvironmentError as e:\n225\t        print(f\"\\nERROR: {e}\\n\\nMake sure .env exists with CATAPULT_TOKEN set.\")\n226\t        sys.exit(1)\n227\t\n228\t    # ── --list-positions mode ─────────────────────────────────────────\n229\t    if args.list_positions:\n230\t        print(\"\\nFetching roster to list position strings...\")\n231\t        positions = client.list_positions()\n232\t        if positions:\n233\t            print(\"\\nPosition strings from Catapult roster:\")\n234\t            for p in positions:\n235\t                print(f\"  {p}\")\n236\t            print(f\"\\nTotal unique positions: {len(positions)}\")\n237\t            print(\"Update config.yaml position_groups with these values.\\n\")\n238\t        else:\n239\t            print(\"No position strings found. Check logs/debug_first_response.json for raw data.\")\n240\t        return\n241\t\n242\t    # ── Determine target date ─────────────────────────────────────────\n243\t    if args.date:\n244\t        try:\n245\t            session_date = date.fromisoformat(args.date)\n246\t        except ValueError:\n247\t            print(f\"ERROR: Invalid date '{args.date}'. Use YYYY-MM-DD format.\")\n248\t            sys.exit(1)\n249\t    else:\n250\t        session_date = today_in_tz(timezone)\n251\t\n252\t    # ── Fetch or confirm session ──────────────────────────────────────\n253\t    if args.session_id:\n254\t        activity_id = args.session_id\n255\t        session_name = f\"Session {activity_id[:8]}\"  # placeholder; real name fetched below\n256\t        # Fetch the specific activity to get its name\n257\t        try:\n258\t            start_str, end_str = iso_day_bounds(session_date, timezone)\n259\t            activities = client.list_activities(start_str, end_str)\n260\t            match = next((a for a in activities if str(a.get(\"id\", \"\")) == activity_id), None)\n261\t            if match:\n262\t                session_name = match.get(\"name\", session_name)\n263\t        except CatapultAPIError:\n264\t            pass  # non-fatal — name is cosmetic\n265\t    else:\n266\t        start_str, end_str = iso_day_bounds(session_date, timezone)\n267\t        print(f\"\\nFetching sessions for {session_date}...\")\n268\t        try:\n269\t            activities = client.list_activities(start_str, end_str)\n270\t        except CatapultAPIError as e:\n271\t            print(f\"\\nERROR fetching activities: {e}\")\n272\t            sys.exit(1)\n273\t\n274\t        if not activities:\n275\t            print(f\"\\nNo sessions found for {session_date}.\")\n276\t            print(\"If the session is still uploading, wait a few minutes and try again.\")\n277\t            sys.exit(0)\n278\t\n279\t        if len(activities) == 1:\n280\t            chosen = activities[0]\n281\t        else:\n282\t            print(f\"\\nFound {len(activities)} session(s) on {session_date}:\")\n283\t            for i, act in enumerate(activities, 1):\n284\t                ts = act.get(\"start_time\")\n285\t                start = datetime.fromtimestamp(ts).strftime(\"%Y-%m-%d %H:%M\") if ts else \"\"\n286\t                print(f\"  [{i}] {act.get('name', 'Unnamed')}  ({start})\")\n287\t            while True:\n288\t                try:\n289\t                    choice = int(input(\"\\nEnter the number of the session to report: \"))\n290\t                    if 1 <= choice <= len(activities):\n291\t                        chosen = activities[choice - 1]\n292\t                        break\n293\t                    print(f\"Please enter a number between 1 and {len(activities)}.\")\n294\t                except ValueError:\n295\t                    print(\"Please enter a valid number.\")\n296\t\n297\t        activity_id  = str(chosen.get(\"id\", \"\"))\n298\t        session_name = chosen.get(\"name\", \"Practice\")\n299\t\n300\t    print(f\"\\nSelected session: {session_name} ({session_date})\")\n301\t\n302\t    # ── Init storage ──────────────────────────────────────────────────\n303\t    storage = Storage(db_path=\"data/gps_history.duckdb\")\n304\t\n305\t    # ── Idempotency check ─────────────────────────────────────────────\n306\t    if storage.session_exists(activity_id) and not args.force:\n307\t        print(\n308\t            f\"\\nWARNING: Session '{session_name}' ({activity_id}) is already in the database.\\n\"\n309\t            \"Use --force to re-import and regenerate the report.\"\n310\t        )\n311\t        # Offer to regenerate from existing data\n312\t        choice = input(\"Regenerate report from existing data? [y/N] \").strip().lower()\n313\t        if choice != \"y\":\n314\t            print(\"Exiting without changes.\")\n315\t            storage.close()\n316\t            return\n317\t        # Skip to report generation using stored data\n318\t        session_df = storage.get_athlete_session_df(activity_id)\n319\t        print(f\"Loaded {len(session_df)} athletes from existing data.\")\n320\t    else:\n321\t        # ── Fetch athlete stats ───────────────────────────────────────\n322\t        print(\"Fetching athlete stats from Catapult...\")\n323\t        try:\n324\t            raw_athlete_activities = client.get_athlete_stats(activity_id)\n325\t        except CatapultAPIError as e:\n326\t            print(f\"\\nERROR fetching athlete stats: {e}\")\n327\t            storage.close()\n328\t            sys.exit(1)\n329\t\n330\t        if not raw_athlete_activities:\n331\t            print(\"\\nWARNING: No athlete stats returned for this session.\")\n332\t            print(\"The session may still be processing. Try again in a few minutes.\")\n333\t            storage.close()\n334\t            sys.exit(0)\n335\t\n336\t        # ── Fetch and update roster ───────────────────────────────────\n337\t        print(\"Updating athlete roster...\")\n338\t        try:\n339\t            raw_athletes = client.list_athletes()\n340\t        except CatapultAPIError as e:\n341\t            logger.warning(\"Could not refresh roster: %s — using existing athlete data.\", e)\n342\t            raw_athletes = []\n343\t\n344\t        if raw_athletes:\n345\t            parsed_athletes = [parse_athlete(a, pos_groups) for a in raw_athletes]\n346\t            # Filter out rows with no ID\n347\t            parsed_athletes = [a for a in parsed_athletes if a[\"catapult_id\"]]\n348\t            storage.upsert_athletes(parsed_athletes)\n349\t\n350\t        # Build a quick position lookup from the freshly stored athletes\n351\t        # (use activity data as fallback for athletes not in the roster endpoint)\n352\t        position_lookup: dict[str, str] = {}\n353\t        for a in (raw_athletes or []):\n354\t            aid = str(a.get(\"id\", a.get(\"athlete_id\", \"\")) or \"\")\n355\t            raw_pos = str(a.get(\"position\", a.get(\"position_name\", \"\")) or \"\").strip()\n356\t            if aid:\n357\t                position_lookup[aid] = map_position_group(raw_pos, pos_groups)\n358\t\n359\t        # ── Store session ─────────────────────────────────────────────\n360\t        session_record = {\n361\t            \"session_id\":   activity_id,\n362\t            \"session_name\": session_name,\n363\t            \"session_date\": session_date,\n364\t            \"start_time\":   None,\n365\t            \"end_time\":     None,\n366\t        }\n367\t        # Populate start/end if we have the full activity object\n368\t        try:\n369\t            activities_local = locals().get(\"activities\") or []\n370\t            match = next((a for a in activities_local if str(a.get(\"id\", \"\")) == activity_id), None)\n371\t            if match:\n372\t                ts_start = match.get(\"start_time\")\n373\t                ts_end   = match.get(\"end_time\")\n374\t                session_record[\"start_time\"] = datetime.fromtimestamp(ts_start) if ts_start else None\n375\t                session_record[\"end_time\"]   = datetime.fromtimestamp(ts_end) if ts_end else None\n376\t        except Exception:\n377\t            pass\n378\t\n379\t        if args.force and storage.session_exists(activity_id):\n380\t            storage._con.execute(\"DELETE FROM athlete_sessions WHERE session_id = ?\", [activity_id])\n381\t            storage._con.execute(\"DELETE FROM sessions WHERE session_id = ?\", [activity_id])\n382\t\n383\t        storage.insert_session(session_record, sport)\n384\t\n385\t        # ── Parse and store athlete sessions ─────────────────────────\n386\t        parsed_rows = [\n387\t            parse_athlete_activity(row, activity_id, session_date, derived_cfg)\n388\t            for row in raw_athlete_activities\n389\t        ]\n390\t        parsed_rows = [r for r in parsed_rows if r[\"athlete_id\"]]\n391\t        storage.insert_athlete_sessions(parsed_rows)\n392\t\n393\t        # Load back from DB to get joined athlete metadata\n394\t        session_df = storage.get_athlete_session_df(activity_id)\n395\t        print(f\"Stored {len(session_df)} athlete rows.\")\n396\t\n397\t    # ── Compute baseline ──────────────────────────────────────────────\n398\t    print(\"Computing rolling baseline...\")\n399\t    window_days = int(flagging_cfg.get(\"baseline_window_days\", 28))\n400\t    baseline_df = storage.get_rolling_baseline_df(session_date, window_days)\n401\t\n402\t    min_sessions = int(flagging_cfg.get(\"min_sessions_for_baseline\", 3))\n403\t    sufficient = has_sufficient_baseline(baseline_df, min_sessions)\n404\t\n405\t    flagged_athletes: list[dict] = []\n406\t    baseline_note: str | None = None\n407\t\n408\t    if sufficient:\n409\t        flagged_athletes = compute_flags(\n410\t            current_df=session_df,\n411\t            baseline_df=baseline_df,\n412\t            flagging_cfg=flagging_cfg,\n413\t            metrics_to_flag=metrics_to_flag,\n414\t            display_names=display_names,\n415\t        )\n416\t    else:\n417\t        baseline_note = (\n418\t            f\"Baseline data is being established. Athlete flagging activates after \"\n419\t            f\"{min_sessions} sessions per athlete (rolling {window_days}-day window).\"\n420\t        )\n421\t        logger.info(\"Insufficient baseline data — flagging skipped.\")\n422\t\n423\t    # ── Build report context ──────────────────────────────────────────\n424\t    team_summary         = build_team_summary(session_df, display_names)\n425\t    position_groups_data = build_position_groups(session_df)\n426\t\n427\t    # Volume trend (last N sessions before this one)\n428\t    n_trend  = int(report_cfg.get(\"volume_trend_sessions\", 10))\n429\t    trend_df = storage.get_volume_trend_df(session_date, sport, n_trend)\n430\t    volume_trend = build_volume_trend(trend_df)\n431\t\n432\t    # Top speeds\n433\t    top_speeds = build_top_speeds(session_df, n=8)\n434\t\n435\t    # Session duration (from stored timestamps if available)\n436\t    session_duration_min = None\n437\t    try:\n438\t        s_start = session_record.get(\"start_time\")\n439\t        s_end   = session_record.get(\"end_time\")\n440\t        if s_start and s_end:\n441\t            session_duration_min = round((s_end - s_start).total_seconds() / 60, 1)\n442\t    except NameError:\n443\t        pass  # session_record not in scope (regenerate-from-DB path)\n444\t\n445\t    # Individual player tables (Offense / Defense split)\n446\t    layout_cfg   = cfg.get(\"layout\", {})\n447\t    player_groups = build_position_group_players(session_df, flagged_athletes, layout_cfg)\n448\t\n449\t    context = {\n450\t        \"report_title\":         report_title,\n451\t        \"session_name\":         session_name,\n452\t        \"session_date\":         str(session_date),\n453\t        \"generated_at\":         datetime.now().strftime(\"%Y-%m-%d %H:%M\"),\n454\t        \"sport\":                sport,\n455\t        \"athlete_count\":        len(session_df),\n456\t        \"team_summary\":         team_summary,\n457\t        \"position_groups\":      position_groups_data,\n458\t        \"flagged_athletes\":     flagged_athletes,\n459\t        \"flag_count\":           len(flagged_athletes),\n460\t        \"baseline_note\":        baseline_note,\n461\t        \"volume_trend\":         volume_trend,\n462\t        \"top_speeds\":           top_speeds,\n463\t        \"session_duration_min\": session_duration_min,\n464\t        \"player_groups\":        player_groups,\n465\t    }\n466\t\n467\t    # ── Render and save ───────────────────────────────────────────────\n468\t    print(\"Rendering report...\")\n469\t    html = render_report(context, templates_dir=\"templates\")\n470\t\n471\t    email_text = build_email_text(\n472\t        session_name=session_name,\n473\t        session_date=session_date,\n474\t        team_summary=team_summary,\n475\t        position_groups=position_groups_data,\n476\t        flagged_athletes=flagged_athletes,\n477\t        report_path=f\"{output_dir}/{session_date}/report_{session_date}.html\",\n478\t        report_title=report_title,\n479\t    )\n480\t\n481\t    html_path, txt_path = save_outputs(html, email_text, session_date, output_dir)\n482\t\n483\t    storage.close()\n484\t\n485\t    # ── Done ──────────────────────────────────────────────────────────\n486\t    print(\"\\n\" + \"=\" * 60)\n487\t    print(\"REPORT COMPLETE\")\n488\t    print(\"=\" * 60)\n489\t    print(f\"  Session : {session_name} ({session_date})\")\n490\t    print(f\"  Athletes: {len(session_df)}\")\n491\t    print(f\"  Flagged : {len(flagged_athletes)}\")\n492\t    print(f\"\\n  HTML report : {html_path}\")\n493\t    print(f\"  Email text  : {txt_path}\")\n494\t    print(\"=\" * 60)\n495\t    print(\"\\nNext steps:\")\n496\t    print(\"  1. Open the HTML report in your browser to review\")\n497\t    print(\"  2. Copy the email text from the .txt file into your email\")\n498\t    print(\"  3. Attach the HTML file and send to coaching staff\")\n499\t\n500\t\n501\tif __name__ == \"__main__\":\n502\t    main()\n503\t"}]},"uuid":"35b3ce29-f25f-4885-b944-c292fd1e8904","timestamp":"2026-09-13T20:06:05.963Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/kristinarash/DEV/DataBase_GPS_Reporting/gps_report/run_report.py","content":"\"\"\"run_report.py — Post-Practice GPS Report Generator\n\nUsage:\n  python run_report.py                          # interactive: shows today's sessions, prompts to pick one\n  python run_report.py --date 2026-03-10        # sessions for a specific date\n  python run_report.py --session-id <uuid>      # skip session picker, use known ID\n  python run_report.py --list-positions         # print Catapult position strings (setup helper)\n  python run_report.py --force                  # re-import session even if already in DB\n\"\"\"\n\nimport argparse\nimport os\nimport sys\nfrom datetime import date, datetime\n\nimport yaml\nfrom dotenv import load_dotenv\n\n# ── Bootstrap ──────────────────────────────────────────────────────────────────\n# Load .env before any src imports that read env vars\nload_dotenv()\n\nfrom src.utils import setup_logging, today_in_tz, iso_day_bounds\nfrom src.api_client import CatapultClient, CatapultAPIError\nfrom src.storage import Storage\nfrom src.baseline import compute_flags, has_sufficient_baseline\nfrom src.report_builder import (\n    build_team_summary,\n    build_position_groups,\n    build_volume_trend,\n    build_top_speeds,\n    build_position_group_players,\n    build_email_text,\n    render_report,\n    save_outputs,\n)\n\n\ndef load_config(path: str = \"config.yaml\") -> dict:\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        return yaml.safe_load(f)\n\n\ndef map_position_group(raw_position: str | None, position_groups: dict[str, list[str]]) -> str:\n    \"\"\"Return the group label for a raw Catapult position string.\"\"\"\n    if not raw_position:\n        return \"Unknown\"\n    pos = raw_position.strip().upper()\n    for group_name, members in position_groups.items():\n        if pos in [m.upper() for m in members]:\n            return group_name\n    return \"Unknown\"\n\n\ndef _derive_metric(row: dict, bands: list[int]) -> float | None:\n    \"\"\"Sum raw velocity band values for the given band numbers. Returns None if all zero.\"\"\"\n    total = sum(float(row.get(f\"velocity_band{b}_total_distance\") or 0) for b in bands)\n    return total or None\n\n\ndef parse_athlete_activity(row: dict, session_id: str, session_date: date, derived_cfg: dict | None = None) -> dict:\n    \"\"\"Normalise a Catapult POST /stats row into our storage schema.\n\n    Raw velocity bands (vb3–vb8) are stored as ground truth. Derived metrics\n    (high_speed_distance_m, sprint_distance_m) are computed from the bands using\n    the config's metrics.derived definitions, so changing band assignments only\n    requires updating config.yaml and re-running backfill.\n    \"\"\"\n    max_vel_mph = row.get(\"max_vel\") or 0\n\n    # Raw band values (ground truth)\n    bands = {b: float(row.get(f\"velocity_band{b}_total_distance\") or 0) for b in range(3, 9)}\n\n    # Derived metrics from config (default: HSD=band3, Sprint=bands4-8)\n    derived = derived_cfg or {}\n    hsd_bands    = derived.get(\"high_speed_distance_m\", {}).get(\"bands\", [3])\n    sprint_bands = derived.get(\"sprint_distance_m\", {}).get(\"bands\", [4, 5, 6, 7, 8])\n\n    hsd_m    = sum(bands.get(b, 0) for b in hsd_bands) or None\n    sprint_m = sum(bands.get(b, 0) for b in sprint_bands) or None\n\n    def _int(key: str) -> int | None:\n        v = row.get(key)\n        return int(v) if v is not None else None\n\n    def _flt(key: str) -> float | None:\n        v = row.get(key)\n        return float(v) if v is not None else None\n\n    return {\n        \"session_id\":            session_id,\n        \"athlete_id\":            str(row.get(\"athlete_id\") or \"\"),\n        \"session_date\":          session_date,\n        # Core load / distance\n        \"total_player_load\":     _flt(\"average_player_load\"),\n        \"total_distance_m\":      _flt(\"total_distance\"),\n        \"max_velocity_ms\":       (max_vel_mph * 0.44704) if max_vel_mph else None,\n        \"high_speed_distance_m\": hsd_m,\n        \"sprint_distance_m\":     sprint_m,\n        \"accel_density\":         _flt(\"acceleration_density\"),\n        \"explosive_efforts\":     _int(\"explosive_efforts\"),\n        # Raw velocity bands (ground truth)\n        \"vb1_distance_m\":        None,\n        \"vb2_distance_m\":        None,\n        \"vb3_distance_m\":        bands[3] or None,\n        \"vb4_distance_m\":        bands[4] or None,\n        \"vb5_distance_m\":        bands[5] or None,\n        \"vb6_distance_m\":        bands[6] or None,\n        \"vb7_distance_m\":        bands[7] or None,\n        \"vb8_distance_m\":        bands[8] or None,\n        # Velocity band effort counts\n        \"vb3_effort_count\":      _int(\"velocity_band3_total_effort_count\"),\n        \"vb4_effort_count\":      _int(\"velocity_band4_total_effort_count\"),\n        # Intensity / rate metrics\n        \"total_duration_s\":      _flt(\"total_duration\"),\n        \"total_accel_load\":      _flt(\"total_acceleration_load\"),\n        \"average_velocity_ms\":   _flt(\"average_velocity\"),\n        \"meterage_per_minute\":   _flt(\"meterage_per_minute\"),\n        \"player_load_per_minute\":_flt(\"player_load_per_minute\"),\n        \"explosive_ratio_avg\":   _flt(\"explosive_ratio_(avg)\"),\n        # IMA high-intensity counts\n        \"ima_high_accel\":        _int(\"ima_band3_accel_count\"),\n        \"ima_high_decel\":        _int(\"ima_band3_decel_count\"),\n        \"ima_high_right\":        _int(\"ima_band3_right_count\"),\n        \"ima_high_left\":         _int(\"ima_band3_left_count\"),\n        \"ima_high_accel_decel\":  _int(\"high_ima_accel/decel\"),\n        \"total_high_ima\":        _int(\"total_high_ima\"),\n        \"total_medium_ima\":      _int(\"total_medium_ima\"),\n        \"total_low_ima\":         _int(\"total_low_ima_movements\"),\n        \"ima_per_minute\":        _flt(\"ima/min\"),\n        \"total_high_ima_per_min\":_flt(\"total_high_ima/min\"),\n        \"total_high_ima_avg\":    _flt(\"total_high_ima_(avg)\"),\n        # Impacts\n        \"impacts_low\":           _int(\"impacts_low\"),\n        \"impacts_med\":           _int(\"impacts_med\"),\n        \"impacts_high\":          _int(\"impacts_high\"),\n        \"impacts_low_avg\":       _flt(\"impact_low_(avg)\"),\n        \"impacts_med_avg\":       _flt(\"impacts_med_(avg)\"),\n        \"impacts_high_avg\":      _flt(\"impacts_high_(avg)\"),\n        # Player load bands\n        \"pl_low\":                _flt(\"pl_low\"),\n        \"pl_med\":                _flt(\"pl_med\"),\n        \"pl_high\":               _flt(\"pl_high\"),\n        \"pl_veryhigh\":           _flt(\"pl_veryhigh\"),\n        \"pl_high_avg\":           _flt(\"pl_med_(avg)\"),\n        \"pl_veryhigh_avg\":       _flt(\"pl_veryhigh_(avg)\"),\n        \"pl_veryhigh_per_min\":   _flt(\"pl_veryhigh/min\"),\n        # Sport-specific\n        \"total_contacts\":        _int(\"total_lineman_contact_count\"),\n        \"total_throws\":          _int(\"total_qb_throw_count\"),\n        \"total_fb_impacts\":      _int(\"total_football_impact_count\"),\n    }\n\n\ndef parse_athlete(row: dict, position_groups: dict[str, list[str]]) -> dict:\n    \"\"\"Normalise a raw Catapult athlete dict.\"\"\"\n    def _get(*keys, default=None):\n        for k in keys:\n            if k in row and row[k] is not None:\n                return row[k]\n        return default\n\n    raw_pos = str(_get(\"position_name\", \"position\", default=\"\") or \"\").strip()\n    athlete_id = str(_get(\"id\", \"athlete_id\", default=\"\") or \"\")\n    first = str(row.get(\"first_name\") or \"\").strip()\n    last  = str(row.get(\"last_name\")  or \"\").strip()\n    full_name = f\"{first} {last}\".strip() or _get(\"full_name\", \"name\", \"displayName\")\n    raw_jersey = _get(\"jersey\", \"jersey_number\", \"jerseyNumber\", \"number\")\n    try:\n        jersey = int(raw_jersey) if raw_jersey is not None else None\n    except (ValueError, TypeError):\n        jersey = None\n    return {\n        \"catapult_id\":    athlete_id,\n        \"name\":           full_name or None,\n        \"jersey_number\":  jersey,\n        \"position\":       raw_pos or None,\n        \"position_group\": map_position_group(raw_pos, position_groups),\n    }\n\n\n# ── Main ───────────────────────────────────────────────────────────────────────\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Generate a post-practice GPS report.\")\n    parser.add_argument(\"--date\", help=\"Session date YYYY-MM-DD (default: today)\")\n    parser.add_argument(\"--session-id\", help=\"Catapult activity UUID — skips session picker\")\n    parser.add_argument(\"--list-positions\", action=\"store_true\",\n                        help=\"Print all position strings from the roster and exit\")\n    parser.add_argument(\"--force\", action=\"store_true\",\n                        help=\"Re-import session even if already in DB\")\n    parser.add_argument(\"--config\", default=\"config.yaml\", help=\"Path to config.yaml\")\n    args = parser.parse_args()\n\n    run_ts = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    logger = setup_logging(log_dir=\"logs\", run_ts=run_ts)\n    logger.info(\"=== GPS Report run started ===\")\n\n    # ── Load config ──────────────────────────────────────────────────\n    try:\n        cfg = load_config(args.config)\n    except FileNotFoundError:\n        print(f\"ERROR: config file not found: {args.config}\")\n        sys.exit(1)\n\n    catapult_cfg   = cfg.get(\"catapult\", {})\n    report_cfg     = cfg.get(\"report\", {})\n    flagging_cfg   = cfg.get(\"flagging\", {})\n    metrics_cfg    = cfg.get(\"metrics\", {})\n    derived_cfg    = metrics_cfg.get(\"derived\", {})\n    pos_groups     = cfg.get(\"position_groups\", {})\n\n    display_names = metrics_cfg.get(\"display_names\", {})\n    metrics_to_flag = metrics_cfg.get(\"flagged\", [\"total_player_load\", \"total_distance_m\", \"high_speed_distance_m\"])\n    timezone      = report_cfg.get(\"timezone\", \"America/Chicago\")\n    output_dir    = report_cfg.get(\"output_base_dir\", \"Reports\")\n    report_title  = report_cfg.get(\"title\", \"Baylor Football \\u2014 Practice GPS Report\")\n    sport         = catapult_cfg.get(\"sport\", \"Football\")\n    region        = catapult_cfg.get(\"region\", \"us\")\n\n    # ── Init Catapult client ──────────────────────────────────────────\n    try:\n        client = CatapultClient(region=region)\n    except EnvironmentError as e:\n        print(f\"\\nERROR: {e}\\n\\nMake sure .env exists with CATAPULT_TOKEN set.\")\n        sys.exit(1)\n\n    # ── --list-positions mode ─────────────────────────────────────────\n    if args.list_positions:\n        print(\"\\nFetching roster to list position strings...\")\n        positions = client.list_positions()\n        if positions:\n            print(\"\\nPosition strings from Catapult roster:\")\n            for p in positions:\n                print(f\"  {p}\")\n            print(f\"\\nTotal unique positions: {len(positions)}\")\n            print(\"Update config.yaml position_groups with these values.\\n\")\n        else:\n            print(\"No position strings found. Check logs/debug_first_response.json for raw data.\")\n        return\n\n    # ── Determine target date ─────────────────────────────────────────\n    if args.date:\n        try:\n            session_date = date.fromisoformat(args.date)\n        except ValueError:\n            print(f\"ERROR: Invalid date '{args.date}'. Use YYYY-MM-DD format.\")\n            sys.exit(1)\n    else:\n        session_date = today_in_tz(timezone)\n\n    # ── Fetch or confirm session ──────────────────────────────────────\n    if args.session_id:\n        activity_id = args.session_id\n        session_name = f\"Session {activity_id[:8]}\"  # placeholder; real name fetched below\n        # Fetch the specific activity to get its name\n        try:\n            start_str, end_str = iso_day_bounds(session_date, timezone)\n            activities = client.list_activities(start_str, end_str)\n            match = next((a for a in activities if str(a.get(\"id\", \"\")) == activity_id), None)\n            if match:\n                session_name = match.get(\"name\", session_name)\n        except CatapultAPIError:\n            pass  # non-fatal — name is cosmetic\n    else:\n        start_str, end_str = iso_day_bounds(session_date, timezone)\n        print(f\"\\nFetching sessions for {session_date}...\")\n        try:\n            activities = client.list_activities(start_str, end_str)\n        except CatapultAPIError as e:\n            print(f\"\\nERROR fetching activities: {e}\")\n            sys.exit(1)\n\n        if not activities:\n            print(f\"\\nNo sessions found for {session_date}.\")\n            print(\"If the session is still uploading, wait a few minutes and try again.\")\n            sys.exit(0)\n\n        if len(activities) == 1:\n            chosen = activities[0]\n        else:\n            print(f\"\\nFound {len(activities)} session(s) on {session_date}:\")\n            for i, act in enumerate(activities, 1):\n                ts = act.get(\"start_time\")\n                start = datetime.fromtimestamp(ts).strftime(\"%Y-%m-%d %H:%M\") if ts else \"\"\n                print(f\"  [{i}] {act.get('name', 'Unnamed')}  ({start})\")\n            while True:\n                try:\n                    choice = int(input(\"\\nEnter the number of the session to report: \"))\n                    if 1 <= choice <= len(activities):\n                        chosen = activities[choice - 1]\n                        break\n                    print(f\"Please enter a number between 1 and {len(activities)}.\")\n                except ValueError:\n                    print(\"Please enter a valid number.\")\n\n        activity_id  = str(chosen.get(\"id\", \"\"))\n        session_name = chosen.get(\"name\", \"Practice\")\n\n    print(f\"\\nSelected session: {session_name} ({session_date})\")\n\n    # ── Init storage ──────────────────────────────────────────────────\n    storage = Storage(db_path=\"data/gps_history.duckdb\")\n\n    # ── Idempotency check ─────────────────────────────────────────────\n    if storage.session_exists(activity_id) and not args.force:\n        print(\n            f\"\\nWARNING: Session '{session_name}' ({activity_id}) is already in the database.\\n\"\n            \"Use --force to re-import and regenerate the report.\"\n        )\n        # Offer to regenerate from existing data\n        choice = input(\"Regenerate report from existing data? [y/N] \").strip().lower()\n        if choice != \"y\":\n            print(\"Exiting without changes.\")\n            storage.close()\n            return\n        # Skip to report generation using stored data\n        session_df = storage.get_athlete_session_df(activity_id)\n        print(f\"Loaded {len(session_df)} athletes from existing data.\")\n    else:\n        # ── Fetch athlete stats ───────────────────────────────────────\n        print(\"Fetching athlete stats from Catapult...\")\n        try:\n            raw_athlete_activities = client.get_athlete_stats(activity_id)\n        except CatapultAPIError as e:\n            print(f\"\\nERROR fetching athlete stats: {e}\")\n            storage.close()\n            sys.exit(1)\n\n        if not raw_athlete_activities:\n            print(\"\\nWARNING: No athlete stats returned for this session.\")\n            print(\"The session may still be processing. Try again in a few minutes.\")\n            storage.close()\n            sys.exit(0)\n\n        # ── Fetch and update roster ───────────────────────────────────\n        print(\"Updating athlete roster...\")\n        try:\n            raw_athletes = client.list_athletes()\n        except CatapultAPIError as e:\n            logger.warning(\"Could not refresh roster: %s — using existing athlete data.\", e)\n            raw_athletes = []\n\n        if raw_athletes:\n            parsed_athletes = [parse_athlete(a, pos_groups) for a in raw_athletes]\n            # Filter out rows with no ID\n            parsed_athletes = [a for a in parsed_athletes if a[\"catapult_id\"]]\n            storage.upsert_athletes(parsed_athletes)\n\n        # Build a quick position lookup from the freshly stored athletes\n        # (use activity data as fallback for athletes not in the roster endpoint)\n        position_lookup: dict[str, str] = {}\n        for a in (raw_athletes or []):\n            aid = str(a.get(\"id\", a.get(\"athlete_id\", \"\")) or \"\")\n            raw_pos = str(a.get(\"position\", a.get(\"position_name\", \"\")) or \"\").strip()\n            if aid:\n                position_lookup[aid] = map_position_group(raw_pos, pos_groups)\n\n        # ── Store session ─────────────────────────────────────────────\n        session_record = {\n            \"session_id\":   activity_id,\n            \"session_name\": session_name,\n            \"session_date\": session_date,\n            \"start_time\":   None,\n            \"end_time\":     None,\n        }\n        # Populate start/end if we have the full activity object\n        try:\n            activities_local = locals().get(\"activities\") or []\n            match = next((a for a in activities_local if str(a.get(\"id\", \"\")) == activity_id), None)\n            if match:\n                ts_start = match.get(\"start_time\")\n                ts_end   = match.get(\"end_time\")\n                session_record[\"start_time\"] = datetime.fromtimestamp(ts_start) if ts_start else None\n                session_record[\"end_time\"]   = datetime.fromtimestamp(ts_end) if ts_end else None\n        except Exception:\n            pass\n\n        if args.force and storage.session_exists(activity_id):\n            storage._con.execute(\"DELETE FROM athlete_sessions WHERE session_id = ?\", [activity_id])\n            storage._con.execute(\"DELETE FROM sessions WHERE session_id = ?\", [activity_id])\n\n        storage.insert_session(session_record, sport)\n\n        # ── Parse and store athlete sessions ─────────────────────────\n        parsed_rows = [\n            parse_athlete_activity(row, activity_id, session_date, derived_cfg)\n            for row in raw_athlete_activities\n        ]\n        parsed_rows = [r for r in parsed_rows if r[\"athlete_id\"]]\n        storage.insert_athlete_sessions(parsed_rows)\n\n        # Load back from DB to get joined athlete metadata\n        session_df = storage.get_athlete_session_df(activity_id)\n        print(f\"Stored {len(session_df)} athlete rows.\")\n\n    # ── Compute baseline ──────────────────────────────────────────────\n    print(\"Computing rolling baseline...\")\n    window_days = int(flagging_cfg.get(\"baseline_window_days\", 28))\n    baseline_df = storage.get_rolling_baseline_df(session_date, window_days)\n\n    min_sessions = int(flagging_cfg.get(\"min_sessions_for_baseline\", 3))\n    sufficient = has_sufficient_baseline(baseline_df, min_sessions)\n\n    flagged_athletes: list[dict] = []\n    baseline_note: str | None = None\n\n    if sufficient:\n        flagged_athletes = compute_flags(\n            current_df=session_df,\n            baseline_df=baseline_df,\n            flagging_cfg=flagging_cfg,\n            metrics_to_flag=metrics_to_flag,\n            display_names=display_names,\n        )\n    else:\n        baseline_note = (\n            f\"Baseline data is being established. Athlete flagging activates after \"\n            f\"{min_sessions} sessions per athlete (rolling {window_days}-day window).\"\n        )\n        logger.info(\"Insufficient baseline data — flagging skipped.\")\n\n    # ── Build report context ──────────────────────────────────────────\n    team_summary         = build_team_summary(session_df, display_names)\n    position_groups_data = build_position_groups(session_df)\n\n    # Volume trend (last N sessions before this one)\n    n_trend  = int(report_cfg.get(\"volume_trend_sessions\", 10))\n    trend_df = storage.get_volume_trend_df(session_date, sport, n_trend)\n    volume_trend = build_volume_trend(trend_df)\n\n    # Top speeds\n    top_speeds = build_top_speeds(session_df, n=8)\n\n    # Session duration (from stored timestamps if available)\n    session_duration_min = None\n    try:\n        s_start = session_record.get(\"start_time\")\n        s_end   = session_record.get(\"end_time\")\n        if s_start and s_end:\n            session_duration_min = round((s_end - s_start).total_seconds() / 60, 1)\n    except NameError:\n        pass  # session_record not in scope (regenerate-from-DB path)\n\n    # Individual player tables (Offense / Defense split)\n    layout_cfg   = cfg.get(\"layout\", {})\n    player_groups = build_position_group_players(session_df, flagged_athletes, layout_cfg)\n\n    context = {\n        \"report_title\":         report_title,\n        \"session_name\":         session_name,\n        \"session_date\":         str(session_date),\n        \"generated_at\":         datetime.now().strftime(\"%Y-%m-%d %H:%M\"),\n        \"sport\":                sport,\n        \"athlete_count\":        len(session_df),\n        \"team_summary\":         team_summary,\n        \"position_groups\":      position_groups_data,\n        \"flagged_athletes\":     flagged_athletes,\n        \"flag_count\":           len(flagged_athletes),\n        \"baseline_note\":        baseline_note,\n        \"volume_trend\":         volume_trend,\n        \"top_speeds\":           top_speeds,\n        \"session_duration_min\": session_duration_min,\n        \"player_groups\":        player_groups,\n    }\n\n    # ── Render and save ───────────────────────────────────────────────\n    print(\"Rendering report...\")\n    html = render_report(context, templates_dir=\"templates\")\n\n    email_text = build_email_text(\n        session_name=session_name,\n        session_date=session_date,\n        team_summary=team_summary,\n        position_groups=position_groups_data,\n        flagged_athletes=flagged_athletes,\n        report_path=f\"{output_dir}/{session_date}/report_{session_date}.html\",\n        report_title=report_title,\n    )\n\n    html_path, txt_path = save_outputs(html, email_text, session_date, output_dir)\n\n    storage.close()\n\n    # ── Done ──────────────────────────────────────────────────────────\n    print(\"\\n\" + \"=\" * 60)\n    print(\"REPORT COMPLETE\")\n    print(\"=\" * 60)\n    print(f\"  Session : {session_name} ({session_date})\")\n    print(f\"  Athletes: {len(session_df)}\")\n    print(f\"  Flagged : {len(flagged_athletes)}\")\n    print(f\"\\n  HTML report : {html_path}\")\n    print(f\"  Email text  : {txt_path}\")\n    print(\"=\" * 60)\n    print(\"\\nNext steps:\")\n    print(\"  1. Open the HTML report in your browser to review\")\n    print(\"  2. Copy the email text from the .txt file into your email\")\n    print(\"  3. Attach the HTML file and send to coaching staff\")\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":503,"startLine":1,"totalLines":503}},"sourceToolAssistantUUID":"5bcbdb89-3ea9-4433-9e51-5e4ff7cb137b","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"764640dd-fa00-46b9-a4d9-f83074a06408","version":"2.1.270","gitBranch":"main"}
