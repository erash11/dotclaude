)\n    print(f\"[{label}] exit={p.returncode} elapsed={time.time()-t0:.1f}s\")\n    print(f\"[{label}] stdout tail:\", p.stdout.strip().splitlines()[-6:])\n    err = p.stderr.strip().splitlines()\n    print(f\"[{label}] stderr non-log tail:\", [l for l in err if \"  INFO  \" not in l][-3:])\n    logs = sorted(glob.glob(os.path.join(d, \"logs\", \"run_*.log\")))\n    if logs:\n        with open(logs[-1]) as f:\n            lines = f.read().splitlines()\n        print(f\"[{label}] log lines={len(lines)} first={lines[:1]} last={[l[:140] for l in lines[-3:]]}\")\n    return p\n\n\nwhich = sys.argv[1]\nif which == \"s1\":\n    # What refresh_all_data.bat passes when `wmic` is missing: %TODAY% is not a date.\n    d = rundir(\"s1\")\n    run(d, [\"--start\", \"2025-09-01\", \"--end\", \"~0,4-~4,2-~6,2\"], \"S1 bad --end (no wmic)\")\n    run(d, [\"--start\", \"2025-09-01\", \"--end\", \"-\"], \"S1b empty-ish --end\")\nelif which == \"s2\":\n    # Another process holds the DB file (Power BI/ODBC, notebook, sync client).\n    d = rundir(\"s2\")\n    db = os.path.join(d, \"data\", \"gps_history.duckdb\")\n    holder = subprocess.Popen([PY, \"-c\", f\"import duckdb,time; c=duckdb.connect({db!r}); time.sleep(25)\"])\n    time.sleep(3)\n    run(d, [\"--start\", \"2026-04-26\", \"--end\", \"2026-04-26\"], \"S2 DB locked\")\n    holder.kill()\nelif which == \"s3\":\n    # Real narrow import into the COPY: Auburn game week.\n    d = rundir(\"s3\")\n    run(d, [\"--start\", \"2026-09-04\", \"--end\", \"2026-09-05\"], \"S3 live import to copy\")\n    import duckdb\n    c = duckdb.connect(os.path.join(d, \"data\", \"gps_history.duckdb\"), read_only=True)\n    print(\"copy sessions:\", c.execute(\"select count(*), max(session_date) from sessions\").fetchall())\n    print(\"new sessions:\", c.execute(\"select session_date, session_name, (select count(*) from athlete_sessions a where a.session_id=s.session_id) from sessions s where session_date>='2026-09-01'\").fetchall())\n    print(\"null-rate of key cols on new rows:\", c.execute(\"select count(*), count(player_load_per_minute), count(total_distance_m), count(max_velocity_ms), count(total_fb_impacts) from athlete_sessions where session_date>='2026-09-01'\").fetchall())\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"c4ce9410-822f-4a0a-b6d8-690593c8dbe4","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"764640dd-fa00-46b9-a4d9-f83074a06408","version":"2.1.270","gitBranch":"main"}
