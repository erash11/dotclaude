ys: 28  # rolling window length in days\n\nmetrics:\n  # Derived metrics: computed from raw velocity bands at ingest time.\n  # Change band assignments here if Catapult redefines HSD or Sprint zones —\n  # then run backfill_velocity.py --force to recompute stored values.\n  derived:\n    high_speed_distance_m:\n      bands: [3]           # velocity_band3_total_distance (75–90% max vel)\n    sprint_distance_m:\n      bands: [4, 5, 6, 7, 8]  # bands 4–8 summed; 5–8 always 0 for Baylor\n\n  # Metrics shown as large KPI tiles in the Team Summary section\n  primary:\n    - total_player_load\n    - total_distance_m\n    - max_velocity_ms\n    - high_speed_distance_m\n\n  # Additional metrics shown in the detail table\n  secondary:\n    - accel_density\n    - explosive_efforts\n\n  # Metrics used for athlete flagging\n  flagged:\n    - total_player_load\n    - total_distance_m\n    - high_speed_distance_m\n\n  display_names:\n    total_player_load: \"Total Player Load\"\n    total_distance_m: \"Total Distance (yds)\"\n    max_velocity_ms: \"Max Velocity (mph)\"\n    high_speed_distance_m: \"High Speed Distance (yds)\"\n    sprint_distance_m: \"Sprint Distance (yds)\"\n    accel_density: \"Accel Density\"\n    explosive_efforts: \"Explosive Efforts\"\n\n# Map Catapult position strings to your position group labels.\n# Run: python run_report.py --list-positions\n# to see the exact strings Catapult uses for your roster, then update below.\nposition_groups:\n  Skill:\n    - Quarter Back\n    - QB\n    - RB\n    - WR\n    - TE\n  DBs:\n    - DB\n    - CB\n    - S\n  STAR:\n    - STAR\n  DL:\n    - DL\n    - DE\n    - DT\n  OL:\n    - OL\n    - OT\n    - OG\n  LB:\n    - LB\n    - OLB\n  Special_Teams:\n    - K\n    - PK\n    - P\n    - SP\n\n# Controls Offense/Defense split in the individual player breakdown section of the report.\n# Groups listed here appear under the labeled section header.\n# Any group not listed appears under \"Other\".\nlayout:\n  offense_groups: [Skill, OL]\n  defense_groups: [DBs, STAR, LB, DL]\n  other_groups:   [Special_Teams]\n----\n== logs/run_20260428_200005.log\n2026-04-28 20:00:05,303  INFO      gps_report  === Bulk import started ===\r\n== logs/run_20260430_135552.log\n2026-04-30 13:55:52,577  INFO      gps_report  === Bulk import started ===\r\n2026-04-30 13:55:52,621  INFO      src.storage  DuckDB connected: data/gps_history.duckdb\r\n2026-04-30 13:55:53,182  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:53,746  INFO      src.api_client  Found 1 activit(ies) for the requested window.\r\n2026-04-30 13:55:54,290  INFO      src.api_client  Found 4 activit(ies) for the requested window.\r\n2026-04-30 13:55:54,725  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:55,222  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:55,844  INFO      src.api_client  Found 3 activit(ies) for the requested window.\r\n2026-04-30 13:55:56,409  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:56,998  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:57,523  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:58,067  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:58,506  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:59,019  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:55:59,518  INFO      src.api_client  Found 0 activit(ies) for the requested window.\r\n2026-04-30 13:56:00,018  INFO      src.api_cli== logs/run_20260504_200006.log\n2026-05-04 20:00:06,378  INFO      gps_report  === Bulk import started ===\r\n== logs/run_20260801_200729.log\n2026-08-01 20:07:49,704  INFO      gps_report  === Bulk import started ===\r\n== logs/run_20260804_200009.log\n2026-08-04 20:00:09,963  INFO      gps_report  === Bulk import started ===\r\n== logs/run_20260716_073216.log\n2026-07-16 07:32:16,155  INFO      gps_report  === Bulk import started ===\r\n\ntotal 6456\ndrwx------  70 kristinarash  staff     2240 Aug  5 07:25 .\ndrwx------  20 kristinarash  staff      640 Aug  8 22:25 ..\n-rwx------   1 kristinarash  staff  1067487 Mar 16 16:11 all_parameters.json\n-rwx------   1 kristinarash  staff     2176 Sep  7 12:09 debug_first_response.json\n     603 logs/run_20260313_181140.log\n     608 logs/run_20260313_180842.log\n     608 logs/run_20260316_131102.log\n     636 logs/run_20260313_230747.log\n     710 logs/run_20260313_165739.log\n     930 logs/run_20260313_165805.log\n     930 logs/run_20260313_165832.log\n    1027 logs/run_20260313_230141.log\n    1258 logs/run_20260313_180434.log\n    1269 logs/run_20260313_165848.log\n    1269 logs/run_20260313_230317.log\n    1269 logs/run_20260313_230912.log\n    9283 logs/run_20260313_173316.log\n    9283 logs/run_20260313_173416.log\n   35419 logs/run_20260313_172113.log\n   41464 logs/run_20260428_170404.log\n   93816 logs/run_20260313_173517.log\n  454418 logs/run_20260430_135552.log\n 1332159 logs/run_backfill.log\n 1991938 total\ntotal 48152\ndrwx------   3 kristinarash  staff        96 Aug  5 07:25 .\ndrwx------  20 kristinarash  staff       640 Aug  8 22:25 ..\n-rwx------   1 kristinarash  staff  24653824 Aug  1 12:01 gps_history.duckdb\n.\n..\n.DS_Store\n.env\n.env.example\n.gitignore\nbackfill_velocity.py\nbulk_import.py\ncompute_norms.py\nconfig.yaml\ndata\ngenerate_norms_report.py\nlogs\nREADME.md\nReports\nrequirements.txt\nrun_report.py\nsrc\ntemplates\ntest_stats.py\n/Users/kristinarash/DEV/DataBase_GPS_Reporting/.claude:\nsettings.json\nsettings.local.json\nworktrees\n\n/Users/kristinarash/DEV/DataBase_GPS_Reporting/coach_report:\ncoach_config.yaml\ncoach_report.py\nplan_overrides.yaml\nsrc\ntemplates\ntests\n\n/Users/kristinarash/DEV/DataBase_GPS_Reporting