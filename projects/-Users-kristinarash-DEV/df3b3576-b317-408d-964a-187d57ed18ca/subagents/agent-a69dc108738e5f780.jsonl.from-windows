{"parentUuid":"43ca1e67-2447-49a4-93c2-5360e7927ec8","isSidechain":true,"agentId":"a69dc108738e5f780","message":{"model":"claude-opus-5","id":"msg_011Cf4SckRCnq11MR1kYVfcf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KFxJjf5hdbhShq1ufXYnVz","name":"mcp__claude_ai_Google_Calendar__list_events","input":{"calendarId":"3gso454ipti1qgbb09532u55km3ncm4g@import.calendar.google.com","startTime":"2026-09-15T00:00:00-05:00","endTime":"2026-09-29T00:00:00-05:00","timeZone":"America/Chicago","orderBy":"startTime","pageSize":250},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":4663,"cache_read_input_tokens":47416,"cache_creation":{"ephemeral_5m_input_tokens":4663,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01KFxJjf5hdbhShq1ufXYnVz":{"calendarId":"3gso454ipti1qgbb09532u55km3ncm4g@import.calendar.google.com","startTime":"2026-09-15T00:00:00-05:00","endTime":"2026-09-29T00:00:00-05:00","timeZone":"America/Chicago","orderBy":"startTime","pageSize":250}},"apiBlockIndex":2,"requestId":"req_011Cf4ScjPSc7NEFuvWiPG1p","attributionAgent":"general-purpose","type":"assistant","uuid":"907d573e-49bf-471a-a3c0-f8ffffdefcb9","timestamp":"2026-09-15T02:33:15.777Z","advisorModel":"claude-fable-5-1","effort":"high","perTurnEffort":null,"sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"df3b3576-b317-408d-964a-187d57ed18ca","version":"2.1.271","gitBranch":"main"}
{"parentUuid":"43ca1e67-2447-49a4-93c2-5360e7927ec8","isSidechain":true,"promptId":"e6c71aa2-85de-41b4-a940-039142d474f6","agentId":"a69dc108738e5f780","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016haE9t4WAwjqchcSr4ga8E","type":"tool_result","content":"\"\"\"Slate rules for the job lane: cap, charters, dated steps, checkpoints.\n\nDesign: docs/superpowers/specs/2026-09-14-prioritization-system-design.md\n\nEvery earlier prioritization fix died because it needed remembering. This\nmodule only *evaluates* the rules; KeystoneOS/scripts/ritual-check.ps1 calls\n`portfolio.py slate-check --json` on a timer and raises the desktop prompt.\nIt never writes the registry.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime as _dt\n\nPILLARS = {\"data\", \"education\", \"research\"}\nSTEP_COUNT = 4\n_RANK = {\"OK\": 0, \"DUE\": 1, \"OVERDUE\": 2}\n\n\ndef parse_date(value) -> _dt.date | None:\n    if not isinstance(value, str):\n        return None\n    try:\n        return _dt.date.fromisoformat(value)\n    except ValueError:\n        return None\n\n\ndef charter_gaps(charter, semester_close: _dt.date | None) -> list[str]:\n    \"\"\"What stops this charter from being complete. Empty list = complete.\"\"\"\n    if not isinstance(charter, dict):\n        return [\"no charter\"]\n    gaps = []\n    if charter.get(\"pillar\") not in PILLARS:\n        gaps.append(f\"pillar must be one of {sorted(PILLARS)}\")\n    for field in (\"jd_duty\", \"receiver\", \"done_means\"):\n        if not str(charter.get(field) or \"\").strip():\n            gaps.append(f\"no {field}\")\n    finish = parse_date(charter.get(\"finish_by\"))\n    if finish is None:\n        gaps.append(\"no finish_by date\")\n    elif semester_close and finish > semester_close:\n        gaps.append(f\"finish_by {finish} is after semester close {semester_close}\")\n    steps = charter.get(\"steps\")\n    if not isinstance(steps, list) or len(steps) != STEP_COUNT:\n        gaps.append(f\"needs exactly {STEP_COUNT} steps\")\n    else:\n        for s in steps:\n            if not str(s.get(\"name\") or \"\").strip() or parse_date(s.get(\"due\")) is None:\n                gaps.append(\"every step needs a name and a due date\")\n                break\n    return gaps\n\n\ndef check(data: dict, today: _dt.date) -> dict:\n    cfg = (data.get(\"meta\") or {}).get(\"slate\")\n    if not isinstance(cfg, dict):\n        return {\"status\": \"OK\", \"enabled\": False, \"active\": 0, \"cap\": None, \"problems\": []}\n\n    cap = cfg.get(\"cap\")\n    close = parse_date(cfg.get(\"semester_close\"))\n    problems: list[dict] = []\n\n    def add(level, project, message):\n        problems.append({\"level\": level, \"project\": project, \"message\": message})\n\n    active = [p for p in data.get(\"projects\", [])\n              if p.get(\"lane\") == \"job\" and p.get(\"status\") == \"active\"]\n\n    if isinstance(cap, int) and len(active) > cap:\n        add(\"OVERDUE\", \"(slate)\",\n            f\"{len(active)} active job projects, cap is {cap} - finish or park one before anything else\")\n\n    for p in active:\n        name = p.get(\"name\", \"<unnamed>\")\n        c = p.get(\"charter\")\n        gaps = charter_gaps(c, close)\n        if gaps:\n            add(\"DUE\", name, \"charter incomplete: \" + \"; \".join(gaps))\n        if not isinstance(c, dict):\n            continue\n        finish = parse_date(c.get(\"finish_by\"))\n        if finish and finish < today:\n            add(\"OVERDUE\", name, f\"past its finish date {finish} and still active - deliver, re-date with the receiver, or drop\")\n            continue\n        for s in c.get(\"steps\") or []:\n            due = parse_date(s.get(\"due\"))\n            if due and due < today and not s.get(\"done\"):\n                add(\"OVERDUE\", name,\n                    f\"step '{s.get('name')}' was due {due} - receiver: {c.get('receiver') or 'none named'}\")\n                break  # the earliest late step is the one to act on\n\n    for cp in cfg.get(\"checkpoints\") or []:\n        due = parse_date(cp.get(\"due\"))\n        if due and due < today and not cp.get(\"done\"):\n            add(\"OVERDUE\", \"(checkpoint)\", f\"{cp.get('name')} was due {due}\")\n\n    next_up = cfg.get(\"next_up\") or []\n    if isinstance(cap, int) and next_up and len(active) < cap:\n        add(\"DUE\", next_up[0],\n            f\"a slot is open ({len(active)} of {cap}) - write its charter and start it\")\n\n    status = max((p[\"level\"] for p in problems), key=_RANK.get, default=\"OK\")\n    return {\"status\": status, \"enabled\": True, \"active\": len(active), \"cap\": cap, \"problems\": problems}\n\n\ndef format_report(result: dict) -> str:\n    if not result[\"enabled\"]:\n        return \"slate: not configured (meta.slate missing)\"\n    lines = [f\"slate: {result['status']} - {result['active']} of {result['cap']} active\"]\n    for p in result[\"problems\"]:\n        lines.append(f\"  {p['level']:<8} {p['project']}: {p['message']}\")\n    return \"\\n\".join(lines)\nimport datetime as dt\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nimport portfolio\nimport slate\n\nTODAY = dt.date(2026, 10, 1)\nREPO = Path(__file__).resolve().parent.parent\n\n\ndef charter(**overrides):\n    c = {\n        \"pillar\": \"data\",\n        \"jd_duty\": \"Technology oversight\",\n        \"receiver\": \"Kenny Boyd\",\n        \"done_means\": \"Final inventory report in Kenny's hands\",\n        \"finish_by\": \"2026-11-30\",\n        \"steps\": [\n            {\"name\": \"Plan agreed\", \"due\": \"2026-09-20\", \"done\": \"2026-09-19\"},\n            {\"name\": \"First draft\", \"due\": \"2026-10-15\", \"done\": None},\n            {\"name\": \"Final delivered\", \"due\": \"2026-11-15\", \"done\": None},\n            {\"name\": \"In use\", \"due\": \"2026-11-30\", \"done\": None},\n        ],\n    }\n    c.update(overrides)\n    return c\n\n\ndef project(name, lane=\"job\", status=\"active\", rank=1, with_charter=True, **charter_overrides):\n    p = {\"name\": name, \"lane\": lane, \"rank\": rank, \"status\": status,\n         \"purpose\": \"p\", \"next_action\": \"n\"}\n    if with_charter:\n        p[\"charter\"] = charter(**charter_overrides)\n    return p\n\n\ndef registry(projects, cap=4, next_up=None, checkpoints=None):\n    return {\n        \"meta\": {\"artifact_url\": \"\", \"slate\": {\n            \"cap\": cap,\n            \"semester_close\": \"2026-12-18\",\n            \"next_up\": next_up or [],\n            \"checkpoints\": checkpoints or [],\n        }},\n        \"projects\": projects,\n        \"ideas\": [],\n    }\n\n\ndef levels(result):\n    return sorted((p[\"level\"], p[\"project\"]) for p in result[\"problems\"])\n\n\nclass TestSlateCheck(unittest.TestCase):\n    def test_healthy_slate_is_ok(self):\n        r = slate.check(registry([project(\"A\", rank=1), project(\"B\", rank=2)]), TODAY)\n        self.assertEqual(r[\"status\"], \"OK\")\n        self.assertEqual(r[\"active\"], 2)\n        self.assertEqual(r[\"problems\"], [])\n\n    def test_over_cap_is_overdue(self):\n        projects = [project(f\"P{i}\", rank=i) for i in range(1, 6)]\n        r = slate.check(registry(projects, cap=4), TODAY)\n        self.assertEqual(r[\"status\"], \"OVERDUE\")\n        self.assertIn(\"5 active\", r[\"problems\"][0][\"message\"])\n\n    def test_side_lane_and_paused_do_not_count_toward_cap(self):\n        projects = [project(f\"P{i}\", rank=i) for i in range(1, 5)]\n        projects.append(project(\"Side\", lane=\"side\", with_charter=False))\n        projects.append(project(\"Parked\", status=\"paused\", rank=9, with_charter=False))\n        r = slate.check(registry(projects, cap=4), TODAY)\n        self.assertEqual(r[\"status\"], \"OK\")\n        self.assertEqual(r[\"active\"], 4)\n\n    def test_late_step_is_overdue(self):\n\"\"\"Registry module for portfolio management.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport datetime as _dt\nimport json\nimport os\nimport shutil\nimport sys\nfrom pathlib import Path\n\nLANES = {\"job\", \"side\"}\nPROJECT_STATUSES = {\"active\", \"paused\", \"done\", \"dropped\"}\nIDEA_STATUSES = {\"inbox\", \"promoted\", \"parked\", \"dropped\"}\nSTAGES = [\"idea\", \"grilled\", \"spec\", \"planned\", \"building\", \"shipped\"]\n\n\nclass RegistryError(Exception):\n    pass\n\n\ndef _is_iso_date(value) -> bool:\n    try:\n        _dt.date.fromisoformat(value)\n        return True\n    except (TypeError, ValueError):\n        return False\n\n\ndef validate(data: dict) -> None:\n    problems: list[str] = []\n    for key in (\"meta\", \"projects\", \"ideas\"):\n        if key not in data:\n            problems.append(f\"missing top-level key: {key}\")\n    ranks_seen: dict[str, set[int]] = {}\n    for p in data.get(\"projects\", []):\n        name = p.get(\"name\") or \"<unnamed>\"\n        if not isinstance(p.get(\"name\"), str) or not p.get(\"name\"):\n            problems.append(\"project with missing/empty name\")\nTech_Inventory_Analysis ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"Technology oversight (department software inventory, ITS coordination)\", \"receiver\": \"Kenny Boyd\", \"done_means\": \"Final one-page tech inventory summary, rebuilt on final numbers, in Kenny Boyd's hands\", \"finish_by\": \"2026-10-09\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-18\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-10-02\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-10-09\", \"done\": null}]}\nNCAA_BestPractices_Doc ['name', 'lane', 'rank', 'status', 'purpose', 'stage', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"Technology oversight and data governance (NCAA SSI performance-technology best practices)\", \"receiver\": \"Chris Ruf\", \"done_means\": \"Best-practices document signed off by Chris: technology adoption plan, athlete consent, vendor data contracts, staff-transition continuity\", \"finish_by\": \"2026-12-16\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-10-14\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-11-06\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-25\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-16\", \"done\": null}]}\nHPI_Protocol ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"HPI protocol and its dashboarding (protected hands-on lane; KR 1.3)\", \"receiver\": \"Chris Ruf + Kenny Boyd\", \"done_means\": \"HPI protocol v1 (integration, flow, storage, dashboarding, interpretation) circulated to Chris and Kenny and walked through with Kenny\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-10-01\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-30\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-20\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nEducation_Curriculum ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"education\", \"jd_duty\": \"Education engine (OKR Objective 2)\", \"receiver\": \"Kenny Boyd, Chris Ruf, Carrie, Josh Young, Kevin Washington, Kristen Fant (Student Services leadership)\", \"done_means\": \"4 education pieces (slide decks or short videos), built from strength-coach interviews, published to staff and athletes\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-16\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-13\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nRTP_Constraints_Course ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"education\", \"jd_duty\": \"Staff education: return to performance (OKR Objective 2)\", \"receiver\": \"Joe Smith (assistant AT); protocols approved by Jacob (rehab) and Tim (head AT)\", \"done_means\": \"6-lesson course finished by Joe, who runs one real return-to-performance session with it, approved by Jacob\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-24\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-22\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-19\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nWomensHealth_Survey ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"research\", \"jd_duty\": \"Research & development - BAIR research support (OKR Objective 3)\", \"receiver\": \"Andrew Gallucci\", \"done_means\": \"Laurel Proulx women's health survey data set cleaned, with a data dictionary, in Andrew Gallucci's hands for analysis\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-23\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-20\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}","is_error":false}]},"uuid":"146f1659-6593-4766-9839-a6c771ac9288","timestamp":"2026-09-15T02:33:15.868Z","toolUseResult":{"stdout":"\"\"\"Slate rules for the job lane: cap, charters, dated steps, checkpoints.\n\nDesign: docs/superpowers/specs/2026-09-14-prioritization-system-design.md\n\nEvery earlier prioritization fix died because it needed remembering. This\nmodule only *evaluates* the rules; KeystoneOS/scripts/ritual-check.ps1 calls\n`portfolio.py slate-check --json` on a timer and raises the desktop prompt.\nIt never writes the registry.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime as _dt\n\nPILLARS = {\"data\", \"education\", \"research\"}\nSTEP_COUNT = 4\n_RANK = {\"OK\": 0, \"DUE\": 1, \"OVERDUE\": 2}\n\n\ndef parse_date(value) -> _dt.date | None:\n    if not isinstance(value, str):\n        return None\n    try:\n        return _dt.date.fromisoformat(value)\n    except ValueError:\n        return None\n\n\ndef charter_gaps(charter, semester_close: _dt.date | None) -> list[str]:\n    \"\"\"What stops this charter from being complete. Empty list = complete.\"\"\"\n    if not isinstance(charter, dict):\n        return [\"no charter\"]\n    gaps = []\n    if charter.get(\"pillar\") not in PILLARS:\n        gaps.append(f\"pillar must be one of {sorted(PILLARS)}\")\n    for field in (\"jd_duty\", \"receiver\", \"done_means\"):\n        if not str(charter.get(field) or \"\").strip():\n            gaps.append(f\"no {field}\")\n    finish = parse_date(charter.get(\"finish_by\"))\n    if finish is None:\n        gaps.append(\"no finish_by date\")\n    elif semester_close and finish > semester_close:\n        gaps.append(f\"finish_by {finish} is after semester close {semester_close}\")\n    steps = charter.get(\"steps\")\n    if not isinstance(steps, list) or len(steps) != STEP_COUNT:\n        gaps.append(f\"needs exactly {STEP_COUNT} steps\")\n    else:\n        for s in steps:\n            if not str(s.get(\"name\") or \"\").strip() or parse_date(s.get(\"due\")) is None:\n                gaps.append(\"every step needs a name and a due date\")\n                break\n    return gaps\n\n\ndef check(data: dict, today: _dt.date) -> dict:\n    cfg = (data.get(\"meta\") or {}).get(\"slate\")\n    if not isinstance(cfg, dict):\n        return {\"status\": \"OK\", \"enabled\": False, \"active\": 0, \"cap\": None, \"problems\": []}\n\n    cap = cfg.get(\"cap\")\n    close = parse_date(cfg.get(\"semester_close\"))\n    problems: list[dict] = []\n\n    def add(level, project, message):\n        problems.append({\"level\": level, \"project\": project, \"message\": message})\n\n    active = [p for p in data.get(\"projects\", [])\n              if p.get(\"lane\") == \"job\" and p.get(\"status\") == \"active\"]\n\n    if isinstance(cap, int) and len(active) > cap:\n        add(\"OVERDUE\", \"(slate)\",\n            f\"{len(active)} active job projects, cap is {cap} - finish or park one before anything else\")\n\n    for p in active:\n        name = p.get(\"name\", \"<unnamed>\")\n        c = p.get(\"charter\")\n        gaps = charter_gaps(c, close)\n        if gaps:\n            add(\"DUE\", name, \"charter incomplete: \" + \"; \".join(gaps))\n        if not isinstance(c, dict):\n            continue\n        finish = parse_date(c.get(\"finish_by\"))\n        if finish and finish < today:\n            add(\"OVERDUE\", name, f\"past its finish date {finish} and still active - deliver, re-date with the receiver, or drop\")\n            continue\n        for s in c.get(\"steps\") or []:\n            due = parse_date(s.get(\"due\"))\n            if due and due < today and not s.get(\"done\"):\n                add(\"OVERDUE\", name,\n                    f\"step '{s.get('name')}' was due {due} - receiver: {c.get('receiver') or 'none named'}\")\n                break  # the earliest late step is the one to act on\n\n    for cp in cfg.get(\"checkpoints\") or []:\n        due = parse_date(cp.get(\"due\"))\n        if due and due < today and not cp.get(\"done\"):\n            add(\"OVERDUE\", \"(checkpoint)\", f\"{cp.get('name')} was due {due}\")\n\n    next_up = cfg.get(\"next_up\") or []\n    if isinstance(cap, int) and next_up and len(active) < cap:\n        add(\"DUE\", next_up[0],\n            f\"a slot is open ({len(active)} of {cap}) - write its charter and start it\")\n\n    status = max((p[\"level\"] for p in problems), key=_RANK.get, default=\"OK\")\n    return {\"status\": status, \"enabled\": True, \"active\": len(active), \"cap\": cap, \"problems\": problems}\n\n\ndef format_report(result: dict) -> str:\n    if not result[\"enabled\"]:\n        return \"slate: not configured (meta.slate missing)\"\n    lines = [f\"slate: {result['status']} - {result['active']} of {result['cap']} active\"]\n    for p in result[\"problems\"]:\n        lines.append(f\"  {p['level']:<8} {p['project']}: {p['message']}\")\n    return \"\\n\".join(lines)\nimport datetime as dt\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nimport portfolio\nimport slate\n\nTODAY = dt.date(2026, 10, 1)\nREPO = Path(__file__).resolve().parent.parent\n\n\ndef charter(**overrides):\n    c = {\n        \"pillar\": \"data\",\n        \"jd_duty\": \"Technology oversight\",\n        \"receiver\": \"Kenny Boyd\",\n        \"done_means\": \"Final inventory report in Kenny's hands\",\n        \"finish_by\": \"2026-11-30\",\n        \"steps\": [\n            {\"name\": \"Plan agreed\", \"due\": \"2026-09-20\", \"done\": \"2026-09-19\"},\n            {\"name\": \"First draft\", \"due\": \"2026-10-15\", \"done\": None},\n            {\"name\": \"Final delivered\", \"due\": \"2026-11-15\", \"done\": None},\n            {\"name\": \"In use\", \"due\": \"2026-11-30\", \"done\": None},\n        ],\n    }\n    c.update(overrides)\n    return c\n\n\ndef project(name, lane=\"job\", status=\"active\", rank=1, with_charter=True, **charter_overrides):\n    p = {\"name\": name, \"lane\": lane, \"rank\": rank, \"status\": status,\n         \"purpose\": \"p\", \"next_action\": \"n\"}\n    if with_charter:\n        p[\"charter\"] = charter(**charter_overrides)\n    return p\n\n\ndef registry(projects, cap=4, next_up=None, checkpoints=None):\n    return {\n        \"meta\": {\"artifact_url\": \"\", \"slate\": {\n            \"cap\": cap,\n            \"semester_close\": \"2026-12-18\",\n            \"next_up\": next_up or [],\n            \"checkpoints\": checkpoints or [],\n        }},\n        \"projects\": projects,\n        \"ideas\": [],\n    }\n\n\ndef levels(result):\n    return sorted((p[\"level\"], p[\"project\"]) for p in result[\"problems\"])\n\n\nclass TestSlateCheck(unittest.TestCase):\n    def test_healthy_slate_is_ok(self):\n        r = slate.check(registry([project(\"A\", rank=1), project(\"B\", rank=2)]), TODAY)\n        self.assertEqual(r[\"status\"], \"OK\")\n        self.assertEqual(r[\"active\"], 2)\n        self.assertEqual(r[\"problems\"], [])\n\n    def test_over_cap_is_overdue(self):\n        projects = [project(f\"P{i}\", rank=i) for i in range(1, 6)]\n        r = slate.check(registry(projects, cap=4), TODAY)\n        self.assertEqual(r[\"status\"], \"OVERDUE\")\n        self.assertIn(\"5 active\", r[\"problems\"][0][\"message\"])\n\n    def test_side_lane_and_paused_do_not_count_toward_cap(self):\n        projects = [project(f\"P{i}\", rank=i) for i in range(1, 5)]\n        projects.append(project(\"Side\", lane=\"side\", with_charter=False))\n        projects.append(project(\"Parked\", status=\"paused\", rank=9, with_charter=False))\n        r = slate.check(registry(projects, cap=4), TODAY)\n        self.assertEqual(r[\"status\"], \"OK\")\n        self.assertEqual(r[\"active\"], 4)\n\n    def test_late_step_is_overdue(self):\n\"\"\"Registry module for portfolio management.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport datetime as _dt\nimport json\nimport os\nimport shutil\nimport sys\nfrom pathlib import Path\n\nLANES = {\"job\", \"side\"}\nPROJECT_STATUSES = {\"active\", \"paused\", \"done\", \"dropped\"}\nIDEA_STATUSES = {\"inbox\", \"promoted\", \"parked\", \"dropped\"}\nSTAGES = [\"idea\", \"grilled\", \"spec\", \"planned\", \"building\", \"shipped\"]\n\n\nclass RegistryError(Exception):\n    pass\n\n\ndef _is_iso_date(value) -> bool:\n    try:\n        _dt.date.fromisoformat(value)\n        return True\n    except (TypeError, ValueError):\n        return False\n\n\ndef validate(data: dict) -> None:\n    problems: list[str] = []\n    for key in (\"meta\", \"projects\", \"ideas\"):\n        if key not in data:\n            problems.append(f\"missing top-level key: {key}\")\n    ranks_seen: dict[str, set[int]] = {}\n    for p in data.get(\"projects\", []):\n        name = p.get(\"name\") or \"<unnamed>\"\n        if not isinstance(p.get(\"name\"), str) or not p.get(\"name\"):\n            problems.append(\"project with missing/empty name\")\nTech_Inventory_Analysis ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"Technology oversight (department software inventory, ITS coordination)\", \"receiver\": \"Kenny Boyd\", \"done_means\": \"Final one-page tech inventory summary, rebuilt on final numbers, in Kenny Boyd's hands\", \"finish_by\": \"2026-10-09\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-18\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-10-02\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-10-09\", \"done\": null}]}\nNCAA_BestPractices_Doc ['name', 'lane', 'rank', 'status', 'purpose', 'stage', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"Technology oversight and data governance (NCAA SSI performance-technology best practices)\", \"receiver\": \"Chris Ruf\", \"done_means\": \"Best-practices document signed off by Chris: technology adoption plan, athlete consent, vendor data contracts, staff-transition continuity\", \"finish_by\": \"2026-12-16\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-10-14\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-11-06\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-25\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-16\", \"done\": null}]}\nHPI_Protocol ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"data\", \"jd_duty\": \"HPI protocol and its dashboarding (protected hands-on lane; KR 1.3)\", \"receiver\": \"Chris Ruf + Kenny Boyd\", \"done_means\": \"HPI protocol v1 (integration, flow, storage, dashboarding, interpretation) circulated to Chris and Kenny and walked through with Kenny\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-10-01\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-30\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-20\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nEducation_Curriculum ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"education\", \"jd_duty\": \"Education engine (OKR Objective 2)\", \"receiver\": \"Kenny Boyd, Chris Ruf, Carrie, Josh Young, Kevin Washington, Kristen Fant (Student Services leadership)\", \"done_means\": \"4 education pieces (slide decks or short videos), built from strength-coach interviews, published to staff and athletes\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-16\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-13\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nRTP_Constraints_Course ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"education\", \"jd_duty\": \"Staff education: return to performance (OKR Objective 2)\", \"receiver\": \"Joe Smith (assistant AT); protocols approved by Jacob (rehab) and Tim (head AT)\", \"done_means\": \"6-lesson course finished by Joe, who runs one real return-to-performance session with it, approved by Jacob\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-24\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-22\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-19\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}\nWomensHealth_Survey ['name', 'lane', 'rank', 'status', 'stage', 'purpose', 'next_action', 'dev_folder'] {\"pillar\": \"research\", \"jd_duty\": \"Research & development - BAIR research support (OKR Objective 3)\", \"receiver\": \"Andrew Gallucci\", \"done_means\": \"Laurel Proulx women's health survey data set cleaned, with a data dictionary, in Andrew Gallucci's hands for analysis\", \"finish_by\": \"2026-12-11\", \"steps\": [{\"name\": \"Plan agreed with receiver\", \"due\": \"2026-09-25\", \"done\": null}, {\"name\": \"First draft to receiver\", \"due\": \"2026-10-23\", \"done\": null}, {\"name\": \"Final delivered\", \"due\": \"2026-11-20\", \"done\": null}, {\"name\": \"Receiver confirms in use\", \"due\": \"2026-12-11\", \"done\": null}]}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"43ca1e67-2447-49a4-93c2-5360e7927ec8","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"df3b3576-b317-408d-964a-187d57ed18ca","version":"2.1.271","gitBranch":"main"}
