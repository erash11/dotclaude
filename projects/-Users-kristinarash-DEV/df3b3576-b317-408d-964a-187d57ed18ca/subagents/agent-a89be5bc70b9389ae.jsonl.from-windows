ified* coach-facing dashboard\n  ... [truncated, run 'memsearch expand 87e070dc7d554830' for full content]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/kristinarash/DEV/project-triage/tests/test_slate.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":181,"lines":["+import datetime as dt","+import json","+import subprocess","+import sys","+import tempfile","+import unittest","+from pathlib import Path","+","+import portfolio","+import slate","+","+TODAY = dt.date(2026, 10, 1)","+REPO = Path(__file__).resolve().parent.parent","+","+","+def charter(**overrides):","+    c = {","+        \"pillar\": \"data\",","+        \"jd_duty\": \"Technology oversight\",","+        \"receiver\": \"Kenny Boyd\",","+        \"done_means\": \"Final inventory report in Kenny's hands\",","+        \"finish_by\": \"2026-11-30\",","+        \"steps\": [","+            {\"name\": \"Plan agreed\", \"due\": \"2026-09-20\", \"done\": \"2026-09-19\"},","+            {\"name\": \"First draft\", \"due\": \"2026-10-15\", \"done\": None},","+            {\"name\": \"Final delivered\", \"due\": \"2026-11-15\", \"done\": None},","+            {\"name\": \"In use\", \"due\": \"2026-11-30\", \"done\": None},","+        ],","+    }","+    c.update(overrides)","+    return c","+","+","+def project(name, lane=\"job\", status=\"active\", rank=1, with_charter=True, **charter_overrides):","+    p = {\"name\": name, \"lane\": lane, \"rank\": rank, \"status\": status,","+         \"purpose\": \"p\", \"next_action\": \"n\"}","+    if with_charter:","+        p[\"charter\"] = charter(**charter_overrides)","+    return p","+","+","+def registry(projects, cap=4, next_up=None, checkpoints=None):","+    return {","+        \"meta\": {\"artifact_url\": \"\", \"slate\": {","+            \"cap\": cap,","+            \"semester_close\": \"2026-12-18\",","+            \"next_up\": next_up or [],","+            \"checkpoints\": checkpoints or [],","+        }},","+        \"projects\": projects,","+        \"ideas\": [],","+    }","+","+","+def levels(result):","+    return sorted((p[\"level\"], p[\"project\"]) for p in result[\"problems\"])","+","+","+class TestSlateCheck(unittest.TestCase):","+    def test_healthy_slate_is_ok(self):","+        r = slate.check(registry([project(\"A\", rank=1), project(\"B\", rank=2)]), TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+        self.assertEqual(r[\"active\"], 2)","+        self.assertEqual(r[\"problems\"], [])","+","+    def test_over_cap_is_overdue(self):","+        projects = [project(f\"P{i}\", rank=i) for i in range(1, 6)]","+        r = slate.check(registry(projects, cap=4), TODAY)","+        self.assertEqual(r[\"status\"], \"OVERDUE\")","+        self.assertIn(\"5 active\", r[\"problems\"][0][\"message\"])","+","+    def test_side_lane_and_paused_do_not_count_toward_cap(self):","+        projects = [project(f\"P{i}\", rank=i) for i in range(1, 5)]","+        projects.append(project(\"Side\", lane=\"side\", with_charter=False))","+        projects.append(project(\"Parked\", status=\"paused\", rank=9, with_charter=False))","+        r = slate.check(registry(projects, cap=4), TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+        self.assertEqual(r[\"active\"], 4)","+","+    def test_late_step_is_overdue(self):","+        steps = charter()[\"steps\"]","+        steps[1][\"due\"] = \"2026-09-30\"  # passed, not done","+        r = slate.check(registry([project(\"A\", steps=steps)]), TODAY)","+        self.assertEqual(r[\"status\"], \"OVERDUE\")","+        self.assertIn(\"First draft\", r[\"problems\"][0][\"message\"])","+","+    def test_step_due_today_is_not_late(self):","+        steps = charter()[\"steps\"]","+        steps[1][\"due\"] = TODAY.isoformat()","+        r = slate.check(registry([project(\"A\", steps=steps)]), TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+","+    def test_past_finish_by_is_overdue(self):","+        steps = [dict(s, done=\"2026-09-01\") for s in charter()[\"steps\"]]","+        r = slate.check(registry([project(\"A\", finish_by=\"2026-09-15\", steps=steps)]), TODAY)","+        self.assertEqual(levels(r), [(\"OVERDUE\", \"A\")])","+        self.assertIn(\"finish\", r[\"problems\"][0][\"message\"])","+","+    def test_missing_receiver_is_due(self):","+        r = slate.check(registry([project(\"A\", receiver=\"\")]), TODAY)","+        self.assertEqual(r[\"status\"], \"DUE\")","+        self.assertIn(\"receiver\", r[\"problems\"][0][\"message\"])","+","+    def test_no_charter_is_due(self):","+        r = slate.check(registry([project(\"A\", with_charter=False)]), TODAY)","+        self.assertEqual(levels(r), [(\"DUE\", \"A\")])","+","+    def test_wrong_step_count_is_due(self):","+        r = slate.check(registry([project(\"A\", steps=charter()[\"steps\"][:3])]), TODAY)","+        self.assertEqual(r[\"status\"], \"DUE\")","+        self.assertIn(\"4 steps\", r[\"problems\"][0][\"message\"])","+","+    def test_bad_pillar_is_due(self):","+        r = slate.check(registry([project(\"A\", pillar=\"fun\")]), TODAY)","+        self.assertEqual(r[\"status\"], \"DUE\")","+","+    def test_finish_after_semester_close_is_due(self):","+        r = slate.check(registry([project(\"A\", finish_by=\"2027-01-10\")]), TODAY)","+        self.assertEqual(r[\"status\"], \"DUE\")","+        self.assertIn(\"semester close\", r[\"problems\"][0][\"message\"])","+","+    def test_missed_checkpoint_is_overdue(self):","+        cps = [{\"name\": \"Mid-semester OKR checkpoint\", \"due\": \"2026-09-30\", \"done\": None}]","+        r = slate.check(registry([project(\"A\")], checkpoints=cps), TODAY)","+        self.assertEqual(levels(r), [(\"OVERDUE\", \"(checkpoint)\")])","+","+    def test_done_checkpoint_is_quiet(self):","+        cps = [{\"name\": \"Mid-semester OKR checkpoint\", \"due\": \"2026-09-30\", \"done\": \"2026-09-30\"}]","+        r = slate.check(registry([project(\"A\")], checkpoints=cps), TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+","+    def test_open_slot_with_next_up_is_due(self):","+        r = slate.check(registry([project(\"A\")], cap=4, next_up=[\"NCAA\"]), TODAY)","+        self.assertEqual(levels(r), [(\"DUE\", \"NCAA\")])","+","+    def test_full_slate_with_next_up_is_quiet(self):","+        projects = [project(f\"P{i}\", rank=i) for i in range(1, 5)]","+        r = slate.check(registry(projects, cap=4, next_up=[\"NCAA\"]), TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+","+    def test_worst_level_wins(self):","+        steps = charter()[\"steps\"]","+        steps[1][\"due\"] = \"2026-09-30\"","+        r = slate.check(registry([project(\"A\", steps=steps), project(\"B\", rank=2, receiver=\"\")]), TODAY)","+        self.assertEqual(r[\"status\"], \"OVERDUE\")","+        self.assertEqual(len(r[\"problems\"]), 2)","+","+    def test_no_slate_meta_is_ok_and_does_not_crash(self):","+        data = {\"meta\": {}, \"projects\": [project(\"A\", with_charter=False)], \"ideas\": []}","+        r = slate.check(data, TODAY)","+        self.assertEqual(r[\"status\"], \"OK\")","+        self.assertFalse(r[\"enabled\"])","+","+","+class TestSlateCli(unittest.TestCase):","+    def test_cli_json_against_a_scratch_registry(self):","+        with tempfile.TemporaryDirectory() as tmp:","+            path = Path(tmp) / \"portfolio.json\"","+            path.write_text(json.dumps(registry([project(\"A\", receiver=\"\")])), encoding=\"utf-8\")","+            out = subprocess.run(","+                [sys.executable, str(REPO / \"portfolio.py\"), \"slate-check\", \"--json\",","+                 \"--today\", TODAY.isoformat(), \"--registry\", str(path)],","+                capture_output=True, text=True, check=True)","+            result = json.loads(out.stdout)","+            self.assertEqual(result[\"status\"], \"DUE\")","+            # slate-check must never write the registry.","+            self.assertFalse(path.with_suffix(\".json.bak\").exists())","+","+","+class TestValidateCharter(unittest.TestCase):","+    def test_bad_charter_date_rejected(self):","+        data = registry([project(\"A\", finish_by=\"soon\")])","+        with self.assertRaises(portfolio.RegistryError):","+            portfolio.validate(data)","+","+    def test_charter_is_optional(self):","+        portfolio.validate(registry([project(\"A\", with_charter=False)]))","+","+","+if __name__ == \"__main__\":","+    unittest.main()"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/kristinarash/DEV/project-triage/tests/test_slate.py"],"shared":true}},"sourceToolAssistantUUID":"32169563-ba75-45b9-b90b-2eca9f1fbd6d","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/project-triage","sessionId":"df3b3576-b317-408d-964a-187d57ed18ca","version":"2.1.271","gitBranch":"main"}
