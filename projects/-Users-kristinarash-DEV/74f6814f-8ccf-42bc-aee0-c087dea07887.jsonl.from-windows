file can never corrupt a DB.\n\nLayout under the snapshot root:\n\n    manifest.json\n    pff_grades/season=2026.parquet\n    pff_stats/season=2026.parquet\n    teams.parquet                     # dimension tables, no season\n\nSeason-partitioned tables are per season so one season can be exchanged without moving\nsix million rows.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport platform\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\n# Tables carrying a season column are written one file per season; the rest whole.\nSEASON_TABLES = (\"games\", \"player_seasons\", \"pff_grades\", \"pff_stats\", \"pff_premium\")\nWHOLE_TABLES = (\"teams\", \"players\")\n# `ingest_log` is deliberately excluded: it records what THIS machine fetched and when,\n# so copying it would make the other machine's history a lie.\n\nMANIFEST = \"manifest.json\"\n\n\ndef default_root() -> Path:\n    \"\"\"$PFF_SNAPSHOT_DIR, else the Google Drive primary storage drive for this platform.\"\"\"\n    configured = os.environ.get(\"PFF_SNAPSHOT_DIR\")\n    if configured:\n        return Path(configured)\n    home = Path(os.path.expanduser(\"~\"))\n    if platform.system() == \"Windows\":\n        return Path(r\"G:\\My Drive\\00_Primary_Storage_Drive\\pff-snapshots\")\n    return (home / \"Library\" / \"CloudStorage\" / \"GoogleDrive-eric.rash11@gmail.com\"\n            / \"My Drive\" / \"00_Primary_Storage_Drive\" / \"pff-snapshots\")\n\n\ndef table_file(root: Path, table: str, season: int | None) -> Path:\n    return root / table / f\"season={season}.parquet\" if season is not None else root / f\"{table}.parquet\"\n\n\ndef read_manifest(root: Path) -> dict:\n    try:\n        return json.loads((root / MANIFEST).read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return {}\n\n\ndef write_manifest(root: Path, files: list[dict], seasons: list[int]) -> dict:\n    \"\"\"Merge this export's files into any existing manifest, keyed by path.\n\n    Exporting one season must not erase the record of the others already there.\n    \"\"\"\n    existing = read_manifest(root)\n    by_path = {f[\"path\"]: f for f in existing.get(\"files\", [])}\n    for f in files:\n        by_path[f[\"path\"]] = f\n    manifest = {\n        \"exported_at\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\"),\n        \"exported_by\": platform.node(),\n        \"seasons_in_this_export\": sorted(seasons),\n        \"files\": sorted(by_path.values(), key=lambda f: f[\"path\"]),\n    }\n    (root / MANIFEST).write_text(json.dumps(manifest, indent=2), encoding=\"utf-8\")\n    return manifest\n\n\ndef describe(manifest: dict) -> str:\n    if not manifest:\n        return \"no manifest at that root\"\n    rows = sum(f.get(\"rows\", 0) for f in manifest.get(\"files\", []))\n    size = sum(f.get(\"bytes\", 0) for f in manifest.get(\"files\", []))\n    return (f\"{len(manifest.get('files', []))} files, {rows:,} rows, {size / 1e6:.0f} MB; \"\n            f\"written by {manifest.get('exported_by')} at {manifest.get('exported_at')}\")\n__init__.py\n__pycache__\nfixtures\ntest_db.py\ntest_pff_client.py\ntest_pipeline.py\ntest_season_plays.py\ntest_snapshot.py\ntest_transform.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"ef66602c-c6ca-4f75-8430-5cefd085970a","session_id":"74f6814f-8ccf-42bc-aee0-c087dea07887","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Football/PFF_Data_Project","sessionId":"74f6814f-8ccf-42bc-aee0-c087dea07887","version":"2.1.280","gitBranch":"main"}
