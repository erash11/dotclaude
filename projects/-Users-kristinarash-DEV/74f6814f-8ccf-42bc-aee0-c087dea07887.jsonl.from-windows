{"parentUuid":"e528b48f-9e9e-4a9d-9802-b0f2aea0f040","isSidechain":false,"promptId":"fddbbb96-9f74-4dc8-bbbe-b3bcc5cb7f45","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CbYkeGbqrwkPpSSWmYDKhd","type":"tool_result","content":"40:CREATE TABLE IF NOT EXISTS teams (\n41:    team_id              VARCHAR PRIMARY KEY,   -- PFF team id (Baylor = 118)\n57:CREATE TABLE IF NOT EXISTS players (\n58:    pff_player_id   VARCHAR PRIMARY KEY,\n69:CREATE TABLE IF NOT EXISTS player_seasons (\n81:    PRIMARY KEY (pff_player_id, season)\n84:CREATE TABLE IF NOT EXISTS games (\n85:    game_id            VARCHAR PRIMARY KEY,\n105:CREATE TABLE IF NOT EXISTS pff_grades (\n118:    PRIMARY KEY (game_id, pff_player_id, grade_type)\n124:CREATE TABLE IF NOT EXISTS pff_stats (\n134:    PRIMARY KEY (game_id, pff_player_id, stat_category, stat_name)\n140:CREATE TABLE IF NOT EXISTS pff_premium (\n151:    PRIMARY KEY (game_id, category, row_seq)\n156:CREATE TABLE IF NOT EXISTS ingest_log (\n157:    run_id          VARCHAR PRIMARY KEY,\n---\n\"\"\"Tests for the Parquet snapshot exchange — layout, manifest merging, and a round trip.\n\nThe round trip is the one that matters: export a season, load it into a different DB,\nand prove the row counts match and the seasons the snapshot does not carry survive.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport uuid\nfrom pathlib import Path\n\nimport duckdb\nimport pytest\n\nfrom src import db, snapshot\n\nROOT = Path(__file__).resolve().parent.parent\n\n\ndef _run(cmd: list[str], env: dict) -> subprocess.CompletedProcess:\n    \"\"\"stdin=DEVNULL: under pytest's capture, Windows cannot duplicate the inherited stdin handle.\"\"\"\n    return subprocess.run(cmd, cwd=ROOT, text=True, env=env, stdin=subprocess.DEVNULL,\n                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n\n\ndef test_table_file_layout(tmp_path):\n    assert snapshot.table_file(tmp_path, \"pff_grades\", 2026) == tmp_path / \"pff_grades\" / \"season=2026.parquet\"\n    assert snapshot.table_file(tmp_path, \"teams\", None) == tmp_path / \"teams.parquet\"\n\n\ndef test_ingest_log_is_never_exported():\n    \"\"\"It records what this machine fetched; copying it would make the other machine lie.\"\"\"\n    assert \"ingest_log\" not in snapshot.SEASON_TABLES + snapshot.WHOLE_TABLES\n\n\ndef test_write_manifest_keeps_earlier_seasons(tmp_path):\n    snapshot.write_manifest(tmp_path, [{\"path\": \"pff_grades/season=2025.parquet\", \"table\": \"pff_grades\",\n                                        \"season\": 2025, \"rows\": 10, \"bytes\": 1}], [2025])\n    merged = snapshot.write_manifest(tmp_path, [{\"path\": \"pff_grades/season=2026.parquet\", \"table\": \"pff_grades\",\n                                                 \"season\": 2026, \"rows\": 20, \"bytes\": 2}], [2026])\n    paths = [f[\"path\"] for f in merged[\"files\"]]\n    assert paths == [\"pff_grades/season=2025.parquet\", \"pff_grades/season=2026.parquet\"]\n    assert merged[\"seasons_in_this_export\"] == [2026]\n\n\ndef test_default_root_honours_env(monkeypatch, tmp_path):\n    monkeypatch.setenv(\"PFF_SNAPSHOT_DIR\", str(tmp_path))\n    assert snapshot.default_root() == tmp_path\n\n\ndef _seed(path: Path, season: int, rows: int) -> None:\n    \"\"\"Game ids are unique per season, as they are in the real feed.\"\"\"\n    conn = db.connect(path)\n    conn.execute(\"insert into teams (team_id, nickname) values ('118', 'Baylor')\")\n    conn.execute(f\"\"\"insert into games (game_id, season, week, home_franchise_id, away_franchise_id)\n                     select '{season}-g' || i, {season}, 1, '118', '270' from range({rows}) t(i)\"\"\")\n    conn.close()\n\n\ndef test_round_trip_preserves_counts_and_other_seasons(tmp_path):\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 5)\n    _seed(target, 2025, 3)  # the target machine already holds a season the snapshot lacks\n\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    run = lambda script, dbp, *a: _run([sys.executable, f\"scripts/{script}\", *a], dict(env, PFF_DB=str(dbp)))\n\n    exported = run(\"export_snapshot.py\", source, \"--season\", \"2026\")\n    assert exported.returncode == 0, exported.stderr\n    assert json.loads((snap / snapshot.MANIFEST).read_text())[\"files\"]\n\n    loaded = run(\"load_snapshot.py\", target, \"--no-backup\")\n    assert loaded.returncode == 0, loaded.stderr\n\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select count(*) from games where season = 2026\").fetchone()[0] == 5\n        assert conn.execute(\"select count(*) from games where season = 2025\").fetchone()[0] == 3\n    finally:\n        conn.close()\n\n\ndef test_loading_twice_does_not_duplicate(tmp_path):\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 4)\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    assert _run([sys.executable, \"scripts/export_snapshot.py\"], dict(env, PFF_DB=str(source))).returncode == 0\n    for _ in range(2):\n        assert _run([sys.executable, \"scripts/load_snapshot.py\", \"--no-backup\"],\n                    dict(env, PFF_DB=str(target))).returncode == 0\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select count(*) from games\").fetchone()[0] == 4\n    finally:\n        conn.close()\n\n\ndef test_a_row_that_changed_season_upstream_is_replaced_not_fatal(tmp_path):\n    \"\"\"Same game_id, different season locally: the load must take the snapshot's version.\n\n    Plain INSERT aborts the whole file on that one row, which is how this was found.\n    \"\"\"\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 2)\n    conn = db.connect(target)\n    conn.execute(\"\"\"insert into games (game_id, season, week, home_franchise_id, away_franchise_id)\n                    values ('2026-g0', 2025, 9, '118', '270')\"\"\")  # same id, wrong season\n    conn.close()\n\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    assert _run([sys.executable, \"scripts/export_snapshot.py\"], dict(env, PFF_DB=str(source))).returncode == 0\n    result = _run([sys.executable, \"scripts/load_snapshot.py\", \"--no-backup\"], dict(env, PFF_DB=str(target)))\n    assert result.returncode == 0, result.stderr\n\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select season from games where game_id = '2026-g0'\").fetchone()[0] == 2026\n        assert conn.execute(\"select count(*) from games\").fetchone()[0] == 2\n    finally:\n        conn.close()\n\n\ndef test_load_refuses_when_manifest_missing(tmp_path):\n    result = _run([sys.executable, \"scripts/load_snapshot.py\"],\n                  dict(os.environ, PFF_SNAPSHOT_DIR=str(tmp_path / \"nothing\"),\n                       PFF_DB=str(tmp_path / \"x.db\")))\n    assert result.returncode == 2\n    assert \"no manifest\" in result.stderr.lower()\nbe8a8ef Closeout 2026-09-22 (Mac): snapshot load verified; load bug erased Mac-only premium rows, restored\n9d46de6 Closeout 2026-09-22: STATUS current state, handoff for the DB move and snapshots (#3)\ne494290 snapshots: exchange seasons between machines as Parquet on Drive (#2)","is_error":false}]},"uuid":"677707a1-19ad-4145-bd9c-6e86125433c7","timestamp":"2026-09-22T23:27:56.811Z","toolUseResult":{"stdout":"40:CREATE TABLE IF NOT EXISTS teams (\n41:    team_id              VARCHAR PRIMARY KEY,   -- PFF team id (Baylor = 118)\n57:CREATE TABLE IF NOT EXISTS players (\n58:    pff_player_id   VARCHAR PRIMARY KEY,\n69:CREATE TABLE IF NOT EXISTS player_seasons (\n81:    PRIMARY KEY (pff_player_id, season)\n84:CREATE TABLE IF NOT EXISTS games (\n85:    game_id            VARCHAR PRIMARY KEY,\n105:CREATE TABLE IF NOT EXISTS pff_grades (\n118:    PRIMARY KEY (game_id, pff_player_id, grade_type)\n124:CREATE TABLE IF NOT EXISTS pff_stats (\n134:    PRIMARY KEY (game_id, pff_player_id, stat_category, stat_name)\n140:CREATE TABLE IF NOT EXISTS pff_premium (\n151:    PRIMARY KEY (game_id, category, row_seq)\n156:CREATE TABLE IF NOT EXISTS ingest_log (\n157:    run_id          VARCHAR PRIMARY KEY,\n---\n\"\"\"Tests for the Parquet snapshot exchange — layout, manifest merging, and a round trip.\n\nThe round trip is the one that matters: export a season, load it into a different DB,\nand prove the row counts match and the seasons the snapshot does not carry survive.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport uuid\nfrom pathlib import Path\n\nimport duckdb\nimport pytest\n\nfrom src import db, snapshot\n\nROOT = Path(__file__).resolve().parent.parent\n\n\ndef _run(cmd: list[str], env: dict) -> subprocess.CompletedProcess:\n    \"\"\"stdin=DEVNULL: under pytest's capture, Windows cannot duplicate the inherited stdin handle.\"\"\"\n    return subprocess.run(cmd, cwd=ROOT, text=True, env=env, stdin=subprocess.DEVNULL,\n                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n\n\ndef test_table_file_layout(tmp_path):\n    assert snapshot.table_file(tmp_path, \"pff_grades\", 2026) == tmp_path / \"pff_grades\" / \"season=2026.parquet\"\n    assert snapshot.table_file(tmp_path, \"teams\", None) == tmp_path / \"teams.parquet\"\n\n\ndef test_ingest_log_is_never_exported():\n    \"\"\"It records what this machine fetched; copying it would make the other machine lie.\"\"\"\n    assert \"ingest_log\" not in snapshot.SEASON_TABLES + snapshot.WHOLE_TABLES\n\n\ndef test_write_manifest_keeps_earlier_seasons(tmp_path):\n    snapshot.write_manifest(tmp_path, [{\"path\": \"pff_grades/season=2025.parquet\", \"table\": \"pff_grades\",\n                                        \"season\": 2025, \"rows\": 10, \"bytes\": 1}], [2025])\n    merged = snapshot.write_manifest(tmp_path, [{\"path\": \"pff_grades/season=2026.parquet\", \"table\": \"pff_grades\",\n                                                 \"season\": 2026, \"rows\": 20, \"bytes\": 2}], [2026])\n    paths = [f[\"path\"] for f in merged[\"files\"]]\n    assert paths == [\"pff_grades/season=2025.parquet\", \"pff_grades/season=2026.parquet\"]\n    assert merged[\"seasons_in_this_export\"] == [2026]\n\n\ndef test_default_root_honours_env(monkeypatch, tmp_path):\n    monkeypatch.setenv(\"PFF_SNAPSHOT_DIR\", str(tmp_path))\n    assert snapshot.default_root() == tmp_path\n\n\ndef _seed(path: Path, season: int, rows: int) -> None:\n    \"\"\"Game ids are unique per season, as they are in the real feed.\"\"\"\n    conn = db.connect(path)\n    conn.execute(\"insert into teams (team_id, nickname) values ('118', 'Baylor')\")\n    conn.execute(f\"\"\"insert into games (game_id, season, week, home_franchise_id, away_franchise_id)\n                     select '{season}-g' || i, {season}, 1, '118', '270' from range({rows}) t(i)\"\"\")\n    conn.close()\n\n\ndef test_round_trip_preserves_counts_and_other_seasons(tmp_path):\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 5)\n    _seed(target, 2025, 3)  # the target machine already holds a season the snapshot lacks\n\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    run = lambda script, dbp, *a: _run([sys.executable, f\"scripts/{script}\", *a], dict(env, PFF_DB=str(dbp)))\n\n    exported = run(\"export_snapshot.py\", source, \"--season\", \"2026\")\n    assert exported.returncode == 0, exported.stderr\n    assert json.loads((snap / snapshot.MANIFEST).read_text())[\"files\"]\n\n    loaded = run(\"load_snapshot.py\", target, \"--no-backup\")\n    assert loaded.returncode == 0, loaded.stderr\n\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select count(*) from games where season = 2026\").fetchone()[0] == 5\n        assert conn.execute(\"select count(*) from games where season = 2025\").fetchone()[0] == 3\n    finally:\n        conn.close()\n\n\ndef test_loading_twice_does_not_duplicate(tmp_path):\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 4)\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    assert _run([sys.executable, \"scripts/export_snapshot.py\"], dict(env, PFF_DB=str(source))).returncode == 0\n    for _ in range(2):\n        assert _run([sys.executable, \"scripts/load_snapshot.py\", \"--no-backup\"],\n                    dict(env, PFF_DB=str(target))).returncode == 0\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select count(*) from games\").fetchone()[0] == 4\n    finally:\n        conn.close()\n\n\ndef test_a_row_that_changed_season_upstream_is_replaced_not_fatal(tmp_path):\n    \"\"\"Same game_id, different season locally: the load must take the snapshot's version.\n\n    Plain INSERT aborts the whole file on that one row, which is how this was found.\n    \"\"\"\n    source, target, snap = tmp_path / \"a.db\", tmp_path / \"b.db\", tmp_path / \"snap\"\n    _seed(source, 2026, 2)\n    conn = db.connect(target)\n    conn.execute(\"\"\"insert into games (game_id, season, week, home_franchise_id, away_franchise_id)\n                    values ('2026-g0', 2025, 9, '118', '270')\"\"\")  # same id, wrong season\n    conn.close()\n\n    env = dict(os.environ, PFF_SNAPSHOT_DIR=str(snap))\n    assert _run([sys.executable, \"scripts/export_snapshot.py\"], dict(env, PFF_DB=str(source))).returncode == 0\n    result = _run([sys.executable, \"scripts/load_snapshot.py\", \"--no-backup\"], dict(env, PFF_DB=str(target)))\n    assert result.returncode == 0, result.stderr\n\n    conn = duckdb.connect(str(target), read_only=True)\n    try:\n        assert conn.execute(\"select season from games where game_id = '2026-g0'\").fetchone()[0] == 2026\n        assert conn.execute(\"select count(*) from games\").fetchone()[0] == 2\n    finally:\n        conn.close()\n\n\ndef test_load_refuses_when_manifest_missing(tmp_path):\n    result = _run([sys.executable, \"scripts/load_snapshot.py\"],\n                  dict(os.environ, PFF_SNAPSHOT_DIR=str(tmp_path / \"nothing\"),\n                       PFF_DB=str(tmp_path / \"x.db\")))\n    assert result.returncode == 2\n    assert \"no manifest\" in result.stderr.lower()\nbe8a8ef Closeout 2026-09-22 (Mac): snapshot load verified; load bug erased Mac-only premium rows, restored\n9d46de6 Closeout 2026-09-22: STATUS current state, handoff for the DB move and snapshots (#3)\ne494290 snapshots: exchange seasons between machines as Parquet on Drive (#2)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"e528b48f-9e9e-4a9d-9802-b0f2aea0f040","session_id":"74f6814f-8ccf-42bc-aee0-c087dea07887","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/Football/PFF_Data_Project","sessionId":"74f6814f-8ccf-42bc-aee0-c087dea07887","version":"2.1.280","gitBranch":"main"}
