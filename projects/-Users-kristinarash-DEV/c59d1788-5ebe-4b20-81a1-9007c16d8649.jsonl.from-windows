d too: they would describe a publish that cannot safely happen.","+# (Manifest lines cannot redirect writes: valid_entry below admits only plain","+# basenames, and publish targets come from canonical names, not the manifest.)","+resolve_root() {","+  if [ -L \"$1\" ] && [ ! -e \"$1\" ]; then","+    return 1                                  # dangling link cannot be a root","+  fi","+  if [ -d \"$1\" ]; then","+    (cd -P -- \"$1\" 2>/dev/null && pwd -P)","+    return","+  fi","+  if [ -e \"$1\" ]; then","+    return 1                                  # exists, but not a directory","+  fi","+  [ \"$1\" != \"/\" ] || return 1","+  local parent                                # not created yet: resolve upward","+  parent=\"$(resolve_root \"$(dirname -- \"$1\")\")\" || return 1","+  printf '%s/%s\\n' \"${parent%/}\" \"$(basename -- \"$1\")\"","+}","+roots_overlap() {","+  # Case-folded: APFS and NTFS are case-insensitive by default, so /a/Skills","+  # and /a/skills are one tree. Folding can only cause a refusal, never a delete.","+  local a b","+  a=\"$(printf '%s/' \"$1\" | tr '[:upper:]' '[:lower:]')\"","+  b=\"$(printf '%s/' \"$2\" | tr '[:upper:]' '[:lower:]')\"","+  case \"$a\" in \"$b\"*) return 0 ;; esac","+  case \"$b\" in \"$a\"*) return 0 ;; esac","+  return 1","+}","+for root in \"$SRC\" \"$HOME/.agents/skills\" \"$HOME/.codex/skills\"; do","+  if ! resolve_root \"$root\" >/dev/null; then","+    echo \"FATAL cannot resolve skill root $root (dangling link, or not a directory).\" >&2","+    echo \"      No changes made.\" >&2","+    exit 2","+  fi","+done","+R_SRC=\"$(resolve_root \"$SRC\")\"","+R_POOL=\"$(resolve_root \"$HOME/.agents/skills\")\"","+R_CODEX=\"$(resolve_root \"$HOME/.codex/skills\")\"","+for pair in \"$R_SRC|$R_POOL\" \"$R_SRC|$R_CODEX\" \"$R_POOL|$R_CODEX\"; do","+  if roots_overlap \"${pair%%|*}\" \"${pair#*|}\"; then","+    echo \"FATAL skill roots overlap: '${pair%%|*}' and '${pair#*|}' are the same tree or nested.\" >&2","+    echo \"     