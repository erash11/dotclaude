19 today, and changes on the next `npx skills add`.","originalFile":null,"structuredPatch":[{"oldStart":464,"oldLines":24,"newStart":464,"newLines":18,"lines":[" DRY=\"${DRY_RUN:-0}\""," MANIFEST_NAME=\".generated-by-sync-to-codex\""," ","-# AMEND-01 / R7-01: the ONE declared vendor inventory. These four are a","-# third-party package at ~/.agents/vendor-review/claudex-loop/, linked into","-# all three trees. They are not ours to publish, rewrite or version.","-# This is an EXPLICIT allowlist, not \"any symlink\" - a blanket symlink skip","-# would also wave the 15 ordinary outward links past the R1 guard below,","-# and a canonical skill that silently became a link into its own pool entry","-# would then be archived and deleted by the retirement loop.","-VENDORED=(claudex-loop claudex-route codex-build codex-review)","-VENDOR_ROOT=\"$HOME/.agents/vendor-review\"","+# R8-01: OWNERSHIP IS STRUCTURAL, NOT A LIST.","+#","+#   a real directory in ~/.claude/skills  = Eric wrote it   -> ours to publish","+#   a symlink in ~/.claude/skills          = installed by the","+#                                            skills CLI or vendored","+#                                                            -> never ours","+#","+# All 19 outward links here are third-party (14 recorded in","+# ~/.agents/.skill-lock.json, 4 from the vendor-review package, plus","+# persistent-localhost). No hard-coded name list is kept: it was 4 names","+# yesterday, is 19 today, and changes on the next `npx skills add`."," ","-is_vendored() {","-  local n","-  for n in \"${VENDORED[@]}\"; do","-    [ \"$1\" = \"$n\" ] && return 0","-  done","-  return 1","-}","-"," # R2-01: publish EVERY canonical skill, not a hand-kept list of seven."," # A hard-coded SHARED array is why the pool drifted and why 8 canonical"," # skills were missing from it entirely."]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"bd3aa7b7-b900-4317-ac0e-77631ca19d11","session_id":"c59d1788-5ebe-4b20-81a1-90