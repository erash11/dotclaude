alse)\n    new_block = [\"description: >-\"] + [\"  \" + w for w in wrapped]\n    lines[i:j] = new_block\n    if name in NAME_FIX:\n        old, new = NAME_FIX[name]\n        k = next(k for k, l in enumerate(lines) if re.match(r\"name\\s*:\", l))\n        assert lines[k].strip() == f\"name: {old}\", lines[k]\n        lines[k] = f\"name: {new}\"\n    out = \"---\\n\" + \"\\n\".join(lines) + rest\n    assert out[out.find(\"\\n---\", 3):] == rest, f\"{name}: body changed\"\n    open(path, \"w\", encoding=\"utf-8\").write(out)\n\nfor b in range(0, len(entries), 5):\n    batch = entries[b:b + 5]\n    for name, desc in batch:\n        rewrite(name, desc)\n    r = subprocess.run([\"python3\", CHK], capture_output=True, text=True)\n    still = [n for n, _ in batch if f\"FAIL {n}\\n\" in r.stdout]\n    print(f\"batch {b//5 + 1}: {[n for n, _ in batch]} -> {r.stdout.strip().splitlines()[-1]}; still failing in batch: {still}\")\n    if still:\n        print(r.stdout); sys.exit(1)\nprint(\"applied\", len(entries))\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"a03165a2-fc5f-4493-accc-9b5b4a5edca8","session_id":"c59d1788-5ebe-4b20-81a1-9007c16d8649","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"c59d1788-5ebe-4b20-81a1-9007c16d8649","version":"2.1.269","gitBranch":"main","slug":"replicated-greeting-planet"}
