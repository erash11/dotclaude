ars (>1024)\")","         problems.extend(clause_problems(low))","+    # R2-05: reject syntax outside the supported subset rather than","+    # silently accepting it. Duplicate keys and unbalanced quotes both","+    # parse \"successfully\" with a regex reader and mean something else","+    # to a real YAML loader.","     for k in keys:","         if k not in ALLOWED:","             problems.append(f\"unknown frontmatter key '{k}'\")","+    dupes = {k for k in keys if keys.count(k) > 1}","+    for k in sorted(dupes):","+        problems.append(f\"duplicate frontmatter key '{k}' - unsupported\")","+    for key in (\"name\", \"description\"):","+        raw = raw_scalar(fm, key)","+        if raw and raw[:1] in (\"'\", '\"') and not raw.endswith(raw[0]):","+            problems.append(f\"'{key}' has an unbalanced quote\")","     return name, problems"," ","+def raw_scalar(fm, key):","+    m = re.search(rf\"(?m)^{re.escape(key)}\\s*:[ \\t]*(.*)$\", fm)","+    return m.group(1).strip() if m else \"\"","+"," def clause_problems(low):","     \"\"\"R2-05: a positive phrase sitting INSIDE a negative phrase does not count.","     'Do not use when auditing' contains 'use when' at offset 7 - comparing"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"e549a319-74ba-4284-8445-131f68bcee3c","session_id":"c59d1788-5ebe-4b20-81a1-9007c16d8649","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/KeystoneOS","sessionId":"c59d1788-5ebe-4b20-81a1-9007c16d8649","version":"2.1.269","gitBranch":"main"}
