rs/kristinarash/DEV","sessionId":"67004755-6eb9-4324-a41f-97820a746f73","version":"2.1.289","gitBranch":"main"}
{"parentUuid":"f1c8e715-5575-4026-8a5a-5180d824cbc6","isSidechain":false,"promptId":"29694039-5529-4b2d-92d5-4fa6d92712d1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013L1GpxrpKY8hJX9UvKbAbN","type":"tool_result","content":"## main...origin/main\n#!/usr/bin/env bash\n# dev-activity.sh -- macOS twin of dev-activity.ps1. Rank DEV repos by how much they\n# are actually WORKED. Read-only: touches no path, moves nothing, writes nothing.\n#\n# Signal is DISTINCT COMMIT DAYS, not recency. Recency is fooled by a bulk migration:\n# on 2026-09-09, 43 repos got one commit each and all then looked \"recently active\".\n#\n# An earlier plan to move dormant repos into DEV/_archive was dropped because it would\n# break three things: harvest-dev-docs reads <dir>/docs/*.md without recursing (archived\n# repos drop out of the memsearch index silently); KeystoneOS data files hold DEV paths;\n# and Tier A project memory is slug-keyed by absolute path, so moving a repo orphans it.\n#\n# Usage: dev-activity.sh [days] [active-threshold]\nset -uo pipefail\nDAYS=\"${1:-90}\"\nACTIVE=\"${2:-5}\"\n\nDEV=\"$HOME/DEV\"\n[ -d \"$DEV/KeystoneOS\" ] || DEV=\"$HOME/Desktop/DEV\"\n\ntmp=\"$(mktemp)\"\ntrap 'rm -f \"$tmp\"' EXIT\n\nfor root in \"$DEV\" \"$DEV/Football\" \"$DEV/SpecialRequests\"; do\n  [ -d \"$root\" ] || continue\n  for p in \"$root\"/*/; do\n    [ -d \"$p/.git\" ] || continue\n    name=\"$(basename \"$p\")\"\n    case \"$name\" in .*|_*|*_OLD_merged*) continue ;; esac\n    d=$(git -C \"$p\" log --since=\"$DAYS days ago\" --format=%ad --date=short 2>/dev/null | sort -u | wc -l | tr -d ' ')\n    c=$(git -C \"$p\" log --since=\"$DAYS days ago\" --oneline 2>/dev/null | wc -l | tr -d ' ')\n    l=$(git -C \"$p\" log -1 --format=%ad --date=short 2>/dev/null)\n    printf '%s\\t%s\\t%s\\t%s\\n' \"$d\" \"$name\" \"$c\" \"$l\" >> \"$tmp\"\n  done\ndone\n\ntotal=$(wc -l < \"$tmp\" | tr -d ' ')\necho \"=== DEV activity: $total repos, ${DAYS}-day window, active = ${ACTIVE}+ commit days ===\"\necho\necho \"ACTIVE:\"\nShell cwd was reset to /Users/kristinarash/DEV","is_error":false}]},"uuid":"9a94e2d9-b695-4465-b09d-0638a091e54a","timestamp":"2026-10-05T12:47:43.256Z","toolUseResult":{"stdout":"## main...origin/main\n#!/usr/bin/env bash\n# dev-activity.sh -- macOS twin of dev-activity.ps1. Rank DEV repos by how much they\n# are actually WORKED. Read-only: touches no path, moves nothing, writes nothing.\n#\n# Signal is DISTINCT COMMIT DAYS, not recency. Recency is fooled by a bulk migration:\n# on 2026-09-09, 43 repos got one commit each and all then looked \"recently active\".\n#\n# An earlier plan to move dormant repos into DEV/_archive was dropped because it would\n# break three things: harvest-dev-docs reads <dir>/docs/*.md without recursing (archived\n# repos drop out of the memsearch index silently); KeystoneOS data files hold DEV paths;\n# and Tier A project memory is slug-keyed by absolute path, so moving a repo orphans it.\n#\n# Usage: dev-activity.sh [days] [active-threshold]\nset -uo pipefail\nDAYS=\"${1:-90}\"\nACTIVE=\"${2:-5}\"\n\nDEV=\"$HOME/DEV\"\n[ -d \"$DEV/KeystoneOS\" ] || DEV=\"$HOME/Desktop/DEV\"\n\ntmp=\"$(mktemp)\"\ntrap 'rm -f \"$tmp\"' EXIT\n\nfor root in \"$DEV\" \"$DEV/Football\" \"$DEV/SpecialRequests\"; do\n  [ -d \"$root\" ] || continue\n  for p in \"$root\"/*/; do\n    [ -d \"$p/.git\" ] || continue\n    name=\"$(basename \"$p\")\"\n    case \"$name\" in .*|_*|*_OLD_merged*) continue ;; esac\n    d=$(git -C \"$p\" log --since=\"$DAYS days ago\" --format=%ad --date=short 2>/dev/null | sort -u | wc -l | tr -d ' ')\n    c=$(git -C \"$p\" log --since=\"$DAYS days ago\" --oneline 2>/dev/null | wc -l | tr -d ' ')\n    l=$(git -C \"$p\" log -1 --format=%ad --date=short 2>/dev/null)\n    printf '%s\\t%s\\t%s\\t%s\\n' \"$d\" \"$name\" \"$c\" \"$l\" >> \"$tmp\"\n  done\ndone\n\ntotal=$(wc -l < \"$tmp\" | tr -d ' ')\necho \"=== DEV activity: $total repos, ${DAYS}-day window, active = ${ACTIVE}+ commit days ===\"\necho\necho \"ACTIVE:\"","stderr":"\nShell cwd was reset to /Users/kristinarash/DEV","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"f1c8e715-5575-4026-8a5a-5180d824cbc6","session_id":"67004755-6eb9-4324-a41f-97820a746f73","userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV","sessionId":"67004755-6eb9-4324-a41f-97820a746f73","version":"2.1.289","gitBranch":"main"}
