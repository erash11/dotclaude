p__zotero__teach_playbook","mcp__zotero__workflow","mcp__zotero__workflow_archive","mcp__zotero__workflow_status"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"pendingMcpServers":[],"failedMcpServers":[],"surfacedNames":["mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update","mcp__claude_ai_Firecrawl__firecrawl_scrape","mcp__claude_ai_Firecrawl__firecrawl_search"]},"type":"attachment","uuid":"34a493b2-3182-4f87-8742-28a6e4fd3515","timestamp":"2026-10-05T12:46:42.301Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\nmcp__claude_ai_Firecrawl__firecrawl_scrape\nmcp__claude_ai_Firecrawl__firecrawl_search\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nArtifactComments\nArtifactData\nCronCreate\nCronDelete\nCronList\nDesignSync\nEndConversation\nEnterPlanMode\nEnterWorktree\nExitPlanMode\nExitWorktree\nFetchInboxMessage\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nSendUserFile\nTaskStop\nWebFetch\nWebSearch\nmcp__claude-in-chrome__browser_batch\nmcp__claude-in-chrome__computer\nmcp__claude-in-chrome__file_upload\nmcp__claude-in-chrome__find\nmcp__claude-in-chrome__form_input\nmcp__claude-in-chrome__get_page_text\nmcp__claude-in-chrome__gif_creator\nmcp__claude-in-chrome__javascript_tool\nmcp__claude-in-chrome__list_connected_browsers\nmcp__claude-in-chrome__navigate\nmcp__claude-in-chrome__read_console_messages\nmcp__claude-in-chrome__read_network_requests\nmcp__claude-in-chrome__read_page\nmcp__claude-in-chrome__resize_window\nmcp__claude-in-chrome__select_browser\nmcp__claude-in-chrome__shortcuts_execute\nmcp__claude-in-chrome__shortcuts_list\nmcp__claude-in-chrome__switch_browser\nmcp__claude-in-chrome__tabs_close_mcp\nmcp__claude-in-chrome__tabs_context_mcp\nmcp__claude-in-chrome__tabs_create_mcp\nmcp__claude-in-chrome__upload_image\nmcp__claude_ai_Box__authenticate\nmcp__claude_ai_Box__complete_authentication\nmcp__claude_ai_Claude_Docs__create\nmcp__claude_ai_Claude_Docs__delete\nmcp__claude_ai_Claude_Docs__export\nmcp__claude_ai_Claude_Docs__query\nmcp__claude_ai_Claude_Docs__read\nmcp__claude_ai_Firecrawl__firecrawl_developer_search\nmcp__claude_ai_Firecrawl__firecrawl_find_tools\nmcp__claude_ai_Firecrawl__firecrawl_research_inspect_paper\nmcp__claude_ai_Firecrawl__firecrawl_research_read_paper\nmcp__claude_ai_Firecrawl__firecrawl_research_related_papers\nmcp__claude_ai_Firecrawl__firecrawl_research_search_papers\nmcp__claude_ai_Fireflies__fireflies_create_soundbite\nmcp__claude_ai_Fireflies__fireflies_fetch\nmcp__claude_ai_Fireflies__fireflies_get_active_meetings\nmcp__claude_ai_Fireflies__fireflies_get_analytics\nmcp__claude_ai_Fireflies__fireflies_get_channel\nmcp__claude_ai_Fireflies__fireflies_get_rule_executions\nmcp__claude_ai_Fireflies__fireflies_get_soundbites\nmcp__claude_ai_Fireflies__fireflies_get_summary\nmcp__claude_ai_Fireflies__fireflies_get_transcript\nmcp__claude_ai_Fireflies__fireflies_get_transcripts\nmcp__claude_ai_Fireflies__fireflies_get_user\nmcp__claude_ai_Fireflies__fireflies_get_user_contacts\nmcp__claude_ai_Fireflies__fireflies_get_usergroups\nmcp__claude_ai_Fireflies__fireflies_list_channels\nmcp__claude_ai_Fireflies__fireflies_move_meeting\nmcp__claude_ai_Fireflies__fireflies_revoke_meeting_access\nmcp__claude_ai_Fireflies__fireflies_search\nmcp__claude_ai_Fireflies__fireflies_share_meeting\nmcp__claude_ai_Fireflies__fireflies_update_meeting_privacy\nmcp__claude_ai_Fireflies__fireflies_update_meeting_title\nmcp__claude_ai_Gmail__apply_sensitive_message_label\nmcp__claude_a