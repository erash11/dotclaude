{"parentUuid":"11dd7b82-2a94-4dfe-8bb1-d4dc6833eb21","isSidechain":true,"agentId":"a5c3145ddf1f0dffe","attachment":{"type":"edited_text_file","filename":"/Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA/.worktrees/phase4-alignment/src/playcalls/alignment.py","snippet":"67\t    result = pd.concat(frames, ignore_index=True)\n68\t    # A float play_id stringifies as \"5642403.0\" and matches nothing. Trap 1.\n69\t    result[\"_pid\"] = _play_key(result[\"play_id\"])\n70\t    return (\n71\t        result.drop(columns=\"play_id\")\n72\t        .drop_duplicates(\"_pid\")\n73\t        .reset_index(drop=True)\n74\t    )\n75\t\n76\t\n77\tCHART_KEY = (\"season\", \"game_code\", \"play_no\")\n78\t\n79\t\n80\tdef _chart_extra_columns(chart: pd.DataFrame, joined: pd.DataFrame) -> list[str]:\n81\t    \"\"\"Chart columns the Phase 1 parquet does not already carry, plus the key.\n82\t\n83\t    Re-attaching a column the parquet already has would produce _x/_y pairs and\n84\t    a silently ambiguous frame.\n85\t    \"\"\"\n86\t    return [c for c in chart.columns if c not in joined.columns or c in CHART_KEY]\n87\t\n88\t\n89\tdef attach_chart_columns(\n90\t    joined: pd.DataFrame, charts: dict[int, pd.DataFrame]\n91\t) -> pd.DataFrame:\n92\t    \"\"\"Merge the widened charting columns onto the Phase 1 joined table.\n93\t\n94\t    outputs/joined_plays_enriched.parquet was written before charting.py was\n95\t    widened, so the new columns are not in it. This merge is asserted rather\n96\t    than trusted: a silent many-to-one here would inflate every denominator\n97\t    downstream, and success rates would look fine while being wrong.\n98\t    \"\"\"\n99\t    chart = pd.concat([charts[season] for season in sorted(charts)], ignore_index=True)\n100\t    extra = _chart_extra_columns(chart, joined)\n101\t    chart = chart[extra].copy()\n102\t\n103\t    if chart.duplicated(list(CHART_KEY)).any():\n104\t        raise ValueError(\"charting key (season, game_code, play_no) is not unique\")\n105\t    if joined.duplicated(list(CHART_KEY)).any():\n106\t        raise ValueError(\"joined key (season, game_code, play_no) is not unique\")\n107\t\n108\t    result = joined.merge(chart, on=list(CHART_KEY), how=\"left\", validate=\"one_to_one\")\n109\t    if len(result) != len(joined):\n110\t        raise ValueError(\n111\t            f\"chart merge changed the row count: {len(joined)} -> {len(result)}\"\n112\t        )\n113\t\n114\t    probe = [c for c in extra if c not in CHART_KEY][-1]\n115\t    unmatched = int(result[probe].isna().sum())\n116\t    if unmatched:\n117\t        raise ValueError(f\"chart merge left {unmatched} unmatched joined rows\")\n118\t    return result\n119\t\n120\t\n121\tdef attach_pff_alignment(\n122\t    df: pd.DataFrame, pff_alignment: pd.DataFrame\n123\t) -> pd.DataFrame:\n124\t    \"\"\"Left-merge PFF alignment fields on the normalised play id.\n125\t\n126\t    Columns that already exist on the left (play_action, screen, shotgun and so\n127\t    on came through Phase 1's join) are suffixed _pff rather than overwritten,\n128\t    so a later disagreement between the two sources stays visible.\n129\t    \"\"\"\n130\t    result = df.copy()\n131\t    result[\"_pid\"] = _play_key(result[\"play_id\"])\n132\t    right = pff_alignment.drop(\n133\t        columns=[c for c in (\"pff_game_id\",) if c in pff_alignment.columns]\n134\t    )\n135\t    overlapping = [c for c in right.columns if c in result.columns and c != \"_pid\"]\n136\t    right = right.rename(columns={c: f\"{c}_pff\" for c in overlapping})\n137\t    return result.merge(right, on=\"_pid\", how=\"left\").drop(columns=\"_pid\")"},"type":"attachment","uuid":"4d2d0914-d3e7-4dc4-bd92-9dffa24b5d06","timestamp":"2026-09-10T03:28:03.186Z","rendered":[{"content":"<system-reminder>\nNote: /Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA/.worktrees/phase4-alignment/src/playcalls/alignment.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n67\t    result = pd.concat(frames, ignore_index=True)\n68\t    # A float play_id stringifies as \"5642403.0\" and matches nothing. Trap 1.\n69\t    result[\"_pid\"] = _play_key(result[\"play_id\"])\n70\t    return (\n71\t        result.drop(columns=\"play_id\")\n72\t        .drop_duplicates(\"_pid\")\n73\t        .reset_index(drop=True)\n74\t    )\n75\t\n76\t\n77\tCHART_KEY = (\"season\", \"game_code\", \"play_no\")\n78\t\n79\t\n80\tdef _chart_extra_columns(chart: pd.DataFrame, joined: pd.DataFrame) -> list[str]:\n81\t    \"\"\"Chart columns the Phase 1 parquet does not already carry, plus the key.\n82\t\n83\t    Re-attaching a column the parquet already has would produce _x/_y pairs and\n84\t    a silently ambiguous frame.\n85\t    \"\"\"\n86\t    return [c for c in chart.columns if c not in joined.columns or c in CHART_KEY]\n87\t\n88\t\n89\tdef attach_chart_columns(\n90\t    joined: pd.DataFrame, charts: dict[int, pd.DataFrame]\n91\t) -> pd.DataFrame:\n92\t    \"\"\"Merge the widened charting columns onto the Phase 1 joined table.\n93\t\n94\t    outputs/joined_plays_enriched.parquet was written before charting.py was\n95\t    widened, so the new columns are not in it. This merge is asserted rather\n96\t    than trusted: a silent many-to-one here would inflate every denominator\n97\t    downstream, and success rates would look fine while being wrong.\n98\t    \"\"\"\n99\t    chart = pd.concat([charts[season] for season in sorted(charts)], ignore_index=True)\n100\t    extra = _chart_extra_columns(chart, joined)\n101\t    chart = chart[extra].copy()\n102\t\n103\t    if chart.duplicated(list(CHART_KEY)).any():\n104\t        raise ValueError(\"charting key (season, game_code, play_no) is not unique\")\n105\t    if joined.duplicated(list(CHART_KEY)).any():\n106\t        raise ValueError(\"joined key (season, game_code, play_no) is not unique\")\n107\t\n108\t    result = joined.merge(chart, on=list(CHART_KEY), how=\"left\", validate=\"one_to_one\")\n109\t    if len(result) != len(joined):\n110\t        raise ValueError(\n111\t            f\"chart merge changed the row count: {len(joined)} -> {len(result)}\"\n112\t        )\n113\t\n114\t    probe = [c for c in extra if c not in CHART_KEY][-1]\n115\t    unmatched = int(result[probe].isna().sum())\n116\t    if unmatched:\n117\t        raise ValueError(f\"chart merge left {unmatched} unmatched joined rows\")\n118\t    return result\n119\t\n120\t\n121\tdef attach_pff_alignment(\n122\t    df: pd.DataFrame, pff_alignment: pd.DataFrame\n123\t) -> pd.DataFrame:\n124\t    \"\"\"Left-merge PFF alignment fields on the normalised play id.\n125\t\n126\t    Columns that already exist on the left (play_action, screen, shotgun and so\n127\t    on came through Phase 1's join) are suffixed _pff rather than overwritten,\n128\t    so a later disagreement between the two sources stays visible.\n129\t    \"\"\"\n130\t    result = df.copy()\n131\t    result[\"_pid\"] = _play_key(result[\"play_id\"])\n132\t    right = pff_alignment.drop(\n133\t        columns=[c for c in (\"pff_game_id\",) if c in pff_alignment.columns]\n134\t    )\n135\t    overlapping = [c for c in right.columns if c in result.columns and c != \"_pid\"]\n136\t    right = right.rename(columns={c: f\"{c}_pff\" for c in overlapping})\n137\t    return result.merge(right, on=\"_pid\", how=\"left\").drop(columns=\"_pid\")\n</system-reminder>"}],"userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA/.worktrees/phase4-alignment","sessionId":"b8143861-beec-4930-9c27-06bc9d94fa8b","version":"2.1.267","gitBranch":"main"}
