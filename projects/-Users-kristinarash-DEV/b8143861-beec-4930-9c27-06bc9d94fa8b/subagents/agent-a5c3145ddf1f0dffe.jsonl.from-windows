\"\"\"team_play holds both teams and they collide on play_id. Trap 2.\"\"\"\n80\t    assert (pff_alignment[\"offense\"] == \"TXBA\").all()\n</system-reminder>"}],"userType":"external","entrypoint":"cli","cwd":"/Users/kristinarash/DEV/PlayCalls_SuccessRate_EPA/.worktrees/phase4-alignment","sessionId":"b8143861-beec-4930-9c27-06bc9d94fa8b","version":"2.1.267","gitBranch":"main"}
