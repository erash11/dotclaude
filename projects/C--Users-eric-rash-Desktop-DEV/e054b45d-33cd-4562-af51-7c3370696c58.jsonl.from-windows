{"type":"cost-state","sessionId":"e054b45d-33cd-4562-af51-7c3370696c58","totalCostUSD":5.9396358000000005,"totalAPIDuration":3011484,"totalAPIDurationWithoutRetries":446679,"totalToolDuration":523424,"totalLinesAdded":134,"totalLinesRemoved":0,"totalDuration":16807621,"startTime":1790600213180,"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":944,"outputTokens":16,"thinkingTokens":0,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.001024},"claude-opus-5-5[1m]":{"inputTokens":17166,"outputTokens":38094,"thinkingTokens":8061,"cacheReadInputTokens":10764429,"cacheCreationInputTokens":403888,"webSearchRequests":0,"costUSD":5.938611800000001}},"hasUnknownModelCost":false}
{"type":"ai-title","aiTitle":"drive triage handoff","sessionId":"e054b45d-33cd-4562-af51-7c3370696c58"}
