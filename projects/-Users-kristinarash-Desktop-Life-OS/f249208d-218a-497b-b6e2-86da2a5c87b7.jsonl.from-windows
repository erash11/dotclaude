ssages","mcp__Claude_in_Chrome__read_network_requests","mcp__Claude_in_Chrome__read_page","mcp__Claude_in_Chrome__resize_window","mcp__Claude_in_Chrome__select_browser","mcp__Claude_in_Chrome__shortcuts_execute","mcp__Claude_in_Chrome__shortcuts_list","mcp__Claude_in_Chrome__switch_browser","mcp__Claude_in_Chrome__tabs_close_mcp","mcp__Claude_in_Chrome__tabs_context_mcp","mcp__Claude_in_Chrome__tabs_create_mcp","mcp__Claude_in_Chrome__upload_image","mcp__Control_your_Mac__osascript","mcp__PowerPoint__By_Anthropic___add_slide","mcp__PowerPoint__By_Anthropic___add_text_to_slide","mcp__PowerPoint__By_Anthropic___close_presentation","mcp__PowerPoint__By_Anthropic___create_presentation","mcp__PowerPoint__By_Anthropic___delete_slide","mcp__PowerPoint__By_Anthropic___export_pdf","mcp__PowerPoint__By_Anthropic___get_slide_content","mcp__PowerPoint__By_Anthropic___insert_image","mcp__PowerPoint__By_Anthropic___open_presentation","mcp__PowerPoint__By_Anthropic___save_presentation","mcp__PowerPoint__By_Anthropic___set_slide_title","mcp__Word__By_Anthropic___close_document","mcp__Word__By_Anthropic___create_document","mcp__Word__By_Anthropic___export_pdf","mcp__Word__By_Anthropic___format_text","mcp__Word__By_Anthropic___get_document_text","mcp__Word__By_Anthropic___insert_text","mcp__Word__By_Anthropic___open_document","mcp__Word__By_Anthropic___replace_text","mcp__Word__By_Anthropic___save_document","mcp__ccd_directory__request_directory","mcp__ccd_session_mgmt__archive_session","mcp__ccd_session_mgmt__list_sessions","mcp__ccd_session_mgmt__search_session_transcripts","mcp__computer-use__computer_batch","mcp__computer-use__cursor_position","mcp__computer-use__double_click","mcp__computer-use__hold_key","mcp__computer-use__key","mcp__computer-use__left_click","mcp__computer-use__left_click_drag","mcp__computer-use__left_mouse_down","mcp__computer-use__left_mouse_up","mcp__computer-use__list_granted_applications","mcp__computer-use__middle_click","mcp__computer-use__mouse_move"