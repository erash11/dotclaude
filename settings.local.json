{
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Bash(claude:*)",
      "Bash(npm:*)",
      "Bash(bash --version)",
      "Bash(powershell --version)",
      "Bash(powershell -Command '$PSVersionTable.PSVersion')",
      "Bash(winget install:*)",
      "Bash(cmd /c \"winget install Microsoft.PowerShell\")",
      "Bash(graphify install:*)",
      "Bash(powershell.exe:*)",
      "Bash(python -c ':*)",
      "Bash(mkdir -p graphify-out)",
      "Bash(rm -f .graphify_detect.json .graphify_extract.json .graphify_ast.json .graphify_semantic.json .graphify_analysis.json .graphify_labels.json .graphify_chunk*.json .graphify_python .graphify_uncached.txt .graphify_cached.json .graphify_chunk*_result.json)",
      "Bash(python -c \"import sys; print\\(sys.stdin.read\\(\\).encode\\('ascii','replace'\\).decode\\('ascii'\\)\\)\")",
      "Bash(xargs grep:*)",
      "Bash(awk '{print $2}')"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\eric_rash\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
