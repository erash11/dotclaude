# dotclaude config repo — whitelist approach.
# Ignore everything at top level, then re-include only durable config.
# Explicitly NEVER tracked: .credentials.json (OAuth tokens), token-dashboard.db,
# caches, session state, and nested repos (skills/, global-memory/, claude-memory-compiler/).
/*

!/.gitignore
!/RESTORE.md
!/CLAUDE.md
!/AGENTS.md
!/TOOLPATHS.md
!/STORAGE.md
!/HARNESS_FIXES.md
!/settings.json
!/settings.local.json
!/keybindings.json
!/agents/
!/hooks/
!/skills-archive/
!/audits/
!/scripts/
!/mods/
!/docs/
!/output-styles/
mods/**/.claude-plugin/types/
mods/.loadlist
scripts/logs/
**/.env

!/CREDENTIALS.md
!/.gitattributes

# Claude Code session transcripts (added 2026-09-09)
!/projects/

!/machine.macos.md
!/machine.windows.md
# machine.md is per-machine, never tracked
audits/recall-eval/logs/
__pycache__/
# recall bench evidence holds note text (athlete names): local only
scripts/recall-bench/out/
scripts/recall-bench/out-run2/
scripts/recall-bench/out-run3/
scripts/recall-bench/out-run4/
scripts/recall-bench/out-run5/
scripts/recall-bench/out-run6/

# Config backups are git history plus the daily Drive tgz. No loose copies (2026-10-24).
**/*.bak*
**/*.win-orig
**/*.orig
