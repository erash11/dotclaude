# dotclaude config repo — whitelist approach.
# Ignore everything at top level, then re-include only durable config.
# Explicitly NEVER tracked: .credentials.json (OAuth tokens), token-dashboard.db,
# caches, session state, and nested repos (skills/, global-memory/, claude-memory-compiler/).
/*

!/.gitignore
!/RESTORE.md
!/CLAUDE.md
!/AGENTS.md
!/TOOLPATHS.md
!/HARNESS_FIXES.md
!/settings.json
!/settings.local.json
!/keybindings.json
!/statusline-command.py
!/package.json
!/agents/
!/hooks/
!/skills-archive/
!/skills-audit/
!/audits/
!/scripts/
!/mods/
mods/**/.claude-plugin/types/
mods/.loadlist
scripts/logs/
**/.env

!/MIGRATION-MACOS.md
!/CREDENTIALS.md
!/START-HERE.md
!/RECOVERY-INVENTORY.md
!/restore.command
!/restore-README.txt
!/.gitattributes

# Claude Code session transcripts (added 2026-09-09)
!/projects/

!/machine.macos.md
!/machine.windows.md
# machine.md is per-machine, never tracked
audits/recall-eval/logs/
