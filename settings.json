  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skill-router/router.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/uv run --directory $HOME/.claude/claude-memory-compiler python $HOME/.claude/claude-memory-compiler/hooks/session-start.py",
            "timeout": 15,
            "statusMessage": "Loading knowledge base..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/superpowers-quiet.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/keystone-unified-snapshot.js\"",
            "timeout": 15,
            "statusMessage": "Loading unified cross-harness snapshot..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/uv run --directory $HOME/.claude/claude-memory-compiler python $HOME/.claude/claude-memory-compiler/hooks/pre-compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "exec $HOME/.local/bin/uv run --directory $HOME/.claude/claude-memory-compiler python $HOME/.claude/claude-memory-compiler/hooks/session-end.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "exec node \"$HOME/.claude/hooks/memsearch-sync.js\"",
            "timeout": 50
          },
          {
            "type": "command",
            "command": "exec node \"$HOME/.claude/hooks/session-autopush.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/dcg\" ]; then exec \"$HOME/.local/bin/dcg\"; else cat >/dev/null; fi"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*|WebFetch|SendMessage|SendUserFile|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/permission-gate/shadow_hook.py\" ]; then exec python3 \"$HOME/.claude/permission-gate/shadow_hook.py\"; else cat >/dev/null; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/transcript-capture.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
